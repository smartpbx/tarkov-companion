<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../TarkovCompanion.Core/TarkovCompanion.Core.csproj" />
    <ProjectReference Include="../TarkovCompanion.Application/TarkovCompanion.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="TesseractOCR" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TarkovCompanion.IntegrationTests" />
    <!-- Release verifier tests inject a process boundary so cancellation can prove the child is
         gone before staging cleanup begins, without executing an untrusted test binary. -->
    <InternalsVisibleTo Include="TarkovCompanion.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    <EmbeddedResource Include="../../assets/maps/extract-switch-overrides.json"
                      Link="Maps/extract-switch-overrides.json"
                      LogicalName="TarkovCompanion.Infrastructure.Maps.extract-switch-overrides.json" />
    <EmbeddedResource Include="Recognition/anchors.en.json"
                      WithCulture="false"
                      LogicalName="TarkovCompanion.Infrastructure.Recognition.anchors.en.json" />
    <EmbeddedResource Include="Recognition/Tessdata/eng.traineddata" />
  </ItemGroup>
</Project>
