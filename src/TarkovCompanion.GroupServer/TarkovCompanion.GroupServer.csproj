<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TarkovCompanion.GroupServer</RootNamespace>
    <AssemblyName>TarkovCompanion.GroupServer</AssemblyName>
    <UserSecretsId>tarkov-companion-group-server</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TarkovCompanion.Core\TarkovCompanion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The second screen, embedded rather than copied beside the binary. A server deployed as
         one file and a page that has to sit next to it is a deployment that works until
         somebody moves the file. -->
    <EmbeddedResource Include="Tablet/index.html" LogicalName="TarkovCompanion.GroupServer.Tablet.index.html" />
    <EmbeddedResource Include="Admin/index.html" LogicalName="TarkovCompanion.GroupServer.Admin.index.html" />
  </ItemGroup>

</Project>
