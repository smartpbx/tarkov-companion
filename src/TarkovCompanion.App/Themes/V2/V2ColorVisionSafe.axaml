<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Preference application is owned by #270. These role overrides deliberately preserve the
       word, glyph, and border cues required by the semantic manifest. -->
  <Color x:Key="V2.Cvd.RedGreenSafe.Success">#0072B2</Color>
  <Color x:Key="V2.Cvd.RedGreenSafe.Warning">#E69F00</Color>
  <Color x:Key="V2.Cvd.RedGreenSafe.Danger">#CC79A7</Color>
  <Color x:Key="V2.Cvd.BlueYellowSafe.Success">#008A8A</Color>
  <Color x:Key="V2.Cvd.BlueYellowSafe.Warning">#A44A00</Color>
  <Color x:Key="V2.Cvd.BlueYellowSafe.Danger">#8D2F6D</Color>
  <Color x:Key="V2.Cvd.Monochrome.Success">#FFFFFF</Color>
  <Color x:Key="V2.Cvd.Monochrome.Warning">#FFFFFF</Color>
  <Color x:Key="V2.Cvd.Monochrome.Danger">#FFFFFF</Color>
</ResourceDictionary>
