<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme-independent V2 values. A V2 consumer uses these role names only; the numbers are private
       to this Avalonia adapter and the semantic manifest names the roles without their values.
       Colours and shadows vary by theme and live in V2ThemeVariants.axaml. Nothing here merges
       another dictionary, so a test can load and read this file on its own. -->

  <!-- Readable floors: nothing below 14 DIP, and every size carries its line height. -->
  <x:Double x:Key="V2.Type.Heading1.Size">28</x:Double>
  <x:Double x:Key="V2.Type.Heading1.LineHeight">36</x:Double>
  <x:Double x:Key="V2.Type.Heading2.Size">22</x:Double>
  <x:Double x:Key="V2.Type.Heading2.LineHeight">28</x:Double>
  <x:Double x:Key="V2.Type.Heading3.Size">18</x:Double>
  <x:Double x:Key="V2.Type.Heading3.LineHeight">24</x:Double>
  <x:Double x:Key="V2.Type.Body.Size">16</x:Double>
  <x:Double x:Key="V2.Type.Body.LineHeight">24</x:Double>
  <x:Double x:Key="V2.Type.Label.Size">14</x:Double>
  <x:Double x:Key="V2.Type.Label.LineHeight">20</x:Double>

  <!-- Each step exists as a gap (StackPanel.Spacing is a double) and an inset (Padding and Margin
       are Thickness). A DynamicResource of the wrong type is not converted, so one value cannot
       serve both. -->
  <x:Double x:Key="V2.Space.Xs.Gap">4</x:Double>
  <Thickness x:Key="V2.Space.Xs.Inset">4</Thickness>
  <x:Double x:Key="V2.Space.Sm.Gap">8</x:Double>
  <Thickness x:Key="V2.Space.Sm.Inset">8</Thickness>
  <x:Double x:Key="V2.Space.Md.Gap">12</x:Double>
  <Thickness x:Key="V2.Space.Md.Inset">12</Thickness>
  <x:Double x:Key="V2.Space.Lg.Gap">16</x:Double>
  <Thickness x:Key="V2.Space.Lg.Inset">16</Thickness>
  <x:Double x:Key="V2.Space.Xl.Gap">24</x:Double>
  <Thickness x:Key="V2.Space.Xl.Inset">24</Thickness>

  <!-- A Border takes a CornerRadius and a Rectangle two doubles, so each shape has both forms. -->
  <CornerRadius x:Key="V2.Shape.Control">6</CornerRadius>
  <x:Double x:Key="V2.Shape.Control.Radius">6</x:Double>
  <CornerRadius x:Key="V2.Shape.Card">10</CornerRadius>
  <x:Double x:Key="V2.Shape.Card.Radius">10</x:Double>

  <!-- Density changes whitespace only. Type sizes and target minimums are deliberately absent. -->
  <x:Double x:Key="V2.Density.Compact.Gap">8</x:Double>
  <Thickness x:Key="V2.Density.Compact.Inset">8</Thickness>
  <x:Double x:Key="V2.Density.Standard.Gap">12</x:Double>
  <Thickness x:Key="V2.Density.Standard.Inset">16</Thickness>
  <x:Double x:Key="V2.Density.Comfortable.Gap">16</x:Double>
  <Thickness x:Key="V2.Density.Comfortable.Inset">20</Thickness>

  <x:Double x:Key="V2.Target.Desktop">44</x:Double>
  <x:Double x:Key="V2.Target.Touch">48</x:Double>

  <Thickness x:Key="V2.Focus.Indicator.Thickness">3</Thickness>

  <!-- Adapters pick one of these when a control actually animates; reduced motion keeps the state
       change and drops the transition. -->
  <x:TimeSpan x:Key="V2.Motion.Full.Duration">00:00:00.16</x:TimeSpan>
  <x:TimeSpan x:Key="V2.Motion.Reduced.Duration">00:00:00</x:TimeSpan>

  <!-- Shape cues named by the manifest's status and banner-tone glyph ids. They are decorative beside
       the state word, so views mark them AccessibilityView="Raw" and never translate them. -->
  <x:String x:Key="V2.Glyph.Check">✓</x:String>
  <x:String x:Key="V2.Glyph.QuarterCircle">◔</x:String>
  <x:String x:Key="V2.Glyph.Question">?</x:String>
  <x:String x:Key="V2.Glyph.Minus">−</x:String>
  <x:String x:Key="V2.Glyph.SlashedCircle">⊘</x:String>
  <x:String x:Key="V2.Glyph.CircledMinus">⊖</x:String>
  <x:String x:Key="V2.Glyph.Cross">✕</x:String>
  <x:String x:Key="V2.Glyph.FilledSquare">■</x:String>
  <x:String x:Key="V2.Glyph.HalfSquare">◧</x:String>
  <x:String x:Key="V2.Glyph.EmptySquare">□</x:String>
  <x:String x:Key="V2.Glyph.FilledDiamond">◆</x:String>
  <x:String x:Key="V2.Glyph.EmptyDiamond">◇</x:String>
  <x:String x:Key="V2.Glyph.InsetDiamond">◈</x:String>
  <x:String x:Key="V2.Glyph.CircledInfo">ⓘ</x:String>
  <x:String x:Key="V2.Glyph.WarningSign">⚠</x:String>
  <x:String x:Key="V2.Glyph.DoubleExclamation">‼</x:String>
</ResourceDictionary>
