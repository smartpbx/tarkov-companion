<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme-independent V2 values. A V2 consumer uses these role names only; the numbers are private
       to this Avalonia adapter and the semantic manifest names the roles without their values.
       Colours and shadows vary by theme and live in V2ThemeVariants.axaml. Nothing here merges
       another dictionary, so a test can load and read this file on its own. -->

  <!-- Readable floors: nothing below 12 DIP at 100%, and every size carries its line height.
       [#574] The whole ramp is one step smaller than it first was (28/22/18/16/14): the app runs
       on a 1920x1080 second screen beside the game, where the first ramp read as big. The text
       setting (100-200%) multiplies these, so a player who wants the old size picks 125%.
       Display is for the one number a page exists to show (a price, a pairing code); a view that
       wants a size asks for a role here rather than writing a literal, which would not scale. -->
  <x:Double x:Key="V2.Type.Display.Size">32</x:Double>
  <x:Double x:Key="V2.Type.Display.LineHeight">40</x:Double>
  <x:Double x:Key="V2.Type.Heading1.Size">24</x:Double>
  <x:Double x:Key="V2.Type.Heading1.LineHeight">32</x:Double>
  <x:Double x:Key="V2.Type.Heading2.Size">20</x:Double>
  <x:Double x:Key="V2.Type.Heading2.LineHeight">26</x:Double>
  <x:Double x:Key="V2.Type.Heading3.Size">16</x:Double>
  <x:Double x:Key="V2.Type.Heading3.LineHeight">22</x:Double>
  <x:Double x:Key="V2.Type.Body.Size">14</x:Double>
  <x:Double x:Key="V2.Type.Body.LineHeight">20</x:Double>
  <x:Double x:Key="V2.Type.Label.Size">12</x:Double>
  <x:Double x:Key="V2.Type.Label.LineHeight">18</x:Double>

  <!-- Each step exists as a gap (StackPanel.Spacing is a double) and an inset (Padding and Margin
       are Thickness). A DynamicResource of the wrong type is not converted, so one value cannot
       serve both. -->
  <x:Double x:Key="V2.Space.Xs.Gap">4</x:Double>
  <Thickness x:Key="V2.Space.Xs.Inset">4</Thickness>
  <x:Double x:Key="V2.Space.Sm.Gap">8</x:Double>
  <Thickness x:Key="V2.Space.Sm.Inset">8</Thickness>
  <x:Double x:Key="V2.Space.Md.Gap">12</x:Double>
  <Thickness x:Key="V2.Space.Md.Inset">12</Thickness>
  <x:Double x:Key="V2.Space.Lg.Gap">16</x:Double>
  <Thickness x:Key="V2.Space.Lg.Inset">16</Thickness>
  <x:Double x:Key="V2.Space.Xl.Gap">24</x:Double>
  <Thickness x:Key="V2.Space.Xl.Inset">24</Thickness>

  <!-- A Border takes a CornerRadius and a Rectangle two doubles, so each shape has both forms. -->
  <CornerRadius x:Key="V2.Shape.Control">6</CornerRadius>
  <x:Double x:Key="V2.Shape.Control.Radius">6</x:Double>
  <CornerRadius x:Key="V2.Shape.Card">10</CornerRadius>
  <x:Double x:Key="V2.Shape.Card.Radius">10</x:Double>

  <!-- Density changes whitespace only. Type sizes and target minimums are deliberately absent.
       Gap is the space between a card's children and between cards; Inset is a card's padding.
       [#574] Compact was 8/8 against Standard's 12/16, which on a card of three lines was not a
       visible difference; it is 6/10 now, and Comfortable stays a clear step the other way. -->
  <x:Double x:Key="V2.Density.Compact.Gap">6</x:Double>
  <Thickness x:Key="V2.Density.Compact.Inset">10</Thickness>
  <x:Double x:Key="V2.Density.Standard.Gap">12</x:Double>
  <Thickness x:Key="V2.Density.Standard.Inset">16</Thickness>
  <x:Double x:Key="V2.Density.Comfortable.Gap">16</x:Double>
  <Thickness x:Key="V2.Density.Comfortable.Inset">20</Thickness>

  <!-- [#574] Desktop is the height of every ordinary control: button, toggle, segment, chip, menu
       button, field. It was 44, a touch figure, on an app driven by a mouse on a 1080p second
       screen; 32 clears the 24 DIP pointer-target minimum with room. Touch stays what it says. -->
  <x:Double x:Key="V2.Target.Desktop">32</x:Double>
  <x:Double x:Key="V2.Target.Touch">48</x:Double>

  <!-- [#574] One button family. Three heights: Small for a choice inside a caption or a table
       row, Desktop (above) for everything ordinary, Large for the one primary action of a page
       or card. An icon-only button is a Desktop square, so it lines up with its neighbours. Inset is the padding that goes
       with each height; Gap is the space between an icon and its label, everywhere. -->
  <x:Double x:Key="V2.Control.Small.Height">24</x:Double>
  <Thickness x:Key="V2.Control.Small.Inset">8,2</Thickness>
  <Thickness x:Key="V2.Control.Inset">12,4</Thickness>
  <x:Double x:Key="V2.Control.Large.Height">40</x:Double>
  <Thickness x:Key="V2.Control.Large.Inset">20,8</Thickness>
  <x:Double x:Key="V2.Control.Gap">8</x:Double>
  <!-- [#921] A choice inside a segmented group (Navigate/Inspect/Route/Draw, 2D/Stack/3D, the
       floor ladder): the group's 1 DIP outline above and below brings it to Desktop, so a group
       and a lone button beside it share one height and one baseline. An icon-only choice is as
       wide as it is tall; a worded one is a little tighter than a lone button, because the group's
       outline already sets it apart, and that is what keeps the Raid strip one row in raid. -->
  <x:Double x:Key="V2.Control.Segment.Height">30</x:Double>
  <Thickness x:Key="V2.Control.Segment.Inset">10,4</Thickness>
  <!-- [#921] A chip on a toolbar (the Raid strip's traffic chip, the map's off-plan chip): the
       buttons' height, label type and a narrower side inset, because it states and is not pressed. -->
  <Thickness x:Key="V2.Control.Chip.Inset">8,4</Thickness>
  <!-- [#921] The space between two controls on a toolbar or a map strip. -->
  <x:Double x:Key="V2.Control.Spacing">8</x:Double>

  <!-- [#574] Three icon sizes and one stroke weight. The geometry in V2Icons.axaml is drawn on a
       24 grid, and a Path with Stretch=None ignores Width and Height when it draws, so a view
       that wrote Width="16" got a 24 DIP icon hanging 8 DIP out of a 16 DIP box: that is what
       put the Layers button's icon on top of its label. Each size is therefore a box, the scale
       that fits the 24 grid into it, and the stroke that comes out at 1.5 DIP after that scale.
       Small sits in a chip or a table row, Default beside body text in a button, menu row or
       tab, Large in an icon-only button and the navigation rail. -->
  <x:Double x:Key="V2.IconSize.Small">14</x:Double>
  <ScaleTransform x:Key="V2.IconSize.Small.Scale" ScaleX="0.58333" ScaleY="0.58333" />
  <x:Double x:Key="V2.IconSize.Small.Stroke">2.57</x:Double>
  <x:Double x:Key="V2.IconSize.Default">16</x:Double>
  <ScaleTransform x:Key="V2.IconSize.Default.Scale" ScaleX="0.66667" ScaleY="0.66667" />
  <x:Double x:Key="V2.IconSize.Default.Stroke">2.25</x:Double>
  <x:Double x:Key="V2.IconSize.Large">20</x:Double>
  <ScaleTransform x:Key="V2.IconSize.Large.Scale" ScaleX="0.83333" ScaleY="0.83333" />
  <x:Double x:Key="V2.IconSize.Large.Stroke">1.8</x:Double>
  <!-- The grid itself, for an icon a Viewbox scales: the Viewbox does the fitting, so the Path
       inside keeps the whole grid and is not scaled twice. -->
  <x:Double x:Key="V2.IconSize.Grid">24</x:Double>
  <x:Double x:Key="V2.IconSize.Grid.Stroke">1.6</x:Double>

  <Thickness x:Key="V2.Focus.Indicator.Thickness">3</Thickness>

  <!-- Adapters pick one of these when a control actually animates; reduced motion keeps the state
       change and drops the transition. -->
  <x:TimeSpan x:Key="V2.Motion.Full.Duration">00:00:00.16</x:TimeSpan>
  <x:TimeSpan x:Key="V2.Motion.Reduced.Duration">00:00:00</x:TimeSpan>

  <!-- Shape cues named by the manifest's status and banner-tone glyph ids. They are decorative beside
       the state word, so views mark them AccessibilityView="Raw" and never translate them. -->
  <x:String x:Key="V2.Glyph.Check">✓</x:String>
  <x:String x:Key="V2.Glyph.QuarterCircle">◔</x:String>
  <x:String x:Key="V2.Glyph.Question">?</x:String>
  <x:String x:Key="V2.Glyph.Minus">−</x:String>
  <x:String x:Key="V2.Glyph.SlashedCircle">⊘</x:String>
  <x:String x:Key="V2.Glyph.CircledMinus">⊖</x:String>
  <x:String x:Key="V2.Glyph.Cross">✕</x:String>
  <x:String x:Key="V2.Glyph.FilledSquare">■</x:String>
  <x:String x:Key="V2.Glyph.HalfSquare">◧</x:String>
  <x:String x:Key="V2.Glyph.EmptySquare">□</x:String>
  <x:String x:Key="V2.Glyph.FilledDiamond">◆</x:String>
  <x:String x:Key="V2.Glyph.EmptyDiamond">◇</x:String>
  <x:String x:Key="V2.Glyph.InsetDiamond">◈</x:String>
  <x:String x:Key="V2.Glyph.CircledInfo">ⓘ</x:String>
  <x:String x:Key="V2.Glyph.WarningSign">⚠</x:String>
  <x:String x:Key="V2.Glyph.DoubleExclamation">‼</x:String>
</ResourceDictionary>
