  <!-- [Issue 508] Pins, not the boxed chip a waypoint and a quest objective used to share. Both
       are drawn on the same 28x36 grid, bounding box touching every edge on purpose
       (MapPinGeometry.Width/Height and MapPinAnchorTests depend on that), so both shapes' tip —
       the bottom-centre point — lands on the exact map coordinate the same way. Only the head
       differs: round for a waypoint, a pointed shield for a quest objective, so shape tells the
       two apart before colour or label ever has to. -->
  <StreamGeometry x:Key="V2.Icon.PinRound">M14,36 C14,36 0,24 0,14 A14,14 0 1 1 28,14 C28,24 14,36 14,36 Z</StreamGeometry>
  <StreamGeometry x:Key="V2.Icon.PinShield">M0,0 L28,0 L28,18 L14,36 L0,18 Z</StreamGeometry>
