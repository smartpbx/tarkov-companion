<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The future V2 host merges this one dictionary; V1 remains untouched until #267. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://TarkovCompanion/Themes/V2/V2Tokens.axaml" />
    <ResourceInclude Source="avares://TarkovCompanion/Themes/V2/V2Strings.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
