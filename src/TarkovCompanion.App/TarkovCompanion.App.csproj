<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TarkovCompanion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The executable's icon, which is what Explorer, the taskbar and alt-tab show. Separate
         from the window icon below it and from the installer's; setting one leaves the others
         at their defaults, which is how an application ends up anonymous in two places out of
         three. -->
    <ApplicationIcon>Assets/TarkovCompanion.ico</ApplicationIcon>
    <!-- Two frameworks, because the Windows OCR engine needs a Windows target and everything
         else here does not. The portable one is what Linux CI builds and what the test
         projects resolve against; the Windows one is what actually ships, and is the only one
         that sees TarkovCompanion.Platform.Windows.Ocr.

         Clearing TargetFramework first is required: Directory.Build.props sets it for every
         project, and a project cannot have both. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TarkovCompanion.Core/TarkovCompanion.Core.csproj" />
    <ProjectReference Include="../TarkovCompanion.Application/TarkovCompanion.Application.csproj" />
    <ProjectReference Include="../TarkovCompanion.Infrastructure/TarkovCompanion.Infrastructure.csproj" />
    <ProjectReference Include="../TarkovCompanion.Platform.Windows/TarkovCompanion.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="../TarkovCompanion.Platform.Windows.Ocr/TarkovCompanion.Platform.Windows.Ocr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="../../docs/CHANGELOG-player.json" LogicalName="TarkovCompanion.PlayerChangelog.json" />
    <!-- [#314] The interface's string tables, one per culture; see Localization/UiText.cs. -->
    <EmbeddedResource Include="Localization/Strings/*.json" LogicalName="TarkovCompanion.Strings.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OCR probe's atomic report write is proven by interrupting a write partway through,
         which needs its internal writer seam. -->
    <InternalsVisibleTo Include="TarkovCompanion.UnitTests" />
    <!-- [V2 rough package 48] The render tool drives the pairing panel's four states through
         CompanionPairingViewModel.PresentForPreview; none of them can be reached in a render
         without a relay and a tablet. -->
    <InternalsVisibleTo Include="TarkovCompanion.V2RenderPreview" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
