<UserControl x:Class="TarkovCompanion.App.Views.Pages.HistoryView"
             x:DataType="vm:HistoryPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Border Classes="inset">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Border>
      <Button Grid.Column="1" MinWidth="120" Command="{Binding RefreshCommand}" Content="Reload" VerticalAlignment="Stretch" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
      <!-- What fills this, said where there is nothing in it. The page's resting state was one
           sentence and seven hundred pixels of nothing, and the sentence was already printed
           in the header chip above it, so the body said nothing the header had not. -->
      <Border Classes="panel" IsVisible="{Binding HasNoEntries}">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="What goes in here" />
          <TextBlock Classes="caption"
                     Text="One row per raid, written as it happens. The map, when it started and ended, and how far you walked — measured between the screenshots you took, so a raid you photographed twice reports a shorter walk than you made."
                     TextWrapping="Wrap" />
          <Border Classes="hairline" />
          <TextBlock Classes="caption"
                     Text="A raid with screenshots in it can be watched back across the map afterwards. Everything is read out of the game's own log and the filenames of your own screenshots; nothing is asked of anybody and nothing leaves this machine."
                     TextWrapping="Wrap" />
          <Border Classes="hairline" />
          <TextBlock Classes="caption"
                     Text="The game never records whether you survived, so no outcome is shown for any of them."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RaidHistoryEntryViewModel">
            <Border Classes="panel" Margin="0,0,0,8">
              <Grid ColumnDefinitions="1.2*,1.1*,1.1*,1.2*" ColumnSpacing="12">
                <StackPanel Spacing="1">
                  <TextBlock Classes="lede" Text="{Binding Map}" />
                  <TextBlock Classes="label" Text="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="label" Text="Started" />
                  <TextBlock Classes="value" Text="{Binding Started}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1">
                  <TextBlock Classes="label" Text="Ended" />
                  <TextBlock Classes="value" Text="{Binding Ended}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="1">
                  <!-- Distance rather than a count of screenshots. "Nine screenshots" says how
                       often somebody photographed something; "1.4 km" says what the raid was.
                       It is a floor: straight lines between screenshots minutes apart. -->
                  <TextBlock Classes="label" Text="Path" />
                  <TextBlock Classes="value" Text="{Binding Path}" TextWrapping="Wrap" />
                  <!-- Only where there is something to watch. A button that opens an empty
                       replay is a button that answers a question with nothing. -->
                  <Button Classes="quiet"
                          Command="{Binding ReplayCommand}"
                          Content="Watch it"
                          IsVisible="{Binding CanReplay}"
                          HorizontalAlignment="Left" />
                  <TextBlock Classes="caption" Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
