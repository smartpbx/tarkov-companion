<UserControl x:Class="TarkovCompanion.App.Views.Pages.HistoryView"
             x:DataType="vm:HistoryPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" />
      <Button Grid.Column="1" Classes="tool" Command="{Binding RefreshCommand}" Content="Reload local history" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RaidHistoryEntryViewModel">
            <Border Classes="panel" Margin="0,0,0,8" Padding="13">
              <Grid ColumnDefinitions="1.2*,1.1*,1.1*,1.1*,1.2*" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding Map}" />
                  <TextBlock Classes="label" Text="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Started" />
                  <TextBlock Text="{Binding Started}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="label" Text="Ended" />
                  <TextBlock Text="{Binding Ended}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Classes="label" Text="Outcome" />
                  <TextBlock Text="{Binding Outcome}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Classes="label" Text="Notes" />
                  <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
