<UserControl x:Class="TarkovCompanion.App.Views.Pages.HistoryView"
             x:DataType="vm:HistoryPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Border Classes="inset">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Border>
      <Button Grid.Column="1" MinWidth="120" Command="{Binding RefreshCommand}" Content="Reload" VerticalAlignment="Stretch" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RaidHistoryEntryViewModel">
            <Border Classes="panel" Margin="0,0,0,8">
              <Grid ColumnDefinitions="1.2*,1.1*,1.1*,1.1*,1.2*" ColumnSpacing="12">
                <StackPanel Spacing="1">
                  <TextBlock Classes="lede" Text="{Binding Map}" />
                  <TextBlock Classes="label" Text="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="label" Text="Started" />
                  <TextBlock Classes="value" Text="{Binding Started}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1">
                  <TextBlock Classes="label" Text="Ended" />
                  <TextBlock Classes="value" Text="{Binding Ended}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="1">
                  <TextBlock Classes="label" Text="Outcome" />
                  <TextBlock Classes="value" Text="{Binding Outcome}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="1">
                  <TextBlock Classes="label" Text="Notes" />
                  <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
