<UserControl x:Class="TarkovCompanion.App.Views.Pages.RaidView"
             x:DataType="vm:RaidPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels"
             xmlns:maps="using:TarkovCompanion.App.Views.Maps">
  <Grid ColumnDefinitions="*,316" ColumnSpacing="12">
    <maps:MapView Grid.Column="0" DataContext="{Binding Map}" />

    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <!-- The raid that just finished, shown first so it is read without going looking for
             it. It stays until the player dismisses it or the next raid ends. Nothing about
             survival, kills or loot appears here because the game logs none of it. -->
        <Border Classes="panel" IsVisible="{Binding HasSummary}" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="sectionTitle" Text="Last raid" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="viewControl"
                      Command="{Binding DismissSummaryCommand}"
                      Content="Dismiss" />
            </Grid>
            <TextBlock Classes="metric" Text="{Binding Summary.Headline}" TextWrapping="Wrap" />
            <Border Classes="readout" Padding="11">
              <StackPanel Spacing="7">
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="Started" />
                  <TextBlock Text="{Binding Summary.Started}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="Ended" />
                  <TextBlock Text="{Binding Summary.Ended}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="Duration" />
                  <TextBlock Text="{Binding Summary.Duration}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="label" Text="{Binding Summary.Timing}" TextWrapping="Wrap" />
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Scanned during the raid" />
              <TextBlock Text="{Binding Summary.Scans}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Last-known position" />
              <TextBlock Text="{Binding Summary.LastKnownPosition}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Game mode" />
              <TextBlock Text="{Binding Summary.Mode}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Summary.Outcome}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding Summary.Side}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding Summary.History}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel cyan" Padding="14">
          <StackPanel Spacing="7">
            <TextBlock Classes="sectionTitle" Text="Raid state" />
            <TextBlock Text="{Binding RaidState}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding Evidence}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="14">
          <StackPanel Spacing="7">
            <TextBlock Classes="sectionTitle" Text="Last-known position" />
            <TextBlock Text="{Binding Position}" TextWrapping="Wrap" />
            <TextBlock Classes="label"
                       Text="Position is historical screenshot evidence, never live player tracking."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel sage" Padding="14">
          <StackPanel Spacing="7">
            <TextBlock Classes="sectionTitle" Text="Observed extracts" />
            <TextBlock Text="{Binding Extracts}" TextWrapping="Wrap" />
            <TextBlock Classes="label"
                       Text="Only externally observed or manually selected extracts may be presented as active."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel coral" Padding="14">
          <StackPanel Spacing="7">
            <TextBlock Classes="sectionTitle" Text="Strategy and routes" />
            <TextBlock Text="Unavailable until a validated service-backed route graph is loaded." TextWrapping="Wrap" />
            <TextBlock Classes="label"
                       Text="No enemy, traffic, or live-player detection is performed."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
