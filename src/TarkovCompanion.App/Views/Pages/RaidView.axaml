<UserControl x:Class="TarkovCompanion.App.Views.Pages.RaidView"
             x:DataType="vm:RaidPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels"
             xmlns:maps="using:TarkovCompanion.App.Views.Maps"
             xmlns:mapvm="using:TarkovCompanion.App.ViewModels.Maps">
  <Grid ColumnDefinitions="*,300" ColumnSpacing="12">
    <maps:MapView Grid.Column="0" DataContext="{Binding Map}" />

    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <!-- The raid that just finished, shown first so it is read without going looking for
             it. It stays until the player dismisses it or the next raid ends. Nothing about
             survival, kills or loot appears here because the game logs none of it.

             Written as label-and-value pairs rather than sentences. Every line used to explain
             itself: why the duration was exact, how the side came to be known, that only a
             screenshot can establish a position. None of that changed what the player did
             next, and there is a map on the other half of this page. -->
        <Border Classes="panel sage" IsVisible="{Binding HasSummary}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="Last raid" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="quiet"
                      Command="{Binding DismissSummaryCommand}"
                      Content="Dismiss" />
            </Grid>
            <!-- Scoped to the summary rather than reaching through it by path. Bound as
                 "Summary.Headline" from the page, every one of these was evaluated while the
                 summary was still null and threw: eleven caught exceptions per launch, on a
                 panel nobody had opened. A content control with nothing in it evaluates
                 nothing at all. -->
            <ContentControl Content="{Binding Summary}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:RaidSummaryViewModel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="metric" Text="{Binding Headline}" TextWrapping="Wrap" />
                    <Border Classes="readout">
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <StackPanel Spacing="1">
                          <TextBlock Classes="label" Text="Started" />
                          <TextBlock Classes="value" Text="{Binding Started}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Classes="label" Text="Ended" />
                          <TextBlock Classes="value" Text="{Binding Ended}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="1">
                          <TextBlock Classes="label" Text="Duration" />
                          <TextBlock Classes="value" Text="{Binding Duration}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                          <TextBlock Classes="label" Text="Side" />
                          <TextBlock Classes="value" Text="{Binding Side}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="1">
                          <TextBlock Classes="label" Text="Mode" />
                          <TextBlock Classes="value" Text="{Binding Mode}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="1">
                          <TextBlock Classes="label" Text="Outcome" />
                          <TextBlock Classes="value" Text="{Binding Outcome}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <StackPanel Spacing="1">
                      <TextBlock Classes="label" Text="Scanned" />
                      <TextBlock Text="{Binding Scans}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="1">
                      <TextBlock Classes="label" Text="Last position" />
                      <TextBlock Text="{Binding LastKnownPosition}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="1">
                      <TextBlock Classes="label" Text="History" />
                      <TextBlock Classes="caption" Text="{Binding History}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </Border>

        <!-- One instrument with three readouts, rather than three boxes. Each readout is a
             label, a value and a caption, and none carries an accent border: at rest all
             three say "nothing observed", and three accent-bordered boxes saying that made
             the sidebar the loudest thing on a page whose point is the map. The colour that
             marks a live observation is on the status bar, where it is read first. -->
        <Border Classes="panel">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Raid" />
              <TextBlock Classes="value" Text="{Binding RaidState}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="hairline" />
            <!-- Read off the extract list where a screenshot showed it, counted from the raid's
                 own start otherwise. The caption says which, because a number the game drew and
                 a number we worked out are not the same claim. -->
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Time left" />
              <TextBlock Classes="metric" Text="{Binding TimeLeft}" />
              <TextBlock Classes="caption" Text="{Binding TimeLeftDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="hairline" />
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Last-known position" />
              <TextBlock Classes="value" Text="{Binding Position}" TextWrapping="Wrap" />
              </StackPanel>
            <Border Classes="hairline" />
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Extracts" />
              <TextBlock Classes="value" Text="None observed" IsVisible="{Binding !HasExtracts}" />
              <!-- One row each. This was the recognition's own diagnostic printed verbatim and
                   joined with commas, so it named the OCR engine and the instant of the read
                   in the middle of a list of places to run to. Both are kept on the row as a
                   tooltip, which is where they are wanted: when the extract turns out wrong. -->
              <ItemsControl ItemsSource="{Binding Extracts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActiveExtractViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,3"
                          ToolTip.Tip="{Binding Evidence}">
                      <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1"
                                 Classes="caption"
                                 Text="{Binding Confidence}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- What there is to do on this map, by quest rather than by objective: a quest with
             four things to do on one map is one decision, and four rows of the same name is a
             list nobody reads. Pinned first, because that is the player saying which one they
             are actually doing.

             Only this map. A quest with nothing to do here is not on the map and has no
             business in the column beside it. -->
        <Border Classes="panel" IsVisible="{Binding Map.HasQuestPanel}">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Quests here" />
            <ItemsControl ItemsSource="{Binding Map.QuestPanel}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mapvm:QuestPanelViewModel">
                  <Border Classes="inset" Padding="9,7" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="value" Text="{Binding Task}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Classes="caption ochre"
                                   Text="Pinned"
                                   IsVisible="{Binding IsPinned}"
                                   VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Classes="label" Text="{Binding Objectives}" TextWrapping="Wrap" />
                      <!-- An exact point is somewhere to walk to; an association is only a
                           claim that the quest has something to do with this map. -->
                      <TextBlock Classes="caption"
                                 Text="Roughly placed"
                                 IsVisible="{Binding IsApproximate}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Everyone else in the group, in the column beside the map rather than floating over
             it. A marker says where somebody is; it cannot say that they are on a different
             map, that their position is eight minutes old, or what they are carrying, and
             those are the things asked out loud.

             Present only when somebody else is actually sharing, so a player alone sees
             nothing. Rows for people on another map are dimmed rather than hidden, because
             "he is on Customs" is an answer to where he is. -->
        <Border Classes="panel" IsVisible="{Binding Map.HasGroupPanel}">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Group" />
            <ItemsControl ItemsSource="{Binding Map.GroupPanel}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mapvm:GroupMemberPanelViewModel">
                  <Border Classes="inset" Classes.elsewhere="{Binding IsElsewhere}" Padding="9,7" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <!-- The swatch is the colour this member's marker is drawn in. It is the
                           only thing joining a name in this list to a dot on the map. -->
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{Binding SwatchColor}"
                                 Stroke="#FF0B1016"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center" />
                        <TextBlock Classes="value" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Classes="label" Text="{Binding Where}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding Position}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding Extra}" IsVisible="{Binding HasExtra}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Both gestures have always worked and neither was written down anywhere, so the
                 first question asked about them was whether they had been built. -->
            <Border Classes="hairline" />
            <TextBlock Classes="caption" Text="Right-click the map to mark a waypoint" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="Hold shift for a ping, which fades" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
