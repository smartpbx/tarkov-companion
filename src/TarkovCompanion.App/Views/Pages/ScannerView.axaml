<UserControl x:Class="TarkovCompanion.App.Views.Pages.ScannerView"
             x:DataType="vm:ScannerPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Border Classes="panel cyan" Padding="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionTitle" Text="User-triggered scan" />
          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock Classes="label"
                     Text="Captured pixels are not persisted; production recognition remains unavailable until a provider is configured."
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="148"
                Command="{Binding ScanCommand}"
                Content="Run configured scan"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,0.8*" ColumnSpacing="12">
      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="sectionTitle" Text="Last result" />
          <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="#E6EDF2" Text="{Binding ItemName}" />
          <Grid ColumnDefinitions="150,*">
            <TextBlock Classes="label" Text="Observed value" />
            <TextBlock Grid.Column="1" Classes="ochre" Text="{Binding Value}" />
          </Grid>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Classes="label" Text="Recommendation" />
            <TextBlock Grid.Column="1" Text="{Binding Recommendation}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Classes="label" Text="Confidence" />
            <TextBlock Grid.Column="1" Text="{Binding Confidence}" />
          </Grid>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Classes="label" Text="Source" />
            <TextBlock Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="panel" Padding="18">
        <StackPanel Spacing="9">
          <TextBlock Classes="sectionTitle" Text="Evidence" />
          <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" />
          <TextBlock Classes="label"
                     Text="Unavailable results never produce item identity, value, confidence, or keep/sell advice."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
