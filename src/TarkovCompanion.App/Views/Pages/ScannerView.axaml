<UserControl x:Class="TarkovCompanion.App.Views.Pages.ScannerView"
             x:DataType="vm:ScannerPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <!-- Two layouts, one per state. Before anything has been scanned the page says so once,
       names the action, and stops; the earlier layout said "nothing scanned" in four places
       and laid out a table of "unavailable" under it. After a scan the item name is the
       headline, because a player who has just pressed the shortcut from inside the game is
       reading this from the other monitor. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Border Classes="panel" IsVisible="{Binding HasNoResult}" Padding="22,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="lede" Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
          <TextBlock Classes="note" Text="Take a screenshot in game with an item on screen." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="140"
                Command="{Binding ScanCommand}"
                Content="Scan now"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Classes="panel ochre" IsVisible="{Binding HasResult}" Padding="22,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Last result" />
            <TextBlock Classes="display" Text="{Binding ItemName}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{Binding Evidence}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32" RowDefinitions="Auto,Auto" RowSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Observed value" />
              <TextBlock Classes="metric ochre" Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="label" Text="Recommendation" />
              <TextBlock Classes="lede sage" Text="{Binding Recommendation}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="2">
              <TextBlock Classes="label" Text="Confidence" />
              <TextBlock Classes="value" Text="{Binding Confidence}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
              <TextBlock Classes="label" Text="Source" />
              <TextBlock Classes="value" Text="{Binding Source}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="note" Text="{Binding Detail}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="140"
                Command="{Binding ScanCommand}"
                Content="Scan again"
                VerticalAlignment="Top" />
      </Grid>
    </Border>

    <!-- Every scan on this machine has been written to the database since the first migration
         and nothing ever read one back, so a player could scan all evening and the application
         could not show them one of them again. This is that list. -->
    <Border Grid.Row="1" Classes="panel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="sectionTitle" Text="Earlier scans" VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding RefreshHistoryCommand}" Content="Refresh" />
        </Grid>
        <TextBlock Grid.Row="1" Classes="note" Text="{Binding HistoryStatus}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" IsVisible="{Binding HasHistory}">
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScanHistoryRowViewModel">
                <Border Classes="inset" Margin="0,0,0,6" Padding="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="2">
                    <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding When}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
