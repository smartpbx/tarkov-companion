<UserControl x:Class="TarkovCompanion.App.Views.Pages.EventsView" x:DataType="vm:EventsPageViewModel"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Border Classes="panel" Padding="22">
    <StackPanel Spacing="10">
      <TextBlock Classes="sectionTitle" Text="Runtime availability" />
      <TextBlock Text="{Binding AvailabilityMessage}" TextWrapping="Wrap" />
      <TextBlock Classes="label" Text="{Binding Evidence}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
