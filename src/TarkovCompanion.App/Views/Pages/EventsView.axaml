<UserControl x:Class="TarkovCompanion.App.Views.Pages.EventsView"
             x:DataType="vm:EventsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Border Classes="inset" Padding="10">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </Border>
      <Button Grid.Column="1"
              Command="{Binding RefreshCommand}"
              Content="Reload definitions"
              VerticalAlignment="Stretch" />
    </Grid>

    <!-- An empty catalog is the ordinary out of season state, so it gets an explanation
         rather than an error panel. -->
    <Border Grid.Row="1"
            Classes="panel"
            IsVisible="{Binding HasNoEvents}"
            Padding="22"
            VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="No event is configured" />
        <TextBlock Text="{Binding EmptyGuidance}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="12" IsVisible="{Binding HasEvents}">
      <ListBox Background="Transparent"
               BorderThickness="0"
               ItemsSource="{Binding Events}"
               SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EventSummaryViewModel">
            <Border Classes="panel" Margin="0,0,0,8" Padding="12">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="ochre" Text="{Binding Season}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{Binding Window}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{Binding ItemSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{Binding Provenance}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" Classes="panel" Padding="15">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="9">
          <TextBlock Classes="sectionTitle" Text="Applicable items" />
          <TextBlock Grid.Row="1" Text="{Binding Detail}" TextWrapping="Wrap" />
          <Border Grid.Row="2" Classes="inset" Padding="10">
            <TextBlock Classes="metric" FontSize="15" Text="{Binding Progress}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Grid.Row="3" Classes="label" Text="{Binding StateGuidance}" TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventItemViewModel">
                  <Border Classes="inset" Margin="0,0,0,6" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Text="{Binding ItemName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" MinWidth="80">
                        <TextBlock Classes="label" Text="Recorded" />
                        <TextBlock Text="{Binding StateLabel}" />
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Button Command="{Binding MarkSafeCommand}"
                                Content="Safe"
                                IsEnabled="{Binding CanRecord}"
                                Margin="0,0,5,0" />
                        <Button Command="{Binding MarkAllergicCommand}"
                                Content="Allergic"
                                IsEnabled="{Binding CanRecord}"
                                Margin="0,0,5,0" />
                        <Button Command="{Binding MarkUntestedCommand}"
                                Content="Untested"
                                IsEnabled="{Binding CanRecord}"
                                Margin="0,0,5,0" />
                        <Button Command="{Binding MarkUnknownCommand}"
                                Content="Unknown"
                                IsEnabled="{Binding CanRecord}" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
