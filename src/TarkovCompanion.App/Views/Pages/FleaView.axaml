<UserControl x:Class="TarkovCompanion.App.Views.Pages.FleaView"
             x:DataType="vm:FleaPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
               PlaceholderText="Search by item name or short name" />
      <Button Grid.Column="1" Classes="primary" MinWidth="120" Command="{Binding SearchCommand}" Content="Look up value" />
    </Grid>

    <Border Grid.Row="1" Classes="inset">
      <TextBlock Text="{Binding SearchStatus}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FleaPriceViewModel">
            <Border Classes="panel">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding ShortName}" />
                </Grid>
                <TextBlock Classes="metric ochre" Text="{Binding FleaPrice}" />
                <TextBlock Text="{Binding BestSale}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{Binding DailyBand}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{Binding ValuePerSlot}" />
                <TextBlock Classes="label" Text="{Binding Dimensions}" />
                <TextBlock Classes="caption" Text="{Binding Provenance}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="sectionTitle" Text="Sold while you were playing" />
            <TextBlock Grid.Row="1" Classes="note" Text="{Binding SalesStatus}" />
            <ItemsControl Grid.Row="2" IsVisible="{Binding HasSales}" ItemsSource="{Binding Sales}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FleaSaleViewModel">
                  <Border Classes="inset" Margin="0,0,0,6" Padding="9">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding Item}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value ochre" Text="{Binding Quantity}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Observed}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <TextBlock Classes="sectionTitle" Text="Local observations" />
            <TextBlock Grid.Row="1" Classes="note" Text="{Binding HistoryStatus}" />
            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FleaHistoryPointViewModel">
                    <Border Classes="inset" Margin="0,0,0,6" Padding="9">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Text="{Binding Observed}" />
                        <Grid ColumnDefinitions="*,*">
                          <TextBlock Classes="value" Text="{Binding FleaPrice}" />
                          <TextBlock Grid.Column="1" Classes="label" Text="{Binding TraderValue}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
