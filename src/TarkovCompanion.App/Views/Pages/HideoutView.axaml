<UserControl x:Class="TarkovCompanion.App.Views.Pages.HideoutView"
             x:DataType="vm:HideoutPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid ColumnDefinitions="*,320" ColumnSpacing="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <WrapPanel ItemWidth="336" ItemHeight="216">
        <Border Classes="panel ochre" Width="324" Height="204" Margin="0,0,10,10" Padding="14"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Illumination" /><TextBlock Classes="label" Text="Level 1 → 2" /></StackPanel><Border Grid.Column="1" Classes="inset ochre" Padding="8,4"><TextBlock Classes="ochre" Text="4 missing" /></Border></Grid><StackPanel Grid.Row="1" Spacing="7" Margin="0,11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Light bulb" /><TextBlock Grid.Column="1" Classes="ochre" Text="10 / 14" /></Grid><ProgressBar Value="71" Height="7" Foreground="#C6A15B" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Wires" /><TextBlock Grid.Column="1" Classes="sage" Text="5 / 5" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /></StackPanel><Button Grid.Row="2" Classes="tool" HorizontalAlignment="Left" Content="Edit materials" /></Grid></Border>
        <Border Classes="panel sage" Width="324" Height="204" Margin="0,0,10,10" Padding="14"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Medstation" /><TextBlock Classes="label" Text="Level 1 → 2" /></StackPanel><Border Grid.Column="1" Classes="inset sage" Padding="8,4"><TextBlock Classes="sage" Text="Ready" /></Border></Grid><StackPanel Grid.Row="1" Spacing="7" Margin="0,11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Medical bloodset" /><TextBlock Grid.Column="1" Classes="sage" Text="3 / 3" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Saline solution" /><TextBlock Grid.Column="1" Classes="sage" Text="4 / 4" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /></StackPanel><Button Grid.Row="2" Classes="primary" HorizontalAlignment="Left" Content="Mark built" /></Grid></Border>
        <Border Classes="panel sage" Width="324" Height="204" Margin="0,0,10,10" Padding="14"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Workbench" /><TextBlock Classes="label" Text="Level 1 → 2" /></StackPanel><Border Grid.Column="1" Classes="inset sage" Padding="8,4"><TextBlock Classes="sage" Text="Ready" /></Border></Grid><StackPanel Grid.Row="1" Spacing="7" Margin="0,11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Toolset" /><TextBlock Grid.Column="1" Classes="sage" Text="1 / 1" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Bolts" /><TextBlock Grid.Column="1" Classes="sage" Text="6 / 6" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /></StackPanel><Button Grid.Row="2" Classes="primary" HorizontalAlignment="Left" Content="Mark built" /></Grid></Border>
        <Border Classes="panel" Width="324" Height="204" Margin="0,0,10,10" Padding="14"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Nutrition unit" /><TextBlock Classes="label" Text="Level 2 → 3" /></StackPanel><Border Grid.Column="1" Classes="inset" Padding="8,4"><TextBlock Classes="label" Text="Locked" /></Border></Grid><StackPanel Grid.Row="1" Spacing="7" Margin="0,11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Stash level 2" /><TextBlock Grid.Column="1" Classes="coral" Text="Required" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Metabolism" /><TextBlock Grid.Column="1" Text="Level 3 / 3" /></Grid><TextBlock Classes="label" TextWrapping="Wrap" Text="Material tracking starts when prerequisites are met." /></StackPanel><Button Grid.Row="2" Classes="tool" HorizontalAlignment="Left" Content="Review prerequisites" /></Grid></Border>
        <Border Classes="panel sage" Width="324" Height="204" Margin="0,0,10,10" Padding="14"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Heating" /><TextBlock Classes="label" Text="Level 2 → 3" /></StackPanel><Border Grid.Column="1" Classes="inset sage" Padding="8,4"><TextBlock Classes="sage" Text="Ready" /></Border></Grid><StackPanel Grid.Row="1" Spacing="7" Margin="0,11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dry fuel" /><TextBlock Grid.Column="1" Classes="sage" Text="2 / 2" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Hunting matches" /><TextBlock Grid.Column="1" Classes="sage" Text="2 / 2" /></Grid><ProgressBar Value="100" Height="7" Foreground="#77B895" /></StackPanel><Button Grid.Row="2" Classes="primary" HorizontalAlignment="Left" Content="Mark built" /></Grid></Border>
      </WrapPanel>
    </ScrollViewer>

    <StackPanel Grid.Column="1" Spacing="10">
      <Border Classes="panel ochre" Padding="14"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="Keep for upgrades" /><TextBlock Classes="metric ochre" Text="27 items" /><TextBlock Classes="label" Text="Across 4 available upgrades" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Light bulb" /><TextBlock Grid.Column="1" Text="4" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Corrugated hose" /><TextBlock Grid.Column="1" Text="6" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Pressure gauge" /><TextBlock Grid.Column="1" Text="2" /></Grid><Button Classes="primary" Content="Open combined item list" /></StackPanel></Border>
      <Border Classes="panel" Padding="14"><StackPanel Spacing="7"><TextBlock Classes="sectionTitle" Text="Upgrade summary" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Ready" /><TextBlock Grid.Column="1" Classes="sage" Text="3" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Collecting" /><TextBlock Grid.Column="1" Classes="ochre" Text="4" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Locked" /><TextBlock Grid.Column="1" Classes="label" Text="5" /></Grid></StackPanel></Border>
      <Border Classes="panel" Padding="14"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Empty-state rule" /><TextBlock Classes="label" TextWrapping="Wrap" Text="Stations with no remaining materials say “Ready” instead of disappearing, so item advice stays auditable." /></StackPanel></Border>
    </StackPanel>
  </Grid>
</UserControl>
