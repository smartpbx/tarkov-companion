<UserControl x:Class="TarkovCompanion.App.Views.Pages.HideoutView"
             x:DataType="vm:HideoutPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Border Classes="inset">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Border>
      <Button Grid.Column="1" MinWidth="120" Command="{Binding RefreshCommand}" Content="Reload" VerticalAlignment="Stretch" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="12">
      <ListBox ItemsSource="{Binding Stations}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HideoutStationViewModel">
            <Border Classes="panel" Padding="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="{Binding Progress}" />
                  <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- The hands the profile never had. HideoutStationLevels is written by nothing
                     anywhere in the application, so every station read "level 0 of N" under a
                     status line saying the levels came from your profile — true, and useless,
                     because there was no way to put anything in it.

                     Zero is a real answer and stays reachable: a station you have not built is
                     not the same as one you have not told us about, and both are level 0. -->
                <NumericUpDown Grid.Column="1"
                               Width="96"
                               FormatString="0"
                               Increment="1"
                               Minimum="0"
                               Maximum="{Binding MaximumLevel}"
                               IsVisible="{Binding CanSetLevel}"
                               Value="{Binding BuiltLevel, Mode=OneWay}"
                               ValueChanged="StationLevelChanged"
                               Tag="{Binding StationId}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="The level you have this station built to" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Classes="sectionTitle" Text="Next level requirements" />
          <TextBlock Grid.Row="1" Classes="prose" Text="{Binding Detail}" />
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HideoutRequirementViewModel">
                  <Border Classes="inset" Margin="0,0,0,6">
                    <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                      <TextBlock Text="{Binding ItemName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" MinWidth="48">
                        <TextBlock Classes="label" Text="Need" />
                        <TextBlock Classes="value" Text="{Binding Required}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="1" MinWidth="48">
                        <TextBlock Classes="label" Text="Have" />
                        <TextBlock Classes="value" Text="{Binding Owned}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="1" MinWidth="80">
                        <TextBlock Classes="label" Text="Still needed" />
                        <TextBlock Classes="value ochre" Text="{Binding Remaining}" />
                      </StackPanel>
                    </Grid>
                    <!-- 789 barters are rewritten on every sync and nothing had ever read one.
                         Shown only where a barter actually beats buying the item, where every
                         one of its inputs has a price, and where the player's own loyalty is
                         enough to take it — anything else is "no answer", and a line saying
                         "buy it" when the truth is "nothing here could work it out" would be
                         making something up. -->
                    <TextBlock Classes="caption sage"
                               Text="{Binding CheapestRoute}"
                               IsVisible="{Binding HasCheapestRoute}"
                               TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
