<UserControl x:Class="TarkovCompanion.App.Views.Pages.GroupView"
             x:DataType="vm:GroupPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="Your group" />
            <CheckBox Content="Share this session" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />

            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Server address" />
              <TextBox Text="{Binding ServerUri, Mode=TwoWay}" PlaceholderText="https://tarkov.example.net" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Display name" />
              <TextBox Text="{Binding DisplayName, Mode=TwoWay}" PlaceholderText="what the others see" />
            </StackPanel>
            <!-- One value, not two. A room name and a secret meant two ways to be wrong and
                 the failure looked identical either way. -->
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Group key" />
              <TextBox PasswordChar="•" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="at least eight characters" />
              <TextBlock Classes="caption" Text="Same key, same group" />
            </StackPanel>

            <Border Classes="hairline" />
            <CheckBox Content="Share my quest progress" IsChecked="{Binding SharesQuests, Mode=TwoWay}" />
            <TextBlock Classes="caption" Text="Pinned and active quests, up to five" />
            <Border Classes="hairline" />
            <TextBlock Classes="label" Text="Your kit, as your party sees it" />
            <TextBlock Classes="caption"
                       Text="{Binding MyLoadout}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="caption"
                       Text="Read off a squadmate's game, not yours · matched on your in-game nickname"
                       TextWrapping="Wrap" />
            <!-- The same asymmetry as the kit, and the same route back. Every squadmate's game
                 has written this player's level, side and scav timer down; their own game has
                 not, which is why the Quests level is typed by hand and the scav cooldown
                 appears nowhere else in the application.

                 Absent rather than three rows of "not known": a blank panel looks broken, and
                 an absent one has nothing to add yet — which is the truth until somebody else
                 in the party is also running this. -->
            <TextBlock Classes="value"
                       Text="{Binding MyProfile}"
                       IsVisible="{Binding HasMyProfile}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Command="{Binding SaveCommand}" Content="Save" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding SaveStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="panel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBlock Classes="label" Text="Who else is here" />
        <TextBlock Grid.Row="1" Classes="value" Text="{Binding Status}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2">
          <StackPanel Spacing="0">
            <ItemsControl ItemsSource="{Binding Members}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupMemberRowViewModel">
                  <Border Classes="inset" Margin="0,0,0,8">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Classes="caption"
                                   Foreground="{Binding StateColor}"
                                   Text="{Binding Where}" />
                      </Grid>
                      <TextBlock Classes="caption" Text="{Binding Position}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
