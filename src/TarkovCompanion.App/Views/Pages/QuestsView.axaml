<UserControl
    x:Class="TarkovCompanion.App.Views.Pages.QuestsView"
    x:DataType="vm:QuestsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TarkovCompanion.App.ViewModels.Quests">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <StackPanel Spacing="8">
      <Border Classes="inset" Padding="12,9">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="value" Text="{Binding ScopeStatus}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding CatalogStatus}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding Status}" TextWrapping="Wrap" />
          </StackPanel>
          <!-- The level is typed here because the game never writes its own player's down, and
               every level requirement on this page is measured against it. Left at the stored
               1, a fresh install gates five hundred quests behind levels the player is past. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Level" />
              <NumericUpDown Width="104"
                             FormatString="0"
                             Increment="1"
                             Maximum="79"
                             Minimum="1"
                             Value="{Binding PlayerLevel, Mode=TwoWay}" />
            </StackPanel>
            <Button Command="{Binding RefreshCommand}" Content="Refresh" VerticalAlignment="Bottom" />
          </StackPanel>
        </Grid>
      </Border>

      <Expander Header="Import and export progress as JSON">
        <Border Classes="inset" Padding="12,9">
          <StackPanel Spacing="7">
            <TextBlock Classes="note" Text="Local file only, previewed before it is applied." />
            <TextBox PlaceholderText="Quest progress JSON file path" Text="{Binding ExchangePath}" />
            <WrapPanel Orientation="Horizontal">
              <Button Command="{Binding ExportProgressCommand}" Content="Export" Margin="0,0,6,6" />
              <Button Command="{Binding PreviewImportCommand}" Content="Preview import" Margin="0,0,6,6" />
              <Button Command="{Binding KeepLocalConflictsCommand}" Content="Keep local conflicts" Margin="0,0,6,6" />
              <Button Command="{Binding UseIncomingConflictsCommand}" Content="Use incoming conflicts" Margin="0,0,6,6" />
              <Button Classes="primary" Command="{Binding ApplyImportCommand}" Content="Apply confirmed preview" Margin="0,0,6,6" />
              <Button Command="{Binding UndoLastImportCommand}" Content="Undo last import" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Classes="value" Text="{Binding ImportPreviewSummary}" TextWrapping="Wrap" />
            <TextBlock Classes="note" Text="{Binding ExchangeStatus}" />
            <ScrollViewer IsVisible="{Binding HasImportProposals}" MaxHeight="170" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ImportProposals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuestImportProposalViewModel">
                    <Border Classes="panel" Padding="8" Margin="0,0,0,5">
                      <Grid ColumnDefinitions="160,*,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                        <TextBlock Classes="value" Text="{Binding Classification}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Entity}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{Binding Resolution}" TextWrapping="Wrap" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                          <TextBlock Classes="ochre" Text="{Binding LocalValue}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Classes="sage" Text="{Binding IncomingValue}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Expander>

      <Expander Header="Optional TarkovTracker import">
        <Border Classes="inset" Padding="12,9">
          <StackPanel Spacing="7">
            <TextBlock Classes="note"
                       Text="Reads your progress from api.tarkovtracker.org. Nothing is written back." />
            <TextBlock Classes="note"
                       Text="Stored with Windows protected storage." />
            <TextBox IsEnabled="{Binding CanConnectTarkovTracker}"
                     PasswordChar="●"
                     PlaceholderText="Paste a PVP_, PVE_, or SZN_ token with GP permission"
                     Text="{Binding TarkovTrackerToken}" />
            <WrapPanel Orientation="Horizontal">
              <Button Command="{Binding ConnectTarkovTrackerCommand}"
                      Content="Connect and validate"
                      IsEnabled="{Binding CanConnectTarkovTracker}"
                      Margin="0,0,6,6" />
              <Button Command="{Binding RefreshTarkovTrackerCommand}"
                      Content="Refresh and preview"
                      IsEnabled="{Binding CanRefreshTarkovTracker}"
                      Margin="0,0,6,6" />
              <Button Command="{Binding DisconnectTarkovTrackerCommand}"
                      Content="Disconnect and delete token"
                      IsEnabled="{Binding CanDisconnectTarkovTracker}"
                      Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Classes="value" Text="{Binding TarkovTrackerStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="390,6,*" ColumnSpacing="10">
      <Border Classes="panel" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <ComboBox ItemsSource="{Binding AvailableFilters}" SelectedItem="{Binding SelectedFilter}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestBoardFilter">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestTaskViewModel">
                  <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                      <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="label" Text="{Binding RecordedState}" Margin="8,0,0,0" />
                      <TextBlock Grid.Row="1" Classes="label" Text="{Binding ObjectiveSummary}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Classes="caption" Text="{Binding Source}" TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- The detail column is hidden until a task is chosen. Bound through a null task it
           still drew every chip and button, as a row of empty boxes above a row of verbs
           with nothing to act on. -->
      <Border Grid.Column="2" Classes="panel">
        <Panel>
          <!-- Scoped to the selected quest rather than reaching through it by path. Bound as
               "SelectedTask.Name" from the page, every one of these was evaluated before a
               quest had been chosen and threw: nineteen caught exceptions per launch, on a
               pane nobody had opened yet. A content control with nothing in it evaluates
               nothing at all. -->
          <ScrollViewer IsVisible="{Binding HasSelectedTask}" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedTask}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:QuestTaskViewModel">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="title" Text="{Binding Name}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Border Classes="inset" Padding="8,4" Margin="0,0,6,6"><TextBlock Classes="label" Text="{Binding RecordedState}" /></Border>
                      <Border Classes="inset" Padding="8,4" Margin="0,0,6,6"><TextBlock Classes="label" Text="{Binding Eligibility}" /></Border>
                      <Border Classes="inset" Padding="8,4" Margin="0,0,6,6"><TextBlock Classes="label" Text="{Binding ObjectiveSummary}" /></Border>
                    </WrapPanel>
                    <StackPanel Spacing="3">
                      <TextBlock Classes="label" Text="{Binding Source}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding Trader}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding Map}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding Prerequisites}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Classes="note ochre" Text="{Binding EligibilityDetail}" />
                    <TextBlock Classes="note ochre" IsVisible="{Binding HasBranchNotes}" Text="{Binding BranchNotes}" />

                    <WrapPanel Orientation="Horizontal">
                      <Button Command="{Binding SetUnknownCommand}" Content="Unknown" Margin="0,0,6,6" />
                      <Button Command="{Binding SetNotStartedCommand}" Content="Not started" Margin="0,0,6,6" />
                      <Button Command="{Binding SetActiveCommand}" Content="Active" Margin="0,0,6,6" />
                      <Button Command="{Binding SetCompletedCommand}" Content="Completed" Margin="0,0,6,6" />
                      <Button Command="{Binding SetFailedCommand}" Content="Failed" Margin="0,0,6,6" />
                      <Button Command="{Binding TogglePinCommand}" Content="{Binding PinLabel}" Margin="0,0,6,6" />
                    </WrapPanel>

                    <TextBlock Classes="sectionTitle" Text="Objectives" />
                    <ItemsControl ItemsSource="{Binding Objectives}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestObjectiveViewModel">
                          <Border Classes="inset" Padding="12" Margin="0,0,0,9">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="value" Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Classes="label" Text="{Binding Kind}" />
                              </Grid>
                              <WrapPanel Orientation="Horizontal">
                                <TextBlock Classes="label ochre" IsVisible="{Binding IsUnsupported}" Text="Unsupported details · " />
                                <TextBlock Classes="label" IsVisible="{Binding IsOptional}" Text="Optional · " />
                                <TextBlock Classes="label" Text="{Binding Status}" />
                              </WrapPanel>
                              <TextBlock Classes="label" Text="{Binding Maps}" TextWrapping="Wrap" />
                              <TextBlock Classes="label" IsVisible="{Binding HasItems}" Text="{Binding Items}" TextWrapping="Wrap" />
                              <TextBlock Classes="label" IsVisible="{Binding HasFoundInRaidRule}" Text="{Binding FoundInRaidRule}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding Source}" TextWrapping="Wrap" />
                              <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding SetUnknownCommand}" Content="Unknown" Margin="0,0,5,5" />
                                <Button Command="{Binding SetInProgressCommand}" Content="In progress" Margin="0,0,5,5" />
                                <Button Command="{Binding SetCompletedCommand}" Content="Complete" Margin="0,0,5,5" />
                                <Button Command="{Binding DecrementCommand}" Content="− count" IsVisible="{Binding HasCount}" Margin="0,0,5,5" />
                                <Button Command="{Binding IncrementCommand}" Content="+ count" IsVisible="{Binding HasCount}" Margin="0,0,5,5" />
                                <Button Command="{Binding TogglePinCommand}" Content="{Binding PinLabel}" Margin="0,0,5,5" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="inset" IsVisible="{Binding HasOrphanedProgress}" Padding="10,7">
      <StackPanel Spacing="3">
        <TextBlock Classes="value ochre" Text="Orphaned local progress" />
        <ItemsControl ItemsSource="{Binding OrphanedProgress}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="label" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
