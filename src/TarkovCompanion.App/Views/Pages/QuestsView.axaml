<UserControl x:Class="TarkovCompanion.App.Views.Pages.QuestsView"
             x:DataType="vm:QuestsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid ColumnDefinitions="*,326" ColumnSpacing="12">
    <Border Classes="panel" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="13">
        <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="sectionTitle" Text="Active quest needs" /><TextBlock Classes="label" Text="Manual progress · decisions stay explainable" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBox Width="210" PlaceholderText="Filter quests or items" /><Button Classes="tool" Content="Import profile" /></StackPanel></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16"><Border Classes="inset sage" Padding="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="metric sage" Text="12" /><StackPanel Grid.Column="1"><TextBlock Text="Active quests" /><TextBlock Classes="label" Text="7 affect item decisions" /></StackPanel></Grid></Border><Border Grid.Column="1" Classes="inset ochre" Padding="12" MinWidth="230"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="metric ochre" Text="18" /><StackPanel Grid.Column="1"><TextBlock Text="Items remaining" /><TextBlock Classes="label" Text="11 must be found in raid" /></StackPanel></Grid></Border></Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <Border Classes="inset cyan" Padding="13"><Grid ColumnDefinitions="*,150"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Farming — Part 4" /><TextBlock Grid.Column="1" Classes="cyan" Text="Mechanic" /></Grid><TextBlock Classes="label" Text="Find in raid · 3 / 10 items" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Graphics Card" /><TextBlock Grid.Column="1" Classes="ochre" Text="0 / 3" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU Fan" /><TextBlock Grid.Column="1" Classes="sage" Text="4 / 4" /></Grid></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="7"><TextBlock Classes="label" Text="Progress" /><ProgressBar Value="30" Height="8" Foreground="#56B8C6" /><TextBlock Text="30% complete" /><Button Classes="tool" Content="Edit progress" /></StackPanel></Grid></Border>
            <Border Classes="inset" Padding="13"><Grid ColumnDefinitions="*,150"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Sanitary Standards — Part 2" /><TextBlock Grid.Column="1" Foreground="#C6D0D8" Text="Therapist" /></Grid><TextBlock Classes="label" Text="Find in raid · 1 / 2 items" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gas analyzer" /><TextBlock Grid.Column="1" Classes="ochre" Text="1 / 2" /></Grid></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="7"><TextBlock Classes="label" Text="Progress" /><ProgressBar Value="50" Height="8" Foreground="#C6A15B" /><TextBlock Text="50% complete" /><Button Classes="tool" Content="Edit progress" /></StackPanel></Grid></Border>
            <Border Classes="inset" Padding="13"><Grid ColumnDefinitions="*,150"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Operation Aquarius — Part 1" /><TextBlock Grid.Column="1" Foreground="#C6D0D8" Text="Therapist" /></Grid><TextBlock Classes="label" Text="Location objective · Customs" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dorm room 206 key" /><TextBlock Grid.Column="1" Classes="sage" Text="Owned" /></Grid></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="7"><TextBlock Classes="label" Text="Progress" /><ProgressBar Value="0" Height="8" Foreground="#C6A15B" /><TextBlock Text="Ready to attempt" /><Button Classes="tool" Content="Open key reference" /></StackPanel></Grid></Border>
            <Border Classes="inset" Padding="13"><Grid ColumnDefinitions="*,150"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Car Repair" /><TextBlock Grid.Column="1" Foreground="#C6D0D8" Text="Therapist" /></Grid><TextBlock Classes="label" Text="Find in raid · 5 / 8 items" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Car battery" /><TextBlock Grid.Column="1" Classes="ochre" Text="2 / 4" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Spark plug" /><TextBlock Grid.Column="1" Classes="ochre" Text="3 / 4" /></Grid></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="7"><TextBlock Classes="label" Text="Progress" /><ProgressBar Value="63" Height="8" Foreground="#C6A15B" /><TextBlock Text="63% complete" /><Button Classes="tool" Content="Edit progress" /></StackPanel></Grid></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Column="1" Spacing="10">
      <Border Classes="panel ochre" Padding="14"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="Decision impact" /><TextBlock Classes="metric ochre" Text="Keep 11 items" /><TextBlock TextWrapping="Wrap" Text="These outstanding found-in-raid requirements override normal sell advice." /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Graphics Card" /><TextBlock Grid.Column="1" Text="3" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Car battery" /><TextBlock Grid.Column="1" Text="2" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gas analyzer" /><TextBlock Grid.Column="1" Text="1" /></Grid><Button Classes="primary" Content="Review item needs" /></StackPanel></Border>
      <Border Classes="panel" Padding="14"><StackPanel Spacing="7"><TextBlock Classes="sectionTitle" Text="Profile state" /><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Source" /><TextBlock Grid.Column="1" Text="Manual profile" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Last edited" /><TextBlock Grid.Column="1" Text="Today, 20:18" /></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Confidence" /><TextBlock Grid.Column="1" Classes="sage" Text="Confirmed" /></Grid><Button Classes="tool" HorizontalAlignment="Left" Content="Export profile JSON" /></StackPanel></Border>
      <Border Classes="panel" Padding="14"><StackPanel Spacing="6"><TextBlock Classes="sectionTitle" Text="Completed filter" /><TextBlock Classes="label" TextWrapping="Wrap" Text="Completed quests are hidden. Clear the active-only filter to browse the reference catalog." /><Button Classes="tool" HorizontalAlignment="Left" Content="Show completed quests" /></StackPanel></Border>
    </StackPanel>
  </Grid>
</UserControl>
