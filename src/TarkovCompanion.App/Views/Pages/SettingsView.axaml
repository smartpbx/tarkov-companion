<UserControl x:Class="TarkovCompanion.App.Views.Pages.SettingsView"
             x:DataType="vm:SettingsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels"
             xmlns:quests="using:TarkovCompanion.App.ViewModels.Quests">
  <!-- The page is two columns of panels and nothing bounded their height, so the shell's
       ContentControl (which adds no scrolling of its own; every other page brings its own)
       simply clipped whatever ran past the window. On a 1080p second screen that is most of
       the second column. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel Spacing="10">
        <!-- Updating from inside the application. Only builds that passed Windows verification
             are offered, and a download whose checksum does not match what was published is
             thrown away rather than installed. -->
        <!-- How large everything is drawn. Seven fixed pixel sizes in the type scale, every
             column fixed, and no LayoutTransform anywhere — so the only lever anybody had was
             Windows scaling, which scales the game on the same machine.

             Through the window rather than this page's own view model: it is a property of the
             shell, and giving the Settings view model a reference to the shell to reach it
             would be a cycle for one number. -->
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Interface size" />
            <TextBlock Classes="prose"
                       Text="Everything in this window, drawn larger or smaller. It does not touch the game."
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
              <Button Click="SmallerClick" Content="&#x2212;" MinWidth="44" />
              <Button Grid.Column="1" Click="LargerClick" Content="+" MinWidth="44" />
              <TextBlock Grid.Column="2"
                         Classes="value"
                         VerticalAlignment="Center"
                         Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InterfaceScaleLabel}" />
              <Button Grid.Column="3" Classes="quiet" Click="ResetScaleClick" Content="Reset" />
            </Grid>
            <TextBlock Classes="caption"
                       Text="Ctrl and + or &#x2212; does the same, and Ctrl+0 puts it back."
                       TextWrapping="Wrap" />
            <!-- Said rather than discovered. These are separate top-level windows and the
                 transform on the shell cannot reach them; somebody noticing that on their own
                 would reasonably conclude the setting was half broken. -->
            <TextBlock Classes="caption"
                       Text="Dropdown lists and tooltips stay at their normal size."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="panel cyan" IsVisible="{Binding SupportsUpdates}">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Application updates" />
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Installed build" />
              <TextBlock Classes="value" Text="{Binding InstalledBuild}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- So the person with the problem can send the answer, in one action, without
                 having to find anything. Two players appeared in their group's member list and
                 never on its map, and both times the diagnosis was assembled by somebody else
                 asking questions across Discord. -->
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="This application's log" />
              <TextBlock Classes="caption" Text="{Binding CompanionLogPath}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Command="{Binding ReportProblemCommand}" Content="Report a problem" />
              <Button Command="{Binding CopyDiagnosticsCommand}" Content="Copy diagnostics" />
              <TextBlock Classes="caption" Text="{Binding DiagnosticsStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Report a problem sends this to the group's relay, which opens an issue and gives you the link. Copy diagnostics puts the same text on your clipboard instead. Both contain build, folders, sync state, the shape of your screenshot names and this application's recent log — no game logs, no group key, no screenshots and no coordinates." />
            <TextBlock Classes="prose" Text="{Binding UpdateStatus}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding CheckForUpdateCommand}"
                      Content="Check for updates"
                      IsEnabled="{Binding IsUpdateIdle}" />
              <Button Classes="primary"
                      Command="{Binding DownloadUpdateCommand}"
                      Content="Download"
                      IsVisible="{Binding CanDownloadUpdate}" />
              <Button Classes="primary"
                      Command="{Binding RestartForUpdateCommand}"
                      Content="Install and restart"
                      IsVisible="{Binding CanRestartForUpdate}" />
            </StackPanel>
            <TextBlock Classes="note"
                       Text="Only builds that passed Windows verification are offered. The download is checked against its published checksum before anything is unpacked, and the build you are running is kept alongside the new one." />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Local data" />
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Database" />
              <TextBlock Classes="caption mono" Text="{Binding DatabasePath}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Data state" />
              <TextBlock Classes="value" Text="{Binding DataStatus}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Classes="primary" Command="{Binding SyncCommand}" Content="Sync now" HorizontalAlignment="Left" />
            <TextBlock Classes="note"
                       Text="Offline mode reports the local cache instead of syncing." />
          </StackPanel>
        </Border>
        <!-- The one place this application removes a file it did not create, so it says so in
             full: what goes, when, and where it goes so it can be got back. -->
        <Border Classes="panel" IsVisible="{Binding CanTidyScreenshots}">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Screenshot folder" />
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Keep screenshots for" />
              <TextBlock Classes="value" Text="{Binding RetentionDisplay}" />
            </StackPanel>
            <TextBlock Classes="prose" Text="{Binding RetentionStatus}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ToggleScreenshotTidyingCommand}"
                      Content="{Binding ScreenshotTidyingLabel}" />
              <Button Command="{Binding ChooseRetentionCommand}"
                      Content="Keep longer"
                      IsEnabled="{Binding TidiesScreenshots}" />
            </StackPanel>
            <TextBlock Classes="note"
                       Text="They go to the recycle bin. To keep one, move it out of the folder." />
          </StackPanel>
        </Border>
        <!-- Where the game keeps its screenshots differs by install, by whether OneDrive has
             taken over Documents, and by what the player set in the game. The guesses cover the
             arrangements we know of; this covers the rest. -->
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Game folders" />
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Watching" />
              <TextBlock Classes="value" Text="{Binding WatchedFolders}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Screenshots" />
              <TextBox Text="{Binding ScreenshotFolder, Mode=TwoWay}"
                       PlaceholderText="Leave blank to find it automatically" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="Logs" />
              <TextBox Text="{Binding LogFolder, Mode=TwoWay}"
                       PlaceholderText="Leave blank to find it automatically" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Command="{Binding SaveGameFoldersCommand}" Content="Save" />
              <TextBlock Classes="caption" Text="{Binding GameFolderStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Profile" />
            <TextBlock Classes="value" Text="{Binding ProfileContext}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="10">
        <!-- Scanning is the game's own screenshot key and nothing else. There used to be a
             separate shortcut here, set large because it was the thing a player came back for.
             It came back because the screenshot key ran the whole recogniser and then told
             nobody: the result was logged and dropped, so this was the only door that led
             anywhere. Now that the screenshot path reports, a second shortcut is a second way
             to do one thing, and the one that captures the screen itself is the one that has to
             guess which monitor the game is on. -->
        <Border Classes="panel ochre">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Scanning" />
            <TextBlock Classes="prose"
                       Text="Press the game's own screenshot key. The picture is read for items, extract lists and prices, and its filename gives your position on the map."
                       TextWrapping="Wrap" />
            <TextBlock Classes="note"
                       Text="F12 by default. Nothing needs focus." />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Scan provider" />
            <TextBlock Classes="prose" Text="{Binding ScanProvider}" />
            <StackPanel Spacing="1">
              <TextBlock Classes="label" Text="Recognition provider" />
              <TextBlock Classes="value" Text="{Binding RecognitionProvider}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- Only for the engine that needs it. Windows has an OCR engine of its own and
                 needs no redistributable, so showing this unconditionally sends somebody after
                 a problem they do not have. -->
            <TextBlock Classes="note"
                       IsVisible="{Binding RecognitionNeedsRuntime}"
                       Text="Needs the Microsoft Visual C++ 2015-2022 x64 runtime." />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Developer diagnostics" />
            <TextBlock Classes="prose" Text="{Binding DiagnosticChannel}" />
          </StackPanel>
        </Border>
        <!-- A promise, not a risk, so it is not bordered in coral. -->
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Safety boundary" />
            <TextBlock Classes="prose"
                       Text="External and read-only toward the game." />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="Quest progress" />
            <!-- Moved off the Quests page, where these two expanders cost about 180 px above
                 the first quest on the page used most between raids, for things touched once a
                 wipe. The exchange moves WITH its preview and its confirm and undo: ADR 0004
                 and SAFETY.md both rely on an import being reviewed before it is applied, so
                 splitting the review from the action would be the one way to move this wrongly. -->
          <Expander Header="Import and export progress as JSON">
            <Border Classes="inset" Padding="12,9">
              <StackPanel Spacing="7">
                <TextBlock Classes="note" Text="Local file only, previewed before it is applied." />
                <TextBox PlaceholderText="Quest progress JSON file path" Text="{Binding Quests.ExchangePath}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Command="{Binding Quests.ExportProgressCommand}" Content="Export" Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.PreviewImportCommand}" Content="Preview import" Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.KeepLocalConflictsCommand}" Content="Keep local conflicts" Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.UseIncomingConflictsCommand}" Content="Use incoming conflicts" Margin="0,0,6,6" />
                  <Button Classes="primary" Command="{Binding Quests.ApplyImportCommand}" Content="Apply confirmed preview" Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.UndoLastImportCommand}" Content="Undo last import" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Classes="value" Text="{Binding Quests.ImportPreviewSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="note" Text="{Binding Quests.ExchangeStatus}" />
                <ScrollViewer IsVisible="{Binding Quests.HasImportProposals}" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Quests.ImportProposals}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="quests:QuestImportProposalViewModel">
                        <Border Classes="panel" Padding="8" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="160,*,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                            <TextBlock Classes="value" Text="{Binding Classification}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Entity}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{Binding Resolution}" TextWrapping="Wrap" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                              <TextBlock Classes="ochre" Text="{Binding LocalValue}" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="1" Classes="sage" Text="{Binding IncomingValue}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- What past imports refused. Every import has recorded exactly this and nothing
                     has ever read it, so an import that half-worked said "kept 3 local, 2
                     unresolved" once and could never say which three or which two. -->
                <StackPanel Spacing="6" IsVisible="{Binding Quests.HasImportHistory}">
                  <Border Classes="hairline" />
                  <TextBlock Classes="label" Text="Imports already applied" />
                  <ItemsControl ItemsSource="{Binding Quests.ImportHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="quests:QuestImportHistoryRowViewModel">
                        <Border Classes="inset" Padding="9,7" Margin="0,0,0,5">
                          <StackPanel Spacing="3">
                            <TextBlock Classes="value" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="quests:QuestImportHistoryLineViewModel">
                                  <Grid ColumnDefinitions="200,*" ColumnSpacing="10" Margin="0,2,0,0">
                                    <TextBlock Classes="caption" Text="{Binding What}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Why}" TextWrapping="Wrap" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </Expander>

          <Expander Header="Optional TarkovTracker import">
            <Border Classes="inset" Padding="12,9">
              <StackPanel Spacing="7">
                <TextBlock Classes="note"
                           Text="Reads your progress from api.tarkovtracker.org. Nothing is written back." />
                <TextBlock Classes="note"
                           Text="Stored with Windows protected storage." />
                <TextBox IsEnabled="{Binding Quests.CanConnectTarkovTracker}"
                         PasswordChar="●"
                         PlaceholderText="Paste a PVP_, PVE_, or SZN_ token with GP permission"
                         Text="{Binding Quests.TarkovTrackerToken}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Command="{Binding Quests.ConnectTarkovTrackerCommand}"
                          Content="Connect and validate"
                          IsEnabled="{Binding Quests.CanConnectTarkovTracker}"
                          Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.RefreshTarkovTrackerCommand}"
                          Content="Refresh and preview"
                          IsEnabled="{Binding Quests.CanRefreshTarkovTracker}"
                          Margin="0,0,6,6" />
                  <Button Command="{Binding Quests.DisconnectTarkovTrackerCommand}"
                          Content="Disconnect and delete token"
                          IsEnabled="{Binding Quests.CanDisconnectTarkovTracker}"
                          Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Classes="value" Text="{Binding Quests.TarkovTrackerStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
