<UserControl x:Class="TarkovCompanion.App.Views.Pages.SettingsView"
             x:DataType="vm:SettingsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
    <StackPanel Spacing="10">
      <Border Classes="panel" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Persistent runtime" />
          <TextBlock Classes="label" Text="Database" />
          <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="Data state" />
          <TextBlock Text="{Binding DataStatus}" TextWrapping="Wrap" />
          <Button Classes="primary" Command="{Binding SyncCommand}" Content="Sync now" HorizontalAlignment="Left" />
          <TextBlock Classes="label"
                     Text="Offline mode never contacts the network; Sync now reports the local-cache state instead."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Active profile context" />
          <TextBlock Text="{Binding ProfileContext}" TextWrapping="Wrap" />
          <TextBlock Classes="label"
                     Text="Profile state is local and manual; the app never reads live inventory or account data."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="10">
      <Border Classes="panel cyan" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Scan provider" />
          <TextBlock Text="{Binding ScanProvider}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="Recognition provider" />
          <TextBlock Text="{Binding RecognitionProvider}" TextWrapping="Wrap" />
          <TextBlock Classes="label"
                     Text="Local OCR needs the Microsoft Visual C++ 2015-2022 x64 runtime, which is not part of this archive."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Developer diagnostics" />
          <TextBlock Text="{Binding DiagnosticChannel}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="Diagnostic scan commands delegate to the same scan use case as the UI." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="panel coral" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Safety boundary" />
          <TextBlock Text="External and read-only: no game memory, network interception, renderer hooks, input generation, or live-player tracking."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
