<UserControl x:Class="TarkovCompanion.App.Views.Pages.SettingsView"
             x:DataType="vm:SettingsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
    <StackPanel Spacing="10">
      <!-- Updating from inside the application. Only builds that passed Windows verification
           are offered, and a download whose checksum does not match what was published is
           thrown away rather than installed. -->
      <Border Classes="panel cyan" IsVisible="{Binding SupportsUpdates}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Application updates" />
          <StackPanel Spacing="1">
            <TextBlock Classes="label" Text="Installed build" />
            <TextBlock Classes="value" Text="{Binding InstalledBuild}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="prose" Text="{Binding UpdateStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CheckForUpdateCommand}"
                    Content="Check for updates"
                    IsEnabled="{Binding IsUpdateIdle}" />
            <Button Classes="primary"
                    Command="{Binding DownloadUpdateCommand}"
                    Content="Download"
                    IsVisible="{Binding CanDownloadUpdate}" />
            <Button Classes="primary"
                    Command="{Binding RestartForUpdateCommand}"
                    Content="Install and restart"
                    IsVisible="{Binding CanRestartForUpdate}" />
          </StackPanel>
          <TextBlock Classes="note"
                     Text="Only builds that passed Windows verification are offered. The download is checked against its published checksum before anything is unpacked, and the build you are running is kept alongside the new one." />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Local data" />
          <StackPanel Spacing="1">
            <TextBlock Classes="label" Text="Database" />
            <TextBlock Classes="caption mono" Text="{Binding DatabasePath}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Classes="label" Text="Data state" />
            <TextBlock Classes="value" Text="{Binding DataStatus}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="primary" Command="{Binding SyncCommand}" Content="Sync now" HorizontalAlignment="Left" />
          <TextBlock Classes="note"
                     Text="Offline mode never contacts the network; Sync now reports the local cache state instead." />
        </StackPanel>
      </Border>
      <!-- The one place this application removes a file it did not create, so it says so in
           full: what goes, when, and where it goes so it can be got back. -->
      <Border Classes="panel" IsVisible="{Binding CanTidyScreenshots}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Screenshot folder" />
          <StackPanel Spacing="1">
            <TextBlock Classes="label" Text="Keep screenshots for" />
            <TextBlock Classes="value" Text="{Binding RetentionDisplay}" />
          </StackPanel>
          <TextBlock Classes="prose" Text="{Binding RetentionStatus}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ToggleScreenshotTidyingCommand}"
                    Content="{Binding ScreenshotTidyingLabel}" />
            <Button Command="{Binding ChooseRetentionCommand}"
                    Content="Keep longer"
                    IsEnabled="{Binding TidiesScreenshots}" />
          </StackPanel>
          <TextBlock Classes="note"
                     Text="Only files the game named as screenshots are tidied, and they go to the recycle bin rather than being deleted. To keep one for good, move it somewhere else." />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Profile" />
          <TextBlock Classes="value" Text="{Binding ProfileContext}" TextWrapping="Wrap" />
          <TextBlock Classes="note"
                     Text="Profile state is local and set by hand; the app never reads live inventory or account data." />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="10">
      <!-- Scanning is the game's own screenshot key and nothing else. There used to be a
           separate shortcut here, set large because it was the thing a player came back for.
           It came back because the screenshot key ran the whole recogniser and then told
           nobody: the result was logged and dropped, so this was the only door that led
           anywhere. Now that the screenshot path reports, a second shortcut is a second way
           to do one thing, and the one that captures the screen itself is the one that has to
           guess which monitor the game is on. -->
      <Border Classes="panel ochre">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Scanning" />
          <TextBlock Classes="prose"
                     Text="Press the game's own screenshot key. The picture is read for items, extract lists and prices, and its filename gives your position on the map."
                     TextWrapping="Wrap" />
          <TextBlock Classes="note"
                     Text="Escape from Tarkov binds that to F12 by default. Nothing needs focus and you never leave the raid." />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Scan provider" />
          <TextBlock Classes="prose" Text="{Binding ScanProvider}" />
          <StackPanel Spacing="1">
            <TextBlock Classes="label" Text="Recognition provider" />
            <TextBlock Classes="value" Text="{Binding RecognitionProvider}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="note"
                     Text="Local OCR needs the Microsoft Visual C++ 2015-2022 x64 runtime, which is not part of this archive." />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Developer diagnostics" />
          <TextBlock Classes="prose" Text="{Binding DiagnosticChannel}" />
          <TextBlock Classes="note" Text="Diagnostic scan commands go through the same scan use case as the button." />
        </StackPanel>
      </Border>
      <!-- A promise, not a risk, so it is not bordered in coral. -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Safety boundary" />
          <TextBlock Classes="prose"
                     Text="External and read-only: no game memory, network interception, renderer hooks, input generation, or live-player tracking." />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
