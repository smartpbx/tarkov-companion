<UserControl x:Class="TarkovCompanion.App.Views.Pages.KeysView"
             x:DataType="vm:KeysPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
               PlaceholderText="Filter keys by name" />
      <Button Grid.Column="1" Classes="primary" MinWidth="120" Command="{Binding RefreshCommand}" Content="Reload" />
    </Grid>

    <Border Grid.Row="1" Classes="inset">
      <StackPanel Spacing="5">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Classes="note" Text="{Binding ScoringNotice}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyRowViewModel">
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <!-- The verdict beside the name rather than in the grid below it, because it
                     is the answer to the question the page is opened with and everything else
                     on the row is the working. Sage for keep, coral for sell, and a dash where
                     nothing here is a strong enough signal to say — which is a real answer and
                     is shown as one rather than as a blank. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="lede" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1"
                             Classes="lede"
                             Classes.sage="{Binding IsKeep}"
                             Classes.ochre="{Binding IsKeepForLater}"
                             Classes.coral="{Binding IsSell}"
                             Text="{Binding VerdictLabel}"
                             VerticalAlignment="Center" />
                </Grid>
                <!-- The one fact that decided it, said plainly. A verdict whose reasoning is a
                     score is a verdict nobody can argue with, which means nobody can correct
                     it either. -->
                <TextBlock Classes="caption" Text="{Binding VerdictReason}" TextWrapping="Wrap" />

                <!-- Every cell here is copied from the source. Nothing is weighted, ranked or
                     combined. The map is a raw source identifier, so it is set as one, small and
                     monospaced, rather than as a headline value that wraps onto two lines. -->
                <Grid ColumnDefinitions="*,*,*,1.6*" ColumnSpacing="12">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="label" Text="Locks" />
                    <TextBlock Classes="value" Text="{Binding LockSummary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="label" Text="Uses" />
                    <TextBlock Classes="value" Text="{Binding MaximumUses}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock Classes="label" Text="Cost" />
                    <TextBlock Classes="value ochre" Text="{Binding AcquisitionCost}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="1">
                    <!-- "Map id" was accurate when the row printed one. It prints the map's
                         name now, and a heading that says id above a word that is not one is
                         the same defect wearing the other hat. -->
                    <TextBlock Classes="label" Text="Map" />
                    <TextBlock Classes="caption mono" Text="{Binding Map}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <TextBlock Classes="caption" Text="{Binding Provenance}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Classes="sectionTitle" Text="Locks opened" />
          <TextBlock Grid.Row="1" Classes="note" Text="{Binding Detail}" />
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding SelectedLocks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyLockViewModel">
                  <Border Classes="inset" Margin="0,0,0,6" Padding="9">
                    <TextBlock Classes="label mono" Text="{Binding LockId}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
