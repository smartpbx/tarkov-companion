<Window
    x:Class="TarkovCompanion.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TarkovCompanion.App.ViewModels"
    xmlns:questVm="using:TarkovCompanion.App.ViewModels.Quests"
    xmlns:pages="using:TarkovCompanion.App.Views.Pages"
    xmlns:shell="using:TarkovCompanion.App.Views.V2.Shell"
    xmlns:raidCockpit="using:TarkovCompanion.App.Views.V2.Raid"
    xmlns:raidCockpitVm="using:TarkovCompanion.App.ViewModels.V2.Raid"
    xmlns:lootScanVm="using:TarkovCompanion.App.ViewModels.V2.LootScan"
    xmlns:lootScanViews="using:TarkovCompanion.App.Views.V2.LootScan"
    xmlns:setupVm="using:TarkovCompanion.App.ViewModels.V2.Setup"
    xmlns:setupViews="using:TarkovCompanion.App.Views.V2.Setup"
    Title="{Binding WindowTitle}"
    Icon="/Assets/TarkovCompanion.ico"
    Width="1500"
    Height="900"
    MinWidth="1120"
    MinHeight="720"
    Background="{DynamicResource V2.Brush.Canvas}">
  <Window.DataTemplates>
    <!-- V2 Raid cockpit (package 2) -->
    <DataTemplate DataType="{x:Type raidCockpitVm:RaidCockpitViewModel}">
      <raidCockpit:RaidCockpitView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type lootScanVm:LootScanViewModel}">
      <lootScanViews:LootScanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type setupVm:V2SetupWorkspaceViewModel}">
      <setupViews:V2SetupWorkspaceView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
  <!-- [#294] The V1 shell is a template, not inline markup, so V2 never builds it. Content is
       null under V2 (MainWindowViewModel.LegacyShell), and a ContentControl with no content
       realises no template: the fourteen V1 pages are not constructed, and their bindings never
       attach. IsVisible alone did not do that - it hid a tree that had already been built. -->
  <shell:LegacyPageHost Content="{Binding LegacyShell}" IsVisible="{Binding IsLegacyShell}">
    <shell:LegacyPageHost.ContentTemplate>
      <DataTemplate DataType="vm:MainWindowViewModel">
        <pages:LegacyShellView />
      </DataTemplate>
    </shell:LegacyPageHost.ContentTemplate>
  </shell:LegacyPageHost>
  <!-- [#294] The same one transform V1 has, over the V2 shell. It was V1's alone: it sat inside
       the legacy host, so Setup's Smaller/Larger/Reset buttons and Ctrl +/- moved a number that
       nothing under V2 applied. The buttons were on screen and did nothing.

       LayoutTransformControl rather than a RenderTransform, because the shell has to be measured
       at its new size: a render transform would draw a larger window inside the old one's bounds
       and clip everything past the edge. Two honest caveats, both V1's too: a ComboBox dropdown
       and a tooltip are separate top-level windows and stay at their designed size, and the map's
       pointer maths is unaffected because GetPosition already reads through every transform above
       the surface. -->
  <LayoutTransformControl IsVisible="{Binding IsPreviewShell}">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding InterfaceScale}" ScaleY="{Binding InterfaceScale}" />
    </LayoutTransformControl.LayoutTransform>
    <shell:V2ShellView DataContext="{Binding PreviewShell}" />
  </LayoutTransformControl>
  </Grid>
</Window>
