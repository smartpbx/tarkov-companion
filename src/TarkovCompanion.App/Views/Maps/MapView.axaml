<UserControl
    x:Class="TarkovCompanion.App.Views.Maps.MapView"
    x:DataType="vm:MapViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TarkovCompanion.App.ViewModels.Maps"
    xmlns:maps="using:TarkovCompanion.Application.Services.Maps">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <!-- One compact instrument row. The three choosers stay together on the left so the
         eye lands in one place, and the view controls sit on the right where they do not
         compete with them. Captions are inline rather than stacked: this panel is glanced
         at from a second monitor mid-raid, so vertical space belongs to the map. -->
    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="chooserLabel" Text="MAP" />
          <ComboBox
              x:Name="LocationChooser"
              Classes="chooser"
              MinWidth="150"
              ItemsSource="{Binding Locations}"
              SelectedItem="{Binding SelectedLocation, Mode=OneWay}"
              SelectionChanged="LocationSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="maps:MapLocation">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="chooserLabel" Text="VIEW" />
          <ComboBox
              x:Name="VariantChooser"
              Classes="chooser"
              MinWidth="130"
              ItemsSource="{Binding Variants}"
              SelectedItem="{Binding SelectedVariant, Mode=OneWay}"
              SelectionChanged="VariantSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="maps:MapVariant">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="chooserLabel" Text="FLOOR" />
          <ComboBox
              x:Name="FloorChooser"
              Classes="chooser"
              MinWidth="110"
              ItemsSource="{Binding Floors}"
              SelectedItem="{Binding SelectedFloor, Mode=OneWay}"
              SelectionChanged="FloorSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="maps:MapFloorDefinition">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
        <Button Classes="viewControl" Classes.on="{Binding IsAutoFit}" Click="FitClick" Content="Fit" ToolTip.Tip="Scale the whole map to the panel and centre it" />
        <Button Classes="viewControl" Click="ZoomOutClick" Content="&#x2212;" ToolTip.Tip="Zoom out" />
        <TextBlock Classes="zoomReadout" Text="{Binding ZoomScale, StringFormat={}{0:P0}}" />
        <Button Classes="viewControl" Click="ZoomInClick" Content="+" ToolTip.Tip="Zoom in" />
      </StackPanel>
    </Grid>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Overlays}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MapOverlayViewModel">
          <!-- One chip per layer rather than two separate buttons. The name toggles the
               layer; the trailing target button highlights it. Two controls per layer made
               the row twice as long and read as clutter. -->
          <Border Classes="chip" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal">
              <ToggleButton
                  Classes="chipToggle"
                  Tag="{Binding Kind}"
                  Content="{Binding Name}"
                  IsChecked="{Binding IsVisible, Mode=OneWay}"
                  Click="OverlayVisibilityChanged" />
              <Button
                  Classes="chipFocus"
                  Classes.on="{Binding IsHighlighted}"
                  Tag="{Binding Kind}"
                  Content="&#x25CE;"
                  ToolTip.Tip="{Binding HighlightLabel}"
                  Click="OverlayHighlightClick" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" Classes="panel" ClipToBounds="True" Background="#171E26">
      <ScrollViewer
          x:Name="ViewportScrollViewer"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">
        <Border Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}">
        <Canvas
            Width="{Binding CanvasWidth}"
            Height="{Binding CanvasHeight}"
            RenderTransformOrigin="0%,0%"
            PointerPressed="ViewportPointerPressed"
            PointerMoved="ViewportPointerMoved"
            PointerReleased="ViewportPointerReleased"
            PointerWheelChanged="ViewportPointerWheelChanged">
          <Canvas.RenderTransform>
            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
          </Canvas.RenderTransform>

          <!-- The image and overlay canvas intentionally share the same explicit dimensions.
               Fill preserves the normalized full-canvas mapping tested by MapCanvasCoordinateMapper. -->
          <Image
              Source="{Binding BackgroundImage}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}"
              Stretch="Fill"
              IsVisible="{Binding HasBackgroundImage}" />

          <ItemsControl
              ItemsSource="{Binding Tiles}"
              IsVisible="{Binding HasTiles}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapTileViewModel">
                <Image
                    Source="{Binding Image}"
                    Width="{Binding Size}"
                    Height="{Binding Size}"
                    Stretch="Fill"
                    RenderTransformOrigin="0%,0%">
                  <Image.RenderTransform>
                    <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                  </Image.RenderTransform>
                </Image>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl
              ItemsSource="{Binding QuestRegions}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestMapRegionViewModel">
                <Polygon
                    Points="{Binding Points}"
                    Fill="{Binding FillColor}"
                    Stroke="{Binding StrokeColor}"
                    StrokeThickness="{Binding StrokeThickness}"
                    ToolTip.Tip="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl
              ItemsSource="{Binding QuestPoints}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestMapPointViewModel">
                <Border
                    Width="{Binding Size}"
                    Height="{Binding Size}"
                    CornerRadius="{Binding CornerRadius}"
                    Background="{Binding FillColor}"
                    BorderBrush="{Binding BorderColor}"
                    BorderThickness="{Binding BorderThickness}"
                    ToolTip.Tip="{Binding Label}">
                  <Border.RenderTransform>
                    <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                  </Border.RenderTransform>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl
              ItemsSource="{Binding OverlayElements}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapOverlayElementViewModel">
                <Border
                    Padding="4,2"
                    Background="#CC11151B"
                    BorderBrush="{Binding BorderColor}"
                    BorderThickness="1"
                    RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="{Binding RotationDegrees}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Border.RenderTransform>
                  <TextBlock Text="{Binding Label}" FontSize="{Binding FontSize}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border
              Canvas.Left="16"
              Canvas.Top="16"
              Padding="10,6"
              Background="#DD11151B"
              IsVisible="{Binding ShowsPlaceholder}">
            <TextBlock MaxWidth="520" Text="{Binding Status}" TextWrapping="Wrap" />
          </Border>
        </Canvas>
        </Border>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="label" Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Classes="label" Text="{Binding TransformStatus}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Click="AttributionClick" Content="{Binding AttributionText}" />
      <Button Grid.Column="2" Click="LicenseClick" Content="License" />
    </Grid>

    <Expander Grid.Row="4" Header="{Binding QuestLayerStatus}" IsExpanded="False">
      <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding QuestAssociations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QuestMapAssociationViewModel">
              <Border Classes="inset" Padding="9,6" Margin="0,0,0,5">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Foreground="#C6A15B" IsVisible="{Binding IsUnsupported}" Text="Unsupported objective details" />
                  <TextBlock Foreground="#71808C" IsVisible="{Binding IsFloorFiltered}" Text="Hidden by selected floor" />
                  <TextBlock Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="{Binding Items}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="{Binding Evidence}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Expander>
  </Grid>
</UserControl>
