<UserControl
    x:Class="TarkovCompanion.App.Views.Maps.MapView"
    x:DataType="vm:MapViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TarkovCompanion.App.ViewModels.Maps"
    xmlns:maps="using:TarkovCompanion.Application.Services.Maps">
  <!-- The map takes the whole panel and the controls float on top of it.
       Rows of chrome stacked above and below cost about a third of the height, and on a map
       the size of Streets that was the difference between reading a street name and guessing
       at it. None of these controls is needed continuously: the choosers are touched once a
       raid, the layer list more rarely, the attribution never. So they sit in the corners
       and leave the middle of the map clear.

       Everything drawn on the map lives inside one canvas that is scaled as a whole. The
       artwork should scale, and does; a marker or a name should not, so each of those undoes
       the zoom with a scale of its own, read from one shared object on the view model. That
       is what keeps a marker twenty pixels wide whether the whole map is on screen or one
       building is. -->
  <Panel>
    <Border Classes="panel mapGround" ClipToBounds="True" Padding="0">
      <ScrollViewer
          x:Name="ViewportScrollViewer"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">
        <Border Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}">
        <!-- The canvas is pinned to the wrapper's corner. Its own size is the unscaled map and
             the wrapper's is the scaled one, and a child left to the default alignment is
             centred in its slot, so at any zoom but one the artwork sat half the size
             difference away from where the scroll offsets said it was. The ground is
             transparent rather than unset so a press on bare map still reaches the pan and
             click handlers instead of falling through. -->
        <Canvas
            x:Name="MapSurface"
            Width="{Binding CanvasWidth}"
            Height="{Binding CanvasHeight}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            RenderTransformOrigin="0%,0%"
            PointerPressed="ViewportPointerPressed"
            PointerMoved="ViewportPointerMoved"
            PointerReleased="ViewportPointerReleased"
            PointerWheelChanged="ViewportPointerWheelChanged">
          <!-- The quarter turn, then the stacked view's tilt, then zoom. Both matrices are
               the identity when their feature is off, so there is one transform on this
               surface rather than several code paths that can drift apart.

               The turn comes first because it is a property of the map rather than of the
               view: the tilt and the zoom then apply to a map that is already the right way
               round, which is what somebody expects from both of them.

               Nothing here has to know about the turn. The canvas keeps its own unturned size,
               everything on it is placed in that space, and GetPosition reads a pointer back
               through these transforms, so the mark and click maths are untouched. -->
          <Canvas.RenderTransform>
            <TransformGroup>
              <MatrixTransform Matrix="{Binding SurfaceRotation}" />
              <MatrixTransform Matrix="{Binding StackTilt}" />
              <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
            </TransformGroup>
          </Canvas.RenderTransform>

          <!-- The image and overlay canvas intentionally share the same explicit dimensions.
               Fill preserves the normalized full-canvas mapping tested by MapCanvasCoordinateMapper. -->
          <Image
              Source="{Binding BackgroundImage}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}"
              Stretch="Fill"
              IsVisible="{Binding ShowsFlatBackground}" />

          <!-- The same floors the flat view draws one at a time, drawn one above another.
               The floor being read is solid and the rest are there to say what is above and
               below it. Not a 3D scene: no camera, no perspective, no geometry, which is why
               the flat view is always one toggle away and always correct. -->
          <ItemsControl
              ItemsSource="{Binding FloorLayers}"
              IsVisible="{Binding HasFloorStack}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FloorLayerViewModel">
                <Image
                    Source="{Binding Image}"
                    Width="{Binding $parent[ItemsControl].Width}"
                    Height="{Binding $parent[ItemsControl].Height}"
                    Opacity="{Binding Opacity}"
                    Stretch="Fill"
                    ToolTip.Tip="{Binding Name}">
                  <Image.RenderTransform>
                    <TranslateTransform Y="{Binding Translate}" />
                  </Image.RenderTransform>
                </Image>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl
              ItemsSource="{Binding Tiles}"
              IsVisible="{Binding ShowsTiles}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapTileViewModel">
                <Image
                    Source="{Binding Image}"
                    Width="{Binding Size}"
                    Height="{Binding Size}"
                    Stretch="Fill"
                    RenderTransformOrigin="0%,0%">
                  <Image.RenderTransform>
                    <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                  </Image.RenderTransform>
                </Image>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Quest regions are areas on the ground, so unlike everything after them they
               scale with the artwork: a zone that grows as the map grows is the truth. -->
          <ItemsControl
              ItemsSource="{Binding QuestRegions}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestMapRegionViewModel">
                <Polygon
                    Points="{Binding Points}"
                    Fill="{Binding FillColor}"
                    Stroke="{Binding StrokeColor}"
                    StrokeThickness="{Binding StrokeThickness}"
                    ToolTip.Tip="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Place names, lettered straight onto the map. Each sits in a generous box
               centred on its point so it can be turned the way the catalog asks without being
               cut by its own bounds, and the box takes no pointer events so a name never
               stands between the pointer and a marker or the ground. The four dark copies
               behind the text are its halo. -->
          <ItemsControl
              ItemsSource="{Binding PlaceNames}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapPlaceNameViewModel">
                <Panel
                    Classes="placeName"
                    Classes.dimmed="{Binding IsDimmed}"
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="50%,50%">
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                      <RotateTransform Angle="{Binding RotationDegrees}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <!-- The copies are laid out from the corner of this inner panel rather than
                       centred, because a centred child moves by only half its margin. -->
                  <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="placeNameHalo" Text="{Binding Text}" FontSize="{Binding FontSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,0,0,0" />
                    <TextBlock Classes="placeNameHalo" Text="{Binding Text}" FontSize="{Binding FontSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,0,0" />
                    <TextBlock Classes="placeNameHalo" Text="{Binding Text}" FontSize="{Binding FontSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-1,0,0" />
                    <TextBlock Classes="placeNameHalo" Text="{Binding Text}" FontSize="{Binding FontSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock
                        Classes="placeNameText"
                        Classes.highlighted="{Binding IsHighlighted}"
                        Text="{Binding Text}"
                        FontSize="{Binding FontSize}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />
                  </Panel>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Quest points are drawn as ellipses because a bordered rectangle with its corner
               radius bound from a number does not convert, and rendered as a square. -->
          <ItemsControl
              ItemsSource="{Binding QuestPoints}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestMapPointViewModel">
                <Ellipse
                    Width="{Binding Size}"
                    Height="{Binding Size}"
                    Fill="{Binding FillColor}"
                    Stroke="{Binding BorderColor}"
                    StrokeThickness="{Binding BorderThickness}"
                    ToolTip.Tip="{Binding Label}"
                    RenderTransformOrigin="50%,50%">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Extracts, transits, spawns and locked doors. Each is a fixed box centred on its
               feature: a disc with a glyph at the centre and the name below it. The kind
               classes pick the disc's colour, size and glyph colour from the styles, so the
               view carries no colours of its own and the key in the layer list can be drawn
               from the same rules. -->
          <ItemsControl
              ItemsSource="{Binding Markers}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapOverlayElementViewModel">
                <Panel
                    Classes="marker"
                    Classes.dimmed="{Binding IsDimmed}"
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    RenderTransformOrigin="50%,50%">
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <Panel
                      Width="{Binding DiscBox}"
                      Height="{Binding DiscBox}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Ellipse Classes="markerHalo" IsVisible="{Binding IsOffered}" />
                    <Ellipse
                        Classes="markerDisc"
                        Classes.transit="{Binding IsTransit}"
                        Classes.locked="{Binding IsLock}"
                        Classes.spawn="{Binding IsSpawn}"
                        Classes.pmc="{Binding IsPmc}"
                        Classes.scav="{Binding IsScav}"
                        Classes.shared="{Binding IsShared}"
                        Classes.offered="{Binding IsOffered}"
                        Classes.highlighted="{Binding IsHighlighted}" />
                    <Path
                        Classes="markerGlyph"
                        Classes.transit="{Binding IsTransit}"
                        Classes.scav="{Binding IsScav}"
                        Classes.shared="{Binding IsShared}"
                        Data="{Binding Glyph}"
                        IsVisible="{Binding HasGlyph}" />
                  </Panel>
                  <!-- Placed against every other name on the map rather than at a fixed offset
                       under its own disc, which is what used to put "Sniper Roadblock" across
                       the marker above it. A name that fits nowhere is dropped; the disc still
                       reads, so the map answers "where are the exits" at any zoom. -->
                  <Border
                      Classes="markerName"
                      Classes.quiet="{Binding IsNameQuiet}"
                      Classes.offered="{Binding IsOffered}"
                      IsVisible="{Binding Placement.IsVisible}"
                      Margin="{Binding Placement.Inset}">
                    <TextBlock Classes="markerNameText" Text="{Binding Label}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The clicked marker: a ring on it, a leader up and to the right, and a card on
               the end of the leader saying what it is. Drawn as its own layer so selecting one
               marker does not rebuild the rest. -->
          <ItemsControl
              ItemsSource="{Binding SelectedMarkers}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapMarkerSelectionViewModel">
                <Panel
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="50%,50%">
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <Ellipse Classes="selectionRing" />
                  <Line Classes="selectionLeader" StartPoint="{Binding LeaderStart}" EndPoint="{Binding LeaderEnd}" />
                  <Border Classes="callout" Margin="{Binding CardInset}">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="value" Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                      <!-- What it asks of you: a switch to throw, a price to pay. The feed has
                           carried this all along and the card was showing only the kind. -->
                      <TextBlock Classes="label ochre"
                                 IsVisible="{Binding HasConditions}"
                                 Text="{Binding Conditions}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- What the group has marked. Waypoints stay, pings fade, and the server expires
               pings so whatever arrives is current. Drawn beneath the member markers, because
               where somebody actually is matters more than where they pointed. -->
          <ItemsControl
              ItemsSource="{Binding GroupMarks}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupMarkViewModel">
                <Panel
                    Width="{Binding Extent}"
                    Height="{Binding Extent}"
                    RenderTransformOrigin="50%,50%"
                    ToolTip.Tip="{Binding Detail}">
                  <!-- Positioned by a translate inside the template, the way the member
                       markers below are. Avalonia has no ItemContainerStyle; that is WPF, and
                       borrowing the pattern without checking cost a build. -->
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <!-- A ping's halo. It used to be a transparent disc with a thin outline and
                       was reported as not showing up at all, which is what a transparent disc
                       looks like on a busy map. It is the one mark that means "look here right
                       now" and it is gone in forty-five seconds, so it is the one mark allowed
                       to be loud. -->
                  <Ellipse
                      Width="{Binding HaloSize}"
                      Height="{Binding HaloSize}"
                      IsVisible="{Binding HasHalo}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{Binding HaloColor}"
                      Stroke="{Binding HaloOutlineColor}"
                      StrokeThickness="2" />
                  <!-- A waypoint is a diamond, not a disc. The shape changes with the colour
                       and never instead of it: violet against ochre fails for a colourblind
                       player and fails for everyone at the zoom where a marker is twelve
                       pixels wide. -->
                  <Rectangle
                      Width="{Binding PinSize}"
                      Height="{Binding PinSize}"
                      IsVisible="{Binding IsDiamond}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="50%,50%"
                      Fill="{Binding FillColor}"
                      Stroke="{Binding OutlineColor}"
                      StrokeThickness="{Binding OutlineWidth}">
                    <Rectangle.RenderTransform>
                      <RotateTransform Angle="{Binding DiamondRotation}" />
                    </Rectangle.RenderTransform>
                  </Rectangle>
                  <Ellipse
                      Width="{Binding PinSize}"
                      Height="{Binding PinSize}"
                      IsVisible="{Binding IsPing}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{Binding FillColor}"
                      Stroke="{Binding OutlineColor}"
                      StrokeThickness="{Binding OutlineWidth}" />
                  <Border Classes="markerName" IsVisible="{Binding HasLabel}" Margin="{Binding LabelInset}">
                    <TextBlock Classes="markerNameText" Text="{Binding Label}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Where the other players started, and which way they are from you.
               The first screenshot of a raid is taken where the player spawned, so the player
               spawn points near it are where everybody else began. The panel beside the map
               answers "how far and which one"; this answers "which way" without reading
               anything, which is the question in the first ninety seconds.

               Red, which nothing else on this map is, and it fades with the raid: full for
               three minutes, gone by eight. Where everybody spawned stops being where
               everybody is. -->
          <ItemsControl
              ItemsSource="{Binding SpawnThreats}"
              IsVisible="{Binding HasSpawnThreats}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpawnThreatViewModel">
                <Canvas>
                  <Polyline
                      Points="{Binding LineToPlayer}"
                      IsVisible="{Binding HasLine}"
                      IsHitTestVisible="False"
                      Stroke="{Binding LineColor}"
                      StrokeThickness="1.6"
                      StrokeDashArray="3,3"
                      StrokeLineCap="Round" />
                  <Panel
                      Width="{Binding Extent}"
                      Height="{Binding Extent}"
                      RenderTransformOrigin="50%,50%"
                      ToolTip.Tip="{Binding Name}">
                    <Panel.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                        <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                      </TransformGroup>
                    </Panel.RenderTransform>
                    <Ellipse
                        Width="{Binding PinSize}"
                        Height="{Binding PinSize}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{Binding FillColor}"
                        Stroke="{Binding OutlineColor}"
                        StrokeThickness="1.5" />
                  </Panel>
                </Canvas>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Where the rest of the group has been this raid, one line each in that member's
               own colour. A dot says where somebody is; it does not say which way they came or
               whether they have already swept the building you are walking into.

               Drawn before the markers so a line never sits on top of the dot it ends at, and
               dashed like the player's own trail: the points are screenshots minutes apart and
               a solid line between two of them would claim a route nobody observed. -->
          <!-- Everywhere this player has been on this map, oldest faintest. raid_events has kept
               every position of every raid since the first one, and the only readers were a
               single raid's replay and a distance sum.

               Drawn first, under everything: it is background rather than a thing to read, and
               a past raid sitting on top of the present one would be a past raid mistaken for
               it. Dashed like the other trails, because the points are screenshots minutes
               apart and a solid line between two of them claims a route nobody observed.

               This is where somebody stood and nothing else — never a heat map and never a
               danger colouring. A raid is a handful of screenshots, and four points dressed up
               as a density is a claim the data cannot carry. -->
          <ItemsControl
              ItemsSource="{Binding VisitedTrails}"
              IsVisible="{Binding HasVisitedTrails}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VisitedTrailViewModel">
                <Polyline
                    Points="{Binding Points}"
                    IsVisible="{Binding HasPath}"
                    IsHitTestVisible="False"
                    Stroke="{Binding StrokeColor}"
                    StrokeThickness="2"
                    StrokeDashArray="1,2.4"
                    StrokeLineCap="Round" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl
              ItemsSource="{Binding GroupTrails}"
              IsVisible="{Binding HasGroupTrails}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupTrailViewModel">
                <Polyline
                    Points="{Binding Points}"
                    IsVisible="{Binding HasPath}"
                    IsHitTestVisible="False"
                    Stroke="{Binding StrokeColor}"
                    StrokeThickness="2"
                    StrokeDashArray="1,2.2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The rest of the group, where they last said they were. Ochre against the
               player's cyan, so a glance never mistakes somebody else for yourself. -->
          <ItemsControl
              ItemsSource="{Binding GroupMarkers}"
              IsVisible="{Binding HasGroupMarkers}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupMarkerViewModel">
                <!-- The heading used to turn this whole box, which was fine while the box
                     held only a cone and a circle. With a name in it the name would orbit the
                     dot as somebody turned, so the heading now turns the cone alone: the dot is
                     a circle and does not care, and the name is meant to stay where it was put. -->
                <Panel
                    Width="{Binding Extent}"
                    Height="{Binding Extent}"
                    ToolTip.Tip="{Binding Detail}"
                    RenderTransformOrigin="50%,50%">
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <Panel RenderTransformOrigin="50%,50%">
                    <Panel.RenderTransform>
                      <!-- No counter-turn here, deliberately. A heading is a direction on the
                           map, so when the map turns the heading turns with it; cancelling the
                           turn would leave the cone pointing at the screen's north instead of
                           the map's, which is a lie about which way somebody is facing. -->
                      <RotateTransform Angle="{Binding BearingDegrees}" />
                    </Panel.RenderTransform>
                    <Path Data="{Binding ConeGeometry}" Fill="{Binding ConeColor}" />
                  </Panel>
                  <Ellipse
                      Width="{Binding DotSize}"
                      Height="{Binding DotSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{Binding FillColor}"
                      Stroke="{Binding OutlineColor}"
                      StrokeThickness="2" />
                  <!-- Through the same arrangement pass as the feature names, so a squadmate's
                       name cannot land on an extract label. A name that found nowhere to go is
                       dropped; the dot still reads, and the panel beside the map still says who
                       is where. -->
                  <Border
                      Classes="markerName"
                      IsVisible="{Binding Placement.IsVisible}"
                      Margin="{Binding Placement.Inset}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform>
                      <RotateTransform Angle="{Binding Scale.Upright}" />
                    </Border.RenderTransform>
                    <TextBlock Classes="markerNameText" Text="{Binding Name}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Where the player has been this raid, in the order they were there. Broken
               rather than solid, because the points are screenshots minutes apart and a solid
               line between two of them would claim a route that was never observed. -->
          <Polyline
              Points="{Binding PlayerTrail}"
              IsVisible="{Binding HasPlayerTrail}"
              IsHitTestVisible="False"
              Stroke="#B034D3E8"
              StrokeThickness="{Binding PlayerTrailThickness}"
              StrokeDashArray="1,2.2"
              StrokeLineCap="Round"
              StrokeJoin="Round" />

          <!-- Where the player last was, from their own screenshot. Held as a list of at
               most one so the layer simply disappears when there is no evidence. -->
          <ItemsControl
              ItemsSource="{Binding PlayerMarkers}"
              Width="{Binding CanvasWidth}"
              Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayerMarkerViewModel">
                <!-- The dot and its facing cone sit in one square that is rotated about its
                     own centre, so the cone swings around the player rather than spinning on
                     the spot. The square is then moved so its centre lands on the position. -->
                <Panel
                    Width="{Binding Extent}"
                    Height="{Binding Extent}"
                    ToolTip.Tip="{Binding Label}"
                    RenderTransformOrigin="50%,50%">
                  <Panel.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding Scale.Inverse}" ScaleY="{Binding Scale.Inverse}" />
                      <!-- No counter-turn here, deliberately. A heading is a direction on the
                           map, so when the map turns the heading turns with it; cancelling the
                           turn would leave the cone pointing at the screen's north instead of
                           the map's, which is a lie about which way somebody is facing. -->
                      <RotateTransform Angle="{Binding BearingDegrees}" />
                      <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                    </TransformGroup>
                  </Panel.RenderTransform>
                  <Path Data="{Binding ConeGeometry}" Fill="{Binding ConeColor}" />
                  <Ellipse
                      Width="{Binding DotSize}"
                      Height="{Binding DotSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{Binding FillColor}"
                      Stroke="{Binding OutlineColor}"
                      StrokeThickness="{Binding DotBorderThickness}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border
              Classes="mapPlaceholder"
              Canvas.Left="16"
              Canvas.Top="16"
              IsVisible="{Binding ShowsPlaceholder}">
            <TextBlock Classes="label" MaxWidth="520" Text="{Binding Status}" TextWrapping="Wrap" />
          </Border>
        </Canvas>
        </Border>
      </ScrollViewer>
    </Border>

    <!-- Top left: what is being looked at. Top right: how it is being looked at.
         The map chooser carries no label and is set larger than the other two, because the
         name of the map is the one thing on this bar worth reading from across the room; the
         view and the floor are qualifiers and are labelled as such. -->
    <!-- One bounding row for the two bars. They are both Top-aligned children of the same
         Panel, so the left one grew rightwards under the right one: at the shipped default
         window width the view controls sat on top of the Stack toggle and clipped it. The
         star column gives the left bar whatever the right bar does not need, and the row
         inside it wraps rather than running on. -->
    <Grid VerticalAlignment="Top" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="7">
        <Border Classes="floating" Padding="8,6">
          <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="6">
            <ComboBox
                x:Name="LocationChooser"
                Classes="chooser primary"
                MinWidth="168"
                ItemsSource="{Binding Locations}"
                SelectedItem="{Binding SelectedLocation, Mode=OneWay}"
                SelectionChanged="LocationSelectionChanged"
                ToolTip.Tip="Map">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="maps:MapLocation">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="chooserLabel" Text="View" />
              <ComboBox
                  x:Name="VariantChooser"
                  Classes="chooser"
                  MinWidth="124"
                  ItemsSource="{Binding Variants}"
                  SelectedItem="{Binding SelectedVariant, Mode=OneWay}"
                  SelectionChanged="VariantSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="maps:MapVariant">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="chooserLabel" Text="Floor" />
              <!-- Which building's floor, where the catalog names one. The second floor of dorms
                   on Customs and the second floor of big red are different heights, so a floor
                   number alone is not an answer on the maps that have this. -->
              <TextBlock Classes="chooserLabel ochre"
                         Text="{Binding Area}"
                         IsVisible="{Binding HasArea}"
                         VerticalAlignment="Center" />
              <ComboBox
                  x:Name="FloorChooser"
                  Classes="chooser"
                  MinWidth="100"
                  ItemsSource="{Binding Floors}"
                  SelectedItem="{Binding SelectedFloor, Mode=OneWay}"
                  SelectionChanged="FloorSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="maps:MapFloorDefinition">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <!-- The separate smaller maps some buildings have, which the catalog does not
                   publish and does not need to: a floor is a list of named rectangles, 68 of
                   them across the maps, and framing the one the player is standing in is what a
                   separate map would have been.

                   Only when there is one, and it lets go when they walk out. A floor chosen
                   deliberately still frames the floor. -->
              <ToggleButton Classes="viewControl"
                            IsVisible="{Binding CanFrameArea}"
                            IsChecked="{Binding IsFramingArea, Mode=TwoWay}"
                            Content="{Binding FrameAreaText}" />
              <!-- The flat map answers "where". On a map with floors it cannot answer "which
                   floor", which is the question inside a building, and a stack answers both at
                   once. Off until asked for.

                   One word, because the row is full. "Stack the floors" was clipped to "Stack"
                   by the toolbar beside it, which is the toolbar saying there is no room rather
                   than a label that wanted to be longer. It sits next to the floor chooser, so
                   one word is enough to say which floors. -->
              <ToggleButton Classes="viewControl"
                            IsVisible="{Binding CanStack}"
                            IsChecked="{Binding IsStacked, Mode=TwoWay}"
                            ToolTip.Tip="Draw the floors one above another instead of one at a time"
                            Content="Stack" />
              <!-- Where the Stack toggle would be, when this artwork has no floors and another
                   copy of the same map does. Only the interactive variant of a map carries
                   layers, so switching artwork loses the stack, the toggle correctly
                   disappears, and until now nothing said why or how to get it back. A feature
                   that vanishes silently is indistinguishable from one that is broken, which is
                   exactly how this was reported. -->
              <Button Classes="viewControl"
                      IsVisible="{Binding HasFloorVariant}"
                      Click="FloorVariantClick"
                      Content="Floors…"
                      ToolTip.Tip="{Binding FloorVariantHint}" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- Collapsed by default. A row of layer chips permanently across the top was the
             single largest piece of chrome and is the one touched least. Open, it is a key as
             much as a set of switches: each row is drawn with the disc its markers use, in the
             order they matter, with a count of what is on the layer. -->
        <Expander Classes="floating" Header="Layers" IsExpanded="False">
          <ItemsControl ItemsSource="{Binding Overlays}" MinWidth="220">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapOverlayViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                  <ToggleButton
                      Classes="layerRow"
                      Tag="{Binding Kind}"
                      IsChecked="{Binding IsVisible, Mode=OneWay}"
                      Click="OverlayVisibilityChanged">
                    <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                      <Panel Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse
                            Classes="markerDisc"
                            Classes.spawn="{Binding IsSpawns}"
                            Classes.locked="{Binding IsKeys}"
                            Classes.quest="{Binding IsQuestObjectives}"
                            IsVisible="{Binding HasDiscSwatch}" />
                        <TextBlock
                            Classes="swatchText"
                            Text="Aa"
                            IsVisible="{Binding IsLabels}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="layerName" Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="2" Classes="layerCount" Text="{Binding CountText}" />
                    </Grid>
                  </ToggleButton>
                  <Button
                      Grid.Column="1"
                      Classes="chipFocus"
                      Classes.on="{Binding IsHighlighted}"
                      Tag="{Binding Kind}"
                      Content="&#x25CE;"
                      ToolTip.Tip="{Binding HighlightLabel}"
                      Click="OverlayHighlightClick" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>

      <Border Grid.Column="1" Classes="floating" Margin="12" Padding="6,5" HorizontalAlignment="Right" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <!-- Only shown where the map actually publishes both, which is a minority of them. -->
          <Button
              Classes="viewControl"
              Classes.on="{Binding PrefersDrawing}"
              Click="ArtworkClick"
              Content="Drawing"
              IsVisible="{Binding HasArtworkChoice}"
              ToolTip.Tip="Show the drawn map instead of the photographic one. Remembered for this map." />
          <Button Classes="viewControl" Classes.on="{Binding FollowsPlayer}" Click="FollowClick" Content="Follow" ToolTip.Tip="Move the map to you when you take a screenshot" />
          <Button Classes="viewControl" Classes.on="{Binding AutoSelectsFloor}" Click="AutoFloorClick" Content="Floors"
                  ToolTip.Tip="Change floor to the one you are standing on, from the height in your screenshot" />
          <Button Classes="viewControl" Classes.on="{Binding IsAutoFit}" Click="FitClick" Content="Fit" ToolTip.Tip="Scale the whole map to the panel and centre it. Double-click the map does the same." />
          <!-- Off unless asked for, and loaded when it is. It is the one layer that grows with
               how much somebody has played, and on a map they know well it is a great deal of
               ink over the things they opened the map to read. -->
          <Button
              Classes="viewControl"
              Classes.on="{Binding ShowsVisited}"
              Click="VisitedClick"
              Content="{Binding VisitedLabel}"
              ToolTip.Tip="Draw where your own screenshots put you in past raids on this map" />
          <!-- A setting rather than a given, which is how it was asked for: the colour of
               somebody's dot already appears beside their name in the group panel, so on a
               two-man the names are redundant and on a five-man they are the only thing that
               tells one 13-pixel dot from the next. -->
          <Button
              Classes="viewControl"
              Classes.on="{Binding ShowsGroupNames}"
              Click="GroupNamesClick"
              Content="Names"
              ToolTip.Tip="Draw your squadmates' names beside their markers. Remembered." />
          <!-- One button going one way round, because four presses is the whole space and a
               second button for the other direction is a second button to find under fire. -->
          <Button
              Classes="viewControl"
              Classes.on="{Binding IsRotated}"
              Click="RotateClick"
              Content="{Binding RotationLabel}"
              ToolTip.Tip="Turn the map a quarter turn. A tall map on a wide screen is drawn small and wastes half the panel. Remembered for this map." />
          <Button Classes="viewControl" Click="ZoomOutClick" Content="&#x2212;" ToolTip.Tip="Zoom out" />
          <TextBlock Classes="zoomReadout" Text="{Binding ZoomScale, StringFormat={}{0:P0}}" />
          <Button Classes="viewControl" Click="ZoomInClick" Content="+" ToolTip.Tip="Zoom in" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom left: what the map is doing, in one line, expandable when it matters.

         The header is trimmed rather than clipped. A plain string header is cut off by the
         expander's own width wherever it happens to reach, which the gallery caught on
         Streets: "Map asset downloaded from tarkov.dev. Showing upstream SVG layer 'Ground"
         stops mid-word with nothing to say it had more to say. An ellipsis says so, the
         tooltip gives it back, and opening the expander now shows it in full — it said
         everything except the line somebody was reading. -->
    <Expander
        Classes="floating"
        Margin="12"
        MaxWidth="520"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        ToolTip.Tip="{Binding Status}"
        IsExpanded="False">
      <Expander.Header>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" MaxWidth="460" />
      </Expander.Header>
      <StackPanel Spacing="6" MaxWidth="490">
        <TextBlock Classes="label" Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Classes="label" Text="{Binding TransformStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="label" Text="{Binding QuestLayerStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="quiet" Click="AttributionClick" Content="{Binding AttributionText}" />
          <Button Classes="quiet" Click="LicenseClick" Content="Licence" />
        </StackPanel>
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding QuestAssociations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuestMapAssociationViewModel">
                <Border Classes="inset" Padding="9,6" Margin="0,0,0,5">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="value" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="label ochre" IsVisible="{Binding IsUnsupported}" Text="Unsupported objective details" />
                    <TextBlock Classes="label" IsVisible="{Binding IsFloorFiltered}" Text="Hidden by the selected floor" />
                    <TextBlock Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="{Binding Items}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Evidence}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Expander>
  </Panel>
</UserControl>
