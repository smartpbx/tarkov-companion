<UserControl x:Class="TarkovCompanion.App.Views.V2.Setup.V2SetupWorkspaceView"
             x:DataType="vm:V2SetupWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Setup"
             xmlns:setup="using:TarkovCompanion.App.Views.V2.Setup">
  <UserControl.Styles>
    <!-- A settings section reads as a readable column, not a full-width slab. -->
    <Style Selector="Border.v2-card.v2-setup-section">
      <Setter Property="MaxWidth" Value="960" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style Selector="ProgressBar.v2-setup-progress">
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="MaxWidth" Value="480" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
  </UserControl.Styles>
  <!-- V2 rough package 17 (home): compact section tabs like the shell's own, the home overview
       first, then one settings section at a time. -->
  <StackPanel Classes="v2-stack" Margin="16,4,16,0">
    <ItemsControl ItemsSource="{Binding Sections}"
                  AutomationProperties.AccessibilityView="Control"
                  AutomationProperties.AutomationId="v2-setup-sections"
                  AutomationProperties.LandmarkType="Navigation"
                  AutomationProperties.Name="{Binding SectionsRegionName}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="4" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:V2SetupSectionTabViewModel">
          <Button Classes="v2-target v2-tab" Classes.selected="{Binding IsCurrent}"
                  AutomationProperties.AutomationId="{Binding AutomationId}"
                  AutomationProperties.Name="{Binding Label}"
                  Content="{Binding Label}" Command="{Binding SelectCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Panel IsVisible="{Binding IsOverviewSelected}">
      <setup:V2HomeOverviewView DataContext="{Binding Overview}" />
    </Panel>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsGameProfileSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-body" Text="{Binding Settings.ProfileContext}" />
        <TextBlock Classes="v2-body" Text="{Binding Settings.WatchedFolders}" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.GameFolderStatus}" />
        <StackPanel Classes="v2-field">
          <TextBlock Classes="v2-label" Text="{Binding ScreenshotFolderLabel}" />
          <TextBox Classes="v2-field-input" Text="{Binding Settings.ScreenshotFolder}"
                    AutomationProperties.AutomationId="v2-setup-screenshot-folder"
                    AutomationProperties.Name="{Binding ScreenshotFolderLabel}" />
        </StackPanel>
        <StackPanel Classes="v2-field">
          <TextBlock Classes="v2-label" Text="{Binding LogFolderLabel}" />
          <TextBox Classes="v2-field-input" Text="{Binding Settings.LogFolder}"
                    AutomationProperties.AutomationId="v2-setup-log-folder"
                    AutomationProperties.Name="{Binding LogFolderLabel}" />
        </StackPanel>
        <Button Classes="v2-target" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="v2-setup-save-folders"
                Content="{Binding SaveFoldersLabel}" Command="{Binding Settings.SaveGameFoldersCommand}" />
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsRecognitionSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-body" Text="{Binding Settings.RecognitionProvider}" />
        <TextBlock Classes="v2-label" IsVisible="{Binding Settings.RecognitionNeedsRuntime}"
                   Text="{Binding RecognitionRuntimeWarning}" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.ScanProvider}" />
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsDataSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-body" Text="{Binding Settings.DataStatus}" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.DatabasePath}" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.DiagnosticChannel}" />
        <Button Classes="v2-target" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="v2-setup-sync"
                Content="{Binding SyncLabel}" Command="{Binding Settings.SyncCommand}" />
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsTeamDevicesSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-body" Text="{Binding Group.Status}" />
        <Button Classes="v2-target" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="v2-setup-open-team"
                Content="{Binding OpenTeamLabel}" Command="{Binding OpenTeamCommand}" />
      </StackPanel>
    </Border>

    <!-- V2 rough package 36 (self-updating builds): the channel, what is installed, what is
         available, one press to update, and where the data is. A build run from a folder says
         so and points at the installer instead of offering buttons that cannot act. -->
    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsUpdatesSelected}">
      <StackPanel Classes="v2-stack">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="v2-label" VerticalAlignment="Center" Text="{Binding UpdateChannelLabel}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="v2-body" Text="{Binding Settings.UpdateChannelName}"
                     AutomationProperties.AutomationId="v2-setup-update-channel" />
          <TextBlock Grid.Row="1" Grid.Column="0" Classes="v2-label" VerticalAlignment="Center" Text="{Binding InstalledBuildLabel}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="v2-body" Text="{Binding Settings.InstalledBuild}"
                     AutomationProperties.AutomationId="v2-setup-installed-build" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="v2-label" VerticalAlignment="Center" Text="{Binding AvailableBuildLabel}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="v2-body" Text="{Binding Settings.AvailableBuild}"
                     AutomationProperties.AutomationId="v2-setup-available-build" />
        </Grid>
        <TextBlock Classes="v2-body" Text="{Binding Settings.UpdateStatus}" TextWrapping="Wrap" />
        <ProgressBar Classes="v2-setup-progress" Minimum="0" Maximum="100"
                     IsVisible="{Binding Settings.IsDownloadingUpdate}"
                     Value="{Binding Settings.UpdatePercent}"
                     AutomationProperties.AutomationId="v2-setup-update-progress"
                     AutomationProperties.Name="{Binding Settings.UpdateStatus}" />
        <WrapPanel Classes="v2-toolbar">
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-check-update"
                  IsEnabled="{Binding Settings.CanCheckForUpdate}"
                  Content="{Binding CheckUpdateLabel}" Command="{Binding Settings.CheckForUpdateCommand}" />
          <Button Classes="v2-target primary" IsVisible="{Binding Settings.CanUpdateNow}"
                  IsEnabled="{Binding Settings.IsUpdateIdle}"
                  AutomationProperties.AutomationId="v2-setup-update-now"
                  Content="{Binding UpdateNowLabel}" Command="{Binding Settings.UpdateNowCommand}" />
          <Button Classes="v2-target primary" IsVisible="{Binding Settings.IsRunFromFolder}"
                  AutomationProperties.AutomationId="v2-setup-get-installer"
                  Content="{Binding GetInstallerLabel}" Click="OnGetInstaller" />
        </WrapPanel>
        <SelectableTextBlock Classes="v2-label" IsVisible="{Binding Settings.IsRunFromFolder}"
                             Text="{Binding Settings.InstallerAddress}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.UpdateDataFolder}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="v2-setup-update-data-folder" />
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsPrivacySelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-body" Text="{Binding ScreenshotIntro}" />
        <TextBlock Classes="v2-label" Text="{Binding Settings.RetentionStatus}" />
        <WrapPanel Classes="v2-toolbar">
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-toggle-tidying"
                  IsEnabled="{Binding Settings.CanTidyScreenshots}"
                  Content="{Binding Settings.ScreenshotTidyingLabel}" Command="{Binding Settings.ToggleScreenshotTidyingCommand}" />
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-choose-retention"
                  IsEnabled="{Binding Settings.CanTidyScreenshots}"
                  Content="{Binding RetentionLabel}" Command="{Binding Settings.ChooseRetentionCommand}" />
        </WrapPanel>
        <TextBlock Classes="v2-label" Text="{Binding DebugCaptureLabel}" />
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsAppearanceSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-label" Text="{Binding ScaleLabel}" />
        <WrapPanel Classes="v2-toolbar">
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-scale-smaller"
                  Content="{Binding SmallerLabel}" Command="{Binding DecreaseScaleCommand}" />
          <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="{Binding Legacy.InterfaceScaleLabel}" />
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-scale-larger"
                  Content="{Binding LargerLabel}" Command="{Binding IncreaseScaleCommand}" />
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-scale-reset"
                  Content="{Binding ResetLabel}" Command="{Binding ResetScaleCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsDisplaysSelected}">
      <TextBlock Classes="v2-body" Text="{Binding DisplaysInfo}" />
    </Border>

    <Border Classes="v2-card v2-setup-section" IsVisible="{Binding IsDiagnosticsSelected}">
      <StackPanel Classes="v2-stack">
        <TextBlock Classes="v2-label" Text="{Binding Settings.CompanionLogPath}" />
        <TextBlock Classes="v2-body" Text="{Binding Settings.DiagnosticsStatus}" />
        <WrapPanel Classes="v2-toolbar">
          <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-copy-diagnostics"
                  Content="{Binding CopyDiagnosticsLabel}" Command="{Binding Settings.CopyDiagnosticsCommand}" />
          <Button Classes="v2-target primary" AutomationProperties.AutomationId="v2-setup-report-problem"
                  Content="{Binding ReportProblemLabel}" Command="{Binding Settings.ReportProblemCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
