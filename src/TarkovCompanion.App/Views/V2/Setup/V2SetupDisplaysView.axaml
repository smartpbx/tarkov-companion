<UserControl x:Class="TarkovCompanion.App.Views.V2.Setup.V2SetupDisplaysView"
             x:DataType="vm:SetupDisplaysViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Setup">
  <!-- [#292/#316] The monitors this machine has, where both windows are, and an explicit move. -->
  <StackPanel Classes="v2-stack">
    <TextBlock Classes="v2-label" Text="{Binding UnavailableNote}" IsVisible="{Binding IsUnavailable}" />
    <StackPanel Classes="v2-stack" IsVisible="{Binding IsAvailable}">
      <TextBlock Classes="v2-heading-3" Text="{Binding Heading}" AutomationProperties.HeadingLevel="3" />
      <ItemsControl ItemsSource="{Binding Displays}" AutomationProperties.AutomationId="v2-setup-displays">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SetupDisplayRow">
            <StackPanel Margin="0,2" Spacing="1">
              <TextBlock Classes="v2-body" Text="{Binding Name}" />
              <TextBlock Classes="v2-label" Text="{Binding Detail}" />
              <TextBlock Classes="v2-label" Text="{Binding Badges}" IsVisible="{Binding HasBadges}" />
              <Button Classes="v2-target" HorizontalAlignment="Left" Margin="0,2,0,0"
                      Content="{Binding MoveLabel}" Command="{Binding MoveCommand}" IsVisible="{Binding CanMove}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="v2-heading-3" Text="{Binding CaptureHeading}" AutomationProperties.HeadingLevel="3" Margin="0,6,0,0" />
      <TextBlock Classes="v2-body" Text="{Binding CaptureTarget}" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="v2-setup-capture-target" />
      <TextBlock Classes="v2-label" Text="{Binding CaptureNote}" TextWrapping="Wrap" />
      <StackPanel Spacing="8" IsVisible="{Binding CanCalibrate}" Margin="0,8,0,0"
                  AutomationProperties.AutomationId="v2-setup-capture-calibration">
        <TextBlock Classes="v2-heading-3" Text="{Binding CalibrationHeading}"
                   AutomationProperties.HeadingLevel="3" />
        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
          <TextBlock Classes="v2-label" Text="{Binding CaptureModeLabel}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureModes}"
                    SelectedItem="{Binding SelectedCaptureMode, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SetupCaptureModeChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="{Binding InsetsHeading}" />
        <Grid ColumnDefinitions="Auto,88,Auto,88" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="v2-label" Text="{Binding LeftInsetLabel}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding LeftInset, Mode=TwoWay}"
                         Minimum="0" Maximum="4096" Increment="1" FormatString="0" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="v2-label" Text="{Binding TopInsetLabel}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding TopInset, Mode=TwoWay}"
                         Minimum="0" Maximum="4096" Increment="1" FormatString="0" />
          <TextBlock Grid.Row="1" Grid.Column="0" Classes="v2-label" Text="{Binding RightInsetLabel}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RightInset, Mode=TwoWay}"
                         Minimum="0" Maximum="4096" Increment="1" FormatString="0" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="v2-label" Text="{Binding BottomInsetLabel}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding BottomInset, Mode=TwoWay}"
                         Minimum="0" Maximum="4096" Increment="1" FormatString="0" />
        </Grid>
        <Border Background="{DynamicResource V2.Brush.Surface}" BorderBrush="{DynamicResource V2.Brush.Border}"
                BorderThickness="1" Padding="8" HorizontalAlignment="Left">
          <Canvas Width="{Binding PreviewOuterWidth}" Height="{Binding PreviewOuterHeight}">
            <Border Width="{Binding PreviewOuterWidth}" Height="{Binding PreviewOuterHeight}"
                    BorderBrush="{DynamicResource V2.Brush.TextSecondary}" BorderThickness="1" />
            <Border Canvas.Left="{Binding PreviewInnerLeft}" Canvas.Top="{Binding PreviewInnerTop}"
                    Width="{Binding PreviewInnerWidth}" Height="{Binding PreviewInnerHeight}"
                    Background="{DynamicResource V2.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource V2.Brush.Action}" BorderThickness="2" />
          </Canvas>
        </Border>
        <TextBlock Classes="v2-label" Text="{Binding PreviewDescription}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-label" Text="{Binding CalibrationStatus}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="v2-target" Content="{Binding SaveCalibrationLabel}"
                  Command="{Binding SaveCalibrationCommand}"
                  AutomationProperties.AutomationId="v2-setup-capture-calibration-save" />
          <Button Classes="v2-target" Content="{Binding ResetCalibrationLabel}"
                  Command="{Binding ResetCalibrationCommand}"
                  AutomationProperties.AutomationId="v2-setup-capture-calibration-reset" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <Button Classes="v2-target" HorizontalAlignment="Left" AutomationProperties.AutomationId="v2-setup-displays-refresh"
            Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
  </StackPanel>
</UserControl>
