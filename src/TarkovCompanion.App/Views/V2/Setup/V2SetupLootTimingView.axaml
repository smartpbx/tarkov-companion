<UserControl x:Class="TarkovCompanion.App.Views.V2.Setup.V2SetupLootTimingView"
             x:DataType="vm:SetupLootScanViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Setup">
  <!-- [#572] The last loot scan, stage by stage, from the timeline #586 keeps: a slow scan says where
       its time went instead of only feeling slow. -->
  <StackPanel Classes="v2-field" AutomationProperties.AutomationId="v2-setup-loot-timing">
    <TextBlock Classes="v2-label" Text="{Binding LastScanHeading}" AutomationProperties.HeadingLevel="2" />
    <TextBlock Classes="v2-body" Text="{Binding LastScanSummary}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding LastScanStages}" IsVisible="{Binding HasLastScan}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Classes="v2-label" Text="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- [#712 0-12] Every kind of screenshot, p50 / p95 per milestone since the file appeared. -->
    <Panel DataContext="{Binding Screenshots}">
      <StackPanel Classes="v2-field" x:DataType="vm:ScreenshotTimingViewModel"
                  AutomationProperties.AutomationId="v2-setup-screenshot-timing">
        <TextBlock Classes="v2-label" Text="{Binding Heading}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="v2-label" Opacity="0.8" Text="{Binding Hint}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-body" Text="{Binding Empty}" IsVisible="{Binding !HasRows}" />
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="v2-label" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Panel>
  </StackPanel>
</UserControl>
