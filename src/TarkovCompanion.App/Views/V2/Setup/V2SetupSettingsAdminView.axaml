<UserControl x:Class="TarkovCompanion.App.Views.V2.Setup.V2SetupSettingsAdminView"
             x:DataType="vm:SetupSettingsAdminViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Setup"
             xmlns:setupSvc="using:TarkovCompanion.Application.Services.Setup">
  <!-- #292 task 2: "Reset this section", "Reset everything", export and import. Shown on every
       section (below the section tabs, beside "Show file paths") rather than owning one of its
       own, since "this section" only means something once a section is already open. Nothing here
       applies until Confirm is pressed: every action first computes a diff against what is live
       and holds it until then. -->
  <Border Classes="v2-card v2-setup-section" AutomationProperties.AutomationId="v2-setup-settings-admin">
    <StackPanel Classes="v2-stack">
      <WrapPanel Classes="v2-toolbar">
        <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-reset-section"
                Content="{x:Static l:SetupText.AdminResetSection}" Command="{Binding ResetSectionCommand}" />
        <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-reset-all"
                Content="{x:Static l:SetupText.AdminResetAll}" Command="{Binding ResetAllCommand}" />
      </WrapPanel>
      <StackPanel Classes="v2-field">
        <TextBlock Classes="v2-label" Text="{x:Static l:SetupText.AdminFileLabel}" />
        <TextBox Classes="v2-field-input" Text="{Binding ExchangePath}"
                  PlaceholderText="{x:Static l:SetupText.AdminFilePlaceholder}"
                  AutomationProperties.AutomationId="v2-setup-settings-path"
                  AutomationProperties.Name="{x:Static l:SetupText.AdminFileLabel}" />
      </StackPanel>
      <WrapPanel Classes="v2-toolbar">
        <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-export-settings"
                Content="{x:Static l:SetupText.AdminExport}" Command="{Binding ExportCommand}" />
        <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-preview-import-settings"
                Content="{x:Static l:SetupText.AdminPreviewImport}" Command="{Binding PreviewImportCommand}" />
      </WrapPanel>
      <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding StatusMessage}"
                 IsVisible="{Binding !HasPendingChange}"
                 AutomationProperties.AutomationId="v2-setup-settings-status"
                 AutomationProperties.LiveSetting="Polite" />

      <Border Classes="v2-card" IsVisible="{Binding HasPendingChange}"
              AutomationProperties.AutomationId="v2-setup-settings-preview">
        <StackPanel Classes="v2-stack">
          <TextBlock Classes="v2-body" Text="{Binding PendingLabel}" />
          <ItemsControl ItemsSource="{Binding PendingDiff}"
                        AutomationProperties.AutomationId="v2-setup-settings-diff">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="setupSvc:SetupSettingsDiffEntry">
                <Grid ColumnDefinitions="220,Auto,*" ColumnSpacing="10" Margin="0,2">
                  <TextBlock Classes="v2-label" Text="{Binding Field}" />
                  <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding CurrentValue}" />
                  <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding NewValue}" FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Classes="v2-toolbar">
            <Button Classes="v2-target primary" AutomationProperties.AutomationId="v2-setup-confirm-settings-change"
                    Content="{x:Static l:SetupText.AdminConfirm}" Command="{Binding ConfirmCommand}" />
            <Button Classes="v2-target" AutomationProperties.AutomationId="v2-setup-cancel-settings-change"
                    Content="{x:Static l:SetupText.AdminCancel}" Command="{Binding CancelCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
