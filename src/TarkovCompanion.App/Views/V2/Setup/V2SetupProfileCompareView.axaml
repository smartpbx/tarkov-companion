<UserControl x:Class="TarkovCompanion.App.Views.V2.Setup.V2SetupProfileCompareView"
             x:DataType="vm:SetupProfileCompareViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Setup">
  <UserControl.Styles>
    <Style Selector="Border.v2-compare">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.v2-compare-value.differs">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <!-- [#269] Two profiles side by side. Read-only: nothing here switches or writes. -->
  <StackPanel Spacing="8" AutomationProperties.AutomationId="v2-setup-profile-compare">
    <TextBlock Classes="v2-heading-3" Text="{Binding Heading}" AutomationProperties.HeadingLevel="3" />
    <TextBlock Classes="v2-label" Text="{x:Static l:SetupText.WorkspaceCompareNeedsSecond}" IsVisible="{Binding !CanCompare}" />
    <Border Classes="v2-compare" IsVisible="{Binding CanCompare}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="220,*,*" ColumnSpacing="12">
          <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{x:Static l:SetupText.WorkspaceCompareProfilesLabel}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Left}" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="v2-setup-profile-compare-left"
                    AutomationProperties.Name="{x:Static l:SetupText.WorkspaceCompareFirstName}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SetupProfileCompareChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding Right}" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="v2-setup-profile-compare-right"
                    AutomationProperties.Name="{x:Static l:SetupText.WorkspaceCompareSecondName}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SetupProfileCompareChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}"
                      AutomationProperties.AutomationId="v2-setup-profile-compare-rows">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SetupProfileCompareRow">
              <Grid ColumnDefinitions="220,*,*" ColumnSpacing="12">
                <TextBlock Classes="v2-label" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="v2-body v2-compare-value" Classes.differs="{Binding Differs}" Text="{Binding Left}" />
                <TextBlock Grid.Column="2" Classes="v2-body v2-compare-value" Classes.differs="{Binding Differs}" Text="{Binding Right}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="v2-label" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
                   Foreground="{DynamicResource V2.Brush.Warning}"
                   AutomationProperties.AutomationId="v2-setup-profile-compare-status" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
