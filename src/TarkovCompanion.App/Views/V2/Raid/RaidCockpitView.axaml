<UserControl x:Class="TarkovCompanion.App.Views.V2.Raid.RaidCockpitView"
             x:DataType="vm:RaidCockpitViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Raid"
             xmlns:appVm="using:TarkovCompanion.App.ViewModels"
             xmlns:mapVm="using:TarkovCompanion.App.ViewModels.V2.MapRenderer"
             xmlns:mapvm="using:TarkovCompanion.App.ViewModels.Maps"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives"
             xmlns:raid="using:TarkovCompanion.App.Views.V2.Raid">
  <UserControl.Resources>
    <!-- Fluent's Expander header is a solid dark slab; in the context panel it reads as a card row. -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- A context-panel section: a card with the concept's cyan leading edge. -->
    <Style Selector="Border.v2-raid-section">
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
    </Style>
    <Style Selector="Border.v2-raid-section.v2-raid-accent">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Border.v2-raid-row">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.v2-raid-row.v2-raid-offered">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A Raid plan fact chip. In dark and light the divider is the chip's own fill, so nothing
         changes there; high contrast paints every surface black, and without an edge the chips
         were loose words. -->
    <Style Selector="Border.v2-raid-row.v2-raid-fact">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.v2-raid-row.v2-raid-not-offered">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- A row that selects something: the button is only the hit target, the row inside is what shows. -->
    <Style Selector="Button.v2-raid-rowbutton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.v2-raid-routed">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.v2-raid-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.v2-raid-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Border.v2-raid-chip.v2-raid-muted">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
    </Style>
    <Style Selector="Border.v2-raid-chip.v2-raid-muted TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <!-- [Issue 508] An objective's own letter chip carries the same amber its pin on the map
         does (V2.Brush.Warning, same as Path.v2-map-pin-shield), so this row can be matched to
         its pin by colour as well as by the letter itself. -->
    <Style Selector="Border.v2-raid-chip.v2-raid-chip-objective">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="Border.v2-raid-chip.v2-raid-chip-objective TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <!-- A mark's own row carries a small dot in the same colour family as its pin (a waypoint's
         accent) or pulse (a ping's) on the map. -->
    <Style Selector="Ellipse.v2-raid-mark-dot.v2-raid-mark-waypoint">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <!-- [Issue 598] Matches the map's own ping colour (V2.Brush.Danger, not Info — see
         MapSceneRendererView's ping styles). -->
    <Style Selector="Ellipse.v2-raid-mark-dot.v2-raid-mark-ping">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Danger}" />
    </Style>
    <Style Selector="Border.v2-raid-strip">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Border.v2-raid-mapcard">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- A caption on the plan's bottom edge: who made the artwork, what the map last did. Not a
         control and not hit-testable; the plate is only so it reads over a photograph. -->
    <Style Selector="Border.v2-raid-caption">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="ToggleSwitch.v2-layer-switch">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- V2 rough package 22: V1's view controls, as one floating group over the map's own
         bottom-left corner rather than as V1's column of chrome down the side. Compact text
         toggles: "Follow", "270°", "Names" are read at a glance mid-raid and an icon for each
         would be a guessing game. -->
    <Style Selector="Border.v2-raid-viewgroup">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Opacity" Value="0.97" />
    </Style>
    <!-- [Refs #571] An objective already marked done: its check is lit, and pressing it undoes. -->
    <Style Selector="Button.v2-raid-done Path.v2-icon">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="ToggleButton.v2-raid-viewcontrol, Button.v2-raid-viewcontrol">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="{DynamicResource V2.Type.Label.Size}" />
    </Style>
    <!-- The floating groups fade out a few seconds after the pointer leaves the map when
         "Auto-hide" is on (#388). Purely visual: they stay hit-testable and stay in the
         automation tree, so a keyboard or a screen reader never loses them. -->
    <Style Selector="Border.v2-raid-float">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.35" /></Transitions>
      </Setter>
    </Style>
    <!-- [V2 rough package 60 — appearance] Reduce motion (#266) keeps the state change and drops
         the transition, so the groups still dim, instantly. The class is put on the window by
         V2AppearanceApplier: a DynamicResource duration inside a Transitions setter has no
         resource host to resolve against and would silently keep the authored 0.35s. This style
         has to live beside the one it overrides, because a control's own styles are applied after
         the application's and would otherwise win. -->
    <Style Selector="Window.v2-motion-reduced Border.v2-raid-float">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="Border.v2-raid-float.v2-raid-idle">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="Border.v2-raid-panel">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <!-- [V2 rough package 46] The panel's own edge, and the only chrome left when it is away:
         14 pixels wide, so putting the panel away really does give the map everything else. -->
    <Style Selector="Border.v2-raid-splitter">
      <Setter Property="Width" Value="14" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Border.v2-raid-splitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
    <Style Selector="Button.v2-raid-panel-toggle">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.v2-raid-panel-toggle:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.v2-raid-layers-button">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource V2.Control.Inset}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <!-- Follow is the one view switch pressed mid-raid, so it stays on the strip; it is sized
         like the two menu buttons beside it rather than like the small switches inside them. -->
    <Style Selector="ToggleButton.v2-raid-strip-toggle">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource V2.Control.Inset}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <!-- [#286] The Draw switch's pencil lights the way Follow's word does when it is on. -->
    <Style Selector="ToggleButton.v2-raid-draw-toggle:checked Path.v2-icon">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Button.v2-raid-follow-step">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <!-- [#574] A small phase switch inside the Layers menu: the small control size from the
         tokens, as a style rather than inline on each of the four. -->
    <Style Selector="ToggleButton.v2-raid-phase-choice">
      <Setter Property="MinHeight" Value="{DynamicResource V2.Control.Small.Height}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Control.Small.Inset}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 15: map-first, like docs/design/v2/v2-raid-intelligence-concept.png. The
       map card fills the workspace from the top with its controls floating over its edges; a
       bottom strip carries the raid phase and the map's layer switches; a full-height right
       context panel carries the map header, extract options, marks, spawn areas and loot
       filters. -->
  <!-- V2 rough package 20: the context panel was a fixed 420px, so on Clayton's 3840-wide
       ultrawide the map card took roughly 3000px for a plan that can only ever be as tall as the
       card. A proportional column, clamped, keeps the map card near the concept's shape at every
       width and gives the panel the room instead of leaving it as dead space.
       [V2 rough package 46] "The right one is too wide, maybe we can make it adjustable or
       something. More map is better." A proportional column still took 460px of a 1920 window
       for a list of five cards. It is a dragged width now, 360 by default, remembered, and put
       away entirely with the handle's own button — and then the map takes the whole width. -->
  <Grid ColumnDefinitions="*,Auto,Auto">
    <!-- #591: the owner's own screenshot showed the traffic banner, the phase/legend group and
         this caption all sitting on real terrain because Fit fills the card. The map card is now
         the map plus the zoom group only; everything that used to float over it reads from the
         caption row below the card or the control strip under that. -->
    <Grid Grid.Column="0" x:Name="MapColumn" RowDefinitions="*,Auto,Auto" RowSpacing="6" Margin="16,4,16,16">
      <Border Grid.Row="0" x:Name="MapCard" Classes="v2-raid-mapcard">
        <Grid>
          <!-- IsVisible stays on this wrapper, not on MapSceneRendererView itself: that element's
               own DataContext is overridden to Renderer below, and a binding on the same element
               would resolve against that override instead of this page's view model. -->
          <ContentControl IsVisible="{Binding HasRenderer}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <!-- [#678] The map view joins a turn after the page (StagedHost). -->
            <prim:StagedHost>
            <map:MapSceneRendererView x:Name="MapRenderer" DataContext="{Binding Renderer}" DocksPresentation="True"
                                       PlanRightClicked="RendererPlanRightClicked"
                                       MarkerRightClicked="RendererMarkerRightClicked"
                                       StrokeDrawn="RendererStrokeDrawn"
                                       DrawEscaped="RendererDrawEscaped" />
            </prim:StagedHost>
          </ContentControl>
          <!-- The only thing on the page when there is no map: the renderer, and its own
               background-status line with it, is collapsed above. Named for automation so the
               reason reaches a screen reader rather than being a card with text in it. -->
          <Border Classes="v2-card" IsVisible="{Binding !HasRenderer}" Margin="16"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  AutomationProperties.AccessibilityView="Control"
                  AutomationProperties.Name="{Binding UnavailableReason}"
                  AutomationProperties.AutomationId="v2-raid-unavailable">
            <TextBlock Classes="v2-body" Text="{Binding UnavailableReason}" TextWrapping="Wrap" />
          </Border>
          <!-- #452: a floor that would not rasterise says so over the map, with Retry. -->
          <prim:V2LoadFaultNotice DataContext="{Binding MapFault}" MaxWidth="520" Margin="12,72,12,12"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" />

          <!-- Package 29 (parity): the replay of a past raid, opened from Debrief. Without this a
               replay could be started and never stepped or closed, and while one is open the map
               does not follow live screenshots. -->
          <Border Classes="v2-raid-viewgroup v2-raid-float" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="12,64,12,12" IsVisible="{Binding Replay.IsOpen}"
                  AutomationProperties.AutomationId="v2-raid-replay"
                  AutomationProperties.Name="Replay of a past raid">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="{Binding Replay.Title}" />
              <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding Replay.Position}" />
              <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding Replay.Comparison}"
                         IsVisible="{Binding Replay.HasComparison}" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="Back" Command="{Binding Replay.BackCommand}"
                      AutomationProperties.AutomationId="v2-raid-replay-back" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding Replay.PlayLabel}"
                      Command="{Binding Replay.PlayCommand}" AutomationProperties.AutomationId="v2-raid-replay-play" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="Forward" Command="{Binding Replay.ForwardCommand}"
                      AutomationProperties.AutomationId="v2-raid-replay-forward" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="Close" Command="{Binding Replay.CloseCommand}"
                      AutomationProperties.AutomationId="v2-raid-replay-close" />
            </StackPanel>
          </Border>

          <!-- [#286] Draw mode says so over the map's top edge, with what a line drawn now will be
               and the two things a player drawing wants next: another lifetime, or a clean map. -->
          <Border Classes="v2-raid-viewgroup v2-raid-float" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="12,12,12,12" IsVisible="{Binding IsDrawMode}"
                  AutomationProperties.AccessibilityView="Control"
                  AutomationProperties.AutomationId="v2-raid-draw-bar"
                  AutomationProperties.Name="Draw mode">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="v2-icon" VerticalAlignment="Center" Data="{DynamicResource V2.Icon.Pencil}" />
              <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="Drawing" FontWeight="SemiBold" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding DrawSettingsLabel}"
                      Click="DrawSettingsClicked"
                      AutomationProperties.AutomationId="v2-raid-draw-settings"
                      ToolTip.Tip="Who sees new lines, and for how long" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="Clear mine"
                      Command="{Binding ClearMyDrawingsCommand}" IsEnabled="{Binding HasOwnDrawings}"
                      AutomationProperties.AutomationId="v2-raid-draw-clear"
                      ToolTip.Tip="Clear my drawings on this map" />
              <Button Classes="v2-target v2-raid-viewcontrol" Content="Done"
                      Command="{Binding ToggleDrawCommand}"
                      AutomationProperties.AutomationId="v2-raid-draw-done"
                      ToolTip.Tip="Back to moving the map (Esc)" />
            </StackPanel>
          </Border>

          <!-- [Issue 286] #591: the traffic chip, the phase switch and the gradient legend used to
               float here and sat on real terrain once Fit filled the card. They are in the control
               strip now (below), beside the layer switches they belong with; nothing decorative is
               drawn over the plan any more but the zoom group. -->
        </Grid>
      </Border>

      <!-- #591: the artwork credit and the map's own status line, under the map rather than
           floating on its bottom edge — the map card is the map plus the zoom group only now. -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasRenderer}">
        <TextBlock Grid.Column="0" Classes="v2-label" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasArtworkAttribution}"
                   AutomationProperties.AutomationId="v2-raid-artwork-attribution"
                   Text="{Binding ArtworkAttribution}" />
        <TextBlock Grid.Column="1" Classes="v2-label" HorizontalAlignment="Right"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"
                   IsVisible="{Binding HasStatusLine}"
                   AutomationProperties.AutomationId="v2-raid-status"
                   Text="{Binding StatusLine}" />
      </Grid>

      <!-- The concept's bottom strip: raid phase on the left, the map's layers on the right.
           [V2 rough package 46] "Maybe we can reduce the bottom filters as well to a simple menu
           or half the height so there is more map space available." Fourteen switches wrapped to
           two rows and took 110 pixels of a 1080-tall window for something a player touches once
           a raid. They are one button now, which says how many layers are on, and opens the same
           switches in a menu — one press to reach any of them, and 60 pixels back to the map. -->
      <Border Grid.Row="2" Classes="v2-raid-strip" IsVisible="{Binding HasRenderer}">
        <!-- One row, left to right: the raid clock, how the plan is presented and which floor is
             read, then what the map follows, how it is drawn, and what is on it.
             Everything that used to float over the plan's corners is here, so the plan is clear. -->
        <!-- Keep the strip's established single row, but cap the two verbose status cells so the
             starred presentation column cannot collapse at 200% text scale. Their full text wraps
             inside the cell; the clock's secondary provenance remains available as help text. -->
        <!-- [#266] Below ShellLayout.ControlStripOneRowMinimumWidth (150% and up at 1920 wide)
             RaidCockpitView.axaml.cs moves the traffic chip and the presentation switches into
             StripSecondRow, rather than the star column squeezing the floor switches to nothing. -->
        <StackPanel>
        <Grid x:Name="ControlStrip" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
              ColumnSpacing="{DynamicResource V2.Space.Sm.Gap}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      AutomationProperties.HelpText="{Binding TimeLeftDetail}">
            <!-- [#266] Only while a raid clock runs: the state words are already in the top bar
                 and the Raid plan card, and the strip has no width to repeat them on Customs. -->
            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Clock}"
                  IsVisible="{Binding ShowsStripPhase}" />
            <TextBlock Classes="v2-body" FontWeight="SemiBold" VerticalAlignment="Center"
                       IsVisible="{Binding ShowsStripPhase}"
                       AutomationProperties.AutomationId="v2-raid-phase" Text="{Binding RaidPhaseLabel}" />
            <!-- [#707] Out of the raid with a squadmate still inside: whose map this is, or one
                 press to go to it. -->
            <TextBlock Classes="v2-label" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="v2-raid-squad-watch"
                       Text="{Binding SquadWatchLabel}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasSquadWatch" />
                  <Binding Path="!CanFollowSquadmate" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <Button Classes="v2-chip" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="v2-raid-follow-squadmate"
                    IsVisible="{Binding CanFollowSquadmate}"
                    Command="{Binding FollowSquadmateCommand}"
                    Content="{Binding SquadWatchLabel}" />
          </StackPanel>
          <!-- The starred column: when the Raid plan is dragged wide the mode segment and the floor
               ladder wrap onto a second line here instead of pushing the buttons off the strip
               (MapPresentationControls' own WrapPanel — see that file). Its own Auto column, not
               inside this one, is what lets the Grid shrink the star column for it on a busy map
               like Customs (mode segment, floor ladder and an off-plan chip) rather than the chip
               overlapping the buttons after it. -->
          <map:MapPresentationControls x:Name="PresentationControls" Grid.Column="1" DataContext="{Binding Renderer}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
          <!-- [Issue 286] #591: the one compact chip, always the same words the project rule
               requires ("a prediction is never presented as live"). The basis lines that used to
               sit beside it on the map ("Prior from map structure..." / "Catalog through...") are
               the tooltip and the accessible help text now, and are already on the Raid plan card.
               The phase switch and the heat legend are a press away in the Layers menu, under
               "Modelled traffic" — the strip is one row and has no room for both. -->
          <!-- [#307] One line at 100% text, wrapping only at larger text: see TrafficChipWidthConverter. -->
          <Border Grid.Column="2" x:Name="TrafficChip" Classes="v2-raid-chip" VerticalAlignment="Center"
                  IsVisible="{Binding ShowsTrafficBanner}"
                  BorderBrush="{DynamicResource V2.Brush.Warning}"
                  ToolTip.Tip="{Binding TrafficBannerTooltip}"
                  AutomationProperties.AutomationId="v2-raid-traffic-chip"
                  AutomationProperties.AccessibilityView="Control"
                  AutomationProperties.Name="{Binding TrafficBannerTitle}"
                  AutomationProperties.HelpText="{Binding TrafficBannerTooltip}">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource V2.Brush.Warning}"
                       Text="{Binding TrafficBannerTitle}" TextWrapping="Wrap"
                       MaxWidth="{Binding $self.FontSize, Converter={x:Static raid:TrafficChipWidthConverter.Instance}}" />
          </Border>
          <!-- #675 made Follow adjustable, but three full strip controls took enough width from
               the presentation WrapPanel to add a second strip row at 1920x1080. Keep the common
               toggle at its original width and put the two step targets behind the adjacent,
               state-labelled selector. The commands and automation IDs stay directly reachable. -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <!-- [#286] Navigate / Draw: an icon, so the strip keeps its one row at 1920 (#838). -->
            <ToggleButton Classes="v2-target v2-raid-strip-toggle v2-raid-draw-toggle"
                          IsChecked="{Binding IsDrawMode, Mode=OneWay}"
                          Command="{Binding ToggleDrawCommand}"
                          AutomationProperties.AutomationId="v2-raid-draw"
                          AutomationProperties.Name="{Binding DrawModeLabel}"
                          ToolTip.Tip="{Binding DrawModeLabel}">
              <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Pencil}" />
            </ToggleButton>
            <ToggleButton Classes="v2-target v2-raid-strip-toggle" Content="Follow"
                          IsChecked="{Binding FollowsPlayer, Mode=OneWay}"
                          Command="{Binding ToggleFollowCommand}"
                          AutomationProperties.AutomationId="v2-raid-follow"
                          AutomationProperties.Name="{Binding FollowLabel}"
                          ToolTip.Tip="Move the map to you when you take a screenshot" />
            <Button Classes="v2-target v2-raid-follow-step" Content="{Binding FollowZoomLabel}"
                    AutomationProperties.AutomationId="v2-raid-follow-zoom"
                    AutomationProperties.Name="{Binding FollowLabel}"
                    ToolTip.Tip="Change Follow zoom">
              <Button.Flyout>
                <Flyout Placement="Top">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="v2-target v2-raid-follow-step" Content="−"
                            Command="{Binding DecreaseFollowZoomCommand}"
                            AutomationProperties.AutomationId="v2-raid-follow-zoom-out"
                            AutomationProperties.Name="Zoom Follow out"
                            ToolTip.Tip="Zoom Follow out" />
                    <TextBlock Classes="v2-label" MinWidth="32" TextAlignment="Center"
                               VerticalAlignment="Center" Text="{Binding FollowZoomLabel}" />
                    <Button Classes="v2-target v2-raid-follow-step" Content="+"
                            Command="{Binding IncreaseFollowZoomCommand}"
                            AutomationProperties.AutomationId="v2-raid-follow-zoom-in"
                            AutomationProperties.Name="Zoom Follow in"
                            ToolTip.Tip="Zoom Follow in" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <!-- Scoped under the renderer so nothing binds through a null Renderer before the first
               scene exists (the page gallery fails on any binding fault). -->
          <!-- [#838] 200 rather than 160: "Layers · 12 on" on Interchange wrapped at 160 and made
               the strip 12 pixels taller. The cap is still what makes it wrap at 200% text. -->
          <Button Grid.Column="5" Classes="v2-target v2-raid-layers-button" VerticalAlignment="Center" MaxWidth="200"
                  DataContext="{Binding Renderer}" x:DataType="mapVm:MapSceneRendererViewModel"
                  AutomationProperties.AutomationId="v2-raid-layers"
                  AutomationProperties.Name="{Binding LayersMenuLabel}"
                  ToolTip.Tip="Choose what is drawn on the map">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.List}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding LayersMenuLabel}"
                         TextWrapping="Wrap" />
              <Path Grid.Column="2" Classes="v2-icon" Data="{DynamicResource V2.Icon.ChevronUp}" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="10">
                  <ItemsControl x:DataType="mapVm:MapSceneRendererViewModel" ItemsSource="{Binding Layers}"
                                MinWidth="260"
                                AutomationProperties.AccessibilityView="Control"
                                AutomationProperties.Name="Map layers">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="mapVm:MapSceneRendererLayerViewModel">
                        <!-- No AutomationProperties.AutomationId here: this switch shares its view model
                             (and so its AutomationId) with the renderer's own Layers list further down the
                             same visual tree, and a duplicate id would make either one ambiguous to UIA. -->
                        <!-- V2 rough package 39: the switch says how many things it would show, and
                             an empty layer that is off cannot be switched on to an empty plan, leaving
                             the player to work out why. One that is on can always be switched off. -->
                        <ToggleSwitch Classes="v2-layer-switch" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsVisible, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggle}"
                                      OnContent="{Binding Label}" OffContent="{Binding Label}"
                                      AutomationProperties.Name="{Binding ToggleLabel}"
                                      AutomationProperties.HelpText="{Binding StateLabel}"
                                      Command="{Binding ToggleCommand}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ContentControl Content="{Binding HighValueLoot}" IsVisible="{Binding HasHighValueLoot}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate x:DataType="mapVm:HighValueLootLayerViewModel">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="v2-label" Text="{Binding ValueThresholdLabel}" />
                          <ItemsControl ItemsSource="{Binding ValueThresholdChoices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                                <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Content="{Binding Label}" Command="{Binding SelectCommand}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding CompactValueBasisChoices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                                <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Content="{Binding Label}" Command="{Binding SelectCommand}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <!-- [Issue 286] #591: the phase scrubber and the heat ramp for the "Modelled
                       traffic" switch above, back on the page's own view model (DataContext is
                       Renderer from here up, for the layer list) by name rather than by walking
                       back up through a Popup. Gone with the layer, like the switch's own detail
                       text is for every other layer. -->
                  <!-- [#266] The right margin keeps the legend's values clear of the menu's scroll bar. -->
                  <StackPanel Spacing="6" Margin="0,0,14,0" DataContext="{Binding #MapCard.DataContext}"
                              x:DataType="vm:RaidCockpitViewModel"
                              IsVisible="{Binding ShowsTrafficBanner}"
                              AutomationProperties.AccessibilityView="Control"
                              AutomationProperties.Name="Modelled traffic phase and legend">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding TrafficPhaseTip}">
                      <TextBlock Classes="v2-label" Text="Phase" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding TrafficPhases}"
                                    AutomationProperties.AccessibilityView="Control"
                                    AutomationProperties.Name="Modelled traffic raid phase">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TrafficPhaseChoiceViewModel">
                            <ToggleButton Classes="v2-raid-viewcontrol v2-raid-phase-choice"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                          Content="{Binding Label}"
                                          AutomationProperties.AutomationId="{Binding AutomationId}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <Border Height="8" CornerRadius="4" AutomationProperties.AutomationId="v2-raid-traffic-legend">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                          <GradientStop Offset="0" Color="#33FFC446" />
                          <GradientStop Offset="0.5" Color="#FFFF7824" />
                          <GradientStop Offset="1" Color="#FFDC2C22" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="v2-label" Text="Lower modelled traffic" />
                      <TextBlock Grid.Column="1" Classes="v2-label" Text="Higher" />
                    </Grid>
                    <!-- [#266] The same legend as ordered text, so colour is not the only channel:
                         the bands low to high with where each starts, then the busiest places
                         highest first. A list a screen reader reads in order, not a picture. -->
                    <ItemsControl ItemsSource="{Binding TrafficLegendBands}"
                                  AutomationProperties.AutomationId="v2-raid-traffic-legend-bands"
                                  AutomationProperties.AccessibilityView="Control"
                                  AutomationProperties.Name="Traffic bands, low to high">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrafficLegendRow">
                          <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="6" Margin="0,1"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <TextBlock Classes="v2-label" Text="{Binding Rank}" />
                            <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding Label}" />
                            <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Value}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="Busiest, highest first"
                               IsVisible="{Binding HasTrafficLegendPlaces}" />
                    <ItemsControl ItemsSource="{Binding TrafficLegendPlaces}"
                                  IsVisible="{Binding HasTrafficLegendPlaces}"
                                  AutomationProperties.AutomationId="v2-raid-traffic-legend-places"
                                  AutomationProperties.AccessibilityView="Control"
                                  AutomationProperties.Name="Busiest places, highest first">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrafficLegendRow">
                          <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="6" Margin="0,1"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <TextBlock Classes="v2-label" Text="{Binding Rank}" />
                            <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding Label}" />
                            <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Value}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- How the map is drawn: which way up, what of your own history, whose names, and which
               artwork. Touched once a map, so one press away rather than on the plan. After the
               layers button in this file only because a test reads the strip up to its first
               closing border; the column is what places it. -->
          <Button Grid.Column="4" Classes="v2-target v2-raid-layers-button" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="v2-raid-view-menu"
                  AutomationProperties.Name="Map view"
                  ToolTip.Tip="Turn the map, show where you have been, choose the artwork">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="View" />
              <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.ChevronUp}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <!-- [#574] Rows like the Layers menu beside it (ToggleButton/Button.v2-menu-row): one
                     height, a tick column, the label; not stretched buttons of their own. -->
                <StackPanel Spacing="2" MinWidth="260" MaxWidth="420"
                            AutomationProperties.AccessibilityView="Control"
                            AutomationProperties.Name="Map view controls">
                  <ToggleButton Classes="v2-menu-row"
                                Content="{Binding RotationLabel}"
                                IsChecked="{Binding IsRotated, Mode=OneWay}"
                                Command="{Binding RotateCommand}"
                                AutomationProperties.AutomationId="v2-raid-rotate"
                                AutomationProperties.Name="Turn the map a quarter"
                                ToolTip.Tip="Turn the map a quarter turn, remembered per map" />
                  <ToggleButton Classes="v2-menu-row"
                                Content="{Binding VisitedLabel}"
                                IsChecked="{Binding ShowsVisited, Mode=OneWay}"
                                Command="{Binding ToggleVisitedCommand}"
                                AutomationProperties.AutomationId="v2-raid-visited"
                                AutomationProperties.Name="Show where you have been"
                                ToolTip.Tip="Draw where your own screenshots put you in past raids on this map" />
                  <ToggleButton Classes="v2-menu-row"
                                Content="Squad names"
                                IsChecked="{Binding ShowsGroupNames, Mode=OneWay}"
                                Command="{Binding ToggleGroupNamesCommand}"
                                AutomationProperties.AutomationId="v2-raid-group-names"
                                ToolTip.Tip="Draw your squadmates' names beside their markers. Remembered." />
                  <Button Classes="v2-menu-row"
                          Content="{Binding FrameAreaText}"
                          IsVisible="{Binding CanFrameArea}"
                          Command="{Binding FrameAreaCommand}"
                          AutomationProperties.AutomationId="v2-raid-frame-area"
                          ToolTip.Tip="Put the part of the map this raid is happening in on screen" />
                  <!-- [Issue 573] Hidden / Dim (default) / Normal, one press cycles to the next. -->
                  <Button Classes="v2-menu-row"
                          Content="{Binding CoOpExtractVisibilityLabel}"
                          Command="{Binding ToggleCoOpExtractVisibilityCommand}"
                          AutomationProperties.AutomationId="v2-raid-coop-extract-visibility"
                          ToolTip.Tip="How a co-op extract is drawn and offered: hidden, dim (fewer players use one), or normal" />
                  <!-- The one place artwork is chosen: every reviewed piece of artwork this map
                       publishes, remembered per map by V1's selection service (package 39). -->
                  <TextBlock Classes="v2-label" Text="Artwork" IsVisible="{Binding HasArtworkVariants}" />
                  <ItemsControl ItemsSource="{Binding ArtworkVariants}" IsVisible="{Binding HasArtworkVariants}"
                                AutomationProperties.AutomationId="v2-raid-artwork-variants"
                                AutomationProperties.AccessibilityView="Control"
                                AutomationProperties.Name="Map artwork">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RaidArtworkVariantViewModel">
                        <ToggleButton Classes="v2-target v2-raid-viewcontrol"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding SelectCommand}"
                                      Content="{Binding Name}"
                                      AutomationProperties.AutomationId="{Binding AutomationId}"
                                      AutomationProperties.Name="{Binding Name}"
                                      ToolTip.Tip="{Binding Detail}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="v2-menu-row" Content="Floors…"
                          IsVisible="{Binding HasFloorVariant}"
                          Command="{Binding UseFloorVariantCommand}"
                          AutomationProperties.AutomationId="v2-raid-floor-variant"
                          AutomationProperties.Name="Use the artwork with floors"
                          ToolTip.Tip="{Binding FloorVariantHint}" />
                  <TextBlock Classes="v2-label" Text="{Binding FloorVariantHint}" TextWrapping="Wrap"
                             IsVisible="{Binding HasFloorVariant}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <Grid x:Name="StripSecondRow" ColumnDefinitions="Auto,*" IsVisible="False" Margin="0,6,0,0"
              ColumnSpacing="{DynamicResource V2.Space.Sm.Gap}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- [V2 rough package 46] The handle: drag it to set the panel's width, press its button to
         put the panel away or bring it back. It stays when the panel is gone, which is what makes
         the panel findable again without a control anywhere else. -->
    <Border Grid.Column="1" x:Name="ContextPanelHandle" Classes="v2-raid-splitter"
            IsVisible="{Binding HasRenderer}"
            Cursor="SizeWestEast"
            PointerPressed="PanelHandlePressed"
            PointerMoved="PanelHandleMoved"
            PointerReleased="PanelHandleReleased"
            PointerCaptureLost="PanelHandleCaptureLost"
            AutomationProperties.AccessibilityView="Control"
            AutomationProperties.Name="Raid plan width">
      <!-- The handle was the page's own colour with a 60%-opaque icon on it: a working splitter
           nobody could see, reported as "the context panel cannot be resized". The line is what
           says there is an edge here to take hold of. -->
      <Panel>
      <Rectangle Width="2" HorizontalAlignment="Center" Margin="0,12" IsHitTestVisible="False"
                 Fill="{DynamicResource V2.Brush.Border}" />
      <Button Classes="v2-target v2-raid-panel-toggle" VerticalAlignment="Center"
              AutomationProperties.AutomationId="v2-raid-panel-toggle"
              AutomationProperties.Name="{Binding ContextPanelToggleLabel}"
              ToolTip.Tip="{Binding ContextPanelToggleLabel}"
              Command="{Binding ToggleContextPanelCommand}">
        <!-- [#574] The small icon size, not a 14px box around a default-size icon. -->
        <Path Classes="v2-icon v2-icon-sm" Data="{DynamicResource V2.Icon.Sidebar}" />
      </Button>
      </Panel>
    </Border>

    <Border Grid.Column="2" x:Name="ContextPanel" Classes="v2-raid-panel"
            Width="{Binding ContextPanelWidth}" IsVisible="{Binding ShowsContextPanel}">
      <!-- Named so a headless render can scroll it; see tools/V2RenderPreview. -->
      <ScrollViewer x:Name="RaidPanelScroll" HorizontalScrollBarVisibility="Disabled">
        <prim:StagedStack Spacing="12" Margin="16,12,16,16">
          <TextBlock Classes="v2-heading-2" Text="Raid plan" AutomationProperties.HeadingLevel="2" />

          <!-- Header card: the map, the raid phase, and what this map offers at a glance. Mode is a
               shell-level concept and already sits in the top bar. -->
          <Border Classes="v2-card" Padding="4" AutomationProperties.AutomationId="v2-raid-summary">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Summary.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <WrapPanel ItemSpacing="8" LineSpacing="2">
                  <TextBlock Classes="v2-heading-3" Text="{Binding MapTitle}" TextWrapping="NoWrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18">
                      <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Clock}" />
                    </Viewbox>
                    <TextBlock Classes="v2-label" Text="{Binding RaidPhaseLabel}" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock Classes="v2-label" Text="{Binding MapSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding MapSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="4">
              <TextBlock Classes="v2-label" Opacity="0.8" Text="{Binding TrafficLayerNotice}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding TrafficRows}" IsVisible="{Binding HasTrafficRows}"
                            AutomationProperties.AutomationId="v2-raid-traffic-rows">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="v2-raid-row v2-raid-fact" Padding="8,3">
                      <TextBlock Classes="v2-label" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          </Border>

          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasGroupPanel}"
                  AutomationProperties.AutomationId="v2-raid-squad">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Squad.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Squad" />
                <TextBlock Classes="v2-label" Text="{Binding SquadSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Squad.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding GroupPanel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:GroupMemberPanelViewModel">
                      <Border Classes="v2-raid-row">
                        <!-- Two deliberate lines. The former Auto status column took the row's
                             width and made coordinates, floor and age wrap one word per line. -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                          <!-- The swatch is what joins this row to the dot and the trail on the map. -->
                          <Ellipse Grid.RowSpan="2" Width="10" Height="10" VerticalAlignment="Center"
                                   Fill="{Binding SwatchColor}" />
                          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="v2-body" Text="{Binding Name}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="v2-label" MaxWidth="130"
                                       Text="{Binding RaidStatus}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="v2-label"
                                     Text="{Binding PositionSummary}" TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <!-- [Package 35] The objectives as the plan draws them: numbered like their markers, a
               selected one said in full, and the ones with no place on the map listed as having none. -->
          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasObjectivesCard}"
                  AutomationProperties.AutomationId="v2-raid-objectives">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Objectives.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Objectives" />
                <TextBlock Classes="v2-label" Text="{Binding QuestObjectiveSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Objectives.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <!-- [Refs #571] The count on its own line and the toggle under it: at the panel's
                     narrowest the heading, the count and "Show completed" did not fit one line. -->
                <WrapPanel ItemSpacing="10" LineSpacing="4">
                  <TextBlock Classes="v2-label" Text="{Binding QuestObjectiveSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <!-- [Issue 571] Brings a done objective back on the map and this list, dimmed with a check. -->
                  <ToggleButton Classes="v2-target v2-raid-viewcontrol" Content="Show completed"
                                IsChecked="{Binding ShowCompletedObjectives, Mode=OneWay}"
                                Command="{Binding ToggleShowCompletedObjectivesCommand}"
                                AutomationProperties.AutomationId="v2-raid-objectives-show-completed"
                                ToolTip.Tip="Show objectives already marked done, dimmed with a check" />
                  <!-- [#307] The objective route opened from Plan follows the plan while shown. -->
                  <ToggleButton Classes="v2-target v2-raid-viewcontrol" Content="Hide route"
                                IsVisible="{Binding HasObjectiveRoute}"
                                IsChecked="{Binding ObjectiveRouteHidden, Mode=OneWay}"
                                Command="{Binding ToggleObjectiveRouteCommand}"
                                AutomationProperties.AutomationId="v2-raid-objective-route-hide"
                                ToolTip.Tip="Hide the objective route from Plan" />
                  <!-- [#780] Squadmates' open objectives on this map, outlined in their colour. -->
                  <ToggleButton Classes="v2-target v2-raid-viewcontrol" Content="Squad"
                                IsVisible="{Binding HasSquadObjectivesHere}"
                                IsChecked="{Binding ShowSquadObjectives, Mode=OneWay}"
                                Command="{Binding ToggleSquadObjectivesCommand}"
                                AutomationProperties.AutomationId="v2-raid-objectives-squad"
                                ToolTip.Tip="Show squadmates' open objectives on this map" />
                  <ToggleButton Classes="v2-target v2-raid-viewcontrol" Content="Route squad"
                                IsVisible="{Binding CanRouteSquadStops}"
                                IsChecked="{Binding RouteSquadStops, Mode=OneWay}"
                                Command="{Binding ToggleRouteSquadStopsCommand}"
                                AutomationProperties.AutomationId="v2-raid-objective-route-squad"
                                ToolTip.Tip="Add squadmates' stops to the objective route" />
                </WrapPanel>
                <TextBlock Classes="v2-label" Text="{Binding SquadObjectiveSummary}"
                           IsVisible="{Binding ShowsSquadObjectiveSummary}" TextWrapping="Wrap" />
  
                <!-- [Issue 379] After "Place on map" the next right-click on bare map is this objective's
                     place, not a ping; this says so and lets the player back out. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPlacingObjective}"
                            AutomationProperties.AutomationId="v2-raid-objective-placing">
                  <TextBlock Classes="v2-label" Text="Right-click the map where it is" VerticalAlignment="Center" />
                  <Button Classes="v2-target v2-raid-viewcontrol" Content="Cancel"
                          Command="{Binding CancelPlacingObjectiveCommand}"
                          AutomationProperties.AutomationId="v2-raid-objective-place-cancel" />
                </StackPanel>
  
                <ContentControl Content="{Binding SelectedObjective}" IsVisible="{Binding HasSelectedObjective}"
                                AutomationProperties.AutomationId="v2-raid-objective-detail">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:RaidObjectiveDetailViewModel">
                      <Border Classes="v2-raid-row v2-raid-offered">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Classes="v2-raid-chip v2-raid-chip-objective" IsVisible="{Binding HasNumber}" VerticalAlignment="Center">
                              <TextBlock Classes="v2-label" Text="{Binding Number}" />
                            </Border>
                            <TextBlock Grid.Column="1" Classes="v2-heading-3" Text="{Binding Task}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="v2-target v2-raid-viewcontrol" Content="Close"
                                    Command="{Binding CloseCommand}"
                                    AutomationProperties.AutomationId="v2-raid-objective-close" />
                          </Grid>
                          <TextBlock Classes="v2-body" Text="{Binding Description}" TextWrapping="Wrap" />
                          <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <Border Classes="v2-raid-chip">
                              <TextBlock Classes="v2-label" Text="{Binding Where}" />
                            </Border>
                            <Border Classes="v2-raid-chip" IsVisible="{Binding HasFloor}">
                              <TextBlock Classes="v2-label" Text="{Binding Floor}" />
                            </Border>
                            <Border Classes="v2-raid-chip">
                              <TextBlock Classes="v2-label" Text="{Binding Status}" />
                            </Border>
                          </WrapPanel>
                          <TextBlock Classes="v2-label" Text="{Binding NoLocationReason}" TextWrapping="Wrap"
                                     IsVisible="{Binding HasNoLocationReason}" />
                          <!-- [Issue 379] The catalog has no place for this one: the player can put it on the
                               map themselves. It is drawn as theirs ("Placed by you"), never as quest data. -->
                          <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding PlaceLabel}"
                                    Command="{Binding PlaceCommand}" IsVisible="{Binding CanPlace}"
                                    AutomationProperties.AutomationId="v2-raid-objective-place" />
                            <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding MoveLabel}"
                                    Command="{Binding PlaceCommand}" IsVisible="{Binding CanMove}"
                                    AutomationProperties.AutomationId="v2-raid-objective-move" />
                            <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding RemoveLabel}"
                                    Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                                    AutomationProperties.AutomationId="v2-raid-objective-remove" />
                            <!-- [Issue 571] "Done" leaves the map and this list at once; "Not done" undoes it. -->
                            <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding DoneLabel}"
                                    Command="{Binding ToggleDoneCommand}" IsVisible="{Binding CanToggleDone}"
                                    AutomationProperties.AutomationId="v2-raid-objective-done" />
                          </WrapPanel>
                          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="v2-label" Text="{Binding}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="v2-label" Text="{Binding FoundInRaid}" IsVisible="{Binding HasFoundInRaid}" />
                          <TextBlock Classes="v2-label" Text="{Binding Remaining}" IsVisible="{Binding HasRemaining}" />
                          <StackPanel Spacing="2" IsVisible="{Binding HasWiki}">
                            <Button Classes="v2-target v2-raid-viewcontrol" Content="{Binding WikiLabel}"
                                    HorizontalAlignment="Left" Command="{Binding OpenWikiCommand}"
                                    AutomationProperties.AutomationId="v2-raid-objective-wiki" />
                            <TextBlock Classes="v2-label" Text="{Binding WikiAttribution}" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
  
                <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                  <!-- Right margin: the scroll bar draws over the content, and it sat on the checks. -->
                  <ItemsControl prim:StagedItems.Source="{Binding QuestObjectives}" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RaidObjectiveRowViewModel">
                        <!-- [Issue 571] "Done" sits beside the row rather than inside its button, so
                             marking one done is its own gesture and never also selects the row. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <Button Classes="v2-raid-rowbutton" Command="{Binding SelectCommand}"
                                  AutomationProperties.AutomationId="v2-raid-objective-row"
                                  AutomationProperties.Name="{Binding Description}"
                                  ToolTip.Tip="{Binding Task}">
                            <!-- [Refs #571] The name gets the row's width and two lines; where it is
                                 sits on its own line under it. Beside a wide "Done" button and the
                                 location on one line, names were cut to "Loc…". -->
                            <Border Classes="v2-raid-row" Classes.v2-raid-offered="{Binding IsSelected}" Padding="8,5">
                              <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
                                <Border Classes="v2-raid-chip v2-raid-chip-objective" IsVisible="{Binding HasNumber}" VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                                  <TextBlock Classes="v2-label" Text="{Binding Number}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                  <TextBlock Classes="v2-body" Text="{Binding Description}"
                                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="v2-label" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Button>
                          <!-- [Refs #571] A 32px check rather than a "Done" button, so the name keeps the width. -->
                          <Button Grid.Column="1" Classes="v2-target v2-icon-btn" Classes.v2-raid-done="{Binding IsDone}"
                                  Command="{Binding ToggleDoneCommand}" IsVisible="{Binding CanToggleDone}"
                                  VerticalAlignment="Center" ToolTip.Tip="{Binding DoneTip}"
                                  AutomationProperties.Name="{Binding DoneTip}"
                                  AutomationProperties.AutomationId="v2-raid-objective-row-done">
                            <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Tick}" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
          </Expander>
          </Border>

          <!-- V2 rough package 20: the accent edge is for a card with something in it. While the
               game-data refresh is failing this one is a single muted line, and it should not be
               the loudest thing in the panel. -->
          <Border Classes="v2-card v2-raid-section" Padding="4"
                  Classes.v2-raid-accent="{Binding HasMapExtracts}"
                  AutomationProperties.AutomationId="v2-raid-extract-options">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Extracts.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Extract options" />
                <TextBlock Classes="v2-label" Text="{Binding ExtractClockSummary}"
                           AutomationProperties.AutomationId="v2-raid-extract-clock"
                           IsVisible="{Binding ExtractClockSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="v2-label" Text="{Binding ExtractsSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Extracts.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-label" Text="No extract data for this map yet."
                           IsVisible="{Binding !HasMapExtracts}" />
                <!-- While a raid is running, the legacy extract matcher's own offered list (with its
                     confidence) comes first. -->
                <ItemsControl ItemsSource="{Binding Extracts}" IsVisible="{Binding HasExtracts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="appVm:ActiveExtractViewModel">
                      <Border Classes="v2-raid-row v2-raid-offered">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Viewbox Width="20" Height="20">
                            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Exit}" />
                          </Viewbox>
                          <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Confidence}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- V2 rough package 30 (acceptance sweep): Customs lists thirty extracts. Drawn in
                     full they pushed Marks and the loot filters past the bottom of a 1080-tall
                     window, so the panel was one endless list instead of the concept's short
                     extract card followed by the rest of the plan. It scrolls within its own card. -->
                <ScrollViewer MaxHeight="330" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl prim:StagedItems.Source="{Binding MapExtracts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RaidExtractRowViewModel">
                      <!-- [Issue 594] Pressing a row selects and centres its own marker on the map —
                           "clicking an extract doesn't tell me what one it is" — and where a route was
                           already planned to it (Issue 286), the same press still draws that route. -->
                      <Button Classes="v2-raid-rowbutton" Command="{Binding SelectCommand}"
                              AutomationProperties.AutomationId="v2-raid-extract-row"
                              AutomationProperties.Name="{Binding Name}"
                              raid:BringIntoViewWhen.Selected="{Binding IsSelected}">
                      <Border Classes="v2-raid-row"
                              Classes.v2-raid-offered="{Binding IsOffered}"
                              Classes.v2-raid-routed="{Binding IsHighlighted}"
                              Classes.v2-raid-not-offered="{Binding IsNotOffered}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                          <Viewbox Width="20" Height="20">
                            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Exit}" />
                          </Viewbox>
                          <!-- The estimate sits under the name, not beside it: beside it, "RUAF Roadblock"
                               read "RUAF R…" at the panel's default width. -->
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="v2-body" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Classes="v2-label" Opacity="0.85" Text="{Binding Estimate}" IsVisible="{Binding HasEstimate}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                      IsVisible="{Binding HasRequirements}" ToolTip.Tip="{Binding RequirementText}">
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding NeedsSwitch}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Gear}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding NeedsKey}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Lock}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding NeedsPayment}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Cart}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding NeedsCoOp}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.People}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding IsOneTime}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Clock}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4,2" IsVisible="{Binding NeedsNoBackpack}">
                              <TextBlock Classes="v2-label" Text="NO BAG" />
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4,2" IsVisible="{Binding NeedsNoArmor}">
                              <TextBlock Classes="v2-label" Text="NO VEST" />
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding NeedsItems}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Box}" /></Viewbox>
                            </Border>
                            <Border Classes="v2-raid-chip" Padding="4" IsVisible="{Binding HasTimedWindow}">
                              <Viewbox Width="13" Height="13"><Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Clock}" /></Viewbox>
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Classes="v2-label" Text="{Binding Detail}" VerticalAlignment="Center" />
                          <Border Grid.Column="4" Classes="v2-raid-chip" Classes.v2-raid-muted="{Binding IsNotOffered}"
                                  IsVisible="{Binding HasOfferLabel}" VerticalAlignment="Center">
                            <TextBlock Classes="v2-label" Text="{Binding OfferLabel}" />
                          </Border>
                        </Grid>
                      </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <TextBlock Classes="v2-label" Text="{Binding ExtractsNotMatched}"
                           IsVisible="{Binding HasExtractsNotMatched}" TextWrapping="Wrap" />
                <TextBlock Classes="v2-label" Text="{Binding Transits}"
                           IsVisible="{Binding HasTransits}" TextWrapping="Wrap" />
              </StackPanel>
          </Expander>
          </Border>

          <!-- [Issue 594] "Clicking an extract or transit doesn't tell me what one it is, either
               in the sidebar or on the map." ContentControl.Content, like the loot card above: its
               ContentTemplate is only ever instantiated once Content is not null, so nothing here
               binds through a null Renderer or a null SelectedObject the way a direct
               "Renderer.SelectedObject.Label" path would (the page gallery fails on any binding
               fault, and a null step in a compiled path logs exactly one). The estimate is read
               outside the template, off MapExtracts, which is this page's own list. -->
          <Panel IsVisible="{Binding HasRenderer}">
          <Panel DataContext="{Binding Renderer}">
          <Border x:DataType="mapVm:MapSceneRendererViewModel" Classes="v2-card v2-raid-section" Padding="4"
                  IsVisible="{Binding HasGenericSelection}"
                  AutomationProperties.AutomationId="v2-raid-extract-selection">
            <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                      IsExpanded="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).Cards.ExtractSelection.IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <ContentControl Content="{Binding SelectedObject}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="mapVm:MapSceneRendererObjectViewModel">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Expander.Header>
              <ContentControl Content="{Binding SelectedObject}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="mapVm:MapSceneRendererObjectViewModel">
                    <StackPanel Spacing="6" IsVisible="{Binding IsExtractOrTransit}">
                      <TextBlock Classes="v2-label" Text="{Binding FactionLabel}" />
                      <!-- ExtractConditions.Describe, already carried on the scene object as Detail:
                           who may take it, whether a switch has to be thrown, what it costs — a
                           sentence per condition the catalog actually states, nothing guessed for
                           the rest. -->
                      <TextBlock Classes="v2-body" Text="{Binding Detail}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasDetail}"
                                 AutomationProperties.AutomationId="v2-raid-extract-selection-detail" />
                      <!-- #MapCard is a plain Border earlier in this same file whose own DataContext
                           is never overridden, so its DataContext is this page's root view model —
                           the estimate is this page's own (MapExtracts' route estimate), not the
                           renderer's, and this template's own DataContext is Renderer.SelectedObject. -->
                      <TextBlock Classes="v2-label" Opacity="0.85"
                                 Text="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).SelectedExtractEstimate}"
                                 IsVisible="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).HasSelectedExtractEstimate}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Expander>
          </Border>
          </Panel>
          </Panel>

          <!-- [Issue 286] The concept's "Lower-contact route" and "Why this route", as one card: the
               two lines the map draws with how long each is, then the reasons, which are the two
               routes' own numbers and nothing else. -->
          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasSuggestedRoute}"
                  AutomationProperties.AutomationId="v2-raid-route">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Route.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Lower-contact route" />
                <TextBlock Classes="v2-label" Text="{Binding RouteTitle}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Route.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="6">
                <StackPanel Spacing="0">
                  <TextBlock Classes="v2-body" Text="{Binding RouteTitle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="v2-label" Opacity="0.8" Text="{Binding RouteStartLabel}" />
                </StackPanel>
                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                  <Line StartPoint="0,8" EndPoint="34,8" Stroke="#FF5CF0FF" StrokeThickness="4" StrokeDashArray="2,1.5" />
                  <TextBlock Grid.Column="1" Classes="v2-label" Text="Suggested · lower contact" />
                  <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding PrimaryRouteEstimate}" />
                </Grid>
                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasAlternativeRoute}">
                  <Line StartPoint="0,8" EndPoint="34,8" Stroke="#FFD7DEE6" StrokeThickness="3" StrokeDashArray="2,1.5" />
                  <TextBlock Grid.Column="1" Classes="v2-label" Text="Direct line · higher contact" />
                  <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding AlternativeRouteEstimate}" />
                </Grid>
                <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="Why this route" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding RouteReasons}" AutomationProperties.AutomationId="v2-raid-route-reasons">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="v2-label" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="v2-label" Opacity="0.75" Text="{Binding RouteCaveat}" TextWrapping="Wrap" />
              </StackPanel>
          </Expander>
          </Border>
          <TextBlock Classes="v2-label" Opacity="0.8" Text="{Binding RouteHint}" TextWrapping="Wrap"
                     IsVisible="{Binding ShowsRouteHint}" AutomationProperties.AutomationId="v2-raid-route-hint" />

          <!-- V2 rough package 20: always present, so "where do I remove this waypoint" has a
               fixed answer. Every row — ours and the group's — carries its own Remove; a
               right-click on the marker itself removes it too. -->
          <Border Classes="v2-card v2-raid-section" Padding="4"
                  AutomationProperties.AutomationId="v2-raid-marks">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Marks.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Marks" />
                <TextBlock Classes="v2-label" Text="{Binding MarksSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Marks.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <!-- #289: the scope a new mark gets. Squad while group sharing is on. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="v2-label" Text="New marks" VerticalAlignment="Center" />
                  <ToggleButton Classes="v2-target" Content="Just me" IsChecked="{Binding NewMarksAreJustMe, Mode=OneWay}"
                                Command="{Binding NewMarksJustMeCommand}"
                                AutomationProperties.AutomationId="v2-raid-new-marks-just-me" />
                  <ToggleButton Classes="v2-target" Content="Squad" IsChecked="{Binding NewMarksAreSquad, Mode=OneWay}"
                                Command="{Binding NewMarksSquadCommand}"
                                AutomationProperties.AutomationId="v2-raid-new-marks-squad" />
                </StackPanel>
                <TextBlock Classes="v2-label" IsVisible="{Binding HasMarkNote}" Text="{Binding MarkNote}"
                           Foreground="{DynamicResource V2.Brush.Warning}"
                           AutomationProperties.AutomationId="v2-raid-mark-note" />
                <TextBlock Classes="v2-label" IsVisible="{Binding !HasMarks}"
                           Text="Right-click: ping. Shift: waypoint. Ctrl: pick a lifetime. Right-click a mark for options." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Marks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RaidMarkRowViewModel">
                      <Border Classes="v2-raid-row">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                            <!-- Issue 508: the same colour family as this mark's pin (a waypoint)
                                 or pulse (a ping) on the map, so the row can be matched to it. -->
                            <Ellipse Classes="v2-raid-mark-dot" Classes.v2-raid-mark-waypoint="{Binding IsWaypoint}"
                                     Classes.v2-raid-mark-ping="{Binding IsPing}"
                                     Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="v2-body" Text="{Binding Label}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="v2-raid-mark-label" />
                            <TextBlock Grid.Column="3" Classes="v2-label" VerticalAlignment="Center"
                                       IsVisible="{Binding HasOwner}" Text="{Binding Owner}" />
                            <Button Grid.Column="4" Classes="v2-target" Content="Remove" Command="{Binding RemoveCommand}"
                                    AutomationProperties.AutomationId="v2-raid-mark-remove" />
                          </Grid>
                          <!-- #289: who sees it and how long it has left, and the menu that changes both. -->
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding CanChangeOptions}">
                            <TextBlock Classes="v2-label" Text="{Binding OptionsLabel}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="v2-raid-mark-options-label" />
                            <Button Grid.Column="1" Classes="v2-target" Content="Options" Click="MarkOptionsClicked"
                                    AutomationProperties.AutomationId="v2-raid-mark-options" />
                          </Grid>
                          <!-- A ping is never named: see RaidMarkRowViewModel.CanRename. -->
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding CanRename}">
                            <TextBox Text="{Binding EditableName}" PlaceholderText="Name (blank = numbered)"
                                     AutomationProperties.AutomationId="v2-raid-mark-rename-input" />
                            <Button Grid.Column="1" Classes="v2-target" Content="Rename" Command="{Binding RenameCommand}"
                                    AutomationProperties.AutomationId="v2-raid-mark-rename" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasMarkList}"
                  AutomationProperties.AutomationId="v2-raid-group-marks">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.GroupMarks.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Group waypoints" />
                <TextBlock Classes="v2-label" Text="{Binding GroupMarksSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.GroupMarks.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                  <Button Classes="v2-target v2-raid-viewcontrol" Content="Clear reached"
                          IsVisible="{Binding HasReachedMarks}" Command="{Binding ClearReachedMarksCommand}"
                          AutomationProperties.AutomationId="v2-raid-clear-reached" />
                  <Button Classes="v2-target v2-raid-viewcontrol" Content="Clear all"
                          Command="{Binding ClearMarksCommand}"
                          AutomationProperties.AutomationId="v2-raid-clear-marks" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding MarkList}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:MarkListItemViewModel">
                      <Border Classes="v2-raid-row">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-body" Text="{Binding Name}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                          <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding Detail}" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="v2-target v2-raid-viewcontrol" Content="Remove"
                                  Command="{Binding $parent[ItemsControl].((vm:RaidCockpitViewModel)DataContext).RemoveMarkCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasQuestPanel}"
                  AutomationProperties.AutomationId="v2-raid-quests">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Tasks.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Tasks on this map" />
                <TextBlock Classes="v2-label" Text="{Binding TasksSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Tasks.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding QuestPanel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:QuestPanelViewModel">
                      <Border Classes="v2-raid-row">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="v2-body" Text="{Binding Task}" TextWrapping="Wrap" />
                          <TextBlock Classes="v2-label" Text="{Binding Objectives}" TextWrapping="Wrap" />
                          <TextBlock Classes="v2-label" Text="{Binding Bring}" TextWrapping="Wrap"
                                     IsVisible="{Binding HasBring}" />
                          <TextBlock Classes="v2-label" Text="{Binding HandIn}" TextWrapping="Wrap"
                                     IsVisible="{Binding HasHandIn}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <!-- [Issue 318] The spawn the player tapped, and the one action that leaves the map: a
               waypoint at it. The renderer selects a spawn either way, but its own details panel is
               hidden on this page, so without this card nothing said what had been selected.
               Shown only with a renderer: with none, the inner card's IsVisible binding has no
               source and falls back to visible, which drew an empty card under Spawn areas. -->
          <Panel IsVisible="{Binding HasRenderer}">
          <Panel DataContext="{Binding Renderer}">
          <Border x:DataType="mapVm:MapSceneRendererViewModel" Classes="v2-card v2-raid-section" Padding="4"
                  IsVisible="{Binding HasLootSelection}"
                  AutomationProperties.AutomationId="v2-raid-loot-selection">
            <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                      IsExpanded="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).Cards.LootSelection.IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <ContentControl Content="{Binding SelectedLootEntry}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="mapVm:HighValueLootEntryViewModel">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Expander.Header>
              <ContentControl Content="{Binding SelectedLootEntry}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="mapVm:HighValueLootEntryViewModel">
                    <StackPanel Spacing="6">
                      <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <TextBlock Classes="v2-label" Text="{Binding TierLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding ValueLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                      </WrapPanel>
                      <TextBlock Classes="v2-body" Text="{Binding PossibleItemsLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProbabilityLabel}" TextWrapping="Wrap" />
                      <Button Classes="v2-target" Content="{Binding MakeWaypointLabel}"
                              Command="{Binding MakeWaypointCommand}" IsVisible="{Binding CanMakeWaypoint}"
                              AutomationProperties.AutomationId="v2-raid-loot-waypoint"
                              AutomationProperties.Name="{Binding MakeWaypointLabel}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Expander>
          </Border>
          </Panel>
          </Panel>

          <Border Classes="v2-card v2-raid-section" Padding="4"
                  AutomationProperties.AutomationId="v2-raid-spawn-areas">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.SpawnAreas.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Spawn areas" />
                <TextBlock Classes="v2-label" Text="{Binding SpawnAreasSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.SpawnAreas.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-label" Text="No spawn areas for this map yet."
                           IsVisible="{Binding !HasSpawnAreas}" />
                <ItemsControl ItemsSource="{Binding SpawnAreas}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="v2-raid-row" Padding="8,3">
                        <TextBlock Classes="v2-label" Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <!-- V2 rough package 22: the panels the V1 map page carried down its side. Same view
               models, same rows; they simply had no home in V2 until now. Each is hidden while
               it has nothing to say rather than printing an empty heading. -->
          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasSpawnPanel}"
                  AutomationProperties.AutomationId="v2-raid-spawns">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.Spawns.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Where the others started" />
                <TextBlock Classes="v2-label" Text="{Binding SpawnsSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.Spawns.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-label" Text="{Binding SpawnPanelDetail}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-raid-spawn-detail"
                           IsVisible="{Binding HasSpawnPanelDetail}" />
                <ItemsControl ItemsSource="{Binding SpawnPanel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:SpawnPanelViewModel">
                      <Border Classes="v2-raid-row">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Classes="v2-body" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding FromStart}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding FromPlayer}" VerticalAlignment="Center"
                                       IsVisible="{Binding HasFromPlayer}" />
                          </Grid>
                          <!-- V2 rough package 39: how long until somebody who started there could
                               be here. A band, never a number — see SpawnReach. -->
                          <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="{Binding Reach}"
                                     IsVisible="{Binding HasReach}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasExtractPanel}"
                  AutomationProperties.AutomationId="v2-raid-extract-distances">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.WaysOut.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Ways out from here" />
                <TextBlock Classes="v2-label" Text="{Binding WaysOutSummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.WaysOut.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding ExtractPanel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:ExtractPanelViewModel">
                      <Border Classes="v2-raid-row" Classes.v2-raid-offered="{Binding IsOffered}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-body" Text="{Binding Name}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                          <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding Where}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Side}" VerticalAlignment="Center"
                                     IsVisible="{Binding HasSide}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <Border Classes="v2-card v2-raid-section" Padding="4" IsVisible="{Binding HasLootPanel}"
                  AutomationProperties.AutomationId="v2-raid-loot-nearby">
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Cards.LootNearby.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Spacing="1">
                <TextBlock Classes="v2-heading-3" Text="Loot near you" />
                <TextBlock Classes="v2-label" Text="{Binding LootNearbySummary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Cards.LootNearby.IsCollapsed}" />
              </StackPanel>
            </Expander.Header>
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding LootPanel}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:LootPanelViewModel">
                      <Border Classes="v2-raid-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-body" Text="{Binding Name}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                          <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding Where}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </Expander>
          </Border>

          <!-- Collapsed: the value-basis/tier/floor loot filter used to be its own always-open
               card in the map renderer's own side panel (now hidden in this embedding). It is a
               refinement on the High-value loot layer, not something every raid needs open. -->
          <Panel IsVisible="{Binding HasRenderer}">
          <Panel DataContext="{Binding Renderer}">
          <Border x:DataType="mapVm:MapSceneRendererViewModel" Classes="v2-card v2-raid-section" Padding="4"
                  IsVisible="{Binding HasHighValueLoot}">
          <!-- [Issue 563] Opens on its own with no data, so "no loot shows up" has a visible
               reason and a Refresh action instead of staying collapsed behind "loot filters". -->
          <!-- Remembered like every other card; RaidCockpitViewModel.WatchLootAvailability still opens
               it (without remembering that) whenever the layer has no data. -->
          <Expander Classes="v2-raid-expander" HorizontalAlignment="Stretch"
                    IsExpanded="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).Cards.LootFilters.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="20" Height="20">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Gem}" />
                </Viewbox>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="v2-heading-3" Text="High-value loot filters" />
                  <TextBlock Classes="v2-label" Text="{Binding HighValueLoot.StateMessage}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding #MapCard.((vm:RaidCockpitViewModel)DataContext).Cards.LootFilters.IsCollapsed}" />
                </StackPanel>
              </StackPanel>
            </Expander.Header>
            <ContentControl Content="{Binding HighValueLoot}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="mapVm:HighValueLootLayerViewModel">
                  <StackPanel Classes="v2-stack">
                    <!-- [Issue 563] Independent of whether the layer switch itself is on: the
                         card opens on IsUnavailable, so its own first line must always match. -->
                    <TextBlock Classes="v2-label" Text="{Binding NoDataMessage}" TextWrapping="Wrap"
                               IsVisible="{Binding IsUnavailable}" />
                    <TextBlock Classes="v2-label" Text="{Binding StateMessage}" TextWrapping="Wrap"
                               IsVisible="{Binding !IsUnavailable}" />
                    <Button Classes="v2-target" Content="Refresh" Command="{Binding RefreshCommand}"
                            IsVisible="{Binding IsUnavailable}"
                            AutomationProperties.AutomationId="v2-raid-loot-refresh"
                            AutomationProperties.Name="Refresh loot spawn data" />
                    <!-- [Issue 318] What this map's loot data covers, and how old it is. The label was
                         computed and bound only in the renderer's own side panel, which this page hides,
                         so a player on the Raid page never saw it. -->
                    <TextBlock Classes="v2-label" Text="{Binding CoverageLabel}" IsVisible="{Binding HasCoverage}"
                               AutomationProperties.AutomationId="v2-raid-loot-coverage" TextWrapping="Wrap" />
                    <TextBlock Classes="v2-label" Text="{Binding FreshnessMessage}" IsVisible="{Binding HasFreshnessMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="v2-label" Text="{Binding ValueThresholdLabel}" />
                    <ItemsControl ItemsSource="{Binding ValueThresholdChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding ValueBasisLabel}" />
                    <ItemsControl ItemsSource="{Binding ValueBasisChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                          <!-- No AutomationId: shared with the renderer's own (hidden) choice
                               list further down the same visual tree. -->
                          <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                    <ItemsControl ItemsSource="{Binding FloorChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Expander>
          </Border>
          </Panel>
          </Panel>

          <!-- #286: side, clock and offered exits, each Automatic or Manual, each with its way back. -->
          <Border Classes="v2-card v2-raid-section" Padding="4">
            <raid:RaidCorrectionsView DataContext="{Binding Corrections}" />
          </Border>
        </prim:StagedStack>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
