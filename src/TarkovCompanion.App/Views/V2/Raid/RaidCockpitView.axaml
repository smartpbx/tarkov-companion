<UserControl x:Class="TarkovCompanion.App.Views.V2.Raid.RaidCockpitView"
             x:DataType="vm:RaidCockpitViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Raid"
             xmlns:appVm="using:TarkovCompanion.App.ViewModels"
             xmlns:mapVm="using:TarkovCompanion.App.ViewModels.V2.MapRenderer"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer">
  <!-- V2 rough package 15: map-first, like docs/design/v2/v2-raid-intelligence-concept.png. The
       map fills the column from the top; ping/waypoint float over its top-left edge instead of
       taking their own row (the shell's top bar now owns the map selector); a compact right
       context panel carries the raid clock, extracts and marks; a bottom strip carries the raid
       timer and the map's layer switches instead of burying them in that renderer's own side
       panel. -->
  <Grid RowDefinitions="*,Auto" Margin="{DynamicResource V2.Space.Sm.Inset}">
    <Grid Grid.Row="0" ColumnDefinitions="*,320" ColumnSpacing="12">
      <Grid Grid.Column="0">
        <!-- IsVisible stays on this wrapper, not on MapSceneRendererView itself: that element's
             own DataContext is overridden to Renderer below, and a binding on the same element
             would resolve against that override instead of this page's view model. -->
        <ContentControl IsVisible="{Binding HasRenderer}">
          <map:MapSceneRendererView DataContext="{Binding Renderer}" PlanClicked="RendererPlanClicked"
                                     MarkerRightClicked="RendererMarkerRightClicked" />
        </ContentControl>
        <Border Classes="v2-card" IsVisible="{Binding !HasRenderer}"
                AutomationProperties.AutomationId="v2-raid-unavailable">
          <TextBlock Classes="v2-body" Text="{Binding UnavailableReason}" TextWrapping="Wrap" />
        </Border>

        <!-- Bottom-left, not top-left: the renderer's own presentation-mode/floor pill floats at
             the map's top-left edge, and stacking both there collided. -->
        <Border Classes="v2-card" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
          <WrapPanel Classes="v2-toolbar" ItemSpacing="8" LineSpacing="8"
                     AutomationProperties.AccessibilityView="Control"
                     AutomationProperties.Name="Raid map controls">
            <Button Classes="v2-target" Content="Ping" Command="{Binding PlacePingCommand}"
                    Classes.selected="{Binding IsPlacingPing}"
                    AutomationProperties.AutomationId="v2-raid-place-ping" />
            <Button Classes="v2-target" Content="Waypoint" Command="{Binding PlaceWaypointCommand}"
                    Classes.selected="{Binding IsPlacingWaypoint}"
                    AutomationProperties.AutomationId="v2-raid-place-waypoint" />
            <Button Classes="v2-target" Content="Cancel" Command="{Binding CancelPlacingCommand}"
                    IsVisible="{Binding IsPlacingMark}"
                    AutomationProperties.AutomationId="v2-raid-cancel-placing" />
            <TextBlock Classes="v2-label" Text="Click the map to place it"
                       IsVisible="{Binding IsPlacingMark}" VerticalAlignment="Center" />
          </WrapPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="v2-stack" Spacing="12">

          <!-- The bottom strip is the one place TimeLeft draws now; repeating it here duplicated
               "Unknown / No raid start observed" in two places at once. -->
          <TextBlock Classes="v2-heading-2" Text="Raid plan" />

          <Border Classes="v2-card" IsVisible="{Binding HasExtracts}">
            <StackPanel Classes="v2-stack">
              <TextBlock Classes="v2-heading-3" Text="Extracts" />
              <ItemsControl ItemsSource="{Binding Extracts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appVm:ActiveExtractViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="v2-body" Text="{Binding Name}" />
                      <TextBlock Classes="v2-label" Text="{Binding Confidence}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="v2-label" Text="{Binding ExtractsNotMatched}"
                         IsVisible="{Binding HasExtractsNotMatched}" TextWrapping="Wrap" />
              <TextBlock Classes="v2-label" Text="{Binding Transits}"
                         IsVisible="{Binding HasTransits}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="v2-card">
            <StackPanel Classes="v2-stack">
              <TextBlock Classes="v2-label" Text="{Binding TrafficLayerNotice}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Collapsed: the value-basis/tier/floor loot filter used to be its own always-open
               card in the map renderer's own side panel (now hidden in this embedding). It is a
               refinement on the High-value loot layer, not something every raid needs open. -->
          <Expander Header="Loot filters" IsExpanded="False" IsVisible="{Binding Renderer.HasHighValueLoot}">
            <ContentControl Content="{Binding Renderer.HighValueLoot}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="mapVm:HighValueLootLayerViewModel">
                  <StackPanel Classes="v2-stack">
                    <TextBlock Classes="v2-label" Text="{Binding StateMessage}" TextWrapping="Wrap" />
                    <TextBlock Classes="v2-label" Text="{Binding ValueBasisLabel}" />
                    <ItemsControl ItemsSource="{Binding ValueBasisChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                          <!-- No AutomationId: shared with the renderer's own (hidden) choice
                               list further down the same visual tree. -->
                          <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                    <ItemsControl ItemsSource="{Binding FloorChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mapVm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-target" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Expander>

          <Border Classes="v2-card" IsVisible="{Binding HasMarks}">
            <StackPanel Classes="v2-stack">
              <TextBlock Classes="v2-heading-3" Text="My marks" />
              <ItemsControl ItemsSource="{Binding Marks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RaidMarkRowViewModel">
                    <StackPanel Classes="v2-stack" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                        <TextBlock Classes="v2-body" Text="{Binding Label}"
                                   AutomationProperties.AutomationId="v2-raid-mark-label" />
                        <Button Classes="v2-target" Content="Remove" Command="{Binding RemoveCommand}"
                                AutomationProperties.AutomationId="v2-raid-mark-remove" />
                      </StackPanel>
                      <!-- A ping is never named: see RaidMarkRowViewModel.CanRename. -->
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanRename}">
                        <TextBox Text="{Binding EditableName}" PlaceholderText="Name (blank = numbered)"
                                 MinWidth="140"
                                 AutomationProperties.AutomationId="v2-raid-mark-rename-input" />
                        <Button Classes="v2-target" Content="Rename" Command="{Binding RenameCommand}"
                                AutomationProperties.AutomationId="v2-raid-mark-rename" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- A bottom strip, like docs/design/v2's map-layers row: the raid timer on the left, the
         map's layer switches on the right, instead of burying either in the renderer's own
         scrolling side panel. -->
    <Border Grid.Row="1" Classes="v2-card" Margin="0,8,0,0" IsVisible="{Binding HasRenderer}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="v2-glyph" Text="◷" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Classes="v2-body" Text="{Binding TimeLeft}" VerticalAlignment="Center" />
          <TextBlock Classes="v2-label" Text="{Binding TimeLeftDetail}" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding Renderer.Layers}"
                      AutomationProperties.AccessibilityView="Control"
                      AutomationProperties.Name="Map layers">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="16" LineSpacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mapVm:MapSceneRendererLayerViewModel">
              <!-- No AutomationProperties.AutomationId here: this switch shares its view model
                   (and so its AutomationId) with the renderer's own Layers list further down the
                   same visual tree, and a duplicate id would make either one ambiguous to UIA. -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="v2-label" Text="{Binding Name}" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsVisible, Mode=OneWay}" OnContent="" OffContent=""
                              AutomationProperties.Name="{Binding ToggleLabel}"
                              AutomationProperties.HelpText="{Binding StateLabel}"
                              Command="{Binding ToggleCommand}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
