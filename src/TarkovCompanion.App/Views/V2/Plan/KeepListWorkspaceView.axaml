<UserControl x:Class="TarkovCompanion.App.Views.V2.Plan.KeepListWorkspaceView"
             x:DataType="vm:KeepListWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Plan"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives">
  <UserControl.Styles>
    <!-- Same visual language as the Hideout tab's card and chip. -->
    <Style Selector="Border.v2-keep-card">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
    </Style>
    <Style Selector="Border.v2-keep-row">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.v2-keep-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.v2-keep-chip.v2-keep-high-value">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Border.v2-keep-chip.v2-keep-high-value TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 25 (#402): items worth keeping, computed from synced quest/hideout
       requirements, key market prices, and value-per-slot tiers — no editorial list. -->
  <Border Classes="v2-keep-card" Margin="16,8,16,16">
    <Grid RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Spacing="2" Margin="16,12,8,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="v2-heading-2" Text="{x:Static l:PlanText.KeepListTitle}" AutomationProperties.HeadingLevel="2"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="v2-target v2-icon-btn" Background="Transparent" BorderThickness="0"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="v2-keep-refresh" AutomationProperties.Name="{x:Static l:PlanText.KeepRefresh}"
                  ToolTip.Tip="{x:Static l:PlanText.KeepRefresh}" Command="{Binding RefreshCommand}">
            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Refresh}" />
          </Button>
        </Grid>
        <TextBlock Classes="v2-label" Text="{Binding Status}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="v2-keep-status"
                   AutomationProperties.LiveSetting="Polite" />
        <prim:V2LoadFaultNotice DataContext="{Binding LoadFault}" Margin="0,8,8,0" />
      </StackPanel>

      <Panel Grid.Row="1">
        <TextBlock IsVisible="{Binding !HasGroups}" Classes="v2-body" Opacity="0.8"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420"
                   Text="{x:Static l:PlanText.KeepEmpty}" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGroups}">
          <!-- One flat, virtualised list: a heading, its rows, the next heading. See Rows. -->
          <ItemsControl ItemsSource="{Binding Rows}" Margin="16,0,16,12"
                        AutomationProperties.AutomationId="v2-keep-rows">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate x:DataType="vm:KeepListGroupViewModel">
                <TextBlock Classes="v2-heading-3" Text="{Binding Heading}" Margin="0,10,0,8"
                           AutomationProperties.HeadingLevel="2" />
              </DataTemplate>
              <DataTemplate x:DataType="vm:KeepListRowViewModel">
                        <Border Classes="v2-keep-row" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Classes="v2-keep-chip" IsVisible="{Binding HasRecommendation}"
                                        AutomationProperties.AutomationId="v2-keep-recommendation">
                                  <TextBlock Classes="v2-label" Text="{Binding RecommendationVerdict}" />
                                </Border>
                              </Grid>
                              <TextBlock Classes="v2-label" Text="{Binding ReasonSummary}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource V2.Brush.TextSecondary}" />
                              <TextBlock Classes="v2-label" Text="{Binding LearnReason}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource V2.Brush.Action}"
                                         IsVisible="{Binding $parent[UserControl].((vm:KeepListWorkspaceViewModel)DataContext).LearnMode.IsEnabled}" />
                              <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasCounts}" Margin="0,2,0,0">
                                <Border Classes="v2-keep-chip" Margin="0,0,6,0" IsVisible="{Binding HasQuestCount}"
                                        AutomationProperties.AutomationId="v2-keep-quest-count">
                                  <TextBlock Classes="v2-label" Text="{Binding QuestCountLabel}" />
                                </Border>
                                <Border Classes="v2-keep-chip" Margin="0,0,6,0" IsVisible="{Binding HasHideoutCount}"
                                        AutomationProperties.AutomationId="v2-keep-hideout-count">
                                  <TextBlock Classes="v2-label" Text="{Binding HideoutCountLabel}" />
                                </Border>
                                <Border Classes="v2-keep-chip" AutomationProperties.AutomationId="v2-keep-held">
                                  <TextBlock Classes="v2-label" Text="{Binding HeldLabel}" />
                                </Border>
                              </WrapPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="v2-keep-chip" Classes.v2-keep-high-value="{Binding IsHighValue}"
                                    VerticalAlignment="Center" IsVisible="{Binding IsHighValue}">
                              <TextBlock Classes="v2-label" Text="{Binding Tier}" />
                            </Border>
                          </Grid>
                        </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Grid>
  </Border>
</UserControl>
