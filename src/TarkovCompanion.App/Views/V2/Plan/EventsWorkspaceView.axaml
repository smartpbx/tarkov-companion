<UserControl x:Class="TarkovCompanion.App.Views.V2.Plan.EventsWorkspaceView"
             x:DataType="pages:EventsPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:TarkovCompanion.App.ViewModels"
             xmlns:l="using:TarkovCompanion.App.Localization">
  <UserControl.Styles>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
  </UserControl.Styles>

  <!-- V1's Events page in the workspace layout: create an event across the top, the events on the
       left, and the chosen event's items on the right with what has been recorded about each.
       An empty catalog is the ordinary out-of-season state, so it says so rather than showing an error. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="16,4,16,16">
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="6">
      <Border Grid.Row="0" Classes="v2-intel-search" IsVisible="{Binding CanEdit}" Width="640" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Classes="v2-intel-search-input" Text="{Binding NewEventName}"
                   PlaceholderText="{x:Static l:PlanText.EventsNewEventName}"
                   AutomationProperties.AutomationId="v2-events-new-name"
                   AutomationProperties.Name="{x:Static l:PlanText.EventsNewEventName}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="v2-target v2-outline" Content="{x:Static l:PlanText.EventsCreate}" Command="{Binding CreateCommand}"
                  VerticalAlignment="Center" AutomationProperties.AutomationId="v2-events-create" />
          <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain"
                  AutomationProperties.AutomationId="v2-events-reload"
                  AutomationProperties.Name="{x:Static l:PlanText.EventsReloadEvents}" ToolTip.Tip="{x:Static l:PlanText.EventsReload}"
                  Command="{Binding RefreshCommand}">
            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Refresh}" />
          </Button>
        </Grid>
      </Border>
      <TextBlock Grid.Row="1" Classes="v2-label" Text="{Binding Status}" TextWrapping="Wrap" Margin="4,0"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <!-- Nothing configured. -->
    <Border Grid.Row="1" Classes="v2-intel-pane" Padding="24" IsVisible="{Binding HasNoEvents}"
            VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Classes="v2-heading-3" Text="{x:Static l:PlanText.EventsNoEventConfigured}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="v2-body" Text="{Binding EmptyGuidance}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-label" Text="{Binding DefinitionsDirectory}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="0.3*,*" ColumnSpacing="16" IsVisible="{Binding HasEvents}">
      <Border Grid.Column="0" Classes="v2-intel-pane" Padding="14"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-events-list">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pages:EventSummaryViewModel">
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="v2-label" Text="{Binding Season}" TextWrapping="Wrap"
                             Foreground="{DynamicResource V2.Brush.Warning}" />
                  <TextBlock Classes="v2-label" Text="{Binding Window}" TextWrapping="Wrap" />
                  <TextBlock Classes="v2-label" Text="{Binding ItemSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Classes="v2-intel-pane" Padding="18,14"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-events-detail">
        <!-- #288: the event itself on the left (name, days, typed effects, history) and the items it
             applies to on the right. Two columns because the effect rows and the item list both
             grow, and stacked they squeezed the item list to nothing at 1080p.
             [#832] On a narrow page (200% on 1080p) each half was about 310 and every picker was cut
             to its first letter, so there they do stack, and the pane scrolls as one instead of
             squeezing either; EventsWorkspaceView switches it, PageFit.EventsStacked decides. -->
        <ScrollViewer x:Name="EventsDetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="EventsDetail" ColumnDefinitions="*,*" ColumnSpacing="18" RowSpacing="18">
          <ScrollViewer x:Name="EventsEditor" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRuleInformation}">
            <ScrollViewer.KeyBindings>
              <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveScheduleCommand}" />
            </ScrollViewer.KeyBindings>
            <StackPanel Spacing="10" Margin="0,0,6,0">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="v2-heading-2" Text="{x:Static l:PlanText.EventsEvent}" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="v2-target v2-plain" Content="{x:Static l:PlanText.EventsDuplicate}" Command="{Binding DuplicateCommand}"
                        IsVisible="{Binding CanEdit}" AutomationProperties.AutomationId="v2-events-duplicate"
                        ToolTip.Tip="{x:Static l:PlanText.EventsDuplicateTip}" />
                <Button Grid.Column="2" Classes="v2-target v2-outline" Command="{Binding DeleteCommand}"
                        Content="{Binding DeleteLabel}" IsVisible="{Binding CanEdit}"
                        AutomationProperties.AutomationId="v2-events-delete" />
              </Grid>

              <!-- [V2 rough package 60 — Plan] #288. Archive switches an event off and keeps it,
                   along with everything recorded against it; only Delete removes a definition. -->
              <StackPanel Spacing="8" IsVisible="{Binding CanEditSchedule}">
                <TextBox Classes="v2-field-input" Text="{Binding RenameTo}"
                         PlaceholderText="{x:Static l:PlanText.EventsEventName}"
                         AutomationProperties.AutomationId="v2-events-rename"
                         AutomationProperties.Name="{x:Static l:PlanText.EventsEventName}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <TextBox Classes="v2-field-input" Text="{Binding ScheduleStart}"
                           PlaceholderText="{x:Static l:PlanText.EventsFirstDayOrBlank}"
                           AutomationProperties.AutomationId="v2-events-start"
                           AutomationProperties.Name="{x:Static l:PlanText.EventsFirstDayOfEvent}" />
                  <TextBox Grid.Column="1" Classes="v2-field-input" Text="{Binding ScheduleEnd}"
                           PlaceholderText="{x:Static l:PlanText.EventsLastDayOrBlank}"
                           AutomationProperties.AutomationId="v2-events-end"
                           AutomationProperties.Name="{x:Static l:PlanText.EventsLastDayOfEvent}" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding SchedulePreview}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-events-schedule-preview"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>

              <TextBlock Classes="v2-heading-3" Text="{x:Static l:PlanText.EventsEffects}" AutomationProperties.HeadingLevel="3" />
              <ItemsControl ItemsSource="{Binding RuleEditor.Rows}" IsVisible="{Binding CanEditSchedule}"
                            AutomationProperties.AutomationId="v2-events-effects">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:EventEffectRowViewModel">
                    <Border Classes="v2-intel-fact" Padding="0,6">
                      <Grid ColumnDefinitions="112,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                    IsVisible="{Binding UsesPicker}" HorizontalAlignment="Stretch"
                                    PlaceholderText="{Binding TargetPlaceholder}"
                                    AutomationProperties.Name="{Binding RowName}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="pages:EventTargetChoice">
                                <TextBlock Text="{Binding Name}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBox Classes="v2-field-input" Text="{Binding TargetText}" IsVisible="{Binding UsesTargetText}"
                                   PlaceholderText="{Binding TargetPlaceholder}"
                                   AutomationProperties.Name="{Binding RowName}" />
                          <TextBlock Classes="v2-label" Text="{Binding UnknownText}" IsVisible="{Binding IsUnknown}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                          <TextBox Classes="v2-field-input" Width="76" Text="{Binding Multiplier}" IsVisible="{Binding HasMultiplier}"
                                   PlaceholderText="{x:Static l:PlanText.EventsMultiplierPlaceholder}" ToolTip.Tip="{x:Static l:PlanText.EventsMultiplier}"
                                   AutomationProperties.Name="{x:Static l:PlanText.EventsMultiplier}" />
                          <CheckBox Content="{x:Static l:PlanText.EventsOpen}" IsChecked="{Binding IsOpen, Mode=TwoWay}" IsVisible="{Binding HasOpenToggle}"
                                    AutomationProperties.Name="{x:Static l:PlanText.EventsOpenWhileActive}" />
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasWindow}">
                            <TextBox Classes="v2-field-input" Width="112" Text="{Binding StartText}" PlaceholderText="{x:Static l:PlanText.EventsFirstDay}"
                                     AutomationProperties.Name="{x:Static l:PlanText.EventsQuestFirstDay}" />
                            <TextBox Classes="v2-field-input" Width="112" Text="{Binding EndText}" PlaceholderText="{x:Static l:PlanText.EventsLastDay}"
                                     AutomationProperties.Name="{x:Static l:PlanText.EventsQuestLastDay}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="v2-target v2-icon-btn v2-intel-plain" VerticalAlignment="Center"
                                Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static l:PlanText.EventsRemoveEffect}"
                                AutomationProperties.Name="{x:Static l:PlanText.EventsRemoveEffect}">
                          <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Close}" />
                        </Button>
                        <!-- Errors sit under the field they name, on their own line, so the inputs stay aligned. -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                          <TextBlock Classes="v2-label" Text="{Binding TargetError}" IsVisible="{Binding HasTargetError}"
                                     Foreground="{DynamicResource V2.Brush.Warning}" />
                          <TextBlock Classes="v2-label" Text="{Binding RowError}" IsVisible="{Binding HasRowError}"
                                     TextWrapping="Wrap" Foreground="{DynamicResource V2.Brush.Warning}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="v2-label" Text="{Binding ValueError}"
                                   IsVisible="{Binding HasValueError}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource V2.Brush.Warning}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding CanEditSchedule}">
                <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAddTraderPrice}" Command="{Binding RuleEditor.AddTraderCommand}"
                        AutomationProperties.AutomationId="v2-events-add-trader" />
                <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAddFlea}" Command="{Binding RuleEditor.AddFleaCommand}"
                        AutomationProperties.AutomationId="v2-events-add-flea" />
                <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAddMap}" Command="{Binding RuleEditor.AddMapCommand}"
                        AutomationProperties.AutomationId="v2-events-add-map" />
                <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAddBossSpawns}" Command="{Binding RuleEditor.AddBossCommand}"
                        AutomationProperties.AutomationId="v2-events-add-boss" />
                <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAddQuestWindow}" Command="{Binding RuleEditor.AddQuestCommand}"
                        AutomationProperties.AutomationId="v2-events-add-quest" />
              </WrapPanel>

              <Border Classes="v2-intel-section" AutomationProperties.AutomationId="v2-events-rule-preview">
                <StackPanel Spacing="4">
                  <TextBlock Classes="v2-body" Text="{Binding RuleEditor.Preview}" TextWrapping="Wrap"
                             IsVisible="{Binding RuleEditor.IsValid}"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Classes="v2-label" Text="{Binding RuleEditor.Status}" TextWrapping="Wrap"
                             IsVisible="{Binding RuleEditor.IsValid}"
                             AutomationProperties.AutomationId="v2-events-rule-status" />
                  <TextBlock Classes="v2-label" Text="{Binding RuleEditor.Status}" TextWrapping="Wrap"
                             IsVisible="{Binding !RuleEditor.IsValid}"
                             Foreground="{DynamicResource V2.Brush.Warning}"
                             AutomationProperties.AutomationId="v2-events-rule-error"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Classes="v2-label" Text="{Binding RuleEditor.GeneralError}" TextWrapping="Wrap"
                             IsVisible="{Binding RuleEditor.HasGeneralError}"
                             Foreground="{DynamicResource V2.Brush.Warning}" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="6" IsVisible="{Binding CanEditSchedule}">
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                  <Button Classes="v2-target v2-outline" Content="{x:Static l:PlanText.EventsSaveEvent}"
                          ToolTip.Tip="{x:Static l:PlanText.EventsSaveEventTip}"
                          AutomationProperties.AutomationId="v2-events-save-schedule"
                          Command="{Binding SaveScheduleCommand}" />
                  <Button Classes="v2-target v2-plain" Content="{Binding ArchiveLabel}"
                          AutomationProperties.AutomationId="v2-events-archive"
                          Command="{Binding ToggleArchivedCommand}" />
                </WrapPanel>
                <TextBlock Classes="v2-label" Text="{Binding ScheduleStatus}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Classes="v2-label" Text="{Binding History}"
                           Foreground="{DynamicResource V2.Brush.TextSecondary}"
                           AutomationProperties.AutomationId="v2-events-history" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid x:Name="EventsItems" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" Classes="v2-heading-2" Text="{x:Static l:PlanText.EventsApplicableItemsHeading}" AutomationProperties.HeadingLevel="2" />
            <StackPanel Grid.Row="1" Spacing="4">
              <TextBlock Classes="v2-body" Text="{Binding Detail}" TextWrapping="Wrap"
                         Foreground="{DynamicResource V2.Brush.TextSecondary}" />
              <!-- #285: one press takes back the last state recorded here. -->
              <Button Classes="v2-target v2-outline" HorizontalAlignment="Left" Command="{Binding UndoCommand}"
                      Content="{Binding UndoLabel}" IsVisible="{Binding CanUndo}"
                      AutomationProperties.AutomationId="v2-events-undo" />
            </StackPanel>
            <TextBlock Grid.Row="2" Classes="v2-heading-3" Text="{Binding Progress}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="v2-label" Text="{Binding StateGuidance}" TextWrapping="Wrap" />

            <!-- A definition names items by id and nobody knows them by id, so they are chosen from the catalog. -->
            <StackPanel Grid.Row="4" Spacing="6" IsVisible="{Binding CanEdit}">
              <Border Classes="v2-intel-search">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="v2-intel-search-input" Text="{Binding ItemQuery}"
                           PlaceholderText="{x:Static l:PlanText.EventsFindItemToAdd}"
                           AutomationProperties.AutomationId="v2-events-item-search"
                           AutomationProperties.Name="{x:Static l:PlanText.EventsFindItemToAdd}">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Classes="v2-target v2-icon-btn v2-intel-plain"
                          AutomationProperties.Name="{x:Static l:PlanText.EventsSearch}" ToolTip.Tip="{x:Static l:PlanText.EventsSearch}" Command="{Binding SearchCommand}">
                    <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Search}" />
                  </Button>
                </Grid>
              </Border>
              <TextBlock Classes="v2-label" Text="{Binding SearchStatus}" TextWrapping="Wrap" />
              <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Matches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:EventItemMatchViewModel">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3">
                        <TextBlock Classes="v2-body" Text="{Binding ItemName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="v2-target v2-outline" Content="{x:Static l:PlanText.EventsAdd}" Command="{Binding AddCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>

            <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:EventItemViewModel">
                    <Border Classes="v2-intel-fact" Padding="0,10">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding ItemName}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Classes="v2-label" Text="{x:Static l:PlanText.EventsRecorded}" />
                          <TextBlock Classes="v2-body" Text="{Binding StateLabel}" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" ItemSpacing="6" LineSpacing="6">
                          <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsSafe}" Command="{Binding MarkSafeCommand}" IsEnabled="{Binding CanRecord}" />
                          <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsAllergic}" Command="{Binding MarkAllergicCommand}" IsEnabled="{Binding CanRecord}" />
                          <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsUntested}" Command="{Binding MarkUntestedCommand}" IsEnabled="{Binding CanRecord}" />
                          <Button Classes="v2-target v2-chip" Content="{x:Static l:PlanText.EventsUnknown}" Command="{Binding MarkUnknownCommand}" IsEnabled="{Binding CanRecord}" />
                          <Button Classes="v2-target v2-plain" Content="{x:Static l:PlanText.EventsRemove}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" />
                        </WrapPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
