<UserControl x:Class="TarkovCompanion.App.Views.V2.Plan.PlanWorkspaceView"
             x:DataType="vm:PlanWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Plan"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives"
             xmlns:l="using:TarkovCompanion.App.Localization">
  <UserControl.Styles>
    <!-- A class-selected style outranks a Foreground set inside a data template, so the warning
         colour is a class of its own rather than an attribute on the text. -->
    <Style Selector="TextBlock.v2-label.v2-warning-text">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
    <!-- A bundle card in the left column: flat surface, cyan outline only while selected. -->
    <Style Selector="Button.v2-plan-bundle">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.v2-plan-bundle.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="Border.v2-plan-tile">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <!-- Flat text actions on an objective row; the row, not a wall of boxes, is the unit. -->
    <Style Selector="Button.v2-plan-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.v2-plan-link.v2-plan-link-action">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <!-- The map card, like the Raid workspace's: canvas behind the artwork, clipped corners. -->
    <Style Selector="Border.v2-plan-mapcard">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.v2-plan-section">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Density.Standard.Inset}" />
    </Style>
    <Style Selector="Border.v2-plan-section.v2-plan-accent">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Border.v2-plan-panel">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.v2-plan-step-row">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.v2-plan-step-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
    <Style Selector="Border.v2-plan-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,1" />
      <!-- A chip beside the taller Wiki link was stretched to the row and read as a tall box
           with its word stuck to the top. -->
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Fluent's Expander header is a black 48-high slab; here it sits under the trader picker
         and is drawn as the same kind of field. -->
    <Style Selector="Border.v2-plan-disclosure">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <Style Selector="Border.v2-plan-disclosure Expander">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- The level and loyalty numbers: text centred in the field, one row height for all of them. -->
    <Style Selector="Border.v2-plan-disclosure NumericUpDown">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.v2-plan-disclosure Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- The primary action, the one filled cyan control on the page, like the concept's "Open in Raid". -->
    <Style Selector="Button.v2-plan-primary">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Height" Value="{DynamicResource V2.Control.Large.Height}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource V2.Type.Body.Size}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.v2-plan-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Focus}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Button.v2-plan-primary Path.v2-icon">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="ToggleSwitch.v2-plan-switch">
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 17: laid out like docs/design/v2/v2-plan-workspace-concept.png. Left, the
       "next raid" column of map bundles (one per map with active objectives) plus the Hideout card;
       centre, that map drawn by the V2 renderer with only its active objectives, numbered; right,
       the numbered objectives list and the one primary action, Open in Raid. The concept's traffic,
       route, requirements, loadout readiness and route estimate have no data source yet, so they
       are not drawn. -->
  <!-- V2 rough package 32: the objectives panel is placed by MapPanelLayout, which takes whichever
       arrangement draws more map. Beside at the concepts' proportions and on a wide window; under
       the map at 1920x1080, where a 340px list and a 440px panel leave the map an almost square
       card and a plan that is nearly twice as wide as it is tall spends half of it on nothing. -->
  <Grid x:Name="PlanBody" ColumnDefinitions="340,*,Auto" RowDefinitions="*,Auto">
    <!-- Left column -->
    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
            BorderBrush="{DynamicResource V2.Brush.Divider}" BorderThickness="0,0,1,0">
      <Grid>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="16,8,16,16">
            <!-- [#314] The actions drop under the heading when both do not fit on one line: in a
                 longer language "Next raid" wrapped a word a line beside them. -->
            <prim:V2FitRow Spacing="4">
              <TextBlock Classes="v2-heading-2" Text="{x:Static l:PlanText.NextRaid}" AutomationProperties.HeadingLevel="2"
                         VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <ToggleButton Classes="v2-target v2-intel-chip v2-intel-chip-small"
                            Content="{x:Static l:PlanText.Learn}" IsChecked="{Binding LearnMode.IsEnabled}"
                            AutomationProperties.AutomationId="v2-plan-learn-mode"
                            AutomationProperties.Name="{x:Static l:PlanText.LearnMode}" />
              <!-- [V2 rough package 61 — plan export] #288/#315: the plan as text, on the
                   clipboard and in a file. Beside Refresh because both act on the whole board. -->
              <Button Classes="v2-target v2-plan-link" VerticalAlignment="Center"
                      Padding="8,2" Content="{x:Static l:PlanText.Export}"
                      AutomationProperties.AutomationId="v2-plan-export"
                      AutomationProperties.Name="{x:Static l:PlanText.ExportName}"
                      ToolTip.Tip="{x:Static l:PlanText.ExportTip}" Command="{Binding ExportCommand}" />
              <Button Classes="v2-target v2-icon-btn v2-plan-link" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="v2-plan-refresh" AutomationProperties.Name="{x:Static l:PlanText.Refresh}"
                      ToolTip.Tip="{x:Static l:PlanText.Refresh}" Command="{Binding RefreshCommand}">
                <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Refresh}" />
              </Button>
              </StackPanel>
            </prim:V2FitRow>
            <prim:V2LoadFaultNotice DataContext="{Binding LoadFault}" />
            <StackPanel Spacing="2">
              <TextBlock Classes="v2-body" Text="{Binding Status}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="v2-plan-status"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Classes="v2-label" Text="{Binding ScopeLabel}" />
              <TextBlock Classes="v2-label" Text="{Binding EventRuleSummary}"
                         IsVisible="{Binding HasEventRuleSummary}" TextWrapping="Wrap"
                         Foreground="{DynamicResource V2.Brush.Warning}"
                         AutomationProperties.AutomationId="v2-plan-event-rules" />
              <!-- #288: the map where one raid moves the most quests. Pressing it selects that map. -->
              <Button Classes="v2-target v2-plan-link v2-plan-link-action" Padding="0" HorizontalAlignment="Left"
                      Content="{Binding SuggestedRaidLabel}" Command="{Binding SelectSuggestedRaidCommand}"
                      IsVisible="{Binding HasSuggestedRaid}"
                      AutomationProperties.AutomationId="v2-plan-suggested-raid-select" />
              <TextBlock Classes="v2-label" Text="{Binding ExportStatus}" IsVisible="{Binding HasExportStatus}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="v2-plan-export-status"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Classes="v2-label" Text="{Binding RequirementsRollup}" IsVisible="{Binding HasRequirementsRollup}"
                         Foreground="{DynamicResource V2.Brush.Warning}"
                         AutomationProperties.AutomationId="v2-plan-rollup" />
              <!-- What the game's logs have said about quests this session. Present even when the
                   answer is "nothing yet": a board that had learned nothing used to look exactly
                   like a board with nothing to learn. -->
              <TextBlock Classes="v2-label" Text="{Binding GameLogStatus}" IsVisible="{Binding HasGameLogStatus}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="v2-plan-game-log"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Which quests to plan around: search, a state chip, and a trader. -->
            <Border Classes="v2-intel-search">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
                      Data="{DynamicResource V2.Icon.Search}" />
                <!-- [#314] One line in a 340 column: a longer placeholder ends in an ellipsis rather
                     than mid-letter, and the whole of it is on hover. Wrapping it drew the second
                     line over the box's border, since the box does not grow for its placeholder. -->
                <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchText}"
                         ToolTip.Tip="{x:Static l:PlanText.SearchPlaceholder}"
                         PlaceholderText="{x:Static l:PlanText.SearchPlaceholder}"
                         AutomationProperties.AutomationId="v2-plan-search"
                         AutomationProperties.Name="{x:Static l:PlanText.SearchQuests}">
                  <TextBox.Styles>
                    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                  </TextBox.Styles>
                </TextBox>
                <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain" IsVisible="{Binding HasSearchText}"
                        AutomationProperties.AutomationId="v2-plan-search-clear"
                        AutomationProperties.Name="{x:Static l:PlanText.ClearSearch}" ToolTip.Tip="{x:Static l:PlanText.ClearSearch}"
                        Command="{Binding ClearSearchCommand}">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                </Button>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding FilterChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanFilterChipViewModel">
                  <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Label}"
                          Content="{Binding Label}" Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Traders}" SelectedItem="{Binding SelectedTrader}"
                      AutomationProperties.AutomationId="v2-plan-trader"
                      AutomationProperties.Name="{x:Static l:PlanText.Trader}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanTraderOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- The level is typed here because the game never writes its own player's down, and
                 every level-gated quest is measured against it. Loyalty is set once a wipe. -->
            <Border Classes="v2-plan-disclosure">
            <Expander Classes="v2-why" Header="{x:Static l:PlanText.LevelAndLoyalty}">
              <Expander.Resources>
                <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
              </Expander.Resources>
              <StackPanel Spacing="8" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="v2-body" Text="{x:Static l:PlanText.YourLevel}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Width="104" FormatString="0" Increment="1" Minimum="1" Maximum="79"
                                 Value="{Binding PlayerLevel, Mode=OneWay}" ValueChanged="LevelChanged"
                                 AutomationProperties.AutomationId="v2-plan-level"
                                 AutomationProperties.Name="{x:Static l:PlanText.YourLevel}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TraderLoyalty}" IsVisible="{Binding HasTraderLoyalty}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanTraderLoyaltyViewModel">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3">
                        <TextBlock Classes="v2-label" Text="{Binding Name}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Width="104" FormatString="0" Increment="1" Minimum="0" Maximum="4"
                                       Value="{Binding Level, Mode=OneWay}" ValueChanged="TraderLevelChanged"
                                       Tag="{Binding TraderId}"
                                       AutomationProperties.Name="{Binding Name}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
            </Border>

            <Rectangle Height="1" Fill="{DynamicResource V2.Brush.Divider}" Margin="0,4" />
            <TextBlock Classes="v2-heading-3" Text="{x:Static l:PlanText.ByMap}" AutomationProperties.HeadingLevel="2"
                       IsVisible="{Binding HasGroups}" />
            <ItemsControl ItemsSource="{Binding VisibleGroups}" IsVisible="{Binding HasGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanMapGroupViewModel">
                  <Button Classes="v2-target v2-plan-bundle" Classes.selected="{Binding IsSelected}"
                          Command="{Binding SelectCommand}"
                          AutomationProperties.Name="{Binding MapLabel}"
                          AutomationProperties.ItemStatus="{Binding Summary}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding MapLabel}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding Summary}" />
                        <TextBlock Classes="v2-label" Text="{Binding AvailabilityLabel}"
                                   IsVisible="{Binding HasAvailabilityLabel}"
                                   Foreground="{DynamicResource V2.Brush.Warning}" />
                        <!-- #288: the map where one raid moves the most quests along. -->
                        <TextBlock Classes="v2-label" Text="{x:Static l:PlanText.SuggestedNextRaid}" IsVisible="{Binding IsSuggested}"
                                   Foreground="{DynamicResource V2.Brush.Action}"
                                   AutomationProperties.AutomationId="v2-plan-suggested-raid" />
                      </StackPanel>
                      <Path Grid.Column="1" Classes="v2-icon v2-icon-muted" Classes.v2-icon-action="{Binding IsSelected}"
                            Data="{DynamicResource V2.Icon.ChevronRight}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="v2-target v2-plan-link v2-plan-link-action" HorizontalAlignment="Left"
                    Content="{Binding MoreGroupsLabel}" Command="{Binding ShowMoreGroupsCommand}"
                    IsVisible="{Binding HasMoreGroups}"
                    AutomationProperties.AutomationId="v2-plan-maps-show-all" />

            <Button Classes="v2-target v2-plan-bundle" Command="{Binding OpenHideoutCommand}"
                    AutomationProperties.AutomationId="v2-plan-open-hideout"
                    AutomationProperties.Name="{x:Static l:PlanText.CardHideout}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="v2-plan-tile">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.House}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{x:Static l:PlanText.CardHideout}" />
                  <TextBlock Classes="v2-label" Text="{x:Static l:PlanText.CardHideoutDetail}" />
                </StackPanel>
                <Path Grid.Column="2" Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.ChevronRight}"
                      VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Centre: the selected map with its active objectives, numbered like the list. -->
    <Border x:Name="PlanMapCard" Grid.Column="1" Grid.Row="0" Classes="v2-plan-mapcard" Margin="16,8,16,16">
      <Grid>
        <TextBlock Classes="v2-body" IsVisible="{Binding ShowsNothingPlanned}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Opacity="0.8"
                   Text="{x:Static l:PlanText.NothingPlanned}" />
        <TextBlock Classes="v2-body" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                   IsVisible="{Binding MapNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding MapNote}" />
        <!-- IsVisible stays on this wrapper, not on MapSceneRendererView itself, whose own
             DataContext is overridden to MapPreview (same as the Raid workspace). -->
        <ContentControl IsVisible="{Binding HasMapPreview}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="v2-plan-map">
          <map:MapSceneRendererView DataContext="{Binding MapPreview}" />
        </ContentControl>
      </Grid>
    </Border>

    <!-- The selected map's context panel, its objectives list, and Open in Raid. Its column, row
         and width are set by the code-behind; see PlanWorkspaceView.axaml.cs. -->
    <Border x:Name="PlanPanel" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Width="440" Classes="v2-plan-panel">
      <Panel>
        <TextBlock Classes="v2-label" Margin="16" IsVisible="{Binding !HasPresentedSelectedGroup}" TextWrapping="Wrap"
                   Text="{x:Static l:PlanText.PickAMap}" />
        <!-- IsVisible on this wrapper, DataContext on the grid inside: one element carrying both
             would resolve IsVisible against SelectedGroup. -->
        <Panel IsVisible="{Binding HasPresentedSelectedGroup}">
        <!-- Two columns, of which the panel beside the map uses one. Under the map the code-behind
             moves Requirements and Open in Raid into the second, so the objectives keep the
             panel's whole height instead of the sliver left over after the other two. -->
        <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*,Auto" DataContext="{Binding PresentedSelectedGroup}">
          <StackPanel x:Name="PlanPanelHeading" Grid.Row="0" Grid.ColumnSpan="2" x:DataType="vm:PlanMapGroupViewModel" Spacing="2" Margin="16,12,16,12">
            <TextBlock Classes="v2-heading-2" Text="{Binding MapLabel}" AutomationProperties.HeadingLevel="2"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="v2-label" Text="{Binding Summary}" />
          </StackPanel>
          <Border x:Name="PlanObjectivesCard" Grid.Row="1" Grid.ColumnSpan="2" x:DataType="vm:PlanMapGroupViewModel" Classes="v2-plan-section v2-plan-accent"
                  Margin="16,0,16,12" Padding="12,12,8,8">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Margin="4,0,0,8" Spacing="2">
                <TextBlock Classes="v2-heading-3" Text="{Binding ObjectivesHeading}" />
                <TextBlock Classes="v2-label" Text="{Binding RouteSummary}" IsVisible="{Binding HasRoute}"
                           Foreground="{DynamicResource V2.Brush.Action}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-plan-objective-route-summary" />
                <TextBlock Classes="v2-label" Text="{Binding RouteCaveat}" IsVisible="{Binding HasRoute}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="v2-label" Text="{Binding RouteHint}" IsVisible="{Binding HasRouteHint}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding VisibleObjectives}" Margin="0,0,8,0">
                  <!-- V2 rough package 32: one column in a 440px panel, several under a map card
                       three times that wide. A plain stack would have drawn each objective as a
                       single row the width of the window. -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemWidth="404" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanObjectiveRowViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- The step rail: a numbered ring, joined to the next by a line. -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" Width="34">
                          <Panel Grid.Row="0" Width="28" Height="28" Margin="0,6,0,0">
                            <Ellipse Stroke="{DynamicResource V2.Brush.Action}" StrokeThickness="2" />
                            <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="{Binding Number}"
                                       Foreground="{DynamicResource V2.Brush.TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Panel>
                          <Rectangle Grid.Row="1" Width="2" Fill="{DynamicResource V2.Brush.Action}" Opacity="0.45"
                                     HorizontalAlignment="Center" Margin="0,2,0,-2" IsVisible="{Binding HasNext}" />
                        </Grid>
                        <Border Grid.Column="1" Classes="v2-plan-step-row" Padding="8,6" Margin="0,0,0,6">
                          <StackPanel Spacing="3">
                            <TextBlock Classes="v2-body" Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" TextWrapping="Wrap">
                              <Run Text="{Binding TaskName}" />
                              <Run Text=" · " />
                              <Run Text="{Binding TraderLabel}" />
                            </TextBlock>
                            <WrapPanel ItemSpacing="8" LineSpacing="4">
                              <Border Classes="v2-plan-chip" ToolTip.Tip="{Binding StateDetail}"
                                      AutomationProperties.Name="{x:Static l:PlanText.QuestState}">
                                <TextBlock Classes="v2-label" Text="{Binding StateLabel}" />
                              </Border>
                              <!-- [#780] A squadmate has this quest active too. -->
                              <Border Classes="v2-plan-chip" IsVisible="{Binding HasSquadLabel}"
                                      AutomationProperties.AutomationId="v2-plan-squad-has-it">
                                <TextBlock Classes="v2-label" Text="{Binding SquadLabel}" />
                              </Border>
                              <TextBlock Classes="v2-label" Text="{Binding MetadataLabel}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasMetadataLabel}" VerticalAlignment="Center" />
                              <!-- [Package 35] The quest's wiki page, where the quest is: a link out that opens the
                                   player's browser. Nothing of the page is fetched or shown here. -->
                              <Button Classes="v2-target v2-plan-link v2-plan-link-action" Content="{x:Static l:PlanText.Wiki}" Padding="6,0"
                                      Command="{Binding OpenWikiCommand}" IsVisible="{Binding HasWikiLink}"
                                      ToolTip.Tip="{Binding WikiAttribution}"
                                      AutomationProperties.AutomationId="v2-plan-objective-wiki"
                                      AutomationProperties.Name="{x:Static l:PlanText.WikiName}" />
                              <!-- [#802] Marks the quest active and pins it, so the Raid map draws it. -->
                              <Button Classes="v2-target v2-plan-link v2-plan-link-action" Content="{x:Static l:PlanText.OnIt}" Padding="6,0"
                                      Command="{Binding OnItCommand}" IsVisible="{Binding CanPutOnIt}"
                                      ToolTip.Tip="{x:Static l:PlanText.OnItTip}"
                                      AutomationProperties.AutomationId="v2-plan-objective-on-it"
                                      AutomationProperties.Name="{x:Static l:PlanText.OnItName}" />
                              <Button Classes="v2-target v2-plan-link v2-plan-link-action" Content="{x:Static l:PlanText.ShowInRaid}" Padding="6,0"
                                      Command="{Binding ShowInRaidCommand}" IsVisible="{Binding CanShowInRaid}"
                                      ToolTip.Tip="{x:Static l:PlanText.ShowInRaidTip}"
                                      AutomationProperties.AutomationId="v2-plan-objective-show-in-raid"
                                      AutomationProperties.Name="{x:Static l:PlanText.ShowInRaidName}" />
                            </WrapPanel>
                            <TextBlock Classes="v2-label" IsVisible="{Binding HasRouteReason}" TextWrapping="Wrap">
                              <Run Text="{Binding RouteDistanceLabel}" />
                              <Run Text=" · " />
                              <Run Text="{Binding RouteReason}" />
                            </TextBlock>
                            <TextBlock Classes="v2-label" Text="{Binding LearnReason}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource V2.Brush.Action}"
                                       IsVisible="{Binding $parent[UserControl].((vm:PlanWorkspaceViewModel)DataContext).LearnMode.IsEnabled}" />
                          </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                          <Button Classes="v2-target v2-icon-btn v2-plan-link" Command="{Binding MarkObjectiveDoneCommand}"
                                  AutomationProperties.Name="{x:Static l:PlanText.MarkObjectiveDone}" ToolTip.Tip="{x:Static l:PlanText.MarkObjectiveDone}">
                            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Tick}" />
                          </Button>
                          <Button Classes="v2-target v2-icon-btn v2-plan-link" AutomationProperties.Name="{x:Static l:PlanText.MoreActions}"
                                  ToolTip.Tip="{x:Static l:PlanText.MoreActions}" Click="ObjectiveActionsClicked">
                            <Path Classes="v2-icon v2-icon-muted" StrokeThickness="3" Data="{DynamicResource V2.Icon.More}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="v2-target v2-plan-link v2-plan-link-action" Margin="38,4,0,8"
                        Content="{Binding MoreObjectivesLabel}" Command="{Binding ShowMoreObjectivesCommand}"
                        IsVisible="{Binding HasMoreObjectives}"
                        AutomationProperties.AutomationId="v2-plan-objectives-show-all" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
          <!-- What this map's objectives ask the player to have: keys and gear to bring, items to
               hand in or find in raid, against what they hold. -->
          <Border x:Name="PlanRequirementsCard" Grid.Row="2" Grid.ColumnSpan="2" x:DataType="vm:PlanMapGroupViewModel" Classes="v2-plan-section"
                  Margin="16,0,16,12" MaxHeight="260" IsVisible="{Binding HasRequirements}"
                  AutomationProperties.AutomationId="v2-plan-requirements">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:PlanText.Requirements}" AutomationProperties.HeadingLevel="2" />
                <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center" Text="{Binding RequirementsSummary}"
                           Classes.v2-intel-good="{Binding RequirementsReady}" />
              </Grid>
              <!-- [#453] Virtualised: "Locked" on Customs asks for over a hundred items, and building
                   every row of a card that shows five held the interface thread. -->
              <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleRequirements}">
                  <ItemsControl.Template>
                    <ControlTemplate>
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,10,0" />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanRequirementRowViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
                        <Panel Width="20" VerticalAlignment="Center">
                          <Path Classes="v2-icon v2-intel-yes" IsVisible="{Binding IsSatisfied}" Data="{DynamicResource V2.Icon.Check}" />
                          <Path Classes="v2-icon v2-icon-muted" IsVisible="{Binding !IsSatisfied}" Data="{DynamicResource V2.Icon.MinusCircle}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Classes="v2-body" Text="{Binding ItemName}" TextWrapping="Wrap" />
                          <TextBlock Classes="v2-label" Text="{Binding HandlingLabel}" />
                          <TextBlock Classes="v2-label" Text="{Binding LearnReason}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource V2.Brush.Action}"
                                     IsVisible="{Binding $parent[UserControl].((vm:PlanWorkspaceViewModel)DataContext).LearnMode.IsEnabled}" />
                          <!-- #285: the Events page records an allergy to this food or medicine. -->
                          <TextBlock Classes="v2-label v2-warning-text" Text="{Binding AllergyWarning}" FontWeight="SemiBold"
                                     IsVisible="{Binding HasAllergyWarning}"
                                     AutomationProperties.AutomationId="v2-plan-requirement-allergy" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="v2-body" Text="{Binding ProgressLabel}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Row="2" Classes="v2-target v2-plan-link v2-plan-link-action"
                      HorizontalAlignment="Left" Margin="30,4,0,0"
                      Content="{Binding MoreRequirementsLabel}" Command="{Binding ShowMoreRequirementsCommand}"
                      IsVisible="{Binding HasMoreRequirements}"
                      AutomationProperties.AutomationId="v2-plan-requirements-show-more" />
            </Grid>
          </Border>
          <StackPanel x:Name="PlanPanelActions" Grid.Row="3" Grid.ColumnSpan="2" x:DataType="vm:PlanMapGroupViewModel" Spacing="8" Margin="16,0,16,16">
            <Button Classes="v2-target v2-plan-primary" Command="{Binding OpenInRaidCommand}"
                    IsVisible="{Binding CanOpenInRaid}"
                    AutomationProperties.AutomationId="v2-plan-open-in-raid"
                    AutomationProperties.Name="{x:Static l:PlanText.OpenInRaid}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Viewbox Width="20" Height="20">
                  <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Play}" />
                </Viewbox>
                <TextBlock Text="{x:Static l:PlanText.OpenInRaid}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        </Panel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
