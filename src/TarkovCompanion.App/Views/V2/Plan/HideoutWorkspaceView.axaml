<UserControl x:Class="TarkovCompanion.App.Views.V2.Plan.HideoutWorkspaceView"
             x:DataType="vm:HideoutWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Plan"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives">
  <UserControl.Styles>
    <!-- A class-selected style outranks a Foreground set inside a data template, so the warning
         colour is a class of its own rather than an attribute on the text. -->
    <Style Selector="TextBlock.v2-label.v2-warning-text">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
    <!-- Same visual language as the Plan tab's bundle cards and requirement list. -->
    <Style Selector="Button.v2-hideout-station">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="13,10,16,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.v2-hideout-station.selected">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Border.v2-hideout-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.v2-hideout-chip.v2-hideout-ready">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Border.v2-hideout-chip.v2-hideout-ready TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Border.v2-hideout-card">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
    </Style>
    <Style Selector="Border.v2-hideout-section">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Density.Standard.Inset}" />
    </Style>
    <Style Selector="Path.v2-icon.v2-hideout-done">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="StrokeThickness" Value="2.4" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 17: the Plan route's Hideout tab in the Plan workspace's visual language
       (docs/design/v2/v2-plan-workspace-concept.png has no separate hideout render): a station
       list on the left, the selected station's next-level requirements as the primary content. -->
  <Grid ColumnDefinitions="400,*">
    <Border Grid.Column="0" Classes="v2-hideout-card" Margin="16,8,0,16">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="2" Margin="16,12,8,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="v2-heading-2" Text="Hideout" AutomationProperties.HeadingLevel="2"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="v2-target v2-icon-btn" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="v2-hideout-refresh" AutomationProperties.Name="Refresh"
                    ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}">
              <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Refresh}" />
            </Button>
          </Grid>
          <TextBlock Classes="v2-label" Text="{Binding Status}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="v2-hideout-status"
                     AutomationProperties.LiveSetting="Polite" />
          <prim:V2LoadFaultNotice DataContext="{Binding LoadFault}" Margin="0,8,8,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasStations}">
          <ItemsControl ItemsSource="{Binding Stations}" Margin="0,4,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HideoutStationRowViewModel">
                <Button Classes="v2-target v2-hideout-station" Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Name}"
                        AutomationProperties.ItemStatus="{Binding NextLevelSummary}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="v2-label" Text="{Binding CurrentLevelLabel}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="v2-hideout-chip" Classes.v2-hideout-ready="{Binding IsReady}"
                            VerticalAlignment="Center">
                      <TextBlock Classes="v2-label" Text="{Binding StateLabel}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- V2 rough package 30 (acceptance sweep): the detail card is the size of what it holds.
         Stretched to the pane it was a 1300x950 bordered box with one small Requirements block in
         its top-left corner — nine tenths of the window was an empty card, which reads as a page
         that failed to load rather than as space.

         The cap is two of the 600-wide sections below plus their spacing and this card's padding:
         package 30's 860 and #421's two-column wrap landed in the same file from different
         branches, and 860 silently allowed only one column. A cap that cannot fit what it holds
         is the same fault in the other direction. -->
    <Border Grid.Column="1" Classes="v2-hideout-card" Margin="16,8,16,16"
            HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="1280">
      <Panel>
        <TextBlock Classes="v2-body" IsVisible="{Binding !HasSelection}" Opacity="0.8"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420"
                   Text="Hideout stations appear here once game data has loaded." />
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}" Margin="20,16,20,16">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2">
              <TextBlock Classes="v2-heading-2" Text="{Binding SelectedStationName}" AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="v2-label" Text="{Binding SelectedLevelLabel}" />
            </StackPanel>
            <!-- What the profile says is built. The game never writes it down, so it is set here;
                 the requirements below are always for the level after this one. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="v2-label" Text="Built level" VerticalAlignment="Center" />
              <Button Classes="v2-target v2-icon-btn v2-outline" IsEnabled="{Binding CanLowerLevel}"
                      Command="{Binding LowerLevelCommand}"
                      AutomationProperties.AutomationId="v2-hideout-level-down"
                      AutomationProperties.Name="Lower the built level" ToolTip.Tip="Lower the built level">
                <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Minus}" />
              </Button>
              <Button Classes="v2-target v2-icon-btn v2-outline" IsEnabled="{Binding CanRaiseLevel}"
                      Command="{Binding RaiseLevelCommand}"
                      AutomationProperties.AutomationId="v2-hideout-level-up"
                      AutomationProperties.Name="Raise the built level" ToolTip.Tip="Raise the built level">
                <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Plus}" />
              </Button>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <!-- The next level's needs beside what is short across every station, so a wide window is
               two readable columns rather than one narrow one with the rest empty. -->
          <WrapPanel ItemSpacing="16" LineSpacing="16" HorizontalAlignment="Left">
          <StackPanel Width="600" Spacing="16" VerticalAlignment="Top">
          <Border Classes="v2-hideout-section" VerticalAlignment="Top" Width="600">
            <StackPanel Spacing="10">
              <TextBlock Classes="v2-heading-3" Text="Requirements" />
              <TextBlock Classes="v2-body" Text="{Binding Detail}" TextWrapping="Wrap"
                         Foreground="{DynamicResource V2.Brush.TextSecondary}" />
              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HideoutRequirementRowViewModel">
                    <Grid ColumnDefinitions="*,Auto,28" ColumnSpacing="16">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="v2-body" Text="{Binding ItemName}" TextTrimming="CharacterEllipsis" />
                        <!-- Only where a barter beats buying it and the player's loyalty allows it. -->
                        <TextBlock Classes="v2-label" Text="{Binding CheapestRoute}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasCheapestRoute}"
                                   Foreground="{DynamicResource V2.Brush.Success}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding ProgressLabel}" VerticalAlignment="Center" />
                      <Viewbox Grid.Column="2" Width="20" Height="20" IsVisible="{Binding IsSatisfied}">
                        <Path Classes="v2-icon v2-hideout-done" Data="{DynamicResource V2.Icon.Tick}" />
                      </Viewbox>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- #307: every unbuilt level between the profile and the chosen level of this station,
               prerequisites first. The order is HideoutUpgradePlanner's. -->
          <Border Classes="v2-hideout-card" Padding="16,12" DataContext="{Binding Upgrades}"
                  IsVisible="{Binding HasPath}" AutomationProperties.AutomationId="v2-hideout-path">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="v2-heading-3" Text="{Binding PathHeading}" AutomationProperties.HeadingLevel="2" />
                  <TextBlock Classes="v2-label" Text="{Binding PathSummary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="v2-label" Text="Target" VerticalAlignment="Center" />
                  <Button Classes="v2-target v2-icon-btn v2-outline" IsEnabled="{Binding CanLowerTarget}"
                          Command="{Binding LowerTargetCommand}"
                          AutomationProperties.AutomationId="v2-hideout-target-down"
                          AutomationProperties.Name="Lower the target level" ToolTip.Tip="Lower the target level">
                    <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Minus}" />
                  </Button>
                  <Button Classes="v2-target v2-icon-btn v2-outline" IsEnabled="{Binding CanRaiseTarget}"
                          Command="{Binding RaiseTargetCommand}"
                          AutomationProperties.AutomationId="v2-hideout-target-up"
                          AutomationProperties.Name="Raise the target level" ToolTip.Tip="Raise the target level">
                    <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Plus}" />
                  </Button>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding PathSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HideoutUpgradeStepRowViewModel">
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8" Margin="0,4">
                      <TextBlock Classes="v2-label" Text="{Binding Order}" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="v2-body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label v2-warning-text" Text="{Binding AlsoNeeds}" IsVisible="{Binding HasAlsoNeeds}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding State}" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </StackPanel>

          <!-- #307: what comes next for this profile, and one shopping list across it. The chips
               choose how far ahead the list looks; "Path" makes it the list for the card on the left. -->
          <StackPanel Width="600" Spacing="16" VerticalAlignment="Top" DataContext="{Binding Upgrades}">
          <Border Classes="v2-hideout-card" Padding="16,12" IsVisible="{Binding HasNextUpgrades}"
                  AutomationProperties.AutomationId="v2-hideout-next">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="Next upgrades" AutomationProperties.HeadingLevel="2" />
              <ItemsControl ItemsSource="{Binding NextUpgrades}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HideoutUpgradeStepRowViewModel">
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8" Margin="0,4">
                      <TextBlock Classes="v2-label" Text="{Binding Order}" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="v2-body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label v2-warning-text" Text="{Binding AlsoNeeds}" IsVisible="{Binding HasAlsoNeeds}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding State}" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="v2-hideout-card" Padding="16,12" AutomationProperties.AutomationId="v2-hideout-shopping">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="{Binding ShoppingHeading}" AutomationProperties.HeadingLevel="2" />
              <ItemsControl ItemsSource="{Binding Scopes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HideoutScopeChipViewModel">
                    <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding Label}"
                            Content="{Binding Label}" Command="{Binding SelectCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="v2-label" Text="{Binding ShoppingTotal}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Shopping}" IsVisible="{Binding HasShopping}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HideoutShoppingRowViewModel">
                    <Grid ColumnDefinitions="*,Auto,72" ColumnSpacing="16" Margin="0,3">
                      <StackPanel Spacing="1">
                        <TextBlock Classes="v2-body" Text="{Binding ItemName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding PriceLabel}" Opacity="0.8" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding ProgressLabel}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="v2-body" Text="{Binding CostLabel}" VerticalAlignment="Center"
                                 TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </StackPanel>
          </WrapPanel>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
