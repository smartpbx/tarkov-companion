<UserControl x:Class="TarkovCompanion.App.Views.V2.Plan.LoadoutWorkspaceView"
             x:DataType="pages:LoadoutPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:TarkovCompanion.App.ViewModels"
             xmlns:planVm="using:TarkovCompanion.App.ViewModels.V2.Plan">
  <UserControl.Styles>
    <!-- A class-selected style outranks a Foreground set inside a data template, so the warning
         colour is a class of its own rather than an attribute on the text. -->
    <Style Selector="TextBlock.v2-label.v2-warning-text">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
    <!-- [V2 rough package 60 — Plan] #288. A slot tile reads as a place that holds a thing, so an
         empty one is drawn as an outline and a filled one as a surface. The state is also in the
         words on it ("Empty"), never the border alone. -->
    <Style Selector="Button.v2-loadout-tile">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <Style Selector="Button.v2-loadout-tile.filled">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
    </Style>
    <Style Selector="Button.v2-loadout-tile.aimed">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <!-- V1's Loadout page in the workspace layout: pick a slot and search across the top, results
       under it, and the kit with its evaluation in the context panel, like the concept's
       "Loadout readiness" card. The evaluation is the V1 page's own: nothing is recomputed here. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <Border Grid.Row="0" Classes="v2-intel-search">
        <Grid ColumnDefinitions="210,*,Auto" ColumnSpacing="10">
          <ComboBox VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                    AutomationProperties.AutomationId="v2-loadout-slot"
                    AutomationProperties.Name="Slot">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:LoadoutSlotOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchQuery}"
                   PlaceholderText="Search by item name or short name"
                   AutomationProperties.AutomationId="v2-loadout-search"
                   AutomationProperties.Name="Search items for this slot">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain"
                  AutomationProperties.AutomationId="v2-loadout-search-go"
                  AutomationProperties.Name="Search" ToolTip.Tip="Search"
                  Command="{Binding SearchCommand}">
            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Search}" />
          </Button>
        </Grid>
      </Border>

      <!-- #307: what the chosen map's active quests ask the kit for. Each row names the change,
           the quest it serves and the objective's own words, then what the stash and the traders
           say about it. Read from objective conditions only; nothing here is a guess about a map. -->
      <Border Grid.Row="1" Classes="v2-intel-pane" Padding="14,12" DataContext="{Binding Suggestions}" x:DataType="planVm:LoadoutSuggestionsViewModel"
              IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-loadout-suggestions">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="v2-heading-3" Text="{Binding Heading}" AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="v2-label" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding RulesLabel}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="v2-loadout-suggestions-rules" />
            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                      IsVisible="{Binding HasMaps}"
                      AutomationProperties.AutomationId="v2-loadout-suggestions-map"
                      AutomationProperties.Name="Map to pack for">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="planVm:LoadoutSuggestionMapOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="560" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRows}">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="planVm:LoadoutSuggestionRowViewModel">
                  <Border Classes="v2-intel-fact" Padding="10,8" Margin="0,0,8,8" ToolTip.Tip="{Binding QuestsTip}">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="10">
                      <TextBlock Classes="v2-label" Text="{Binding Kind}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding Quest}" Foreground="{DynamicResource V2.Brush.Action}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding Reason}" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding Availability}" IsVisible="{Binding HasAvailability}"
                                   Classes.v2-warning-text="{Binding IsBlocked}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="v2-intel-pane" Padding="14"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-loadout-results">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Grid.Row="0" Spacing="2" Margin="2,0">
            <TextBlock Classes="v2-label" Text="{Binding SearchStatus}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="v2-label" Text="{Binding SelectedSlot.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:LoadoutSearchResultViewModel">
                  <Border Classes="v2-intel-fact" Padding="10,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding ShortName}" Foreground="{DynamicResource V2.Brush.TextSecondary}" />
                        </TextBlock>
                        <TextBlock Classes="v2-label" Text="{Binding Category}" />
                        <TextBlock Classes="v2-label" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Cost}" /><Run Text=" · " /><Run Text="{Binding Weight}" /><Run Text=" · " /><Run Text="{Binding Caliber}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="v2-target v2-outline" Content="Assign" Command="{Binding AssignCommand}"
                              VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Context panel: the kit, and what evaluating it says. -->
    <Border Grid.Column="1" Width="520" Classes="v2-intel-panel"
            AutomationProperties.AccessibilityView="Control"
            AutomationProperties.LandmarkType="Complementary"
            AutomationProperties.AutomationId="v2-loadout-context">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="16,12,16,16">
          <Border Classes="v2-intel-accent">
            <Border Classes="v2-intel-section">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="v2-heading-2" Text="The kit" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="v2-target v2-plain" Content="Empty the kit" Command="{Binding ClearCommand}"
                          AutomationProperties.AutomationId="v2-loadout-clear" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding SlotBoardSummary}" AutomationProperties.LiveSetting="Polite" />
                <!-- Ten tiles, always. Pressing one aims the search at that slot; the small
                     Clear appears only on a tile that holds something. -->
                <ItemsControl ItemsSource="{Binding SlotBoard}"
                              AutomationProperties.AutomationId="v2-loadout-board"
                              AutomationProperties.AccessibilityView="Control">
                  <!-- Two columns rather than a wrap: the panel is a fixed width, and ten tiles
                       that wrapped by their own measure came out one per row and pushed the
                       evaluation off the bottom of a 1080p window. -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:LoadoutSlotTileViewModel">
                      <Button Classes="v2-loadout-tile" Margin="0,0,8,8"
                              Classes.filled="{Binding IsFilled}" Classes.aimed="{Binding IsSelected}"
                              AutomationProperties.AutomationId="{Binding AutomationId}"
                              AutomationProperties.Name="{Binding Name}"
                              AutomationProperties.HelpText="{Binding Summary}"
                              Command="{Binding SelectCommand}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Classes="v2-label" Text="{Binding Name}" />
                          <Button Grid.Column="1" Classes="v2-target v2-plain" Content="Clear" Padding="6,0"
                                  IsVisible="{Binding IsFilled}" Command="{Binding ClearSlotCommand}"
                                  AutomationProperties.Name="Clear this slot" />
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="v2-body" TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis" MaxLines="2" Text="{Binding Summary}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="v2-label" Text="{Binding AssignmentStatus}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding MultiAssignments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:LoadoutAssignmentViewModel">
                      <Border Classes="v2-intel-fact">
                        <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-label" Text="{Binding SlotName}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Classes="v2-body" Text="{Binding ItemName}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" Text="{Binding Detail}" TextWrapping="Wrap" />
                            <!-- #285: the Events page records an allergy to this food or medicine. -->
                            <TextBlock Classes="v2-label v2-warning-text" Text="{Binding AllergyWarning}" FontWeight="SemiBold"
                                       IsVisible="{Binding HasAllergyWarning}"
                                       AutomationProperties.AutomationId="v2-loadout-allergy" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="v2-target v2-plain" Content="Remove" Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Border>

          <Border Classes="v2-intel-section" AutomationProperties.AutomationId="v2-loadout-alternatives">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="Alternatives" AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="v2-label" Text="{Binding AlternativesStatus}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Alternatives}" IsVisible="{Binding HasAlternatives}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LoadoutAlternativeViewModel">
                    <Border Classes="v2-intel-fact" Opacity="{Binding Opacity}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="1">
                          <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="v2-label" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="v2-label" Text="{Binding Source}" />
                          <TextBlock Classes="v2-label" Text="{Binding Requirement}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="v2-target v2-outline" Content="Use"
                                Command="{Binding ChooseCommand}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="v2-intel-section">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="v2-heading-3" Text="Evaluation" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="v2-target v2-primary" Content="Evaluate" Command="{Binding EvaluateCommand}"
                        AutomationProperties.AutomationId="v2-loadout-evaluate" />
              </Grid>
              <TextBlock Classes="v2-label" Text="{Binding EvaluationStatus}" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="v2-label" Text="Approximate cost" />
                  <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding CostSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="v2-label" Text="Total weight" />
                  <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding WeightSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Classes="v2-label" Text="Ammo tier" />
                  <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding AmmoTierSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <!-- The budget sits with the cost it measures rather than in a card of its own, and
                   reads against the evaluated cost rather than a running total: both totals count
                   a missing price as zero and are floors, so a figure that moved while items were
                   being added would quote a number the page had not computed. -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Classes="v2-label" Text="Budget" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Classes="v2-field-input" Text="{Binding BudgetInput}"
                         PlaceholderText="What you will spend, e.g. 250k"
                         AutomationProperties.AutomationId="v2-loadout-budget"
                         AutomationProperties.Name="Kit budget in roubles" />
              </Grid>
              <TextBlock Classes="v2-body" Text="{Binding BudgetSummary}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="v2-loadout-budget-summary"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Classes="v2-label v2-intel-poor" IsVisible="{Binding IsOverBudget}"
                         Text="Over the budget." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding CanSavePresets}">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="Saved kits" AutomationProperties.HeadingLevel="2" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="v2-field-input" Text="{Binding PresetName}"
                         PlaceholderText="Name this kit"
                         AutomationProperties.AutomationId="v2-loadout-preset-name"
                         AutomationProperties.Name="Name for the saved kit">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SavePresetCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="v2-target v2-outline" Content="Save"
                        AutomationProperties.AutomationId="v2-loadout-preset-save"
                        Command="{Binding SavePresetCommand}" />
              </Grid>
              <TextBlock Classes="v2-label" Text="{Binding PresetStatus}" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
              <ItemsControl ItemsSource="{Binding Presets}" AutomationProperties.AutomationId="v2-loadout-presets">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LoadoutPresetViewModel">
                    <Border Classes="v2-intel-fact">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="v2-label" Text="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="v2-target v2-plain" Content="Load" Command="{Binding LoadCommand}"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="v2-target v2-plain" Command="{Binding CompareCommand}"
                                VerticalAlignment="Center" Content="{Binding CompareLabel}" />
                        <Button Grid.Column="3" Classes="v2-target v2-plain" Content="Delete" Command="{Binding DeleteCommand}"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- The saved kit is re-evaluated rather than showing what it cost when it was saved:
               prices move, and a comparison against last week's price is a comparison against
               nothing in particular. -->
          <Border Classes="v2-intel-section" IsVisible="{Binding HasComparison}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="v2-heading-3" Text="Compared" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="v2-target v2-plain" Content="Stop comparing"
                        Command="{Binding ClearComparisonCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Comparison}" AutomationProperties.AutomationId="v2-loadout-comparison">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LoadoutComparisonRowViewModel">
                    <Grid ColumnDefinitions="140,*,*,90" ColumnSpacing="8" Margin="0,3">
                      <TextBlock Classes="v2-label" Text="{Binding Measure}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding Current}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Classes="v2-body" Text="{Binding Other}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="3" Classes="v2-label" Text="{Binding Difference}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Issues and warnings stay apart: one is a contradiction in the data, the other a judgement call. -->
          <Border Classes="v2-intel-section">
            <StackPanel Spacing="6">
              <TextBlock Classes="v2-heading-3" Text="Compatibility issues" AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="v2-label" Text="{Binding IssuesStatus}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LoadoutFindingViewModel">
                    <StackPanel Spacing="2" Margin="0,3">
                      <TextBlock Classes="v2-body v2-intel-poor" Text="{Binding Message}" TextWrapping="Wrap" />
                      <!-- Why the rule raised it, in fixed offline wording. -->
                      <TextBlock Classes="v2-label" Text="{Binding Explanation}" TextWrapping="Wrap"
                                 IsVisible="{Binding Explanation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="v2-intel-section">
            <StackPanel Spacing="6">
              <TextBlock Classes="v2-heading-3" Text="Warnings" AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="v2-label" Text="{Binding WarningsStatus}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LoadoutFindingViewModel">
                    <StackPanel Spacing="2" Margin="0,3">
                      <TextBlock Classes="v2-body v2-intel-fair" Text="{Binding Message}" TextWrapping="Wrap" />
                      <!-- Why the rule raised it, in fixed offline wording. -->
                      <TextBlock Classes="v2-label" Text="{Binding Explanation}" TextWrapping="Wrap"
                                 IsVisible="{Binding Explanation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
