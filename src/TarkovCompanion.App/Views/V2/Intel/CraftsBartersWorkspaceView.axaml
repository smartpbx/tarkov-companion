<UserControl x:Class="TarkovCompanion.App.Views.V2.Intel.CraftsBartersWorkspaceView"
             x:DataType="vm:CraftsBartersWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Intel"
             xmlns:intel="using:TarkovCompanion.App.Views.V2.Intel">
  <UserControl.Styles>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
  </UserControl.Styles>

  <!-- #287: every craft and barter the catalog holds, searchable by an input or output item
       name, sorted by profit at the catalog's current prices by default. One row template for
       both kinds: inputs, an arrow, the output, then the station/trader, level and (craft only)
       duration underneath. A ListBox rather than a plain ItemsControl — Avalonia virtualises a
       ListBox's items by default, which a list that can hold all 789 barters and 214 crafts at
       once needs and the smaller reference lists beside it have never needed. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Margin="16,4,16,16">
    <Border Grid.Row="0" Classes="v2-intel-search">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
              Data="{DynamicResource V2.Icon.Search}" />
        <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchText}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 AutomationProperties.AutomationId="v2-intel-trade-search" />
        <ToggleButton Grid.Column="2" Classes="v2-target v2-intel-chip" Content="{Binding ReadyNowLabel}"
                      Classes.selected="{Binding ReadyNowOnly}"
                      IsChecked="{Binding ReadyNowOnly}"
                      AutomationProperties.AutomationId="v2-intel-trade-ready-now" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding SortHeading}" Margin="2,0,0,0" />
      <ItemsControl ItemsSource="{Binding Sorts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IntelTradeSortViewModel">
            <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding Label}"
                    Content="{Binding Label}" Command="{Binding SelectCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding ResultCountLabel}" Margin="10,0,0,0"
                 IsVisible="{Binding !ShowsEmpty}" />
      <!-- [#902 P8] Learn mode changes this page's text, so its switch is here too. -->
      <ToggleButton Classes="v2-target v2-intel-chip v2-intel-chip-small" VerticalAlignment="Center"
                            Content="{x:Static l:PlanText.Learn}" IsChecked="{Binding LearnMode.IsEnabled}"
                            AutomationProperties.AutomationId="v2-crafts-learn-mode"
                            AutomationProperties.Name="{x:Static l:PlanText.LearnMode}" />
      <!-- #287 review: "I can do this now" only ever keeps a row known to be ready. A row left
           out because its station/trader level was never recorded is not locked, so its count is
           said out loud rather than folding silently into "everything else was locked". -->
      <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding ReadyNowUnknownLabel}"
                 Margin="10,0,0,0" IsVisible="{Binding HasReadyNowUnknownCount}" />
    </StackPanel>

    <Border Grid.Row="2" Classes="v2-intel-pane" Padding="14" MaxHeight="350"
            IsVisible="{Binding Chain.HasSelection}"
            AutomationProperties.AutomationId="v2-intel-trade-chain">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <Button Grid.Row="0" Classes="v2-target v2-intel-plain" HorizontalAlignment="Right"
                Content="{Binding CloseChainLabel}" Command="{Binding CloseChainCommand}"
                AutomationProperties.AutomationId="v2-intel-chain-close" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <intel:AcquisitionChainView DataContext="{Binding Chain}" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="3" Classes="v2-intel-pane" AutomationProperties.AutomationId="v2-intel-trade-list">
      <Grid>
        <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   IsVisible="{Binding IsLoading}" Text="{Binding LoadingLabel}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Spacing="10"
                    IsVisible="{Binding ShowsEmpty}">
          <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                     HorizontalAlignment="Center" Text="{Binding EmptyLabel}" />
          <!-- [#902 P10] An unknown level is the player's own missing input: link to where it is set. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Classes="v2-outline" IsVisible="{Binding ShowsSetTraderLevels}" Command="{Binding SetTraderLevelsCommand}"
                    Content="{x:Static l:IntelText.CraftsSetTraderLevels}" AutomationProperties.AutomationId="v2-crafts-set-trader-levels" />
            <Button Classes="v2-outline" IsVisible="{Binding ShowsSetHideoutLevels}" Command="{Binding SetHideoutLevelsCommand}"
                    Content="{x:Static l:IntelText.CraftsSetHideoutLevels}" AutomationProperties.AutomationId="v2-crafts-set-hideout-levels" />
            <Button Classes="v2-outline" Margin="0"
                    IsVisible="{Binding ShowsFilterReset}" Command="{Binding ClearFilterCommand}"
                    Content="{x:Static l:FilterText.ShowAll}" AutomationProperties.AutomationId="v2-crafts-show-all" />
          </StackPanel>
        </StackPanel>
        <ListBox Classes="v2-intel-trade-list" ItemsSource="{Binding Rows}" IsVisible="{Binding !ShowsEmpty}"
                 SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:IntelTradeRowViewModel">
              <Border Classes="v2-intel-trade-row" AutomationProperties.AutomationId="{Binding AutomationId}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="v2-intel-trade-kind">
                        <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                      </Border>
                      <TextBlock Classes="v2-body" Text="{Binding InputsLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Path Classes="v2-icon v2-icon-sm v2-icon-muted"
                            Data="{DynamicResource V2.Icon.ChevronRight}" />
                      <Button Classes="v2-target v2-intel-plain v2-intel-trade-output"
                              Content="{Binding Output.Label}"
                              Command="{Binding OpenOutputCommand}"
                              AutomationProperties.Name="{Binding Output.Name}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="v2-label" IsVisible="{Binding HasSourceName}" Text="{Binding SourceName}" />
                      <TextBlock Classes="v2-label" IsVisible="{Binding HasLevelLabel}" Text="{Binding LevelLabel}" />
                      <TextBlock Classes="v2-label" IsVisible="{Binding HasDuration}" Text="{Binding DurationLabel}" />
                      <TextBlock Classes="v2-label v2-intel-good" IsVisible="{Binding IsReady}" Text="{Binding ReadinessLabel}" />
                      <!-- Locked (a known, recorded level short of the requirement) is amber and
                           names what is recorded; Unknown (nothing recorded at all) is a plain,
                           neutral label so it never reads as "locked" at a glance (#287 review). -->
                      <TextBlock Classes="v2-label v2-intel-fair" IsVisible="{Binding IsLocked}" Text="{Binding ReadinessLabel}" />
                      <TextBlock Classes="v2-label" IsVisible="{Binding HasRecordedLevel}" Text="{Binding RecordedLevelLabel}" />
                      <TextBlock Classes="v2-label" IsVisible="{Binding IsUnknownReadiness}" Text="{Binding ReadinessLabel}" />
                    </StackPanel>
                    <TextBlock Classes="v2-label" Text="{Binding LearnReason}" TextWrapping="Wrap"
                               Foreground="{DynamicResource V2.Brush.Action}"
                               IsVisible="{Binding $parent[UserControl].((vm:CraftsBartersWorkspaceViewModel)DataContext).LearnMode.IsEnabled}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Classes="v2-intel-trade-profit" HorizontalAlignment="Right"
                               Classes.v2-intel-unavailable="{Binding ProfitIsUnknown}"
                               Classes.v2-intel-poor="{Binding ProfitIsNegative}"
                               Text="{Binding ProfitLabel}" />
                    <Button Classes="v2-target v2-intel-chip v2-intel-chip-small"
                            Content="{Binding ChainLabel}" Command="{Binding OpenChainCommand}"
                            AutomationProperties.Name="{x:Static l:IntelText.CraftsShowChain}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
