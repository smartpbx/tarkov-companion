<UserControl x:Class="TarkovCompanion.App.Views.V2.Intel.IntelWorkspaceView"
             x:DataType="vm:V2ShellViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Shell"
             xmlns:intelVm="using:TarkovCompanion.App.ViewModels.V2.Intel"
             xmlns:intel="using:TarkovCompanion.App.Views.V2.Intel">
  <UserControl.Styles>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
  </UserControl.Styles>

  <!-- Package 33 (#287): one row template shared by the search results and the four landing
       sections below, so "Needed now"/"Pinned"/"Recently opened"/"Highest value" read exactly
       like a search hit — icon tag, name, category, price — never a bespoke placeholder row. -->
  <UserControl.Resources>
    <DataTemplate x:Key="IntelResultRowTemplate" x:DataType="vm:V2IntelResultRowViewModel">
      <Button Classes="v2-target v2-intel-row" Classes.selected="{Binding IsSelected}"
              AutomationProperties.AutomationId="{Binding AutomationId}"
              AutomationProperties.Name="{Binding Name}"
              Command="{Binding OpenCommand}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <!-- #287 fix: a cached icon image is not modelled on this row yet, so every row draws
               the same neutral glyph rather than the short name clipped to fit a 56px tag
               ("Band…", "CPU f…" on the render that found this). -->
          <Border Grid.Column="0" Classes="v2-intel-thumb">
            <Path Classes="v2-icon v2-icon-lg v2-icon-muted" Data="{DynamicResource V2.Icon.Box}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="v2-label" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="v2-label" IsVisible="{Binding HasMatchLabel}" Text="{Binding MatchLabel}"
                       TextTrimming="CharacterEllipsis" />
            <!-- #287 (event state on items): Allergic is a clear chip, Safe/Untested a quiet label. -->
            <Border Classes="v2-intel-event-chip" HorizontalAlignment="Left"
                    IsVisible="{Binding EventStateIsAllergic}">
              <TextBlock Classes="v2-label" Text="{Binding EventStateLabel}" />
            </Border>
            <TextBlock Classes="v2-label" IsVisible="{Binding HasQuietEventState}" Text="{Binding EventStateLabel}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="v2-body" HorizontalAlignment="Right" Text="{Binding PriceLabel}" />
            <TextBlock Classes="v2-label" HorizontalAlignment="Right" IsVisible="{Binding HasPerSlot}"
                       Text="{Binding PerSlotLabel}" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <!-- V2 rough package 17, like docs/design/v2/v2-intel-workspace-concept.png: search across the
       top, results on the left, the selected item in the middle, and a full-height context panel
       on the right with the need summary and the catalog's prices. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <Border Grid.Row="0" Classes="v2-intel-search" IsVisible="{Binding ShowsWorkspaceSearch}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
                Data="{DynamicResource V2.Icon.Search}" />
          <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchText}"
                   PlaceholderText="{Binding IntelSearchPlaceholder}"
                   AutomationProperties.AutomationId="v2-shell-workspace-search"
                   AutomationProperties.Name="{Binding SearchLabel}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain"
                  IsVisible="{Binding HasSearchText}"
                  AutomationProperties.AutomationId="v2-intel-search-clear"
                  AutomationProperties.Name="{Binding IntelClearSearchLabel}"
                  ToolTip.Tip="{Binding IntelClearSearchLabel}"
                  Command="{Binding ClearIntelSearchCommand}">
            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
          </Button>
          <Button Grid.Column="3" Classes="v2-target v2-icon-btn v2-intel-plain"
                  AutomationProperties.AutomationId="v2-shell-workspace-search-open"
                  AutomationProperties.Name="{Binding SearchOpenLabel}"
                  ToolTip.Tip="{Binding SearchOpenLabel}"
                  Command="{Binding SearchCommand}">
            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Search}" />
          </Button>
        </Grid>
      </Border>

      <!-- The results column grows a little on an ultrawide screen rather than leaving all the
           extra width to the item pane. -->
      <Grid Grid.Row="1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.3*" MinWidth="400" MaxWidth="560" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Results: kind chips, a count, and the rows. Before any search it offers the
             shell's suggestions (recent, pinned, current plan) in the same place. -->
        <!-- #287 fix: the scrollbar used to sit 14px inside the panel's true right edge, because
             the padding that gives the rows and chips their gutter lived on this Border and so
             inset the ScrollViewer (and everything it draws, including its own scrollbar) along
             with them. The padding now lives on the Grid instead, with its right edge left at
             zero so only row 3's ScrollViewer reaches the Border's true edge; the list itself
             keeps its gutter via a margin on its own content, the same split the detail pane
             beside it already uses (no Border padding there either). -->
        <Border Grid.Column="0" Classes="v2-intel-pane"
                AutomationProperties.AccessibilityView="Control"
                AutomationProperties.AutomationId="v2-intel-results">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Margin="14,14,0,14">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding IntelKindFilters}" IsVisible="{Binding HasIntelSearchResults}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:V2IntelKindFilterViewModel">
                  <Button Classes="v2-target v2-intel-chip" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Label}"
                          Content="{Binding Label}" Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Classes="v2-label" IsVisible="{Binding HasIntelSearchResults}"
                       Text="{Binding IntelResultCountLabel}" Margin="2,0" />
            <TextBlock Grid.Row="1" Classes="v2-label" IsVisible="{Binding HasIntelSearchStatus}"
                       Text="{Binding IntelSearchStatus}" TextWrapping="Wrap" Margin="2,0" />

            <!-- Order: relevance is the search's own ranking; the others reorder the same hits. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasIntelResults}">
              <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding IntelSortHeading}" Margin="2,0,0,0" />
              <ItemsControl ItemsSource="{Binding IntelSorts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:V2IntelSortViewModel">
                    <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding Label}"
                            Content="{Binding Label}" Command="{Binding SelectCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="4" Margin="0,0,14,0">
                <ItemsControl ItemsSource="{Binding IntelResults}" IsVisible="{Binding HasIntelResults}"
                              ItemTemplate="{StaticResource IntelResultRowTemplate}" />
                <TextBlock Classes="v2-label" IsVisible="{Binding ShowsIntelNoKindMatch}" Text="{Binding IntelNoKindMatchLabel}" />

                <!-- Package 33 (#287): the Intel landing page. Four real sections, each hidden
                     when it has nothing — never a placeholder row standing in for one that is
                     empty. -->
                <StackPanel Spacing="18" IsVisible="{Binding ShowsIntelSuggestionList}"
                            AutomationProperties.AccessibilityView="Control"
                            AutomationProperties.AutomationId="v2-intel-home">
                  <TextBlock Classes="v2-label" IsVisible="{Binding ShowsIntelHomeEmpty}" Text="{Binding IntelHomeEmptyLabel}" />

                  <StackPanel Spacing="8" IsVisible="{Binding HasIntelHomeNeededNow}"
                              AutomationProperties.AutomationId="v2-intel-home-needed-now">
                    <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelHomeNeededNowHeading}" />
                    <ItemsControl ItemsSource="{Binding IntelHomeNeededNow}" ItemTemplate="{StaticResource IntelResultRowTemplate}" />
                  </StackPanel>

                  <StackPanel Spacing="8" IsVisible="{Binding HasIntelHomePinned}"
                              AutomationProperties.AutomationId="v2-intel-home-pinned">
                    <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelHomePinnedHeading}" />
                    <ItemsControl ItemsSource="{Binding IntelHomePinned}" ItemTemplate="{StaticResource IntelResultRowTemplate}" />
                  </StackPanel>

                  <StackPanel Spacing="8" IsVisible="{Binding HasIntelHomeRecent}"
                              AutomationProperties.AutomationId="v2-intel-home-recent">
                    <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelHomeRecentHeading}" />
                    <ItemsControl ItemsSource="{Binding IntelHomeRecent}" ItemTemplate="{StaticResource IntelResultRowTemplate}" />
                  </StackPanel>

                  <StackPanel Spacing="8" IsVisible="{Binding HasIntelHomeHighestValue}"
                              AutomationProperties.AutomationId="v2-intel-home-highest-value">
                    <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelHomeHighestValueHeading}" />
                    <ItemsControl ItemsSource="{Binding IntelHomeHighestValue}" ItemTemplate="{StaticResource IntelResultRowTemplate}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- The selected item. -->
        <Border Grid.Column="1" Classes="v2-intel-pane"
                AutomationProperties.AccessibilityView="Control"
                AutomationProperties.AutomationId="v2-intel-detail">
          <Grid RowDefinitions="Auto,*">
            <!-- #287: the compare tray. It outlives the open item, so it sits above the detail. -->
            <Border Grid.Row="0" Classes="v2-intel-compare-tray" IsVisible="{Binding IntelCompare.HasEntries}"
                    AutomationProperties.AutomationId="v2-intel-compare-tray">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="v2-label" VerticalAlignment="Center" Text="{Binding IntelCompare.TrayLabel}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding IntelCompare.Entries}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="intelVm:IntelCompareEntryViewModel">
                      <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Margin="0,2,8,2"
                              AutomationProperties.AutomationId="{Binding AutomationId}"
                              AutomationProperties.Name="{Binding RemoveLabel}" ToolTip.Tip="{Binding RemoveLabel}"
                              Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <Path Classes="v2-icon v2-icon-muted" Width="14" Height="14" VerticalAlignment="Center"
                                Data="{DynamicResource V2.Icon.Close}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Classes="v2-target v2-intel-plain" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="v2-intel-compare-clear"
                        Command="{Binding IntelCompare.ClearCommand}" Content="{Binding IntelCompare.ClearLabel}" />
                <Button Grid.Column="3" Classes="v2-target v2-intel-secondary" VerticalAlignment="Center"
                        IsEnabled="{Binding IntelCompare.CanOpen}"
                        AutomationProperties.AutomationId="v2-intel-compare-open"
                        Command="{Binding IntelCompare.OpenCommand}" Content="{Binding IntelCompare.OpenLabel}" />
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                       IsVisible="{Binding ShowsIntelNoSelection}" Text="{Binding IntelNoSelectionLabel}" />
            <StackPanel Grid.Row="1" Margin="24,20" Spacing="8" IsVisible="{Binding ShowsIntelDetailStatus}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="v2-heading-2" Focusable="True"
                           AutomationProperties.AutomationId="v2-shell-intel-heading"
                           AutomationProperties.HeadingLevel="1" Text="{Binding IntelDescription}" />
                <Button Grid.Column="1" Classes="v2-target v2-icon-btn v2-intel-plain"
                        AutomationProperties.AutomationId="v2-shell-intel-close"
                        AutomationProperties.Name="{Binding IntelCloseLabel}" ToolTip.Tip="{Binding IntelCloseLabel}"
                        Command="{Binding CloseTransientCommand}">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                </Button>
              </Grid>
              <TextBlock Classes="v2-label" Text="{Binding IntelStatusLabel}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowsIntelDetail}" HorizontalScrollBarVisibility="Disabled">
              <!-- Fills the pane up to a readable width, then stays left-aligned on an ultrawide screen. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="1400" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              <StackPanel Margin="24,18,24,24" Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="v2-intel-name" Focusable="True"
                               AutomationProperties.AutomationId="v2-shell-intel-heading"
                               AutomationProperties.HeadingLevel="1" Text="{Binding IntelName}" />
                    <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}" Text="{Binding IntelSubtitle}" />
                    <!-- #287 (event state on items): the top of the detail, same as the row chip. -->
                    <Border Classes="v2-intel-event-chip" HorizontalAlignment="Left" Margin="0,4,0,0"
                            IsVisible="{Binding IntelEventStateIsAllergic}"
                            AutomationProperties.AutomationId="v2-shell-intel-event-state">
                      <TextBlock Classes="v2-label" Text="{Binding IntelEventStateLabel}" />
                    </Border>
                    <TextBlock Classes="v2-label" Margin="0,4,0,0"
                               IsVisible="{Binding HasQuietIntelEventState}" Text="{Binding IntelEventStateLabel}" />
                  </StackPanel>
                  <!-- #287: adds the open item to the compare tray, or takes it back out. -->
                  <Button Grid.Column="1" Classes="v2-target v2-intel-secondary" VerticalAlignment="Top" Margin="0,0,8,0"
                          AutomationProperties.AutomationId="v2-intel-compare-toggle"
                          ToolTip.Tip="{Binding IntelCompare.ToggleCurrentTip}"
                          IsEnabled="{Binding IntelCompare.CanToggleCurrent}"
                          Command="{Binding IntelCompare.ToggleCurrentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="v2-icon" Width="16" Height="16" VerticalAlignment="Center"
                            IsVisible="{Binding IntelCompare.CurrentIsInTray}" Data="{DynamicResource V2.Icon.Check}" />
                      <Path Classes="v2-icon" Width="16" Height="16" VerticalAlignment="Center"
                            IsVisible="{Binding !IntelCompare.CurrentIsInTray}" Data="{DynamicResource V2.Icon.Plus}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding IntelCompare.ToggleCurrentLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain" VerticalAlignment="Top"
                          AutomationProperties.AutomationId="v2-shell-intel-close"
                          AutomationProperties.Name="{Binding IntelCloseLabel}" ToolTip.Tip="{Binding IntelCloseLabel}"
                          Command="{Binding CloseTransientCommand}">
                    <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                  </Button>
                </Grid>

                <!-- V2 rough package 30 (acceptance sweep): the footprint hugs its own cells.
                     Stretched across the pane with a 200px floor it was a 1350x200 empty box
                     holding a 128x64 grid — the concept's product photograph, minus the
                     photograph. It reads as a chip until there is real item artwork. -->
                <Border Classes="v2-intel-stage" HorizontalAlignment="Left"
                        AutomationProperties.Name="{Binding IntelSlotsLabel}">
                  <ItemsControl ItemsSource="{Binding IntelSlotCells}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="{Binding IntelSlotColumns}" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:Int32">
                        <Border Classes="v2-intel-cell" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}" TextWrapping="Wrap"
                           IsVisible="{Binding HasIntelItemDescription}" Text="{Binding IntelItemDescription}" />

                <StackPanel Spacing="2">
                  <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelKeyInfoHeading}"
                             Margin="0,4,0,4" />
                  <ItemsControl ItemsSource="{Binding IntelFacts}" AutomationProperties.AutomationId="v2-shell-intel-facts">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:V2ShellIntelFactViewModel">
                        <Border Classes="v2-intel-fact">
                          <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding Label}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding Value}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- #287 (Crafts & barters): what makes this item and what it goes into, read
                     off the same priced list the tab shows, filtered to this one item. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowsIntelTradeSection}">
                  <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelMadeByHeading}" />
                  <TextBlock Classes="v2-label" IsVisible="{Binding !HasIntelMadeBy}" Text="{Binding IntelNoneMadeByLabel}" />
                  <ItemsControl ItemsSource="{Binding IntelMadeBy}" AutomationProperties.AutomationId="v2-shell-intel-made-by">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="intelVm:IntelTradeRowViewModel">
                        <Border Classes="v2-intel-trade-row">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="v2-body" TextWrapping="Wrap" Text="{Binding InputsLabel}" />
                            <TextBlock Grid.Column="1" Classes="v2-intel-trade-profit" Text="{Binding ProfitLabel}"
                                       Classes.v2-intel-unavailable="{Binding ProfitIsUnknown}"
                                       Classes.v2-intel-poor="{Binding ProfitIsNegative}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelUsedInHeading}" Margin="0,8,0,0" />
                  <TextBlock Classes="v2-label" IsVisible="{Binding !HasIntelUsedIn}" Text="{Binding IntelNoneUsedInLabel}" />
                  <ItemsControl ItemsSource="{Binding IntelUsedIn}" AutomationProperties.AutomationId="v2-shell-intel-used-in">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="intelVm:IntelTradeRowViewModel">
                        <Border Classes="v2-intel-trade-row">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Classes="v2-body" TextWrapping="Wrap" Text="{Binding InputsLabel}" />
                              <TextBlock Classes="v2-label" Text="{Binding Output.Label}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="v2-intel-trade-profit" Text="{Binding ProfitLabel}"
                                       Classes.v2-intel-unavailable="{Binding ProfitIsUnknown}"
                                       Classes.v2-intel-poor="{Binding ProfitIsNegative}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              </Grid>
            </ScrollViewer>

            <Panel Grid.Row="1" IsVisible="{Binding IntelCompare.IsOpen}">
              <intel:IntelCompareView DataContext="{Binding IntelCompare}" />
            </Panel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Context panel. V2 rough package 30 (acceptance sweep): it only draws once something is
         selected. Every card inside it is bound to a selected item, so before one there is
         nothing to say, and the fixed 460px column read as a dead stripe down the right of the
         workspace on every landing — a quarter of the window at 1920 wide. -->
    <Border Grid.Column="1" Width="460" Classes="v2-intel-panel"
            IsVisible="{Binding ShowsIntelContextPanel}"
            AutomationProperties.AccessibilityView="Control"
            AutomationProperties.LandmarkType="Complementary"
            AutomationProperties.AutomationId="v2-intel-context">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="16,12,16,16">
          <!-- Need summary: how many to keep, why, and where it sells best. -->
          <Border Classes="v2-intel-accent" IsVisible="{Binding IntelHasResult}">
          <Border Classes="v2-intel-section">
            <StackPanel Spacing="10">
              <TextBlock Classes="v2-heading-2" AutomationProperties.HeadingLevel="2" Text="{Binding IntelVerdictHeadline}" />
              <TextBlock Classes="v2-label" TextWrapping="Wrap" IsVisible="{Binding HasIntelRecommendation}"
                         Text="{Binding IntelRecommendationReason}"
                         AutomationProperties.AutomationId="v2-intel-recommendation-reason" />
              <ItemsControl ItemsSource="{Binding IntelNeedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:V2IntelNeedLineViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,3">
                      <Panel>
                        <Path Classes="v2-icon v2-intel-yes" IsVisible="{Binding IsActive}" Data="{DynamicResource V2.Icon.Check}" />
                        <Path Classes="v2-icon v2-icon-muted" IsVisible="{Binding !IsActive}" Data="{DynamicResource V2.Icon.MinusCircle}" />
                      </Panel>
                      <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,3">
                <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Cart}" />
                <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="{Binding IntelBestSaleLabel}" />
              </StackPanel>
              <Button Classes="v2-target v2-intel-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Margin="0,6,0,0" IsVisible="{Binding IntelHasWikiLink}"
                      AutomationProperties.AutomationId="v2-shell-intel-wiki"
                      AutomationProperties.Name="{Binding IntelWikiLabel}"
                      Command="{Binding OpenIntelWikiCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Link}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding IntelWikiLabel}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          </Border>

          <!-- Package 33 (#287): "should I keep it," named rather than counted — which quests and
               which hideout levels, so far as the catalog knows them. -->
          <Border Classes="v2-intel-section" IsVisible="{Binding HasIntelKeepDetail}">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelKeepHeading}" />
              <ItemsControl ItemsSource="{Binding IntelKeepQuestLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="v2-body" Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding IntelKeepHideoutLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="v2-body" Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Prices: flea beside the best trader, the catalog's 24-hour range, and every channel. -->
          <Border Classes="v2-intel-accent" IsVisible="{Binding IntelHasResult}">
          <Border Classes="v2-intel-section">
            <StackPanel Spacing="12">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelPricesHeading}" />
              <TextBlock Classes="v2-label" IsVisible="{Binding IntelHasNoPrices}" Text="{Binding IntelNoPricesLabel}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="18" IsVisible="{Binding IntelHasPrices}">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Classes="v2-intel-price v2-intel-best" Text="{Binding IntelFleaPriceLabel}" />
                  <TextBlock Classes="v2-body" Text="{Binding IntelFleaCaption}" />
                  <TextBlock Classes="v2-label" Text="{Binding IntelPriceUpdatedLabel}" />
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource V2.Brush.SurfaceRaised}"
                           IsVisible="{Binding IntelHasTraderPrice}" />
                <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding IntelHasTraderPrice}">
                  <TextBlock Classes="v2-intel-price" Text="{Binding IntelTraderPriceLabel}" />
                  <TextBlock Classes="v2-body" Text="{Binding IntelTraderCaption}" />
                  <TextBlock Classes="v2-label" Text="{Binding IntelTraderDetail}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IntelHas24HourRange}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding Intel24HourLabel}" />
                <TextBlock Grid.Column="1" Classes="v2-label" HorizontalAlignment="Right"
                           Foreground="{DynamicResource V2.Brush.TextPrimary}" Text="{Binding Intel24HourRange}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IntelHasSevenDayHistory}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding IntelSevenDayLabel}" />
                <TextBlock Grid.Column="1" Classes="v2-label" HorizontalAlignment="Right"
                           Foreground="{DynamicResource V2.Brush.TextPrimary}" Text="{Binding IntelSevenDayRange}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasIntelPerSlotValue}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding IntelPerSlotHeading}" />
                <TextBlock Grid.Column="1" Classes="v2-label" HorizontalAlignment="Right"
                           Foreground="{DynamicResource V2.Brush.TextPrimary}" Text="{Binding IntelPerSlotValueLabel}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IntelHasPrices}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding IntelFeeHeading}" />
                <TextBlock Grid.Column="1" Classes="v2-label" HorizontalAlignment="Right"
                           Foreground="{DynamicResource V2.Brush.TextPrimary}" Text="{Binding IntelFeeLabel}" />
              </Grid>
              <Border Classes="v2-intel-fact" IsVisible="{Binding IntelHasSellingComparison}"
                      AutomationProperties.AutomationId="v2-intel-selling-comparison">
                <TextBlock Classes="v2-body" Text="{Binding IntelSellingComparison}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="8" IsVisible="{Binding IntelHasPrices}" Margin="0,6,0,0">
                <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding IntelSourcesHeading}" />
                <ItemsControl ItemsSource="{Binding IntelPriceSources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:V2IntelPriceSourceViewModel">
                      <Grid ColumnDefinitions="110,*,120" ColumnSpacing="12" Margin="0,4">
                        <TextBlock Grid.Column="0" Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Classes="v2-intel-bar" Value="{Binding Share}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="v2-body" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Classes.v2-intel-unavailable="{Binding !IsAvailable}" Text="{Binding ValueLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding IntelHasResult}"
                  AutomationProperties.AutomationId="v2-intel-where-to-buy">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2"
                         Text="{Binding IntelWhereToBuyHeading}" />
              <TextBlock Classes="v2-label" IsVisible="{Binding !HasIntelAcquisitionSources}"
                         Text="{Binding IntelNoAcquisitionSourcesLabel}" />
              <ItemsControl ItemsSource="{Binding IntelAcquisitionSources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:V2IntelAcquisitionSourceViewModel">
                    <Border Classes="v2-intel-fact" Opacity="{Binding Opacity}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding Source}" />
                          <TextBlock Classes="v2-label" Text="{Binding Requirement}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding Cost}"
                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- What a key opens. -->
          <Border Classes="v2-intel-section" IsVisible="{Binding IntelIsKey}">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelOpensHeading}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Map}" />
                <TextBlock Classes="v2-body" VerticalAlignment="Center" Text="{Binding IntelKeyMapLabel}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding IntelKeyLocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="v2-body" Margin="34,2,0,2" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- An ammo round's ballistics. -->
          <Border Classes="v2-intel-section" IsVisible="{Binding IntelIsAmmo}">
            <StackPanel Spacing="10">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{Binding IntelBallisticsHeading}" />
              <TextBlock Classes="v2-label" IsVisible="{Binding IntelHasNoAmmoFacts}" Text="{Binding IntelAmmoUnknownLabel}" />
              <StackPanel Spacing="8" IsVisible="{Binding IntelHasAmmoFacts}">
                <StackPanel Spacing="2">
                  <TextBlock Classes="v2-intel-price" Text="{Binding IntelAmmoCaliber}" />
                  <TextBlock Classes="v2-label" Text="Caliber" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="v2-intel-price" Text="{Binding IntelAmmoDamage}" />
                    <TextBlock Classes="v2-label" Text="{Binding IntelDamageLabel}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="v2-intel-price" Text="{Binding IntelAmmoPenetration}" />
                    <TextBlock Classes="v2-label" Text="{Binding IntelPenetrationLabel}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Classes="v2-intel-price" Text="{Binding IntelAmmoTier}" />
                    <TextBlock Classes="v2-label" Text="{Binding IntelTierLabel}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <TextBlock Classes="v2-body" IsVisible="{Binding IntelHasAmmoFacts}" Text="{Binding IntelAmmoAdvice}" TextWrapping="Wrap" />
              <StackPanel Spacing="6" IsVisible="{Binding IntelHasAmmoFacts}">
                <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding IntelArmorClassesHeading}" />
                <ItemsControl ItemsSource="{Binding IntelArmorClasses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:V2IntelArmorClassViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Classes="v2-body" Text="{Binding ClassLabel, StringFormat='Class {0}'}" />
                        <TextBlock Grid.Column="1" Classes="v2-body" FontWeight="SemiBold"
                                   Classes.v2-intel-good="{Binding IsStrong}"
                                   Classes.v2-intel-fair="{Binding IsMarginal}"
                                   Classes.v2-intel-poor="{Binding IsWeak}"
                                   Text="{Binding Rating}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
