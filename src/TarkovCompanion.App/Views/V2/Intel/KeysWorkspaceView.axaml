<UserControl x:Class="TarkovCompanion.App.Views.V2.Intel.KeysWorkspaceView"
             x:DataType="vm:KeysWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Intel"
             xmlns:pages="using:TarkovCompanion.App.ViewModels">
  <UserControl.Styles>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
  </UserControl.Styles>

  <!-- V1's Keys page in the Intel layout: filter and verdict chips across the top, the keys as
       rows (verdict, then the map, locks, uses and cost behind it), and the chosen key's reason
       and locks in the context panel. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <Border Grid.Row="0" Classes="v2-intel-search">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
                Data="{DynamicResource V2.Icon.Search}" />
          <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchQuery}"
                   PlaceholderText="{x:Static l:IntelText.KeysFilterPlaceholder}"
                   AutomationProperties.AutomationId="v2-keys-search"
                   AutomationProperties.Name="{x:Static l:IntelText.KeysFilterKeys}" />
          <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain"
                  AutomationProperties.AutomationId="v2-keys-reload"
                  AutomationProperties.Name="{x:Static l:IntelText.KeysReloadKeys}" ToolTip.Tip="{x:Static l:IntelText.KeysReload}"
                  Command="{Binding RefreshCommand}">
            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Refresh}" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="v2-intel-pane" Padding="14"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-keys-list">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <!-- [#902 P8] Learn mode changes this page's text, so its switch is here too. -->
          <ToggleButton Grid.Row="0" HorizontalAlignment="Right" Classes="v2-target v2-intel-chip v2-intel-chip-small" VerticalAlignment="Center"
                            Content="{x:Static l:PlanText.Learn}" IsChecked="{Binding LearnMode.IsEnabled}"
                            AutomationProperties.AutomationId="v2-keys-learn-mode"
                            AutomationProperties.Name="{x:Static l:PlanText.LearnMode}" />
          <ItemsControl Grid.Row="0" ItemsSource="{Binding VerdictFilters}" Margin="0,0,72,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeyVerdictChipViewModel">
                <Button Classes="v2-target v2-intel-chip" Classes.selected="{Binding IsSelected}"
                        AutomationProperties.AutomationId="{Binding AutomationId}"
                        AutomationProperties.Name="{Binding Label}"
                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Row="1" Spacing="2" Margin="2,0">
            <TextBlock Classes="v2-label" IsVisible="{Binding ShowsKeyCount}" Text="{Binding KeyCountLabel}" />
            <TextBlock Classes="v2-label" Text="{Binding Status}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>

          <!-- [#453] Virtualised: several hundred keys drawn at once held the interface thread for
               over half a second on the first visit. Only the rows in view are built. -->
          <Panel Grid.Row="2">
              <StackPanel VerticalAlignment="Top" Spacing="4" IsVisible="{Binding ShowsNoKeys}">
                <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                           Text="{Binding NoKeysLabel}" TextWrapping="Wrap" Margin="2,8" />
                <Button Classes="v2-outline" HorizontalAlignment="Left" Margin="2,0"
                        IsVisible="{Binding ShowsFilterReset}" Command="{Binding ClearFilterCommand}"
                        Content="{x:Static l:FilterText.ShowAll}" AutomationProperties.AutomationId="v2-keys-show-all" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Keys}" IsVisible="{Binding HasKeys}">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyListRowViewModel">
                    <Button Classes="v2-target v2-intel-row" Classes.selected="{Binding IsSelected}"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="2">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="v2-body" FontWeight="SemiBold"
                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="v2-body" FontWeight="SemiBold"
                                   Classes.v2-intel-good="{Binding IsKeep}"
                                   Classes.v2-intel-fair="{Binding IsKeepForLater}"
                                   Classes.v2-intel-poor="{Binding IsSell}"
                                   Text="{Binding VerdictLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="v2-label" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Map}" /><Run Text=" · " /><Run Text="{Binding LockSummary}" /><Run Text=" · " /><Run Text="{Binding Uses}" />
                        </TextBlock>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <TextBlock Classes="v2-label" Text="{Binding Owned}" IsVisible="{Binding HasOwned}"
                                     Foreground="{DynamicResource V2.Brush.Action}" />
                          <TextBlock Classes="v2-label" Text="{Binding Cost}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="v2-label" Text="{Binding LearnReason}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource V2.Brush.Action}"
                                   IsVisible="{Binding $parent[UserControl].((vm:KeysWorkspaceViewModel)DataContext).LearnMode.IsEnabled}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <!-- Context panel: the chosen key. -->
    <Border Grid.Column="1" Width="460" Classes="v2-intel-panel"
            AutomationProperties.AccessibilityView="Control"
            AutomationProperties.LandmarkType="Complementary"
            AutomationProperties.AutomationId="v2-keys-context">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="16,12,16,16">
          <Border Classes="v2-intel-section" IsVisible="{Binding ShowsNoSelectedKey}">
            <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                       TextWrapping="Wrap" Text="{x:Static l:IntelText.KeysNoKeySelected}" />
          </Border>

          <Border Classes="v2-intel-accent" IsVisible="{Binding HasSelectedKey}">
            <Border Classes="v2-intel-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-2" AutomationProperties.HeadingLevel="2" TextWrapping="Wrap"
                           Text="{Binding SelectedName}" />
                <TextBlock Classes="v2-heading-3" Text="{Binding SelectedVerdict}"
                           Classes.v2-intel-good="{Binding SelectedIsKeep}"
                           Classes.v2-intel-fair="{Binding SelectedIsKeepForLater}"
                           Classes.v2-intel-poor="{Binding SelectedIsSell}" />
                <TextBlock Classes="v2-body" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-keys-owned"
                           IsVisible="{Binding HasSelectedOwned}" Text="{Binding SelectedOwned}" />
                <TextBlock Classes="v2-body" TextWrapping="Wrap" IsVisible="{Binding HasSelectedReason}"
                           Text="{Binding SelectedReason}" />
                <Button Classes="v2-target v2-intel-secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Margin="0,6,0,0"
                        AutomationProperties.AutomationId="v2-keys-open-intel"
                        AutomationProperties.Name="{x:Static l:IntelText.KeysOpenInIntel}"
                        Command="{Binding OpenInIntelCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Link}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static l:IntelText.KeysPricesAndNeeds}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding HasSelectedKey}">
            <StackPanel Spacing="4">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{x:Static l:IntelText.KeysKey}" Margin="0,0,0,4" />
              <Border Classes="v2-intel-fact">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                  <TextBlock Classes="v2-label" Text="{x:Static l:IntelText.KeysMap}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding SelectedMap}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="v2-intel-fact">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                  <TextBlock Classes="v2-label" Text="{x:Static l:IntelText.KeysLocks}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding SelectedLocks}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="v2-intel-fact">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                  <TextBlock Classes="v2-label" Text="{x:Static l:IntelText.KeysUses}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding SelectedUses}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="v2-intel-fact">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                  <TextBlock Classes="v2-label" Text="{x:Static l:IntelText.KeysCost}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding SelectedCost}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <TextBlock Classes="v2-label" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SelectedProvenance}" />
            </StackPanel>
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding HasSelectedLockIds}">
            <StackPanel Spacing="6">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{x:Static l:IntelText.KeysLocksOpened}" />
              <ItemsControl ItemsSource="{Binding SelectedLockIds}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:KeyLockViewModel">
                    <TextBlock Classes="v2-label" Margin="0,2" Text="{Binding LockId}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
