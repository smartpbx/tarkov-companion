<UserControl x:Class="TarkovCompanion.App.Views.V2.Intel.FleaWorkspaceView"
             x:DataType="vm:FleaWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Intel"
             xmlns:v2vm="using:TarkovCompanion.App.ViewModels.V2"
             xmlns:pages="using:TarkovCompanion.App.ViewModels"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives">
  <UserControl.Styles>
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
    <!-- [f920 capture] A photographed offer's verdict chip and row. -->
    <Style Selector="Border.v2-flea-verdict">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <Style Selector="Border.v2-flea-verdict.good">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Border.v2-flea-verdict.good TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="TextBlock.v2-flea-offer-stale">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="Border.v2-flea-scan-row">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>

  <!-- V1's Flea page in the Intel layout: look up an item, read its price, where it sells best and
       what a slot of it is worth; the context panel keeps the item's locally stored observations
       and the offers the game reported sold while the player was busy. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <!-- [f920 capture] #284: the flea screen the player photographed. Each row stands beside
           what a trader pays and what the 24 h average returns after its fee. -->
      <Border Grid.Row="1" Classes="v2-intel-pane" Padding="14" IsVisible="{Binding HasScan}" MaxHeight="480"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-flea-scan">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6" DataContext="{Binding Scan}" x:DataType="vm:FleaScanViewModel">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="v2-heading-3" Text="{Binding Heading}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center" Text="{Binding SummaryLabel}" />
          </Grid>
          <StackPanel Grid.Row="1" Spacing="2">
            <!-- #284: the ranking is of offers as they stood in the screenshot, never live ones. -->
            <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="{Binding ObservedLabel}" TextWrapping="Wrap"
                       Classes.v2-flea-offer-stale="{Binding IsOfferStale}"
                       AutomationProperties.AutomationId="v2-flea-scan-observed" />
            <TextBlock Classes="v2-body" Text="{Binding TraderLabel}" TextWrapping="Wrap" />
            <TextBlock Classes="v2-body" Text="{Binding AverageLabel}" TextWrapping="Wrap" />
            <TextBlock Classes="v2-label" Text="{Binding ItemLabel}" TextWrapping="Wrap" />
            <!-- #712 1-12: a misread name is put right from the other items it could be. -->
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasIdentityChoices}"
                       ToolTip.Tip="{Binding IdentityChoicesTip}">
              <TextBlock Classes="v2-label" VerticalAlignment="Center" Margin="0,0,6,0"
                         Text="{Binding IdentityChoicesLabel}" />
              <ItemsControl ItemsSource="{Binding IdentityChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="v2vm:IdentityChoiceViewModel">
                    <Button Classes="v2-target" Margin="0,0,6,0" Content="{Binding Label}"
                            Command="{Binding ChooseCommand}"
                            AutomationProperties.AutomationId="{Binding AutomationId}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>
            <TextBlock Classes="v2-label" Text="{Binding MarketDataNote}" TextWrapping="Wrap"
                       IsVisible="{Binding HasMarketDataNote}" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <!-- [#314] The rank column is as wide as its longest label, never under 78, and the
                 same on every row: at a fixed 78 "#1 best buy" wrapped in a longer language. -->
            <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FleaScanRowViewModel">
                  <Border Classes="v2-flea-scan-row" Padding="10,6" Margin="0,2"
                          AutomationProperties.AutomationId="{Binding AutomationId}">
                    <Grid ColumnSpacing="14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="78" SharedSizeGroup="FleaScanRank" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Classes="v2-label" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 Text="{Binding RankLabel}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Classes="v2-body" FontWeight="SemiBold" Text="{Binding PriceLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding StackLabel}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding ConditionLabel}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <!-- #842: the engine's sentence, rules version and raw read are details, on hover. -->
                      <StackPanel Grid.Column="2" Spacing="1" Background="Transparent" ToolTip.Tip="{Binding DetailsLabel}">
                        <TextBlock Classes="v2-body" Text="{Binding WhyLabel}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-label" Text="{Binding ConfidenceLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding AlternativesLabel}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasAlternatives}" />
                      </StackPanel>
                      <Border Grid.Column="3" Classes="v2-flea-verdict" Classes.good="{Binding IsGoodBuy}"
                              VerticalAlignment="Center" Padding="8,3" CornerRadius="4">
                        <TextBlock Classes="v2-label" FontWeight="SemiBold" Text="{Binding VerdictLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
      <Border Grid.Row="0" Classes="v2-intel-search">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
                Data="{DynamicResource V2.Icon.Search}" />
          <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchQuery}"
                   PlaceholderText="{x:Static l:IntelText.FleaLookUpPlaceholder}"
                   AutomationProperties.AutomationId="v2-flea-search"
                   AutomationProperties.Name="{x:Static l:IntelText.FleaLookUpPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain"
                  AutomationProperties.AutomationId="v2-flea-search-go"
                  AutomationProperties.Name="{x:Static l:IntelText.FleaLookUpValue}" ToolTip.Tip="{x:Static l:IntelText.FleaLookUpValue}"
                  Command="{Binding SearchCommand}">
            <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Search}" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="v2-intel-pane" Padding="14"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-flea-results">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <TextBlock Grid.Row="0" Classes="v2-label" Text="{Binding SearchStatus}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="v2-flea-search-status"
                     AutomationProperties.LiveSetting="Polite" Margin="2,0" />
          <StackPanel Grid.Row="1" Spacing="10" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding ShowsNoResults}">
            <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
              <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Cart}" />
            </Viewbox>
            <TextBlock Classes="v2-heading-3" HorizontalAlignment="Center" Text="{x:Static l:IntelText.FleaTitle}" />
            <TextBlock Classes="v2-label" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Static l:IntelText.FleaEmptyHint}" />
          </StackPanel>
          <!-- A search that threw: words and Retry where the rows would be; the exception is in the log. -->
          <prim:V2LoadFaultNotice Grid.Row="1" DataContext="{Binding SearchFault}" MaxWidth="480"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding HasResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FleaListRowViewModel">
                  <Button Classes="v2-target v2-intel-row" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Name}"
                          Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="2">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="v2-body" FontWeight="SemiBold"
                                 Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="v2-body" FontWeight="SemiBold"
                                 Text="{Binding FleaPrice}" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Classes="v2-label" Text="{Binding BestSale}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="v2-label" Text="{Binding ValuePerSlot}" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Classes="v2-label" Text="{Binding DailyBand}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="v2-label" Text="{Binding Dimensions}" />
                      <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="v2-label" Text="{Binding SevenDayBand}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Context panel: sales while playing, and the chosen item's stored observations. -->
    <Border Grid.Column="1" Width="460" Classes="v2-intel-panel"
            AutomationProperties.AccessibilityView="Control"
            AutomationProperties.LandmarkType="Complementary"
            AutomationProperties.AutomationId="v2-flea-context">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="16,12,16,16">
          <Border Classes="v2-intel-accent" IsVisible="{Binding HasSelection}">
            <Border Classes="v2-intel-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-2" AutomationProperties.HeadingLevel="2" TextWrapping="Wrap"
                           Text="{Binding SelectedName}" />
                <TextBlock Classes="v2-intel-price v2-intel-best" Text="{Binding SelectedPrice}" />
                <TextBlock Classes="v2-body" TextWrapping="Wrap" Text="{Binding SelectedBestSale}" />
                <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding SelectedBand}" />
                <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding SelectedSevenDayBand}" />
                <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding SelectedValuePerSlot}" />
                <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding SelectedProvenance}" />
                <Button Classes="v2-target v2-intel-secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Margin="0,6,0,0"
                        AutomationProperties.AutomationId="v2-flea-open-intel"
                        AutomationProperties.Name="{x:Static l:IntelText.FleaOpenInIntel}"
                        Command="{Binding OpenInIntelCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Link}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static l:IntelText.FleaPricesAndNeeds}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding !HasSelection}">
            <TextBlock Classes="v2-body" Foreground="{DynamicResource V2.Brush.TextSecondary}"
                       TextWrapping="Wrap" Text="{x:Static l:IntelText.FleaPickForHistory}" />
          </Border>

          <Border Classes="v2-intel-section" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{x:Static l:IntelText.FleaObservedPrices}" />
              <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding HistoryStatus}" />
              <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding HasHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:FleaHistoryPointViewModel">
                    <Border Classes="v2-intel-fact">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding Observed}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="v2-body" Text="{Binding FleaPrice}" />
                        <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding TraderValue}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="v2-intel-section">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" AutomationProperties.HeadingLevel="2" Text="{x:Static l:IntelText.FleaSoldWhilePlaying}" />
              <TextBlock Classes="v2-label" TextWrapping="Wrap" Text="{Binding SalesStatus}" />
              <ItemsControl ItemsSource="{Binding Sales}" IsVisible="{Binding HasSales}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:FleaSaleViewModel">
                    <Border Classes="v2-intel-fact">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <TextBlock Grid.Column="0" Classes="v2-body" Text="{Binding Item}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="v2-body" FontWeight="SemiBold" Text="{Binding Quantity}" />
                        <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Observed}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
