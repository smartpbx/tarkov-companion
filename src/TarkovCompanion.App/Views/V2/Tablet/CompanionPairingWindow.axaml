<Window
    x:Class="TarkovCompanion.App.Views.V2.Tablet.CompanionPairingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Tablet"
    x:DataType="vm:CompanionPairingViewModel"
    Title="Companion pairing"
    Width="480" MinWidth="420" SizeToContent="Height" MinHeight="240"
    CanResize="True">
  <ScrollViewer MaxHeight="640">
    <StackPanel Classes="v2-stack" Margin="16" Spacing="14">
      <TextBlock Classes="v2-heading-3" Text="Companion pairing" />

      <TextBlock Classes="v2-body" Text="{Binding UnavailableReason}" IsVisible="{Binding !CanPair}"
                  TextWrapping="Wrap" />

      <StackPanel Classes="v2-stack" IsVisible="{Binding CanPair}" Spacing="14">
        <Border Classes="v2-card" IsVisible="{Binding CanClaimRelay}">
          <StackPanel Classes="v2-stack" Spacing="8">
            <TextBlock Classes="v2-heading-3" Text="Claim this relay" />
            <TextBlock Classes="v2-body" TextWrapping="Wrap"
                       Text="Type the relay's admin key to make this desktop its owner. The key is used once and never stored." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding AdminKeyInput}" PasswordChar="•" PlaceholderText="Admin key" Width="220" />
              <Button Classes="v2-target" Content="Claim" Command="{Binding ClaimRelayCommand}" IsEnabled="{Binding !IsClaimingRelay}" />
            </StackPanel>
            <TextBlock Classes="v2-label" Text="Claimed by this desktop." IsVisible="{Binding IsClaimedByThisDesktop}" />
            <TextBlock Classes="v2-label" Text="{Binding RelayClaimMessage}" IsVisible="{Binding HasRelayClaimMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="v2-card">
          <StackPanel Classes="v2-stack" Spacing="8">
            <TextBlock Classes="v2-heading-3" Text="Add a device" />

            <Button Classes="v2-target" Content="Start pairing" Command="{Binding StartPairingCommand}"
                    IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsIdle}" />

            <StackPanel Spacing="6" IsVisible="{Binding IsAwaitingTablet}">
              <TextBlock Classes="v2-body" Text="On the tablet, open the group relay's /tablet page and enter this code:" TextWrapping="Wrap" />
              <TextBlock Classes="v2-heading-3" Text="{Binding PairingCode}" FontFamily="monospace" />
              <TextBlock Classes="v2-label" Text="Or scan (QR payload):" />
              <TextBox Text="{Binding QrPayload}" IsReadOnly="True" FontFamily="monospace" />
              <TextBlock Classes="v2-label" Text="Waiting for the tablet…" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsAwaitingApproval}">
              <TextBlock Classes="v2-body">
                <Run Text="&quot;" /><Run Text="{Binding RequestedDisplayName}" /><Run Text="&quot; wants to pair. Confirm it shows the same code:" />
              </TextBlock>
              <TextBlock Classes="v2-heading-3" Text="{Binding VerificationCode}" FontFamily="monospace" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="v2-target" Content="Approve" Command="{Binding ApproveCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Classes="v2-target" Content="Deny" Command="{Binding DenyCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="v2-label" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" />
          </StackPanel>
        </Border>

        <Border Classes="v2-card">
          <StackPanel Classes="v2-stack" Spacing="8">
            <TextBlock Classes="v2-heading-3" Text="Paired devices" />
            <TextBlock Classes="v2-body" Text="No devices are paired yet." IsVisible="{Binding HasNoDevices}" />
            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PairedDeviceRowViewModel">
                  <Border BorderBrush="#22303d" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="v2-body" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="v2-label" Text="{Binding Role}" />
                        <TextBlock Classes="v2-label" Text="{Binding Status}" />
                        <TextBlock Classes="v2-label" Text="{Binding LastUsedUtc}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="v2-target" Content="Revoke"
                              Command="{Binding RevokeCommand}" IsEnabled="{Binding CanRevoke}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
