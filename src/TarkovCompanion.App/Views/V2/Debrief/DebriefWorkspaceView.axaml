<UserControl x:Class="TarkovCompanion.App.Views.V2.Debrief.DebriefWorkspaceView"
             x:DataType="vm:DebriefWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Debrief"
             xmlns:local="using:TarkovCompanion.App.Views.V2.Debrief"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:prim="using:TarkovCompanion.App.Views.V2.Primitives">
  <UserControl.Styles>
    <!-- The search box and filter chip shapes Plan and Intel already use. -->
    <StyleInclude Source="avares://TarkovCompanion/Views/V2/Intel/IntelStyles.axaml" />
    <!-- The same flat pane, context panel and section shapes as the Raid and Team workspaces. -->
    <Style Selector="Border.v2-debrief-pane">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.v2-debrief-panel">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.v2-debrief-section">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Density.Standard.Inset}" />
    </Style>
    <Style Selector="Border.v2-debrief-section.v2-debrief-accent">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <!-- The app-wide Button padding (12,7) reaches the date picker's own flyout button and pushed
         "month / day / year" to the top edge of the field. The picker takes no inset of its own and
         centres its three parts, so it lines up with the filter chips beside it. -->
    <!-- [#574] The desktop control height, like the chips and drop-down on the same rows. -->
    <Style Selector="DatePicker">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Height" Value="{DynamicResource V2.Target.Desktop}" />
    </Style>
    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="DatePicker /template/ TextBlock#PART_MonthTextBlock, DatePicker /template/ TextBlock#PART_DayTextBlock, DatePicker /template/ TextBlock#PART_YearTextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.v2-debrief-muted">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <!-- Where a fact came from (Observed, Inferred, Estimate, Manual): a small outlined tag, in the
         Keep list's chip shape, so it reads as a label and never as a value. -->
    <Style Selector="Border.v2-debrief-kind">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.v2-debrief-kind TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource V2.Type.Label.Size}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.v2-debrief-strong">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextPrimary}" />
    </Style>
    <Style Selector="Grid.v2-debrief-columns > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A raid row: flat, a tint and cyan leading edge when selected, like the rail. -->
    <Style Selector="Button.v2-debrief-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="17,12,20,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.v2-debrief-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
    <Style Selector="Button.v2-debrief-row.selected">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>

    <Style Selector="Button.v2-debrief-primary">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Control.Large.Height}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.v2-debrief-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.v2-debrief-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Button.v2-debrief-plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 17 (home): Debrief has no concept render of its own, so it takes the
       Raid/Team layout — the raid table as the primary pane, the selected raid's detail and its
       correction in a right context panel. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <!-- The title and the action row used to share one Grid row ("*,Auto"): at 1024px wide the
           actions' Auto column always won its full width, the title's Star column was squeezed to
           a sliver, and StackPanel does not clip, so "Raid history" painted on top of "Refresh" /
           "Export CSV" / "Export JSON" (docs/design/v2/revisions/README.md, narrow-1024x768 capture,
           #291). A WrapPanel measures both blocks and drops the actions to a second line instead of
           overlapping the first, at any width, and still reads as one row at 1920x1080. -->
      <WrapPanel Grid.Row="0" ItemSpacing="16" LineSpacing="8" MinHeight="48">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="v2-heading-2" Text="{x:Static l:DebriefText.RaidHistory}" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" />
          <TextBlock Classes="v2-debrief-muted" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.AutomationId="v2-debrief-status"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="v2-target v2-debrief-plain" AutomationProperties.AutomationId="v2-debrief-refresh"
                  AutomationProperties.Name="{x:Static l:DebriefText.Refresh}" Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Refresh}" />
              <TextBlock Text="{x:Static l:DebriefText.Refresh}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="v2-target v2-debrief-plain" AutomationProperties.AutomationId="v2-debrief-export-csv"
                  Content="{x:Static l:DebriefText.ExportCsv}" Command="{Binding ExportCsvCommand}" />
          <Button Classes="v2-target v2-debrief-plain" AutomationProperties.AutomationId="v2-debrief-export-json"
                  Content="{x:Static l:DebriefText.ExportJson}" Command="{Binding ExportJsonCommand}" />
        </StackPanel>
        <!-- #291: the raid list, or coverage and charts over the same filtered raids. -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsListView}"
                  AutomationProperties.AutomationId="v2-debrief-view-list"
                  Content="{x:Static l:DebriefText.Raids}" Command="{Binding ShowListCommand}" />
          <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsStatsView}"
                  AutomationProperties.AutomationId="v2-debrief-view-stats"
                  Content="{x:Static l:DebriefText.Stats}" Command="{Binding ShowStatsCommand}" />
          <Button Classes="v2-target v2-debrief-plain" IsVisible="{Binding HasArchived}"
                  AutomationProperties.AutomationId="v2-debrief-archived-toggle"
                  Content="{Binding ArchiveToggleLabel}" Command="{Binding ToggleArchivedCommand}" />
          <!-- #269: raids from other profiles, modes and wipes are out of the list and totals until this. -->
          <Button Classes="v2-target v2-debrief-plain" IsVisible="{Binding HasOtherContexts}"
                  AutomationProperties.AutomationId="v2-debrief-context-toggle"
                  Content="{Binding ContextToggleLabel}" Command="{Binding ToggleContextCommand}" />
        </StackPanel>
      </WrapPanel>

      <!-- #291 package 3: the one-press undo for the delete that just happened, while the page is
           open. A new delete (or the app restarting) is what finally purges what it covers — see
           SqliteRaidHistoryService.PurgeDeletedAsync. -->
      <Border Grid.Row="1" Classes="v2-debrief-section v2-debrief-accent" Padding="16,10"
              IsVisible="{Binding CanUndoDelete}" AutomationProperties.AutomationId="v2-debrief-undo-banner">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="v2-debrief-muted" Text="{Binding UndoDeleteSummary}" VerticalAlignment="Center" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Grid.Column="1" Classes="v2-target v2-debrief-plain" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="v2-debrief-undo"
                  Content="{x:Static l:DebriefText.Undo}" Command="{Binding UndoDeleteCommand}" />
        </Grid>
      </Border>

      <!-- Search and filters (#291 package 2): map, outcome, side, a date range and free text over
           notes. The per-map stats below follow this same filtered set. -->
      <Border Grid.Row="2" Classes="v2-debrief-pane" Padding="16,12" AutomationProperties.AutomationId="v2-debrief-filters">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Classes="v2-intel-search">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Path Grid.Column="0" Classes="v2-icon v2-icon-muted" VerticalAlignment="Center"
                      Data="{DynamicResource V2.Icon.Search}" />
                <TextBox Grid.Column="1" Classes="v2-intel-search-input" Text="{Binding SearchText}"
                         PlaceholderText="{x:Static l:DebriefText.SearchNotes}"
                         AutomationProperties.AutomationId="v2-debrief-search"
                         AutomationProperties.Name="{x:Static l:DebriefText.SearchNotes}" />
                <Button Grid.Column="2" Classes="v2-target v2-icon-btn v2-intel-plain" IsVisible="{Binding HasSearchText}"
                        AutomationProperties.AutomationId="v2-debrief-search-clear"
                        AutomationProperties.Name="{x:Static l:DebriefText.ClearSearch}" ToolTip.Tip="{x:Static l:DebriefText.ClearSearch}"
                        Command="{Binding ClearSearchCommand}">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                </Button>
              </Grid>
            </Border>
            <Button Grid.Column="1" Classes="v2-target v2-debrief-plain" IsVisible="{Binding HasActiveFilters}"
                    Content="{x:Static l:DebriefText.ClearFilters}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="v2-debrief-filters-clear" />
          </Grid>
          <WrapPanel ItemSpacing="18" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Map}" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding MapFilterOptions}" SelectedItem="{Binding SelectedMapFilterOption}"
                        MinWidth="160" AutomationProperties.AutomationId="v2-debrief-filter-map"
                        AutomationProperties.Name="{x:Static l:DebriefText.Map}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DebriefMapFilterOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Tag}" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding TagFilterOptions}" SelectedItem="{Binding SelectedTagFilterOption}"
                        MinWidth="130" AutomationProperties.AutomationId="v2-debrief-filter-tag"
                        AutomationProperties.Name="{x:Static l:DebriefText.Tag}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DebriefTagFilterOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding OutcomeFilterChips}" AutomationProperties.AutomationId="v2-debrief-filter-outcome">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DebriefFilterChipViewModel">
                  <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Label}"
                          Content="{Binding Label}" Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SideFilterChips}" AutomationProperties.AutomationId="v2-debrief-filter-side">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DebriefFilterChipViewModel">
                  <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Label}"
                          Content="{Binding Label}" Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- [#828] From and To are two items, not one, so each can take a line of its own. As one
                 StackPanel the pair needed about 700 and a 960-wide shell (1920 at 200%) left the
                 pane about 410: the To picker ran off the right-hand edge, where WrapPanel cannot
                 help because it never splits an item. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.From}" VerticalAlignment="Center" />
              <DatePicker SelectedDate="{Binding DateFrom}"
                          AutomationProperties.AutomationId="v2-debrief-filter-date-from"
                          AutomationProperties.Name="{x:Static l:DebriefText.FromDate}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.To}" VerticalAlignment="Center" />
              <DatePicker SelectedDate="{Binding DateTo}"
                          AutomationProperties.AutomationId="v2-debrief-filter-date-to"
                          AutomationProperties.Name="{x:Static l:DebriefText.ToDate}" />
            </StackPanel>
          </WrapPanel>

          <Border BorderBrush="{DynamicResource V2.Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <WrapPanel ItemSpacing="8" LineSpacing="6">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.SavedViews}" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedSavedView}"
                        MinWidth="150" IsVisible="{Binding HasSavedViews}"
                        AutomationProperties.AutomationId="v2-debrief-saved-view">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DebriefSavedView">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="v2-target v2-debrief-plain" Content="{x:Static l:DebriefText.Apply}" IsVisible="{Binding HasSavedViews}"
                      Command="{Binding ApplySavedViewCommand}"
                      AutomationProperties.AutomationId="v2-debrief-saved-view-apply" />
              <Button Classes="v2-target v2-debrief-plain" Content="{x:Static l:DebriefText.Delete}" IsVisible="{Binding HasSavedViews}"
                      Command="{Binding DeleteSavedViewCommand}"
                      AutomationProperties.AutomationId="v2-debrief-saved-view-delete" />
              <TextBox Classes="v2-field-input" Width="170" MaxLength="32" Text="{Binding SavedViewName}"
                       PlaceholderText="{x:Static l:DebriefText.ViewName}" AutomationProperties.Name="{x:Static l:DebriefText.ViewName}"
                       AutomationProperties.AutomationId="v2-debrief-saved-view-name" />
              <Button Classes="v2-target v2-debrief-plain" Content="{x:Static l:DebriefText.SaveCurrent}"
                      Command="{Binding SaveViewCommand}"
                      AutomationProperties.AutomationId="v2-debrief-saved-view-save" />
            </WrapPanel>
          </Border>

          <!-- #291 package 3: bulk delete, with the same preview-then-confirm shape as the single
               raid delete below. Kept beside the date range it reads. -->
          <Border BorderBrush="{DynamicResource V2.Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Spacing="8">
              <WrapPanel ItemSpacing="10" LineSpacing="6" IsVisible="{Binding !IsConfirmingBulkDelete}">
                <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.DeleteRaidsBefore}" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding DeleteBeforeDate}"
                            AutomationProperties.AutomationId="v2-debrief-delete-before-date"
                            AutomationProperties.Name="{x:Static l:DebriefText.DeleteRaidsBeforeDate}" />
                <Button Classes="v2-target v2-debrief-plain"
                        AutomationProperties.AutomationId="v2-debrief-delete-before-begin"
                        Content="{x:Static l:DebriefText.DeleteBefore}" Command="{Binding BeginBulkDeleteCommand}" />
              </WrapPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingBulkDelete}"
                          AutomationProperties.AutomationId="v2-debrief-delete-before-preview">
                <TextBlock Classes="v2-debrief-muted" Text="{Binding BulkDeletePreviewLabel}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="v2-target" Foreground="{DynamicResource V2.Brush.Danger}"
                          BorderBrush="{DynamicResource V2.Brush.Danger}"
                          AutomationProperties.AutomationId="v2-debrief-delete-before-confirm"
                          Content="{x:Static l:DebriefText.Delete}" Command="{Binding ConfirmBulkDeleteCommand}" />
                  <Button Classes="v2-target v2-debrief-plain"
                          AutomationProperties.AutomationId="v2-debrief-delete-before-cancel"
                          Content="{x:Static l:DebriefText.Cancel}" Command="{Binding CancelBulkDeleteCommand}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- V2 rough package 32: the table is the height of the raids in it. Stretched to the row
           it was a full-height bordered card holding a single line, which at 1920x1080 is about
           85% of the card drawn empty and reads as a page that failed to load. VerticalAlignment
           Top with a stretch MaxHeight means a long history still fills the window and scrolls. -->
      <Border Grid.Row="3" Classes="v2-debrief-pane" VerticalAlignment="Top"
              MaxHeight="{Binding $parent[Grid].Bounds.Height}" IsVisible="{Binding IsListView}"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.AutomationId="v2-debrief-history">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <Border Grid.Row="1" BorderBrush="{DynamicResource V2.Brush.Divider}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,2*,*,2*" ColumnSpacing="16">
              <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Map}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Mode}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Started}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Duration}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Outcome}" FontWeight="SemiBold" />
            </Grid>
          </Border>
          <!-- V2 rough package 26 (log facts): per-map stats, measured from raid history. The
               survival rate, which rests on outcomes the player types, is in Stats under a Manual
               tag rather than here beside the measured columns. Drawn above the raid table's column heads, not
               between them and the rows: under "Mode" and "Started" its own columns read as a
               misaligned raid. -->
          <Border Grid.Row="0" IsVisible="{Binding ShowsMapStatsStrip}" Background="{DynamicResource V2.Brush.Canvas}"
                  BorderBrush="{DynamicResource V2.Brush.Divider}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Spacing="6">
              <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.ByMap}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding MapStats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DebriefMapStatRowViewModel">
                    <Grid ColumnDefinitions="2*,*,2*,2*,3*" ColumnSpacing="16" Margin="0,2">
                      <TextBlock Grid.Column="0" Classes="v2-debrief-strong" Text="{Binding MapLabel}" />
                      <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding RaidsLabel}" />
                      <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{Binding DurationLabel}" />
                      <TextBlock Grid.Column="3" Classes="v2-debrief-muted" Text="{Binding LoadLabel}" TextWrapping="Wrap" />
                      <!-- #291 package 4: kills and value brought out, summed over this map's raids. -->
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasManual}">
                        <TextBlock Classes="v2-debrief-muted" Text="{Binding ManualLabel}" TextWrapping="Wrap" />
                        <Border Classes="v2-debrief-kind">
                          <TextBlock Text="{Binding ManualKindLabel}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRaids}">
            <!-- Virtualised (#291 package 2): a raid history runs to hundreds of rows and this list
                 realises only the ones on screen, the same as the Keep list. -->
            <ItemsControl ItemsSource="{Binding Raids}" AutomationProperties.AutomationId="v2-debrief-rows">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DebriefRaidRowViewModel">
                  <Button Classes="v2-target v2-debrief-row" Classes.selected="{Binding IsSelected}"
                          AutomationProperties.Name="{Binding MapLabel}"
                          Command="{Binding SelectCommand}">
                    <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,2*,*,2*" ColumnSpacing="16">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="v2-debrief-strong" Text="{Binding MapLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding TagsLabel}" IsVisible="{Binding HasTags}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="v2-debrief-muted" Text="{Binding Mode}" />
                        <TextBlock Classes="v2-label" Text="{Binding WipeLabel}" IsVisible="{Binding HasWipe}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{Binding StartedLabel}" />
                      <TextBlock Grid.Column="3" Classes="v2-debrief-muted" Text="{Binding DurationLabel}" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="v2-debrief-muted" Text="{Binding Outcome}" />
                        <Border Classes="v2-debrief-kind" IsVisible="{Binding HasOutcomeKind}">
                          <TextBlock Text="{Binding OutcomeKindLabel}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- #871: a failed read says so, with Retry, in place of the table; never also "No raids recorded yet". -->
          <prim:V2LoadFaultNotice Grid.Row="2" DataContext="{Binding LoadFault}" MaxWidth="560"
                                  Margin="0,48,0,56" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel Grid.Row="2" IsVisible="{Binding ShowsNoRaids}" Spacing="10" Margin="0,48,0,56"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Chart}" Width="40" Height="40" Stretch="Uniform"
                  HorizontalAlignment="Center" />
            <TextBlock Classes="v2-debrief-muted" Text="{Binding NoRaidsMessage}" HorizontalAlignment="Center" />
            <!-- [#902 P8] Filters and the archive/Show all switches are remembered, so an empty
                 list that is only hidden says so and offers the way back. -->
            <Button Classes="v2-outline" HorizontalAlignment="Center" IsVisible="{Binding ShowsEmptyReset}"
                    Content="{Binding EmptyResetLabel}" Command="{Binding ShowEverythingCommand}"
                    AutomationProperties.AutomationId="v2-debrief-show-everything" />
          </StackPanel>
        </Grid>
      </Border>
      <!-- #291: coverage by map and two charts, each with its table. Everything follows the
           filters above and leaves archived raids out. Outcomes and the extract used are typed by
           the player, so those columns carry the Manual tag; offered extracts come from
           photographed extract lists, which older raids and raids with no photo do not have. -->
      <Border Grid.Row="3" Classes="v2-debrief-pane" VerticalAlignment="Top" IsVisible="{Binding IsStatsView}"
              MaxHeight="{Binding $parent[Grid].Bounds.Height}"
              AutomationProperties.AutomationId="v2-debrief-stats">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.CoverageByMap}" AutomationProperties.HeadingLevel="3" VerticalAlignment="Center" />
              <Border Classes="v2-debrief-kind">
                <TextBlock Text="{x:Static l:DebriefText.ManualOutcomes}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="v2-label" Text="{x:Static l:DebriefText.CoverageHint}" TextWrapping="Wrap" />
            <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.NoRaidsToCount}" IsVisible="{Binding !HasMapCoverage}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasMapCoverage}" AutomationProperties.AutomationId="v2-debrief-coverage">
              <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*,*,*,2*,2*" ColumnSpacing="16">
                <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Map}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Raids}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Extracted}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Died}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Survival}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Extracts}" FontWeight="SemiBold" />
                <!-- [#314] The last column wraps rather than ellipsising: its notes run long. -->
                <TextBlock Grid.Column="6" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.OfferedLists}" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="None" />
              </Grid>
              <ItemsControl ItemsSource="{Binding MapCoverage}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DebriefMapCoverageRowViewModel">
                    <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*,*,*,2*,2*" ColumnSpacing="16" Margin="0,3">
                      <TextBlock Grid.Column="0" Classes="v2-debrief-strong" Text="{Binding MapLabel}" />
                      <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding RaidsLabel}" />
                      <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{Binding ExtractedLabel}" />
                      <TextBlock Grid.Column="3" Classes="v2-debrief-muted" Text="{Binding DiedLabel}" />
                      <TextBlock Grid.Column="4" Classes="v2-debrief-muted" Text="{Binding SurvivalLabel}" />
                      <TextBlock Grid.Column="5" Classes="v2-debrief-muted" Text="{Binding ExtractsLabel}" />
                      <TextBlock Grid.Column="6" Classes="v2-debrief-muted" Text="{Binding OfferedNote}"
                                 TextWrapping="Wrap" TextTrimming="None" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <!-- Value brought out per raid: a line, oldest left; "Table" swaps in the same values. -->
              <Border Grid.Column="0" Classes="v2-debrief-section" DataContext="{Binding ValueChart}"
                      AutomationProperties.AutomationId="v2-debrief-value-chart">
                <StackPanel Spacing="8" x:DataType="vm:DebriefValueChartViewModel">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.ValuePerRaid}" AutomationProperties.HeadingLevel="3" VerticalAlignment="Center" />
                      <Border Classes="v2-debrief-kind">
                        <TextBlock Text="{x:Static l:DebriefText.Manual}" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="v2-target v2-debrief-plain" Content="{Binding ToggleLabel}"
                            AutomationProperties.AutomationId="v2-debrief-value-table-toggle"
                            AutomationProperties.Name="{x:Static l:DebriefText.ValueChartToggleName}"
                            Command="{Binding ToggleTableCommand}" IsVisible="{Binding HasData}" />
                  </Grid>
                  <TextBlock Classes="v2-debrief-muted" Text="{Binding EmptyLabel}" IsVisible="{Binding HasNoData}" />
                  <Grid RowDefinitions="Auto,160,Auto" IsVisible="{Binding ShowChart}">
                    <TextBlock Grid.Row="0" Classes="v2-label" Text="{Binding MaxLabel}" />
                    <local:DebriefLineChart Grid.Row="1" Values="{Binding Values}"
                                            Stroke="{DynamicResource V2.Brush.Chart.Series1}"
                                            Axis="{DynamicResource V2.Brush.Border}"
                                            AutomationProperties.Name="{Binding Summary}" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*">
                      <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding FirstLabel}" />
                      <TextBlock Grid.Column="1" Classes="v2-label" Text="{Binding LastLabel}" HorizontalAlignment="Right" />
                    </Grid>
                  </Grid>
                  <StackPanel Spacing="2" IsVisible="{Binding ShowTable}" AutomationProperties.AutomationId="v2-debrief-value-table">
                    <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Started}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Map}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Value}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebriefValueRowViewModel">
                          <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*" ColumnSpacing="12" Margin="0,2">
                            <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{Binding StartedLabel}" />
                            <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding MapLabel}" />
                            <TextBlock Grid.Column="2" Classes="v2-debrief-strong" Text="{Binding ValueLabel}" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Survival per map: extracted over raids with an outcome, one bar per map. -->
              <Border Grid.Column="1" Classes="v2-debrief-section" DataContext="{Binding SurvivalChart}"
                      AutomationProperties.AutomationId="v2-debrief-survival-chart">
                <StackPanel Spacing="8" x:DataType="vm:DebriefSurvivalChartViewModel">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.SurvivalByMap}" AutomationProperties.HeadingLevel="3" VerticalAlignment="Center" />
                      <Border Classes="v2-debrief-kind">
                        <TextBlock Text="{x:Static l:DebriefText.Manual}" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="v2-target v2-debrief-plain" Content="{Binding ToggleLabel}"
                            AutomationProperties.AutomationId="v2-debrief-survival-table-toggle"
                            AutomationProperties.Name="{x:Static l:DebriefText.SurvivalChartToggleName}"
                            Command="{Binding ToggleTableCommand}" IsVisible="{Binding HasData}" />
                  </Grid>
                  <TextBlock Classes="v2-debrief-muted" Text="{Binding EmptyLabel}" IsVisible="{Binding HasNoData}" />
                  <ItemsControl ItemsSource="{Binding Bars}" IsVisible="{Binding ShowChart}"
                                AutomationProperties.Name="{Binding Summary}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DebriefSurvivalBarViewModel">
                        <Grid ColumnDefinitions="110,Auto,Auto" ColumnSpacing="10" Margin="0,4">
                          <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{Binding MapLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Width="220" Height="14" VerticalAlignment="Center"
                                  Background="{DynamicResource V2.Brush.SurfaceRaised}" CornerRadius="2">
                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2"
                                    Background="{DynamicResource V2.Brush.Chart.Series1}" />
                          </Border>
                          <TextBlock Grid.Column="2" Classes="v2-debrief-strong" Text="{Binding RateLabel}" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="2" IsVisible="{Binding ShowTable}" AutomationProperties.AutomationId="v2-debrief-survival-table">
                    <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Map}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Extracted}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Rate}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Bars}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebriefSurvivalBarViewModel">
                          <Grid Classes="v2-debrief-columns" ColumnDefinitions="2*,*,*" ColumnSpacing="12" Margin="0,2">
                            <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{Binding MapLabel}" />
                            <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding CountLabel}" />
                            <TextBlock Grid.Column="2" Classes="v2-debrief-strong" Text="{Binding RateLabel}" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Column="1" Width="420" Classes="v2-debrief-panel">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="16,12,16,16">
          <TextBlock Classes="v2-heading-2" Text="{x:Static l:DebriefText.RaidDetail}" AutomationProperties.HeadingLevel="2" />
          <Border Classes="v2-debrief-section" IsVisible="{Binding HasNoSelection}">
            <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.SelectARaid}" TextWrapping="Wrap" />
          </Border>

          <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
            <Border Classes="v2-debrief-section v2-debrief-accent">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="v2-debrief-strong" Text="{Binding SelectedMapLabel}" FontSize="{DynamicResource V2.Type.Heading2.Size}" />
                  <Border Classes="v2-debrief-kind" IsVisible="{Binding HasSelectedMapKind}">
                    <TextBlock Text="{Binding SelectedMapKindLabel}" />
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedFacts}" AutomationProperties.AutomationId="v2-debrief-facts">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefFactRowViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,3">
                        <TextBlock Grid.Column="0" Classes="v2-debrief-muted" Text="{Binding Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="v2-debrief-kind" IsVisible="{Binding HasKind}">
                          <TextBlock Text="{Binding KindLabel}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.Tags}" AutomationProperties.HeadingLevel="3" />
                <ItemsControl ItemsSource="{Binding SelectedTags}" IsVisible="{Binding HasSelectedTags}"
                              AutomationProperties.AutomationId="v2-debrief-tags">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefTagViewModel">
                      <Border Classes="v2-debrief-kind">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding Label}" />
                          <Button Classes="v2-target v2-debrief-plain" Padding="4,0" MinHeight="24"
                                  Content="×" Command="{Binding RemoveCommand}"
                                  AutomationProperties.Name="{x:Static l:DebriefText.RemoveTag}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Classes="v2-field-input" Width="220" MaxLength="24" Text="{Binding NewTag}"
                           PlaceholderText="{x:Static l:DebriefText.AddATag}" AutomationProperties.Name="{x:Static l:DebriefText.NewTag}"
                           AutomationProperties.AutomationId="v2-debrief-tag-input" />
                  <Button Classes="v2-target v2-debrief-plain" Content="{x:Static l:DebriefText.Add}" Command="{Binding AddTagCommand}"
                          AutomationProperties.AutomationId="v2-debrief-tag-add" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- #291: archive hides a raid from lists and totals and keeps it; restore any time. -->
            <Border Classes="v2-debrief-section" AutomationProperties.AutomationId="v2-debrief-archive">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.Archive}" AutomationProperties.HeadingLevel="3" />
                <TextBlock Classes="v2-label" Text="{Binding ArchiveHint}" TextWrapping="Wrap" />
                <Button Classes="v2-target v2-debrief-plain" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="v2-debrief-archive-toggle"
                        Content="{Binding ArchiveActionLabel}" Command="{Binding ArchiveSelectedCommand}" />
              </StackPanel>
            </Border>

            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="6">
                <StackPanel Classes="v2-icon-label">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Camera}" />
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.Screenshots}" AutomationProperties.HeadingLevel="3" />
                </StackPanel>
                <TextBlock Classes="v2-debrief-muted" Text="{Binding SelectedPathLabel}" TextWrapping="Wrap" />
                <StackPanel Spacing="2" IsVisible="{Binding HasSelectedRouteComparison}">
                  <TextBlock Classes="v2-label" Text="{x:Static l:DebriefText.PlannedVsActual}" />
                  <TextBlock Classes="v2-debrief-muted" Text="{Binding SelectedRouteComparisonLabel}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDistance}">
                  <TextBlock Classes="v2-debrief-muted" Text="{Binding SelectedDistanceLabel}" TextWrapping="Wrap" />
                  <Border Classes="v2-debrief-kind">
                    <TextBlock Text="{Binding SelectedDistanceKindLabel}" />
                  </Border>
                </StackPanel>
                <Button Classes="v2-target v2-debrief-plain" HorizontalAlignment="Left" IsVisible="{Binding CanWatch}"
                        AutomationProperties.AutomationId="v2-debrief-watch"
                        Content="{x:Static l:DebriefText.WatchOnMap}" Command="{Binding WatchOnMapCommand}" />
              </StackPanel>
            </Border>

            <!-- #291: the extract left by. The game's logs never name it, so it is picked or typed
                 here; the picks are what this raid's extract-list screenshots offered. -->
            <Border Classes="v2-debrief-section" AutomationProperties.AutomationId="v2-debrief-extract-used">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.ExtractUsed}" AutomationProperties.HeadingLevel="3" VerticalAlignment="Center" />
                  <Border Classes="v2-debrief-kind" IsVisible="{Binding HasSelectedExtractUsed}">
                    <TextBlock Text="{x:Static l:DebriefText.Manual}" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="v2-debrief-strong" Text="{Binding SelectedExtractUsedLabel}" />
                <TextBlock Classes="v2-label" Text="{Binding SelectedOfferedLabel}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding SelectedExtractChoices}" IsVisible="{Binding HasSelectedExtractChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefExtractChoiceViewModel">
                      <Button Classes="v2-target v2-intel-chip v2-intel-chip-small" Content="{Binding Label}"
                              Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Classes="v2-field-input" Width="220" MaxLength="64" Text="{Binding ExtractUsedInput}"
                           PlaceholderText="{x:Static l:DebriefText.TypeAnExtract}"
                           AutomationProperties.Name="{x:Static l:DebriefText.ExtractUsed}"
                           AutomationProperties.AutomationId="v2-debrief-extract-input" />
                  <Button Classes="v2-target v2-debrief-plain" Content="{x:Static l:DebriefText.Save}" Command="{Binding SaveExtractUsedCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- What was scanned during this raid. A recognised item is inferred and its value is an
                 estimate (a market price at scan time); neither is presented as carried-out value. -->
            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="6">
                <StackPanel Classes="v2-icon-label">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Camera}" />
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.Scans}" AutomationProperties.HeadingLevel="3" />
                </StackPanel>
                <TextBlock Classes="v2-debrief-muted" Text="{Binding SelectedScanSummary}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-debrief-scan-summary" />
                <ItemsControl ItemsSource="{Binding SelectedScans}" IsVisible="{Binding HasSelectedScans}"
                              AutomationProperties.AutomationId="v2-debrief-scans">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefScanRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ItemLabel}" TextTrimming="CharacterEllipsis" />
                            <Border Classes="v2-debrief-kind" IsVisible="{Binding HasIdentityKind}">
                              <TextBlock Text="{Binding IdentityKindLabel}" />
                            </Border>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasValue}">
                            <TextBlock Classes="v2-debrief-muted" Text="{Binding ValueLabel}" />
                            <Border Classes="v2-debrief-kind">
                              <TextBlock Text="{Binding ValueKindLabel}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="v2-label" Text="{Binding DetailLabel}" IsVisible="{Binding HasDetail}" />
                          <!-- #274: a saved Loot Scan's calls, one line each. -->
                          <ItemsControl ItemsSource="{Binding VerdictLines}" IsVisible="{Binding HasVerdictLines}"
                                        Margin="0,2,0,0" AutomationProperties.AutomationId="v2-debrief-loot-verdicts">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="v2-debrief-muted" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                          <TextBlock Classes="v2-debrief-muted" Text="{Binding TimeLabel}" HorizontalAlignment="Right" />
                          <TextBlock Classes="v2-label" Text="{Binding CorrectionLabel}" IsVisible="{Binding HasCorrection}"
                                     HorizontalAlignment="Right" />
                          <Button Classes="v2-target v2-debrief-plain" MinHeight="28" Padding="8,2"
                                  Content="{Binding CorrectionActionLabel}" Command="{Binding CorrectionCommand}"
                                  AutomationProperties.Name="{Binding CorrectionActionLabel}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- V2 rough package 26 (log facts): what the game announced while this raid was
                 open. The game states no price for a sale, so none is shown or estimated. -->
            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="6">
                <StackPanel Classes="v2-icon-label">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Cart}" />
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.FleaSales}" AutomationProperties.HeadingLevel="3" />
                </StackPanel>
                <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.NothingSold}" IsVisible="{Binding !HasSelectedSales}" />
                <ItemsControl ItemsSource="{Binding SelectedSales}" IsVisible="{Binding HasSelectedSales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefSaleRowViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding ItemLabel}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding CountLabel}" />
                        <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{Binding TimeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="6">
                <StackPanel Classes="v2-icon-label">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Clipboard}" />
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.Quests}" AutomationProperties.HeadingLevel="3" />
                </StackPanel>
                <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.NoQuestEvents}" IsVisible="{Binding !HasSelectedQuestEvents}" />
                <ItemsControl ItemsSource="{Binding SelectedQuestEvents}" IsVisible="{Binding HasSelectedQuestEvents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebriefQuestEventRowViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding QuestLabel}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="v2-debrief-muted" Text="{Binding StateLabel}" />
                        <TextBlock Grid.Column="2" Classes="v2-debrief-muted" Text="{Binding TimeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.CorrectOutcomeOrNotes}" AutomationProperties.HeadingLevel="3" />
                <TextBlock Classes="v2-label" Text="{Binding OutcomeHint}" TextWrapping="Wrap" />
                <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Outcome}" Margin="0,4,0,0" />
                <TextBox Classes="v2-field-input" Text="{Binding CorrectedOutcome}"
                         AutomationProperties.Name="{x:Static l:DebriefText.Outcome}"
                         AutomationProperties.AutomationId="v2-debrief-outcome-input" />
                <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.Notes}" Margin="0,4,0,0" />
                <TextBox Classes="v2-field-input" AcceptsReturn="True" Height="96" TextWrapping="Wrap"
                         AutomationProperties.Name="{x:Static l:DebriefText.Notes}"
                         Text="{Binding CorrectedNotes}"
                         AutomationProperties.AutomationId="v2-debrief-notes-input" />
                <Button Classes="v2-target v2-debrief-primary" Margin="0,6,0,0"
                        AutomationProperties.AutomationId="v2-debrief-save-correction"
                        Content="{x:Static l:DebriefText.SaveCorrection}" Command="{Binding SaveCorrectionCommand}" />
              </StackPanel>
            </Border>

            <!-- #291 package 4: kills and the value brought out, typed by hand — the game announces
                 neither, so both are always Manual once entered, in the export and the per-map stats. -->
            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.KillsAndValueBroughtOut}" AutomationProperties.HeadingLevel="3" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.PmcKills}" />
                    <NumericUpDown FormatString="0" Increment="1" Minimum="0" Maximum="20"
                                    Value="{Binding ManualPmcKills}"
                                    AutomationProperties.Name="{x:Static l:DebriefText.PmcKills}"
                                    AutomationProperties.AutomationId="v2-debrief-manual-pmc-kills" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.ScavKills}" />
                    <NumericUpDown FormatString="0" Increment="1" Minimum="0" Maximum="20"
                                    Value="{Binding ManualScavKills}"
                                    AutomationProperties.Name="{x:Static l:DebriefText.ScavKills}"
                                    AutomationProperties.AutomationId="v2-debrief-manual-scav-kills" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.BossKills}" />
                    <NumericUpDown FormatString="0" Increment="1" Minimum="0" Maximum="20"
                                    Value="{Binding ManualBossKills}"
                                    AutomationProperties.Name="{x:Static l:DebriefText.BossKills}"
                                    AutomationProperties.AutomationId="v2-debrief-manual-boss-kills" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="v2-debrief-muted" Text="{x:Static l:DebriefText.ValueBroughtOutRoubles}" TextWrapping="Wrap" />
                    <NumericUpDown FormatString="#,##0" Increment="1000" Minimum="0" Maximum="50000000"
                                    Value="{Binding ManualValueRoubles}"
                                    AutomationProperties.Name="{x:Static l:DebriefText.ValueBroughtOut}"
                                    AutomationProperties.AutomationId="v2-debrief-manual-value" />
                  </StackPanel>
                </Grid>
                <Button Classes="v2-target v2-debrief-primary" Margin="0,6,0,0"
                        AutomationProperties.AutomationId="v2-debrief-save-manual"
                        Content="{x:Static l:DebriefText.Save}" Command="{Binding SaveManualMetadataCommand}" />
              </StackPanel>
            </Border>

            <!-- #291 package 3: delete, with a preview of what goes before it happens. -->
            <Border Classes="v2-debrief-section">
              <StackPanel Spacing="8">
                <TextBlock Classes="v2-heading-3" Text="{x:Static l:DebriefText.DeleteThisRaid}" AutomationProperties.HeadingLevel="3" />
                <Button Classes="v2-target v2-debrief-plain" IsVisible="{Binding !IsConfirmingDelete}"
                        AutomationProperties.AutomationId="v2-debrief-delete-begin"
                        Content="{x:Static l:DebriefText.DeleteRaid}" Command="{Binding BeginDeleteCommand}" />
                <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingDelete}"
                            AutomationProperties.AutomationId="v2-debrief-delete-preview">
                  <TextBlock Classes="v2-debrief-muted" Text="{Binding DeletePreviewLabel}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="v2-target" Foreground="{DynamicResource V2.Brush.Danger}"
                            BorderBrush="{DynamicResource V2.Brush.Danger}"
                            AutomationProperties.AutomationId="v2-debrief-delete-confirm"
                            Content="{x:Static l:DebriefText.Delete}" Command="{Binding ConfirmDeleteCommand}" />
                    <Button Classes="v2-target v2-debrief-plain"
                            AutomationProperties.AutomationId="v2-debrief-delete-cancel"
                            Content="{x:Static l:DebriefText.Cancel}" Command="{Binding CancelDeleteCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
