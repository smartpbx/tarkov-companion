<UserControl x:Class="TarkovCompanion.App.Views.V2.MapRenderer.MapSceneRendererView"
             x:DataType="vm:MapSceneRendererViewModel"
             x:Name="RendererRoot"
             Focusable="True"
             KeyDown="RendererKeyDown"
             AutomationProperties.AutomationId="v2-map-renderer"
             AutomationProperties.AccessibilityView="Control"
             AutomationProperties.Name="{Binding MapPlanLabel}"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.MapRenderer"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer">
  <UserControl.Resources>
    <!-- [Issue 551] A mark on the plan is a button with nothing of the theme's button about it:
         no background in any state (the hover square), no pressed scale, no clip. A theme of its
         own rather than setters over the Fluent one, whose pointer-over, pressed and checked
         styles all reach for a presenter by this name. -->
    <ControlTheme x:Key="V2.MapMarkTheme" TargetType="Button">
      <Setter Property="Background" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ToggleButton.v2-map-choice, Button.v2-map-choice">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="2" />
      <!-- [#574] The desktop control height, like every other button beside the map; 48 is the
           touch size and the tablet has its own page. -->
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Space.Sm.Inset}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-choice:checked">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <!-- V2 rough package 21: the drawn chip stays 32px (three dozen 48px boxes with letters in
         them covered the plan; this is a marker, and the plan under it is the point), but the
         button itself is a 44px transparent hit area so touch/automation targets still clear the
         44x44 floor. Border.v2-map-marker-chip carries the drawn box; the state styles below key
         off the button's classes and restyle that inner chip. -->
    <Style Selector="ToggleButton.v2-map-marker, Button.v2-map-marker">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{x:Null}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- [Issue 551] "pins dont look right they are cut off, so is the vision cone ... pings are
           cutoff too and waypoints are even worse. and mousing over them shows a highlighted
           square". Both were this button. A templated control clips to its bounds here (the clip
           probe in tools/V2RenderPreview reads ClipToBounds=True off it), and a pin is drawn
           upward from its tip at the middle of this 44px box, so everything above the box's top
           edge was cut: 14 of a pin's 36px, the arc of the facing cone, a nudged ping's rings.
           The square was the theme's pointer-over and checked backgrounds filling the same box.
           So the button draws nothing of its own and clips nothing: its theme (V2.MapMarkTheme,
           above) is a bare presenter with no background, which also means the empty corners of the box no longer
           take the pointer. Each mark's own shape does (see v2-map-mark-hit below), and hover
           and selection are drawn on that shape. -->
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <!-- [Issue 551] What takes the pointer for a mark: its own outline, drawn invisibly and a
         few pixels fat so the target is the shape plus a margin rather than the 44px square. -->
    <Style Selector="Path.v2-map-mark-hit">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="8" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Ellipse.v2-map-mark-hit">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.v2-map-mark-hit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <!-- Every layer on the camera surface is as big as the card but is turned and scaled with the
         plan, so a layer that clips to its own bounds cuts marks along an edge that is nowhere
         near the card's. Only PlanViewport clips. -->
    <Style Selector="Canvas#CameraSurface > ItemsControl">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Border.v2-map-marker-chip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Border.v2-map-marker-chip">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Focus}" />
    </Style>
    <Style Selector="Button.v2-map-marker.cluster Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.historical Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.local-observed Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.team-observed Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.potential Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
      <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-offered Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-not-offered Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-unknown Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <!-- [Issue 551] Hover is drawn on the mark, not on a square around it. After the truth and
         offer states above, so it shows whichever of them the mark carries. -->
    <Style Selector="ToggleButton.v2-map-marker:pointerover Border.v2-map-marker-chip,
                     Button.v2-map-marker:pointerover Border.v2-map-marker-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Focus}" />
    </Style>
    <!-- [Issue 573] An extract's chip (and the transit two-arrow, which shares the same visual):
         round instead of the square every other chip uses, and two-thirds that chip's size by
         default so several of them no longer bury the building they sit on. Selected grows it
         back to the size every other chip already is.
         [Issue 606] "the black fill is bad, there is a weird white square to it ... v1 extract
         icons were good." The generic chip's Background (V2.Brush.Surface, near-black) and its
         18px icon were both sized for the square 32px chip every other kind uses; on this round
         22px one the icon's own corners sat close enough to the disc's edge to read as a second
         shape. V1's own marker (InstrumentStyles' Ellipse.markerDisc) is the reference: a solid
         faction colour carries who the extract is for, a dark glyph sits directly on it with no
         box of its own, and a transit is hollow rather than filled. This reproduces that with V2's
         own tokens (Action/Warning/Success) rather than V1's fixed hex, so every theme variant —
         including the colour-vision ones — repaints it too; V2.Icon.MapExtract/MapTransit above
         are V1's glyphs, already proportioned for this exact 12px box. -->
    <Style Selector="Border.v2-map-marker-chip.extract, Border.v2-map-marker-chip.transit">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <!-- PMC/Scav still read from the disc's own colour, the way V1 read them; a shared extract
         (or one the faction feed left unknown) keeps the base Success fill above. -->
    <Style Selector="Border.v2-map-marker-chip.extract.pmc">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Border.v2-map-marker-chip.extract.scav">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <!-- A transit belongs to nobody's faction, so V1 drew it hollow rather than filled — the one
         way a round badge on this map is not a solid disc: a dark centre, a Success ring and a
         Success glyph (InstrumentStyles' markerDisc.transit). [#606] It used to be the whole chip
         at 55% opacity, glyph included, which on Windows read as a dark hatched blob. Declared
         after the offer-state rings above so its own ring wins, as V1's did. -->
    <Style Selector="Border.v2-map-marker-chip.transit">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Grid.extract, Grid.transit">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Border.v2-map-marker-chip.extract,
                     ToggleButton.v2-map-marker:checked Border.v2-map-marker-chip.transit">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Grid.extract,
                     ToggleButton.v2-map-marker:checked Grid.transit">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="TextBlock.v2-map-offered">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.v2-map-not-offered">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.v2-map-offer-unknown">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <!-- V2 rough package 22: a person on the plan. A filled dot for where they were, a soft
         wedge for which way they were looking, and nothing else: this is a screenshot's
         last-known position, so it must not read like one of the boxed reference markers. -->
    <Style Selector="Ellipse.v2-map-person-dot">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="StrokeThickness" Value="2.5" />
    </Style>
    <!-- [Issue 581] A squadmate's dot is their own colour — the same one their chip in the squad
         panel already uses — not one shared "teammate" amber for everybody. See
         MapSceneRendererObjectViewModel.ColorHintBrush; the host (RaidCockpitViewModel) is the
         one place that decides what that colour is. -->
    <Style Selector="Ellipse.v2-map-person-dot.teammate">
      <Setter Property="Fill" Value="{Binding ColorHintBrush, DataType=vm:MapSceneRendererObjectViewModel}" />
    </Style>
    <!-- The initial paired with that colour, legible over any hue in the palette. -->
    <Style Selector="TextBlock.v2-map-person-initial">
      <Setter Property="FontSize" Value="8" />
      <Setter Property="LineHeight" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Path.v2-map-person-cone">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="Opacity" Value="0.42" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- [Issue 581] Same source as the dot: a squadmate's facing cone is their own colour too. -->
    <Style Selector="ToggleButton.v2-map-marker.team-observed Path.v2-map-person-cone">
      <Setter Property="Fill" Value="{Binding ColorHintBrush, DataType=vm:MapSceneRendererObjectViewModel}" />
    </Style>
    <!-- V2 rough package 22: a place name written on the plan, not a label on a control. A
         halo-free single line at a size that stays readable when the camera zooms, quieter than
         anything a player is meant to act on. -->
    <Style Selector="TextBlock.v2-map-place-name">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource V2.Type.Label.Size}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <!-- [Issue 581] A squadmate's name label, in their own colour; a plain place name is
         unaffected (it never carries this class — see the label's ColorHintBrush/HasColorHint). -->
    <Style Selector="TextBlock.v2-map-place-name.teammate">
      <Setter Property="Foreground" Value="{Binding ColorHintBrush, DataType=vm:MapSceneRendererLabelViewModel}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Path.v2-map-marker-icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <!-- [#606] An extract's or a transit's glyph, sized for its round disc. These MUST come after
         the generic Path.v2-map-marker-icon rule above: Avalonia has no selector specificity, the
         later of two matching styles wins, and while these sat above it the generic 18px won.
         The glyph then filled a 22px disc edge to edge and V1's door bracket stuck out of its
         left side, which is the "dark square box" the owner saw on Windows (and which the
         headless render showed too, identically). About half the disc, as V1's 12-unit glyph
         was on its 20px disc.
         The glyph sits directly on the coloured disc, so it needs the disc's own contrast rather
         than the page's: Canvas is near-black in the dark theme and near-white in the light one,
         the same relationship V1's fixed dark stroke had to its always-bright discs
         (Action/Warning/Success are bright in both themes by design — see V2ThemeVariants). -->
    <Style Selector="Grid.extract Path.v2-map-marker-icon, Grid.transit Path.v2-map-marker-icon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Grid.transit Path.v2-map-marker-icon">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Grid.extract Path.v2-map-marker-icon,
                     ToggleButton.v2-map-marker:checked Grid.transit Path.v2-map-marker-icon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="TextBlock.v2-map-marker-number">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- [Issue 508] Waypoint and quest-objective pins. One colour family each — the existing
         team/waypoint accent for a waypoint, the amber/warning token for an objective — so shape
         and colour both say which is which, never colour alone (colour-vision modes keep both
         tokens apart; see V2ThemeResourceTests). Selected and hovered states, and a completed
         objective's dim, are style states on the same two Paths rather than a third visual. -->
    <Style Selector="Path.v2-map-pin-round">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Path.v2-map-pin-shield">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <!-- Issue 379: an objective the player placed themselves (the catalog gave it no location)
         keeps the objective's shield and colour, so it never reads as a different kind of mark,
         but a dashed, thicker outline says plainly it is the player's own note and not the quest
         data's own placement. -->
    <Style Selector="Path.v2-map-pin-shield.placed">
      <Setter Property="StrokeDashArray" Value="2,1.5" />
      <Setter Property="StrokeThickness" Value="2.5" />
    </Style>
    <!-- A quest objective still on the map after its own step is done: dimmed, its letter
         replaced by a check (TextBlock.v2-map-pin-label/Path.v2-map-pin-check below), rather than
         looking exactly like one still outstanding. -->
    <Style Selector="Path.v2-map-pin-shield.completed">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:pointerover Path.v2-map-pin-round,
                     ToggleButton.v2-map-marker:pointerover Path.v2-map-pin-shield">
      <Setter Property="StrokeThickness" Value="2.5" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Path.v2-map-pin-round,
                     ToggleButton.v2-map-marker:checked Path.v2-map-pin-shield">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Focus}" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
    <Style Selector="TextBlock.v2-map-pin-label">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="FontSize" Value="{DynamicResource V2.Type.Label.Size}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Path.v2-map-pin-check">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- [Issue 598] A ping is a transient pulse at the exact spot, never a pin: neither a
         waypoint's round head nor an objective's shield, and its own colour so it cannot be read
         as either even before its ring shape is noticed. Danger, not Info: the owner's call was
         that a ping (someone flagging danger, mid-raid) reads as an alert, not as neutral
         information — the pulsing rings are what still say "ping" rather than "extract" or
         "hazard" at a glance, so the shape carries the meaning the colour used to carry alone. -->
    <Style Selector="Ellipse.v2-map-ping-dot">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Danger}" />
      <!-- A Canvas-coloured edge (dark in Dark, white in Light) so the dot still reads sitting on
           the red end of the modelled-traffic heat, which is close to the same hue. -->
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Ellipse.v2-map-ping-halo">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="StrokeThickness" Value="3" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Ellipse.v2-map-ping-ring-inner">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Danger}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Ellipse.v2-map-ping-ring-outer">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Danger}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- [Issue 551] Hover and selection for a person and a ping, on their own shapes. After the
         base styles above: the later style wins. -->
    <Style Selector="ToggleButton.v2-map-marker:pointerover Ellipse.v2-map-person-dot">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Focus}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked Ellipse.v2-map-person-dot">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Focus}" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:pointerover Ellipse.v2-map-ping-ring-inner,
                     ToggleButton.v2-map-marker:checked Ellipse.v2-map-ping-ring-inner">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.v2-map-grid">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <!-- [#574] The segmented control's style lives in MapPresentationControls, the only view
         that draws one (it is hosted outside this view too); the copy that was here was dead. -->
    <!-- Floating controls over the map: a translucent surface so the plan still reads beneath. -->
    <Style Selector="Border.v2-map-float">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Opacity" Value="0.96" />
    </Style>
    <!-- V2 rough package 20: the one small chip allowed over the plan. -->
    <Style Selector="Border.v2-map-chip">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <!-- [Issue 594] The selected extract/transit's name label, centred below its icon by default;
         flips to the other side near the card's own right/bottom edge (PlanViewport's own
         ClipToBounds) rather than let PlanViewport's clip cut it off — see IsNearRightEdge /
         IsNearBottomEdge on MapSceneRendererObjectViewModel. Every property either class sets is
         one the other leaves alone, so a marker in the corner gets both flips at once. -->
    <Style Selector="Border.v2-map-selected-name">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,-20" />
    </Style>
    <Style Selector="Border.v2-map-selected-name.near-right-edge">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.v2-map-selected-name.near-bottom-edge">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-20,0,0" />
    </Style>
    <Style Selector="Button.v2-icon-btn, ToggleButton.v2-icon-btn">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- [#591] Zoom, fit and the loot preset already float at the standard 32 DIP target
         (Button.v2-target); left dim until the player is actually reaching for them so the group
         reads as chrome, not as something drawn on the terrain beside it. Still hit-testable and
         still in the automation tree at every opacity, so a keyboard user or a screen reader never
         loses them. -->
    <Style Selector="StackPanel#RendererCommands">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel#RendererCommands:pointerover, StackPanel#RendererCommands:focus-within">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- [V2 rough package 46] The folded floor ladder: which floor you are on, and the rungs
         behind it. -->
    <Style Selector="Button.v2-map-floor-summary">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" x:Name="RendererScroll">
  <Grid>
    <!-- V2 rough package 15: the map fills the whole area edge to edge; presentation, zoom and
         the floor selector float compactly over its corners instead of taking their own rows
         above it. RendererHeader/RendererTitle/RendererCommands keep their internal shape (the
         code-behind's responsive layout still targets them by name); only where they sit moved. -->
    <!-- One compact floating pill: presentation mode as a segmented control, then the floor
         selector. No card behind the zoom/fit/loot group on the other corner — see below. -->
    <!-- The floating controls sit over the plan's column only, never over the details column. -->
    <Grid x:Name="RendererOverlay" ZIndex="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
    <Panel Grid.Column="0">
    <Border x:Name="PresentationPill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Classes="v2-card v2-map-float" MaxWidth="560">
      <!-- The mode segment, the floor ladder and the off-plan chip: see MapPresentationControls. A
           host that places those itself sets DocksPresentation and this pill is not shown. -->
      <map:MapPresentationControls />
    </Border>

    <!-- No enclosing card: a small vertical group of icon-only buttons at the map's right edge.
         RendererHeader/RendererTitle/RendererCommands keep their shape (the code-behind's
         responsive layout still targets them by name); the location title hides with the rest of
         this renderer's own chrome in a compact embedding (ShowsDetailsPanel). -->
    <Grid x:Name="RendererHeader" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
          ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="8">
      <StackPanel x:Name="RendererTitle" Spacing="4" IsVisible="{Binding ShowsDetailsPanel}">
        <Border Classes="v2-card" Opacity="0.97">
          <TextBlock Classes="v2-heading-3" Text="{Binding LocationLabel}"
                     AutomationProperties.HeadingLevel="1" Margin="{DynamicResource V2.Space.Sm.Inset}" />
        </Border>
      </StackPanel>
      <StackPanel x:Name="RendererCommands" Grid.Column="1" Spacing="8">
        <Button Classes="v2-target v2-icon-btn" Command="{Binding ZoomOutCommand}"
                AutomationProperties.AutomationId="v2-map-zoom-out"
                AutomationProperties.Name="{Binding ZoomOutLabel}" ToolTip.Tip="{Binding ZoomOutLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Minus}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding ZoomInCommand}"
                AutomationProperties.AutomationId="v2-map-zoom-in"
                AutomationProperties.Name="{Binding ZoomInLabel}" ToolTip.Tip="{Binding ZoomInLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Plus}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding FitPlanCommand}"
                AutomationProperties.AutomationId="v2-map-fit"
                AutomationProperties.Name="{Binding FitPlanLabel}" ToolTip.Tip="{Binding FitPlanLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Fit}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding HighValueLootPresetCommand}"
                IsVisible="{Binding HasHighValueLoot}"
                AutomationProperties.AutomationId="v2-map-loot-preset"
                AutomationProperties.Name="{Binding HighValueLootPresetLabel}" ToolTip.Tip="{Binding HighValueLootPresetLabel}">
          <!-- A gem, not "$": this shows the high-value loot layer, named in the tooltip. -->
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Gem}" />
        </Button>
      </StackPanel>
    </Grid>
    </Panel>
    </Grid>

    <Grid x:Name="RendererBody" ColumnDefinitions="2*,*" RowDefinitions="*"
          ColumnSpacing="12" RowSpacing="12" MinHeight="280">
      <Border x:Name="PlanViewport" Grid.Column="0" Classes="v2-map-grid" Padding="0"
              MinHeight="280" ClipToBounds="True"
              AutomationProperties.AutomationId="v2-map-plan"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.Name="{Binding MapPlanLabel}"
              PointerPressed="PlanPointerPressed"
              PointerMoved="PlanPointerMoved"
              PointerReleased="PlanPointerReleased"
              PointerCaptureLost="PlanPointerCaptureLost"
              PointerWheelChanged="PlanPointerWheelChanged">
        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
          <Canvas x:Name="CameraSurface" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                  RenderTransformOrigin="0%,0%">
            <Canvas.RenderTransform>
              <TransformGroup>
                <TranslateTransform X="{Binding CameraPreTranslateX}" Y="{Binding CameraPreTranslateY}" />
                <RotateTransform Angle="{Binding CameraRotationDegrees}" />
                <ScaleTransform ScaleX="{Binding CameraZoom}" ScaleY="{Binding CameraZoom}" />
                <TranslateTransform X="{Binding CameraPostTranslateX}" Y="{Binding CameraPostTranslateY}" />
              </TransformGroup>
            </Canvas.RenderTransform>

            <Border x:Name="PlanArtwork" Canvas.Left="{Binding MapLeft}" Canvas.Top="{Binding MapTop}"
                    Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                    Background="{DynamicResource V2.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource V2.Brush.SurfaceRaised}" BorderThickness="1"
                    IsVisible="{Binding !HasFloorStack}">
              <Image Source="{Binding BackgroundImage}" IsVisible="{Binding ShowsFlatBackground}" Stretch="Fill" />
            </Border>

            <!-- V2 rough package 39: the floors drawn one above another. Every plate is the same
                 rectangle as the flat plan above — MapLeft/MapTop/MapWidth/MapHeight — and only
                 the vertical offset differs, which is zero on the floor being read. That is what
                 keeps #413's contract: the rectangle the artwork draws into is the rectangle the
                 markers project into, on every floor. Nothing is sheared or scaled. -->
            <ItemsControl ItemsSource="{Binding FloorLayers}" IsVisible="{Binding HasFloorStack}"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                          AutomationProperties.AccessibilityView="Control"
                          AutomationProperties.Name="Floor stack">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererFloorLayerViewModel">
                  <!-- Positioned by a transform, not Canvas.Left: the generated ContentPresenter
                       stays at the Canvas origin, which is why every other layer here does the
                       same. The name sits outside the plate's own opacity, so a quieted floor is
                       still one you can read the name of — which is how a section drawing of a
                       building works. -->
                  <Panel Width="{Binding Width}" Height="{Binding Height}"
                         AutomationProperties.AutomationId="{Binding AutomationId}"
                         AutomationProperties.Name="{Binding Name}"
                         ToolTip.Tip="{Binding Name}">
                    <Panel.RenderTransform>
                      <TranslateTransform X="{Binding TranslateX}" Y="{Binding TranslateY}" />
                    </Panel.RenderTransform>
                    <Border Opacity="{Binding Opacity}"
                            Background="{DynamicResource V2.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource V2.Brush.Action}"
                            BorderThickness="{Binding BorderThickness}">
                      <Image Source="{Binding Image}" Stretch="Fill" />
                    </Border>
                    <!-- On the right: the floating presentation pill owns the plan's top-left
                         corner, and a plate labelled underneath it is a plate with no label. -->
                    <Border Classes="v2-map-chip" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6" IsHitTestVisible="False" Opacity="{Binding NameOpacity}">
                      <TextBlock Classes="v2-label" Text="{Binding Name}" TextWrapping="NoWrap" />
                    </Border>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- [Issue 286] Modelled traffic, under every line and marker. Same rectangle as the
                 artwork, so a cell of the field is over the ground it describes. -->
            <Image Canvas.Left="{Binding MapLeft}" Canvas.Top="{Binding MapTop}"
                   Width="{Binding MapWidth}" Height="{Binding MapHeight}" Stretch="Fill"
                   Source="{Binding TrafficHeatImage}" IsVisible="{Binding ShowsTrafficHeat}"
                   IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"
                   AutomationProperties.AccessibilityView="Raw" />

            <map:MapSceneGeometryLayer Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                       IsHitTestVisible="False" Objects="{Binding GeometryObjects}"
                                       Zoom="{Binding CameraZoom}"
                                       Stroke="{DynamicResource V2.Brush.Action}"
                                       LocalStroke="{DynamicResource V2.Brush.Success}"
                                       TeamStroke="{DynamicResource V2.Brush.Info}"
                                       Fill="{DynamicResource V2.Brush.Info}" />

            <!-- V2 rough package 22: place names, written on the plan like V1's "Place names"
                 layer. Text rather than markers, never hit-testable: a street name is not a
                 thing you click. -->
            <ItemsControl ItemsSource="{Binding LabelObjects}" IsHitTestVisible="False"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererLabelViewModel">
                  <!-- [Issue 581] A squadmate's own name (see MapSceneRendererViewModel.LabelObjects)
                       is written in their colour; an ordinary place name has no host opinion and
                       keeps the themed foreground below. -->
                  <TextBlock Classes="v2-map-place-name" Classes.teammate="{Binding HasColorHint}"
                             Width="{Binding Width}"
                             TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             RenderTransformOrigin="50%,50%" Text="{Binding Text}">
                    <TextBlock.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding InverseZoom}" ScaleY="{Binding InverseZoom}" />
                        <RotateTransform Angle="{Binding UprightDegrees}" />
                        <TranslateTransform X="{Binding AnchorLeft}" Y="{Binding AnchorTop}" />
                      </TransformGroup>
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding PointMarkers}"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:MapSceneRendererObjectViewModel">
                  <Setter Property="ZIndex" Value="{Binding ZOrder}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                  <!-- The generated ContentPresenter stays at the Canvas origin in Avalonia.
                       Position inside the template, where the transform is applied to the real control. -->
                  <ToggleButton Classes="v2-map-marker" Theme="{StaticResource V2.MapMarkTheme}"
                                Classes.historical="{Binding IsHistorical}"
                                Classes.local-observed="{Binding IsLocalObserved}"
                                Classes.team-observed="{Binding IsTeamObserved}"
                                Classes.potential="{Binding IsPotential}"
                                Classes.offer-offered="{Binding IsOffered}"
                                Classes.offer-not-offered="{Binding IsKnownNotOffered}"
                                Classes.offer-unknown="{Binding IsOfferUnknown}"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Opacity="{Binding MarkerOpacity}"
                                RenderTransformOrigin="50%,50%"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding AutomationName}"
                                AutomationProperties.HelpText="{Binding Detail}"
                                Command="{Binding SelectCommand}"
                                ToolTip.Tip="{Binding Label}">
                    <ToggleButton.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding MarkerInverseZoom}" ScaleY="{Binding MarkerInverseZoom}" />
                        <RotateTransform Angle="{Binding MarkerUprightDegrees}" />
                        <TranslateTransform X="{Binding AnchorLeft}" Y="{Binding AnchorTop}" />
                      </TransformGroup>
                    </ToggleButton.RenderTransform>
                    <!-- V2 rough package 20: a drawn icon, or the waypoint/step number, and
                         nothing else inside the marker. The letter badges that used to crowd
                         three corners (and printed "?" whenever something was unknown) moved to
                         the accessible name and the tooltip; the border colour still carries
                         truth and offer state. V2 rough package 21: the drawn chip is a nested
                         32px Border so the button around it can be a 44px hit area without
                         growing the visible box. -->
                    <!-- V2 rough package 22: somebody standing somewhere is drawn as V1 drew
                         them — a dot with a cone for which way they are facing — not as a chip
                         with a glyph in it. The cone is outside the chip so it is not clipped by
                         it, and it turns with the recorded heading rather than with the marker. -->
                    <Panel>
                    <Panel IsVisible="{Binding IsPersonIcon}" Width="44" Height="44">
                      <!-- [V2 rough package 46] The 44x44 box and Stretch="None" are what keep the
                           cone on the dot. A Path with no size measures to its own geometry, which
                           for this cone is 36 wide and 22 tall, so 50% of it was (18,11) and the
                           turn swung the apex — written at (22,22), the centre of the marker box —
                           away from the dot by up to 23px. Reported as the facing cones not being
                           attached to anybody. V1 turns a Panel filling the same square, which is
                           why V1 never showed it. -->
                      <Path Classes="v2-map-person-cone" Data="{Binding ConeGeometry}"
                            Width="44" Height="44" Stretch="None" IsHitTestVisible="False"
                            RenderTransformOrigin="50%,50%">
                        <Path.RenderTransform>
                          <RotateTransform Angle="{Binding ConeDegrees}" />
                        </Path.RenderTransform>
                      </Path>
                      <!-- [Issue 551] The dot and a margin take the pointer; the cone does not. -->
                      <Ellipse Classes="v2-map-mark-hit" Width="24" Height="24" />
                      <Ellipse Classes="v2-map-person-dot" Classes.teammate="{Binding IsTeammateIcon}"
                               Width="14" Height="14" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <!-- [Issue 581] The colour is paired with the squadmate's own initial, so a
                           colour-vision mode still tells two teammates apart on the dot itself. -->
                      <TextBlock Classes="v2-map-person-initial" IsVisible="{Binding IsTeammateIcon}"
                                 Text="{Binding PersonInitial}" IsHitTestVisible="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <!-- [Issue 508] A waypoint or a quest objective is a pin: its own head shape
                         and colour, its tip — not its centre — on the exact spot. AnchorLeft/Top
                         (the ToggleButton's own RenderTransform, above) still anchor a 44x44 box
                         centred on the point and never move; PinLeft/PinTop only say where inside
                         that fixed, always-upright box the pin's own bottom-centre tip has to be
                         drawn to land on that centre. See MapPinGeometry and MapPinAnchorTests. -->
                    <Panel IsVisible="{Binding IsPinMark}" Width="44" Height="44">
                      <Canvas Width="44" Height="44">
                        <Panel Canvas.Left="{Binding PinLeft}" Canvas.Top="{Binding PinTop}"
                               Width="{Binding PinWidth}" Height="{Binding PinHeight}">
                          <!-- [Issue 551] The pin's own outline, 4px fatter all round, is what
                               takes the pointer: not the 44px box, most of which is below the tip. -->
                          <Path Classes="v2-map-mark-hit" Margin="-4" Stretch="Fill"
                                IsVisible="{Binding IsWaypointMark}" Data="{DynamicResource V2.Icon.PinRound}" />
                          <Path Classes="v2-map-mark-hit" Margin="-4" Stretch="Fill"
                                IsVisible="{Binding IsObjectiveMark}" Data="{DynamicResource V2.Icon.PinShield}" />
                          <Path Classes="v2-map-pin-round"
                                IsVisible="{Binding IsWaypointMark}"
                                Width="{Binding PinWidth}" Height="{Binding PinHeight}"
                                Stretch="Fill" Data="{DynamicResource V2.Icon.PinRound}" />
                          <!-- [Issue 573] Two-thirds size by default (PinWidth/PinHeight), full
                               size once selected — see MapSceneRendererObjectViewModel.PinScale. -->
                          <Path Classes="v2-map-pin-shield" Classes.placed="{Binding IsUserPlacedMark}"
                                Classes.completed="{Binding IsCompletedObjective}"
                                IsVisible="{Binding IsObjectiveMark}"
                                Width="{Binding PinWidth}" Height="{Binding PinHeight}"
                                Stretch="Fill" Data="{DynamicResource V2.Icon.PinShield}" />
                          <TextBlock Classes="v2-map-pin-label" Margin="{Binding PinLabelMargin}"
                                     FontSize="{Binding PinLabelFontSize}"
                                     IsVisible="{Binding ShowsPinLetter}" Text="{Binding PinLabel}" />
                          <Path Classes="v2-map-pin-check" Margin="{Binding PinCheckMargin}"
                                IsVisible="{Binding IsCompletedObjective}" Data="{DynamicResource V2.Icon.Tick}" />
                        </Panel>
                      </Canvas>
                    </Panel>
                    <!-- A ping: a transient pulse centred exactly on the point, never a pin, and
                         a third colour so it cannot be mistaken for either one even mid-glance. -->
                    <Panel IsVisible="{Binding IsPingMark}" Width="44" Height="44">
                      <Panel.RenderTransform>
                        <TranslateTransform X="{Binding PinOffsetX}" Y="{Binding PinOffsetY}" />
                      </Panel.RenderTransform>
                      <Ellipse Classes="v2-map-mark-hit" Width="32" Height="32" />
                      <!-- [Issue 598] A faint Canvas-coloured halo behind the outer ring: red on
                           red (the ping over the traffic heat's own red end) still shows a ring. -->
                      <Ellipse Classes="v2-map-ping-halo" Width="30" Height="30" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse Classes="v2-map-ping-ring-outer" Width="28" Height="28" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse Classes="v2-map-ping-ring-inner" Width="16" Height="16" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse Classes="v2-map-ping-dot" Width="8" Height="8" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <!-- [Issue 573] The same overlap nudge a pin or a ping gets (PinOffsetX/Y —
                         see MapMarkerOverlapLayout), now also given to the older boxed chip: an
                         extract or a transit point landing on another one is fanned instead of
                         hiding it. -->
                    <Panel IsVisible="{Binding ShowsLegacyChip}" Width="44" Height="44">
                      <Panel.RenderTransform>
                        <TranslateTransform X="{Binding PinOffsetX}" Y="{Binding PinOffsetY}" />
                      </Panel.RenderTransform>
                      <Border Classes="v2-map-mark-hit" />
                      <!-- An extract (or the transit two-arrow) is a round badge at two-thirds of
                           every other chip's size by default, and back to that size once selected
                           — six of them used to bury a whole building at fit zoom. -->
                      <!-- [Issue 606] PMC/Scav/shared read from the same faction the offer-state
                           colour used to stand alone against; a transit is nobody's, so it never
                           carries one of these three. -->
                      <Border Classes="v2-map-marker-chip" Classes.extract="{Binding IsExtractIcon}"
                              Classes.transit="{Binding IsTransitIcon}"
                              Classes.pmc="{Binding IsPmc}" Classes.scav="{Binding IsScav}"
                              Classes.shared="{Binding IsSharedFaction}" IsHitTestVisible="False">
                        <Grid Width="26" Height="26" Classes.extract="{Binding IsExtractIcon}"
                              Classes.transit="{Binding IsTransitIcon}">
                          <TextBlock Classes="v2-map-marker-number" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding HasMarkerNumber}" Text="{Binding MarkerGlyph}" />
                          <Panel IsVisible="{Binding ShowsGlyphIcon}">
                            <!-- [Issue 606] V1's own glyphs, proportioned for this small round disc
                                 — see V2.Icon.MapExtract/MapTransit in V2Icons.axaml. -->
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsExtractIcon}" Data="{DynamicResource V2.Icon.MapExtract}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsTransitIcon}" Data="{DynamicResource V2.Icon.MapTransit}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsSpawnIcon}" Data="{DynamicResource V2.Icon.Spawn}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsLootIcon}" Data="{DynamicResource V2.Icon.Gem}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsHazardIcon}" Data="{DynamicResource V2.Icon.Hazard}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsLockIcon}" Data="{DynamicResource V2.Icon.Lock}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsRouteIcon}" Data="{DynamicResource V2.Icon.Route}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsRiskIcon}" Data="{DynamicResource V2.Icon.Hazard}" />
                            <Path Classes="v2-icon v2-map-marker-icon" IsVisible="{Binding IsGenericIcon}" Data="{DynamicResource V2.Icon.Target}" />
                          </Panel>
                        </Grid>
                      </Border>
                      <!-- [Issue 594] The selected extract or transit keeps its name under the icon,
                           readable without hovering, over Drawing or Photo alike — the same label
                           style a place name uses (TextBlock.v2-map-place-name), on a Canvas-toned
                           plate: an ordinary place name has the whole map to itself to be legible
                           in, but this one has to read over a photograph or a dark drawing right
                           where a route line or the traffic heat is often thickest, at the exact
                           point it is pointing to. Hovering says it for every other one (ToolTip.Tip
                           on the marker itself, above).
                           An owner report against this: "RUAF Roadblock" read as "RU…". The chip
                           sits inside the marker's own 44px box, and a Border with no explicit
                           Width measures within whatever space its parent offers — here, the box's
                           44px, regardless of MaxWidth (a cap, not a floor). An explicit Width
                           escapes that (Avalonia measures an explicit Width against itself, not
                           the parent's offer), so the wrap below is what limits a long name, not
                           the marker's box. Wide enough that a short name still reads on one line
                           at its own natural (shorter) width; a long one ("Boiler Room Basement
                           (Co-op)") wraps to two rather than truncating. PlanViewport's own clip
                           (ClipToBounds="True") still keeps it from drawing outside the map card
                           itself. -->
                      <Border Classes="v2-map-chip v2-map-selected-name" IsVisible="{Binding ShowsSelectedName}"
                              Classes.near-right-edge="{Binding IsNearRightEdge}"
                              Classes.near-bottom-edge="{Binding IsNearBottomEdge}"
                              IsHitTestVisible="False" Width="184" Padding="5,2" Opacity="0.95">
                        <TextBlock Classes="v2-map-place-name" Opacity="1" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Label}" />
                      </Border>
                    </Panel>
                    </Panel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A cluster opens a list; it does not retain a toggled state. Keeping it a Button
                 also exposes the Invoke pattern used by packaged Windows UI Automation. -->
            <ItemsControl ItemsSource="{Binding ClusterMarkers}"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                  <Button Classes="v2-map-marker cluster" Theme="{StaticResource V2.MapMarkTheme}"
                          RenderTransformOrigin="50%,50%"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.HelpText="{Binding Detail}"
                          Command="{Binding SelectCommand}">
                    <Button.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding MarkerInverseZoom}" ScaleY="{Binding MarkerInverseZoom}" />
                        <RotateTransform Angle="{Binding MarkerUprightDegrees}" />
                        <TranslateTransform X="{Binding AnchorLeft}" Y="{Binding AnchorTop}" />
                      </TransformGroup>
                    </Button.RenderTransform>
                    <Panel>
                      <Border Classes="v2-map-mark-hit" />
                      <Border Classes="v2-map-marker-chip" IsHitTestVisible="False">
                        <Grid Width="40" Height="40">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Text="{Binding MarkerGlyph}" />
                        </Grid>
                      </Border>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Canvas>

          <Border Canvas.Left="12" Canvas.Top="12" Classes="v2-card" Padding="8" IsHitTestVisible="False"
                  IsVisible="{Binding ShowsDetailsPanel}">
            <StackPanel Spacing="2">
              <TextBlock Classes="v2-label" Text="{Binding ModeLabel}" />
              <TextBlock Classes="v2-label" Text="{Binding ReviewedAssetLabel}"
                         TextWrapping="Wrap" MaxWidth="500" />
            </StackPanel>
          </Border>

          <TextBlock Canvas.Left="{Binding StatusLeft}" Canvas.Top="{Binding StatusTop}"
                     Width="{Binding MessageWidth}" Classes="v2-label"
                     IsVisible="{Binding HasBackgroundStatus}"
                     AutomationProperties.AutomationId="v2-map-background-status"
                     AutomationProperties.AccessibilityView="Control"
                     AutomationProperties.Name="{Binding BackgroundStatus}"
                     Text="{Binding BackgroundStatus}" TextWrapping="Wrap" TextAlignment="Center" />

          <TextBlock Canvas.Left="{Binding EmptyLeft}" Canvas.Top="{Binding EmptyTop}"
                     Width="{Binding EmptyMessageWidth}" Classes="v2-label"
                     IsVisible="{Binding ShowsEmptyMapMessage}"
                     Text="{Binding EmptyMapMessage}" TextWrapping="Wrap" TextAlignment="Center" />
        </Canvas>
      </Border>

      <ScrollViewer x:Name="DetailsPanel" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding ShowsDetailsPanel}">
        <StackPanel Spacing="12">
          <Border Classes="v2-card" IsVisible="{Binding HasHighValueLoot}">
            <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding HighValueLoot}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:HighValueLootLayerViewModel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="v2-heading-3" Text="{Binding Heading}"
                               AutomationProperties.AutomationId="v2-map-loot-heading"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Classes="v2-body" Text="{Binding Legend}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-legend"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding Legend}" />
                    <TextBlock Classes="v2-label" Text="{Binding StateMessage}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-state"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding StateMessage}" />
                    <TextBlock Classes="v2-label" Text="{Binding FreshnessMessage}" TextWrapping="Wrap"
                               IsVisible="{Binding HasFreshnessMessage}"
                               AutomationProperties.AutomationId="v2-map-loot-freshness"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding FreshnessMessage}" />
                    <TextBlock Classes="v2-label" Text="{Binding CoverageLabel}"
                               IsVisible="{Binding HasCoverage}" TextWrapping="Wrap" />

                    <TextBlock Classes="v2-heading-3" Text="{Binding FilterHeading}"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Classes="v2-label" Text="{Binding ValueBasisLabel}" />
                    <ItemsControl ItemsSource="{Binding ValueBasisChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding MinimumTierLabel}" />
                    <ItemsControl ItemsSource="{Binding MinimumTierChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding ProfileRelevanceLabel}" />
                    <ItemsControl ItemsSource="{Binding ProfileRelevanceChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding CategoryLabel}" />
                    <ItemsControl ItemsSource="{Binding CategoryChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding CategoryOptionsNotice}"
                               IsVisible="{Binding HasCategoryOptionsNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-category-more"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding CategoryOptionsNotice}" />
                    <TextBlock Classes="v2-label" Text="{Binding MultipleCategoryFilterMessage}"
                               IsVisible="{Binding HasMultipleCategoryFilter}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-category-active"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding MultipleCategoryFilterMessage}" />

                    <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                    <ItemsControl ItemsSource="{Binding FloorChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding FloorOptionsNotice}"
                               IsVisible="{Binding HasFloorOptionsNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-floor-more"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding FloorOptionsNotice}" />

                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <TextBlock Classes="v2-label" Text="{Binding PageLabel}" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="v2-map-loot-page-status"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.Name="{Binding PageLabel}" />
                      <Button Classes="v2-target" Content="{Binding PreviousPageLabel}"
                              IsEnabled="{Binding CanGoToPreviousPage}"
                              AutomationProperties.AutomationId="v2-map-loot-page-previous"
                              AutomationProperties.Name="{Binding PreviousPageLabel}"
                              Command="{Binding PreviousPageCommand}" />
                      <Button Classes="v2-target" Content="{Binding NextPageLabel}"
                              IsEnabled="{Binding CanGoToNextPage}"
                              AutomationProperties.AutomationId="v2-map-loot-page-next"
                              AutomationProperties.Name="{Binding NextPageLabel}"
                              Command="{Binding NextPageCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="v2-label" IsVisible="{Binding ShowsEmpty}"
                               Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootEntryViewModel">
                          <Button Classes="v2-map-choice" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding AutomationName}"
                                  Command="{Binding SelectCommand}">
                            <StackPanel Spacing="3">
                              <TextBlock Classes="v2-body" Text="{Binding Label}" TextWrapping="Wrap" />
                              <WrapPanel ItemSpacing="8" LineSpacing="3">
                                <TextBlock Classes="v2-label" Text="{Binding TierLabel}" />
                                <TextBlock Classes="v2-label" Text="{Binding ValueLabel}" />
                                <TextBlock Classes="v2-label" Text="{Binding ListOnlyLabel}"
                                           IsVisible="{Binding IsListOnly}" />
                              </WrapPanel>
                              <TextBlock Classes="v2-label" Text="{Binding CandidateLabel}" TextWrapping="Wrap" />
                              <TextBlock Classes="v2-label" Text="{Binding LocationLabel}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            </ScrollViewer>
          </Border>

          <Border Classes="v2-card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <!-- A hidden border still evaluates bindings. Instantiate the typed detail
                   template only when a selected object exists, so a normal empty selection
                   cannot emit one binding fault per nested property. -->
              <ContentControl Content="{Binding SelectedObject}" IsVisible="{Binding HasGenericSelection}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}"
                                 AutomationProperties.AutomationId="v2-map-selection-live"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.LiveSetting="Polite"
                                 AutomationProperties.Name="{Binding AutomationName}"
                                 AutomationProperties.HeadingLevel="2" />
                      <TextBlock Classes="v2-body" Text="{Binding Detail}"
                                 IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding FactionLabel}" />
                        <TextBlock Classes="v2-label" IsVisible="{Binding HasOfferStatus}"
                                   Classes.v2-map-offered="{Binding IsOffered}"
                                   Classes.v2-map-not-offered="{Binding IsKnownNotOffered}"
                                   Classes.v2-map-offer-unknown="{Binding IsOfferUnknown}"
                                   Text="{Binding OfferedLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding TruthLabel}" />
                      </WrapPanel>
                      <TextBlock Classes="v2-label" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding EstimateLabel}"
                                 IsVisible="{Binding HasEstimate}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <ContentControl Content="{Binding SelectedLootEntry}" IsVisible="{Binding HasLootSelection}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:HighValueLootEntryViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}"
                                 AutomationProperties.AutomationId="v2-map-loot-selection-live"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.LiveSetting="Polite"
                                 AutomationProperties.Name="{Binding AutomationName}"
                                 AutomationProperties.HeadingLevel="2" />
                      <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <TextBlock Classes="v2-label" Text="{Binding TierLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding ValueLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding LocationLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding ListOnlyLabel}"
                                   IsVisible="{Binding IsListOnly}" />
                      </WrapPanel>
                      <TextBlock Classes="v2-body" Text="{Binding PossibleItemsLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding CategoriesLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding CandidateLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProfileRelevanceLabel}"
                                 IsVisible="{Binding HasProfileRelevance}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProfileConflictLabel}"
                                 IsVisible="{Binding HasProfileConflicts}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProbabilityLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding RespawnLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding AccessLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding MissingFactsLabel}"
                                 IsVisible="{Binding HasMissingFacts}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding DatasetLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-dataset" />
                      <TextBlock Classes="v2-label" Text="{Binding SourceLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-source" />
                      <TextBlock Classes="v2-label" Text="{Binding ProducerLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding EvidenceTimeLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ConfidenceLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-confidence" />
                      <TextBlock Classes="v2-label" Text="{Binding SourceCoverageLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-source-coverage" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <Button Classes="v2-target" Content="{Binding ClearSelectionLabel}"
                      AutomationProperties.AutomationId="v2-map-clear-selection"
                      AutomationProperties.Name="{Binding ClearSelectionLabel}"
                      Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
          </Border>

          <Border Classes="v2-card">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="{Binding LayersLabel}"
                         AutomationProperties.HeadingLevel="2" />
              <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererLayerViewModel">
                    <!-- V2 rough package 39: the switch carries the count, and an empty layer that
                         is off cannot be switched on to an empty map. One that is on can always
                         be switched off (CanToggle), or the control is stuck and UI Automation's
                         Toggle throws on it. -->
                    <ToggleButton Classes="v2-map-choice" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  IsChecked="{Binding IsVisible, Mode=OneWay}"
                                  IsEnabled="{Binding CanToggle}"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding ToggleLabel}"
                                  AutomationProperties.HelpText="{Binding StateLabel}"
                                  Content="{Binding Label}" Command="{Binding ToggleCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="v2-card">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="{Binding DetailsLabel}"
                         AutomationProperties.HeadingLevel="2" />
              <TextBox Classes="v2-field-input" Text="{Binding SearchText, Mode=TwoWay}"
                       PlaceholderText="{Binding SearchPlaceholder}"
                       AutomationProperties.AutomationId="v2-map-search"
                       AutomationProperties.Name="{Binding SearchLabel}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasClusterFilter}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding ClusterFilterLabel}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="v2-target" Content="{Binding ClearClusterLabel}"
                        AutomationProperties.AutomationId="v2-map-clear-cluster"
                        AutomationProperties.Name="{Binding ClearClusterLabel}"
                        Command="{Binding ClearClusterCommand}" />
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <TextBlock Classes="v2-label" Text="{Binding ListPageLabel}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="v2-map-page-status"
                           AutomationProperties.AccessibilityView="Control"
                           AutomationProperties.Name="{Binding ListPageLabel}" />
                <Button Classes="v2-target" Content="{Binding PreviousPageLabel}"
                        IsEnabled="{Binding CanGoToPreviousPage}"
                        AutomationProperties.AutomationId="v2-map-page-previous"
                        AutomationProperties.Name="{Binding PreviousPageLabel}"
                        Command="{Binding PreviousPageCommand}" />
                <Button Classes="v2-target" Content="{Binding NextPageLabel}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        AutomationProperties.AutomationId="v2-map-page-next"
                        AutomationProperties.Name="{Binding NextPageLabel}"
                        Command="{Binding NextPageCommand}" />
              </WrapPanel>
              <TextBlock Classes="v2-label" IsVisible="{Binding ShowsEmptyList}"
                         Text="{Binding EmptyListMessage}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ListItems}" IsVisible="{Binding HasListItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererListItemViewModel">
                    <ToggleButton Classes="v2-map-choice"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding AutomationName}"
                                  Command="{Binding SelectCommand}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="v2-body" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Classes="v2-label" Text="{Binding Detail}"
                                   IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                          <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                          <TextBlock Classes="v2-label" Text="{Binding FactionLabel}" />
                          <TextBlock Classes="v2-label" IsVisible="{Binding HasOfferStatus}"
                                     Classes.v2-map-offered="{Binding IsOffered}"
                                     Classes.v2-map-not-offered="{Binding IsKnownNotOffered}"
                                     Classes.v2-map-offer-unknown="{Binding IsOfferUnknown}"
                                     Text="{Binding OfferedLabel}" />
                          <TextBlock Classes="v2-label" Text="{Binding TruthLabel}" />
                        </WrapPanel>
                        <TextBlock Classes="v2-label" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                      </StackPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
