<UserControl x:Class="TarkovCompanion.App.Views.V2.MapRenderer.MapSceneRendererView"
             x:DataType="vm:MapSceneRendererViewModel"
             x:Name="RendererRoot"
             Focusable="True"
             KeyDown="RendererKeyDown"
             AutomationProperties.AutomationId="v2-map-renderer"
             AutomationProperties.AccessibilityView="Control"
             AutomationProperties.Name="{Binding MapPlanLabel}"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.MapRenderer"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer">
  <UserControl.Styles>
    <Style Selector="ToggleButton.v2-map-choice, Button.v2-map-choice">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Touch}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Space.Sm.Inset}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-choice:checked">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker, Button.v2-map-marker">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="MinWidth" Value="{DynamicResource V2.Target.Touch}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Touch}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker:checked">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Focus}" />
    </Style>
    <Style Selector="Button.v2-map-marker.cluster">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.historical">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.local-observed">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.team-observed">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.potential">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Info}" />
      <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-offered">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-not-offered">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ToggleButton.v2-map-marker.offer-unknown">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.v2-map-offered">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.v2-map-not-offered">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.v2-map-offer-unknown">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="Border.v2-map-grid">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <!-- A segmented control, not radio buttons: flat, joined, no per-item circle. -->
    <Style Selector="ToggleButton.v2-segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource V2.Space.Sm.Inset}" />
    </Style>
    <Style Selector="ToggleButton.v2-segment:checked">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <!-- Floating controls over the map: a translucent surface so the plan still reads beneath. -->
    <Style Selector="Border.v2-map-float">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Opacity" Value="0.96" />
    </Style>
    <Style Selector="Button.v2-icon-btn, ToggleButton.v2-icon-btn">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" x:Name="RendererScroll">
  <Grid>
    <!-- V2 rough package 15: the map fills the whole area edge to edge; presentation, zoom and
         the floor selector float compactly over its corners instead of taking their own rows
         above it. RendererHeader/RendererTitle/RendererCommands keep their internal shape (the
         code-behind's responsive layout still targets them by name); only where they sit moved. -->
    <!-- One compact floating pill: presentation mode as a segmented control, then the floor
         selector. No card behind the zoom/fit/loot group on the other corner — see below. -->
    <!-- The floating controls sit over the plan's column only, never over the details column. -->
    <Grid x:Name="RendererOverlay" ZIndex="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
    <Panel Grid.Column="0">
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Classes="v2-card v2-map-float" MaxWidth="560">
      <StackPanel Spacing="8">
        <WrapPanel ItemSpacing="8" LineSpacing="8">
        <ItemsControl ItemsSource="{Binding Modes}" AutomationProperties.Name="{Binding PresentationLabel}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="0" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapSceneRendererModeViewModel">
              <ToggleButton Classes="v2-segment" IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsAvailable}"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding Label}"
                            AutomationProperties.HelpText="{Binding UnavailableReason}"
                            Content="{Binding Label}" Command="{Binding SelectCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- A compact selector rather than a row of radio buttons with raw layer ids: only the
             floor actually visible in the ComboBox needs an id, so the closed control shows the
             human floor name instead. The label stays for assistive technology only. -->
        <ComboBox MinWidth="130" ItemsSource="{Binding Floors}" IsVisible="{Binding HasFloorFilters}"
                  SelectedItem="{Binding SelectedFloor, Mode=OneWay}"
                  SelectionChanged="FloorSelectionChanged"
                  ToolTip.Tip="{Binding FloorLabel}"
                  AutomationProperties.AutomationId="v2-map-floor-picker"
                  AutomationProperties.Name="{Binding FloorLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MapSceneRendererFloorViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        </WrapPanel>
        <TextBlock Classes="v2-body" IsVisible="{Binding ShowsModeFallback}"
                   AutomationProperties.AutomationId="v2-map-mode-fallback"
                   AutomationProperties.AccessibilityView="Control"
                   AutomationProperties.Name="{Binding ModeFallbackNotice}"
                   Text="{Binding ModeFallbackNotice}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-body" IsVisible="{Binding HasRendererNotice}"
                   AutomationProperties.AutomationId="v2-map-live-assertive"
                   AutomationProperties.AccessibilityView="Control"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{Binding RendererNotice}"
                   Text="{Binding RendererNotice}" TextWrapping="Wrap" />
        <TextBlock Classes="v2-label" IsVisible="{Binding HasDenseSceneNotice}"
                   AutomationProperties.AutomationId="v2-map-live-polite"
                   AutomationProperties.AccessibilityView="Control"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding DenseSceneNotice}"
                   Text="{Binding DenseSceneNotice}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- No enclosing card: a small vertical group of icon-only buttons at the map's right edge.
         RendererHeader/RendererTitle/RendererCommands keep their shape (the code-behind's
         responsive layout still targets them by name); the location title hides with the rest of
         this renderer's own chrome in a compact embedding (ShowsDetailsPanel). -->
    <Grid x:Name="RendererHeader" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
          ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="8">
      <StackPanel x:Name="RendererTitle" Spacing="4" IsVisible="{Binding ShowsDetailsPanel}">
        <Border Classes="v2-card" Opacity="0.97">
          <TextBlock Classes="v2-heading-3" Text="{Binding LocationLabel}"
                     AutomationProperties.HeadingLevel="1" Margin="{DynamicResource V2.Space.Sm.Inset}" />
        </Border>
      </StackPanel>
      <StackPanel x:Name="RendererCommands" Grid.Column="1" Spacing="8">
        <Button Classes="v2-target v2-icon-btn" Command="{Binding ZoomOutCommand}"
                AutomationProperties.AutomationId="v2-map-zoom-out"
                AutomationProperties.Name="{Binding ZoomOutLabel}" ToolTip.Tip="{Binding ZoomOutLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Minus}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding ZoomInCommand}"
                AutomationProperties.AutomationId="v2-map-zoom-in"
                AutomationProperties.Name="{Binding ZoomInLabel}" ToolTip.Tip="{Binding ZoomInLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Plus}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding FitPlanCommand}"
                AutomationProperties.AutomationId="v2-map-fit"
                AutomationProperties.Name="{Binding FitPlanLabel}" ToolTip.Tip="{Binding FitPlanLabel}">
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Fit}" />
        </Button>
        <Button Classes="v2-target v2-icon-btn" Command="{Binding HighValueLootPresetCommand}"
                IsVisible="{Binding HasHighValueLoot}"
                AutomationProperties.AutomationId="v2-map-loot-preset"
                AutomationProperties.Name="{Binding HighValueLootPresetLabel}" ToolTip.Tip="{Binding HighValueLootPresetLabel}">
          <!-- A gem, not "$": this shows the high-value loot layer, named in the tooltip. -->
          <Path Classes="v2-icon" Data="{DynamicResource V2.Icon.Gem}" />
        </Button>
      </StackPanel>
    </Grid>
    </Panel>
    </Grid>

    <Grid x:Name="RendererBody" ColumnDefinitions="2*,*" RowDefinitions="*"
          ColumnSpacing="12" RowSpacing="12" MinHeight="280">
      <Border x:Name="PlanViewport" Grid.Column="0" Classes="v2-map-grid" Padding="0"
              MinHeight="280" ClipToBounds="True"
              AutomationProperties.AutomationId="v2-map-plan"
              AutomationProperties.AccessibilityView="Control"
              AutomationProperties.Name="{Binding MapPlanLabel}"
              PointerPressed="PlanPointerPressed"
              PointerMoved="PlanPointerMoved"
              PointerReleased="PlanPointerReleased"
              PointerWheelChanged="PlanPointerWheelChanged">
        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
          <Canvas x:Name="CameraSurface" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                  RenderTransformOrigin="0%,0%">
            <Canvas.RenderTransform>
              <TransformGroup>
                <TranslateTransform X="{Binding CameraPreTranslateX}" Y="{Binding CameraPreTranslateY}" />
                <RotateTransform Angle="{Binding CameraRotationDegrees}" />
                <ScaleTransform ScaleX="{Binding CameraZoom}" ScaleY="{Binding CameraZoom}" />
                <TranslateTransform X="{Binding CameraPostTranslateX}" Y="{Binding CameraPostTranslateY}" />
              </TransformGroup>
            </Canvas.RenderTransform>

            <Border Canvas.Left="{Binding MapLeft}" Canvas.Top="{Binding MapTop}"
                    Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                    Background="{DynamicResource V2.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource V2.Brush.SurfaceRaised}" BorderThickness="1">
              <Image Source="{Binding BackgroundImage}" IsVisible="{Binding HasBackgroundImage}" Stretch="Fill" />
            </Border>

            <map:MapSceneGeometryLayer Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                       IsHitTestVisible="False" Objects="{Binding GeometryObjects}"
                                       Stroke="{DynamicResource V2.Brush.Action}"
                                       Fill="{DynamicResource V2.Brush.Info}" />

            <ItemsControl ItemsSource="{Binding PointMarkers}"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                  <!-- The generated ContentPresenter stays at the Canvas origin in Avalonia.
                       Position inside the template, where the transform is applied to the real control. -->
                  <ToggleButton Classes="v2-map-marker"
                                Classes.historical="{Binding IsHistorical}"
                                Classes.local-observed="{Binding IsLocalObserved}"
                                Classes.team-observed="{Binding IsTeamObserved}"
                                Classes.potential="{Binding IsPotential}"
                                Classes.offer-offered="{Binding IsOffered}"
                                Classes.offer-not-offered="{Binding IsKnownNotOffered}"
                                Classes.offer-unknown="{Binding IsOfferUnknown}"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                RenderTransformOrigin="50%,50%"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding AutomationName}"
                                AutomationProperties.HelpText="{Binding Detail}"
                                Command="{Binding SelectCommand}">
                    <ToggleButton.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding MarkerInverseZoom}" ScaleY="{Binding MarkerInverseZoom}" />
                        <RotateTransform Angle="{Binding MarkerUprightDegrees}" />
                        <TranslateTransform X="{Binding AnchorLeft}" Y="{Binding AnchorTop}" />
                      </TransformGroup>
                    </ToggleButton.RenderTransform>
                    <Grid Width="40" Height="40" IsHitTestVisible="False">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding MarkerGlyph}" />
                      <TextBlock Classes="v2-label" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 IsVisible="{Binding HasTruthGlyph}" Text="{Binding TruthGlyph}" />
                      <TextBlock Classes="v2-label" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 IsVisible="{Binding HasFactionGlyph}" Text="{Binding FactionGlyph}" />
                      <TextBlock Classes="v2-label" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 IsVisible="{Binding HasOfferGlyph}" Text="{Binding OfferGlyph}" />
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A cluster opens a list; it does not retain a toggled state. Keeping it a Button
                 also exposes the Invoke pattern used by packaged Windows UI Automation. -->
            <ItemsControl ItemsSource="{Binding ClusterMarkers}"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                  <Button Classes="v2-map-marker cluster"
                          RenderTransformOrigin="50%,50%"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.HelpText="{Binding Detail}"
                          Command="{Binding SelectCommand}">
                    <Button.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="{Binding MarkerInverseZoom}" ScaleY="{Binding MarkerInverseZoom}" />
                        <RotateTransform Angle="{Binding MarkerUprightDegrees}" />
                        <TranslateTransform X="{Binding AnchorLeft}" Y="{Binding AnchorTop}" />
                      </TransformGroup>
                    </Button.RenderTransform>
                    <Grid Width="40" Height="40" IsHitTestVisible="False">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding MarkerGlyph}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Canvas>

          <Border Canvas.Left="12" Canvas.Top="12" Classes="v2-card" Padding="8" IsHitTestVisible="False"
                  IsVisible="{Binding ShowsDetailsPanel}">
            <StackPanel Spacing="2">
              <TextBlock Classes="v2-label" Text="{Binding ModeLabel}" />
              <TextBlock Classes="v2-label" Text="{Binding ReviewedAssetLabel}"
                         TextWrapping="Wrap" MaxWidth="500" />
            </StackPanel>
          </Border>

          <TextBlock Canvas.Left="{Binding StatusLeft}" Canvas.Top="{Binding StatusTop}"
                     Width="{Binding MessageWidth}" Classes="v2-label"
                     IsVisible="{Binding HasBackgroundStatus}"
                     AutomationProperties.AutomationId="v2-map-background-status"
                     AutomationProperties.AccessibilityView="Control"
                     AutomationProperties.Name="{Binding BackgroundStatus}"
                     Text="{Binding BackgroundStatus}" TextWrapping="Wrap" TextAlignment="Center" />

          <TextBlock Canvas.Left="{Binding EmptyLeft}" Canvas.Top="{Binding EmptyTop}"
                     Width="{Binding EmptyMessageWidth}" Classes="v2-label"
                     IsVisible="{Binding ShowsEmptyMapMessage}"
                     Text="{Binding EmptyMapMessage}" TextWrapping="Wrap" TextAlignment="Center" />
        </Canvas>
      </Border>

      <ScrollViewer x:Name="DetailsPanel" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding ShowsDetailsPanel}">
        <StackPanel Spacing="12">
          <Border Classes="v2-card" IsVisible="{Binding HasHighValueLoot}">
            <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding HighValueLoot}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:HighValueLootLayerViewModel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="v2-heading-3" Text="{Binding Heading}"
                               AutomationProperties.AutomationId="v2-map-loot-heading"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Classes="v2-body" Text="{Binding Legend}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-legend"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding Legend}" />
                    <TextBlock Classes="v2-label" Text="{Binding StateMessage}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-state"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding StateMessage}" />
                    <TextBlock Classes="v2-label" Text="{Binding FreshnessMessage}" TextWrapping="Wrap"
                               IsVisible="{Binding HasFreshnessMessage}"
                               AutomationProperties.AutomationId="v2-map-loot-freshness"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding FreshnessMessage}" />
                    <TextBlock Classes="v2-label" Text="{Binding CoverageLabel}"
                               IsVisible="{Binding HasCoverage}" TextWrapping="Wrap" />

                    <TextBlock Classes="v2-heading-3" Text="{Binding FilterHeading}"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Classes="v2-label" Text="{Binding ValueBasisLabel}" />
                    <ItemsControl ItemsSource="{Binding ValueBasisChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding MinimumTierLabel}" />
                    <ItemsControl ItemsSource="{Binding MinimumTierChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding ProfileRelevanceLabel}" />
                    <ItemsControl ItemsSource="{Binding ProfileRelevanceChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="v2-label" Text="{Binding CategoryLabel}" />
                    <ItemsControl ItemsSource="{Binding CategoryChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding CategoryOptionsNotice}"
                               IsVisible="{Binding HasCategoryOptionsNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-category-more"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding CategoryOptionsNotice}" />
                    <TextBlock Classes="v2-label" Text="{Binding MultipleCategoryFilterMessage}"
                               IsVisible="{Binding HasMultipleCategoryFilter}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-category-active"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding MultipleCategoryFilterMessage}" />

                    <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                    <ItemsControl ItemsSource="{Binding FloorChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootFilterChoiceViewModel">
                          <ToggleButton Classes="v2-map-choice" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="v2-label" Text="{Binding FloorOptionsNotice}"
                               IsVisible="{Binding HasFloorOptionsNotice}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-map-loot-floor-more"
                               AutomationProperties.AccessibilityView="Control"
                               AutomationProperties.Name="{Binding FloorOptionsNotice}" />

                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <TextBlock Classes="v2-label" Text="{Binding PageLabel}" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="v2-map-loot-page-status"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.Name="{Binding PageLabel}" />
                      <Button Classes="v2-target" Content="{Binding PreviousPageLabel}"
                              IsEnabled="{Binding CanGoToPreviousPage}"
                              AutomationProperties.AutomationId="v2-map-loot-page-previous"
                              AutomationProperties.Name="{Binding PreviousPageLabel}"
                              Command="{Binding PreviousPageCommand}" />
                      <Button Classes="v2-target" Content="{Binding NextPageLabel}"
                              IsEnabled="{Binding CanGoToNextPage}"
                              AutomationProperties.AutomationId="v2-map-loot-page-next"
                              AutomationProperties.Name="{Binding NextPageLabel}"
                              Command="{Binding NextPageCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="v2-label" IsVisible="{Binding ShowsEmpty}"
                               Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighValueLootEntryViewModel">
                          <Button Classes="v2-map-choice" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding AutomationName}"
                                  Command="{Binding SelectCommand}">
                            <StackPanel Spacing="3">
                              <TextBlock Classes="v2-body" Text="{Binding Label}" TextWrapping="Wrap" />
                              <WrapPanel ItemSpacing="8" LineSpacing="3">
                                <TextBlock Classes="v2-label" Text="{Binding TierLabel}" />
                                <TextBlock Classes="v2-label" Text="{Binding ValueLabel}" />
                                <TextBlock Classes="v2-label" Text="{Binding ListOnlyLabel}"
                                           IsVisible="{Binding IsListOnly}" />
                              </WrapPanel>
                              <TextBlock Classes="v2-label" Text="{Binding CandidateLabel}" TextWrapping="Wrap" />
                              <TextBlock Classes="v2-label" Text="{Binding LocationLabel}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            </ScrollViewer>
          </Border>

          <Border Classes="v2-card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <!-- A hidden border still evaluates bindings. Instantiate the typed detail
                   template only when a selected object exists, so a normal empty selection
                   cannot emit one binding fault per nested property. -->
              <ContentControl Content="{Binding SelectedObject}" IsVisible="{Binding HasGenericSelection}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererObjectViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}"
                                 AutomationProperties.AutomationId="v2-map-selection-live"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.LiveSetting="Polite"
                                 AutomationProperties.Name="{Binding AutomationName}"
                                 AutomationProperties.HeadingLevel="2" />
                      <TextBlock Classes="v2-body" Text="{Binding Detail}"
                                 IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding FactionLabel}" />
                        <TextBlock Classes="v2-label" IsVisible="{Binding HasOfferStatus}"
                                   Classes.v2-map-offered="{Binding IsOffered}"
                                   Classes.v2-map-not-offered="{Binding IsKnownNotOffered}"
                                   Classes.v2-map-offer-unknown="{Binding IsOfferUnknown}"
                                   Text="{Binding OfferedLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding TruthLabel}" />
                      </WrapPanel>
                      <TextBlock Classes="v2-label" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding EstimateLabel}"
                                 IsVisible="{Binding HasEstimate}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <ContentControl Content="{Binding SelectedLootEntry}" IsVisible="{Binding HasLootSelection}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:HighValueLootEntryViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="v2-heading-3" Text="{Binding Label}"
                                 AutomationProperties.AutomationId="v2-map-loot-selection-live"
                                 AutomationProperties.AccessibilityView="Control"
                                 AutomationProperties.LiveSetting="Polite"
                                 AutomationProperties.Name="{Binding AutomationName}"
                                 AutomationProperties.HeadingLevel="2" />
                      <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <TextBlock Classes="v2-label" Text="{Binding TierLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding ValueLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding LocationLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding FloorLabel}" />
                        <TextBlock Classes="v2-label" Text="{Binding ListOnlyLabel}"
                                   IsVisible="{Binding IsListOnly}" />
                      </WrapPanel>
                      <TextBlock Classes="v2-body" Text="{Binding PossibleItemsLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding CategoriesLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding CandidateLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProfileRelevanceLabel}"
                                 IsVisible="{Binding HasProfileRelevance}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProfileConflictLabel}"
                                 IsVisible="{Binding HasProfileConflicts}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ProbabilityLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding RespawnLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding AccessLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding MissingFactsLabel}"
                                 IsVisible="{Binding HasMissingFacts}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding DatasetLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-dataset" />
                      <TextBlock Classes="v2-label" Text="{Binding SourceLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-source" />
                      <TextBlock Classes="v2-label" Text="{Binding ProducerLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding EvidenceTimeLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" Text="{Binding ConfidenceLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-confidence" />
                      <TextBlock Classes="v2-label" Text="{Binding SourceCoverageLabel}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-map-loot-source-coverage" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <Button Classes="v2-target" Content="{Binding ClearSelectionLabel}"
                      AutomationProperties.AutomationId="v2-map-clear-selection"
                      AutomationProperties.Name="{Binding ClearSelectionLabel}"
                      Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
          </Border>

          <Border Classes="v2-card">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="{Binding LayersLabel}"
                         AutomationProperties.HeadingLevel="2" />
              <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererLayerViewModel">
                    <ToggleButton Classes="v2-map-choice" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  IsChecked="{Binding IsVisible, Mode=OneWay}"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding ToggleLabel}"
                                  AutomationProperties.HelpText="{Binding StateLabel}"
                                  Content="{Binding Name}" Command="{Binding ToggleCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="v2-card">
            <StackPanel Spacing="8">
              <TextBlock Classes="v2-heading-3" Text="{Binding DetailsLabel}"
                         AutomationProperties.HeadingLevel="2" />
              <TextBox Classes="v2-field-input" Text="{Binding SearchText, Mode=TwoWay}"
                       PlaceholderText="{Binding SearchPlaceholder}"
                       AutomationProperties.AutomationId="v2-map-search"
                       AutomationProperties.Name="{Binding SearchLabel}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasClusterFilter}">
                <TextBlock Grid.Column="0" Classes="v2-label" Text="{Binding ClusterFilterLabel}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="v2-target" Content="{Binding ClearClusterLabel}"
                        AutomationProperties.AutomationId="v2-map-clear-cluster"
                        AutomationProperties.Name="{Binding ClearClusterLabel}"
                        Command="{Binding ClearClusterCommand}" />
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <TextBlock Classes="v2-label" Text="{Binding ListPageLabel}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="v2-map-page-status"
                           AutomationProperties.AccessibilityView="Control"
                           AutomationProperties.Name="{Binding ListPageLabel}" />
                <Button Classes="v2-target" Content="{Binding PreviousPageLabel}"
                        IsEnabled="{Binding CanGoToPreviousPage}"
                        AutomationProperties.AutomationId="v2-map-page-previous"
                        AutomationProperties.Name="{Binding PreviousPageLabel}"
                        Command="{Binding PreviousPageCommand}" />
                <Button Classes="v2-target" Content="{Binding NextPageLabel}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        AutomationProperties.AutomationId="v2-map-page-next"
                        AutomationProperties.Name="{Binding NextPageLabel}"
                        Command="{Binding NextPageCommand}" />
              </WrapPanel>
              <TextBlock Classes="v2-label" IsVisible="{Binding ShowsEmptyList}"
                         Text="{Binding EmptyListMessage}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ListItems}" IsVisible="{Binding HasListItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MapSceneRendererListItemViewModel">
                    <ToggleButton Classes="v2-map-choice"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding AutomationName}"
                                  Command="{Binding SelectCommand}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="v2-body" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Classes="v2-label" Text="{Binding Detail}"
                                   IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                          <TextBlock Classes="v2-label" Text="{Binding KindLabel}" />
                          <TextBlock Classes="v2-label" Text="{Binding FactionLabel}" />
                          <TextBlock Classes="v2-label" IsVisible="{Binding HasOfferStatus}"
                                     Classes.v2-map-offered="{Binding IsOffered}"
                                     Classes.v2-map-not-offered="{Binding IsKnownNotOffered}"
                                     Classes.v2-map-offer-unknown="{Binding IsOfferUnknown}"
                                     Text="{Binding OfferedLabel}" />
                          <TextBlock Classes="v2-label" Text="{Binding TruthLabel}" />
                        </WrapPanel>
                        <TextBlock Classes="v2-label" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                      </StackPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
