<UserControl x:Class="TarkovCompanion.App.Views.V2.Team.TeamWorkspaceView"
             x:DataType="vm:TeamWorkspaceViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TarkovCompanion.App.ViewModels.V2.Team"
             xmlns:l="using:TarkovCompanion.App.Localization"
             xmlns:appVm="using:TarkovCompanion.App.ViewModels"
             xmlns:tabletVm="using:TarkovCompanion.App.ViewModels.V2.Tablet"
             xmlns:map="using:TarkovCompanion.App.Views.V2.MapRenderer">
  <UserControl.Resources>
    <!-- Fluent's Expander header is a solid dark slab; in the context panel it reads as a card row (as on Raid). -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- A primary pane: the flat card the Raid map sits in. -->
    <Style Selector="Border.v2-team-pane">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.v2-team-pane.v2-team-stage">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Border.v2-team-panel">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <!-- A context-panel section; the accented one takes the concept's cyan leading edge. -->
    <Style Selector="Border.v2-team-section">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="{DynamicResource V2.Density.Standard.Inset}" />
    </Style>
    <Style Selector="Border.v2-team-section.v2-team-accent">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <!-- A member chip along the top, like the concept's Clayton/Maya/Jordan cards. -->
    <Style Selector="Border.v2-team-member">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Card}" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="MinHeight" Value="58" />
    </Style>
    <Style Selector="Ellipse.v2-team-dot">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.v2-team-dot.v2-team-live">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Ellipse.v2-team-dot.v2-team-stale">
      <Setter Property="Fill" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.v2-team-state">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.v2-team-state.v2-team-live">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="TextBlock.v2-team-state.v2-team-stale">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.v2-team-strong">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.v2-team-pill">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <!-- The shared plan's route: numbered stops joined by a dashed line, like the map's own. -->
    <Style Selector="Border.v2-team-stop">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.v2-team-stop TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- [#780] "Shared" beside a quest two or more of the squad have. -->
    <Style Selector="Border.v2-team-chip">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.v2-team-row">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="Padding" Value="14,9,6,9" />
    </Style>
    <Style Selector="Grid.v2-team-reached">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <!-- [#574] The Marks card is an expander inside a 6,4 border; its header and body are
         inset so its icon and text line up with the Party, Group and Devices cards above and
         below (their inset is the standard 16). -->
    <Style Selector="Expander.v2-team-expander">
      <Setter Property="Padding" Value="10,4,10,10" />
    </Style>
    <Style Selector="Expander.v2-team-expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.v2-team-row.v2-team-reached">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Path.v2-icon.v2-team-success">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Success}" />
    </Style>
    <Style Selector="Path.v2-icon.v2-team-warning">
      <Setter Property="Stroke" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.v2-team-warning-text">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Buttons: one filled primary action per view, cyan outline for secondary ones, and plain
         text for the rest, instead of a wall of bordered buttons. -->
    <Style Selector="Button.v2-team-primary">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Control.Large.Height}" />
      <Setter Property="Padding" Value="22,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.v2-team-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.v2-team-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Button.v2-team-primary:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.v2-team-outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="CornerRadius" Value="{DynamicResource V2.Shape.Control}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.v2-team-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Action}" />
    </Style>
    <Style Selector="Button.v2-team-outline:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.v2-team-plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextSecondary}" />
      <Setter Property="MinHeight" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.v2-team-icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Height" Value="{DynamicResource V2.Target.Desktop}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- [#289] The ready check's two answers: the chosen one filled (ready) or amber (not ready). -->
    <Style Selector="Button.v2-team-outline.v2-team-on">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.v2-team-outline.v2-team-on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Action}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Canvas}" />
    </Style>
    <Style Selector="Button.v2-team-outline.v2-team-hold">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.v2-team-outline.v2-team-hold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource V2.Brush.Warning}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.v2-team-ready-text">
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.Success}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleSwitch.v2-team-switch">
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- V2 rough package 17: laid out like docs/design/v2/v2-team-tablet-concept.png inside the
       package-15 shell. Members run along the top; the tab's own pane fills the rest (Team: the
       shared plan's waypoints, Group: joining and sharing, Tablet preview: paired devices); a
       right context panel carries team quests, the group and devices at a glance, and the one
       primary action. Team, Group and Tablet all land on this view (TeamWorkspaceViewModel). -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12" Margin="16,4,16,16">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ItemsControl ItemsSource="{Binding Presence}" IsVisible="{Binding HasPresence}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TeamPresenceRowViewModel">
              <Border Classes="v2-team-member">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Ellipse Classes="v2-team-dot"
                           Classes.v2-team-live="{Binding IsLive}" Classes.v2-team-stale="{Binding IsStale}" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Name}" />
                      <TextBlock Classes="v2-label" Text="·" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
                      <TextBlock Classes="v2-label" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="v2-label v2-team-state"
                                 Classes.v2-team-live="{Binding IsLive}" Classes.v2-team-stale="{Binding IsStale}"
                                 Text="{Binding StateLabel}" />
                      <TextBlock Classes="v2-label" Text="{Binding SinceLabel}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="v2-team-member" HorizontalAlignment="Left" IsVisible="{Binding HasNoPresence}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Ellipse Classes="v2-team-dot" />
            <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center"
                       Text="{x:Static l:TeamText.NobodySharing}" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="v2-team-pill" VerticalAlignment="Top" MinHeight="58">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Classes="v2-team-dot"
                     Classes.v2-team-live="{Binding IsConnected}" Classes.v2-team-stale="{Binding IsReconnecting}" />
            <TextBlock Classes="v2-body" Text="{Binding ConnectionHealth}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="v2-team-connection"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
      </Grid>

      <Panel Grid.Row="1">
        <!-- Team: the shared plan, drawn on the map the Raid workspace shows (the top bar's map
             picker): the group's waypoints numbered 1..N and joined in order, and pings. The
             renderer is hosted the way Raid and Plan host it; the marks list sits in the context
             panel with the same numbers. -->
        <Border Classes="v2-team-pane v2-team-stage" IsVisible="{Binding IsOverview}">
          <Grid>
            <!-- IsVisible stays on this wrapper, not on MapSceneRendererView itself, whose own
                 DataContext is overridden to MapPreview (same as the Raid workspace). -->
            <ContentControl IsVisible="{Binding HasMapPreview}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="v2-team-map">
              <map:MapSceneRendererView DataContext="{Binding MapPreview}" MarkerRightClicked="MapMarkerRightClicked" />
            </ContentControl>
            <StackPanel IsVisible="{Binding !HasMapPreview}" Spacing="10" MaxWidth="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Map}" />
              </Viewbox>
              <TextBlock Classes="v2-label" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding MapNote}" />
              <Button Classes="v2-team-outline" HorizontalAlignment="Center" Margin="0,6,0,0"
                      Content="{x:Static l:TeamText.OpenRaidMap}" Command="{Binding OpenSharedPlanCommand}" />
            </StackPanel>

            <!-- Bottom-left: the renderer's own presentation pill owns the top-left corner and its
                 zoom group the top-right, as on Raid. -->
            <Border Classes="v2-team-pill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Pin}" />
                <TextBlock Classes="v2-body v2-team-strong" VerticalAlignment="Center"
                           Text="{x:Static l:TeamText.SharedPlanHeading}" AutomationProperties.HeadingLevel="2" />
                <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="·" IsVisible="{Binding !HasMarks}" />
                <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{x:Static l:TeamText.NoneYetLower}" IsVisible="{Binding !HasMarks}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Group: joining, creating and leaving a group, and what this desktop shares. -->
        <Border Classes="v2-team-pane" IsVisible="{Binding IsGroupSection}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- Readable form width: the star column stops at 820 and the rest of the pane stays empty. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="28,22,28,28" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="v2-heading-2" Text="{x:Static l:TeamText.GroupSharing}" AutomationProperties.HeadingLevel="2" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="v2-label" Text="{Binding Status}" TextWrapping="Wrap"
                                 VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="v2-team-group-status"
                                 AutomationProperties.LiveSetting="Polite" />
                      <!-- Every other workspace has a Reload. Without one, a Team pane whose
                           settings would not read had no way back short of restarting. -->
                      <Button Classes="v2-plain v2-target v2-touch-target" Content="{x:Static l:TeamText.Reload}"
                              Command="{Binding ReloadCommand}"
                              AutomationProperties.AutomationId="v2-team-reload"
                              AutomationProperties.Name="{x:Static l:TeamText.ReloadSharingSettings}" />
                    </StackPanel>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" Classes="v2-team-switch" VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                OnContent="{x:Static l:TeamText.ShareThisSession}" OffContent="{x:Static l:TeamText.ShareThisSession}"
                                AutomationProperties.Name="{x:Static l:TeamText.ShareThisSession}" />
                </Grid>

                <StackPanel Spacing="6">
                  <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.ServerAddress}" />
                  <TextBox Classes="v2-field-input" Text="{Binding ServerUri, Mode=TwoWay}"
                           Watermark="https://relay.example" AutomationProperties.Name="{x:Static l:TeamText.ServerAddress}"
                           AutomationProperties.AutomationId="v2-team-server-input" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.DisplayName}" />
                    <TextBox Classes="v2-field-input" Text="{Binding DisplayName, Mode=TwoWay}"
                             AutomationProperties.Name="{x:Static l:TeamText.DisplayName}"
                             AutomationProperties.AutomationId="v2-team-name-input" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.GroupKey}" />
                    <TextBox Classes="v2-field-input" Text="{Binding Key, Mode=TwoWay}" PasswordChar="•"
                             AutomationProperties.Name="{x:Static l:TeamText.GroupKey}"
                             AutomationProperties.AutomationId="v2-team-key-input" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="v2-label" Margin="0,-10,0,0" TextWrapping="Wrap"
                           Text="{x:Static l:TeamText.GroupKeyHint}" />

                <StackPanel Spacing="6">
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:TeamText.WhatYouShare}" AutomationProperties.HeadingLevel="3" />
                  <ToggleSwitch Classes="v2-team-switch" IsChecked="{Binding SharesLoadout, Mode=TwoWay}"
                                OnContent="{x:Static l:TeamText.MyLoadoutToggle}" OffContent="{x:Static l:TeamText.MyLoadoutToggle}" AutomationProperties.Name="{x:Static l:TeamText.ShareMyLoadout}" />
                  <ToggleSwitch Classes="v2-team-switch" IsChecked="{Binding SharesQuests, Mode=TwoWay}"
                                OnContent="{x:Static l:TeamText.MyQuestProgressToggle}" OffContent="{x:Static l:TeamText.MyQuestProgressToggle}"
                                AutomationProperties.Name="{x:Static l:TeamText.ShareMyQuestProgress}" />
                  <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.ShareQuestsHint}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Classes="v2-team-primary" MinWidth="140" AutomationProperties.AutomationId="v2-team-save"
                          Content="{x:Static l:TeamText.Save}" Command="{Binding SaveCommand}" />
                  <Button Classes="v2-team-plain" AutomationProperties.AutomationId="v2-team-leave"
                          Content="{Binding LeaveLabel}" Command="{Binding LeaveCommand}" />
                </StackPanel>

                <!-- Package 29 (parity): V1's Group page said what your own game never tells you —
                     your kit, level, side and scav timer — because a squadmate's game wrote them down. -->
                <StackPanel Spacing="6" AutomationProperties.AutomationId="v2-team-about-you">
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:TeamText.WhatGroupKnows}"
                             AutomationProperties.HeadingLevel="3" />
                  <TextBlock Classes="v2-body" Text="{Binding MyLoadout}" TextWrapping="Wrap" />
                  <TextBlock Classes="v2-body" Text="{Binding MyProfile}" TextWrapping="Wrap"
                             IsVisible="{Binding HasMyProfile}" />
                  <TextBlock Classes="v2-label" TextWrapping="Wrap"
                             Text="{x:Static l:TeamText.WhatGroupKnowsHint}" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding HasPresence}" AutomationProperties.AutomationId="v2-team-members">
                  <TextBlock Classes="v2-heading-3" Text="{x:Static l:TeamText.WhoElseIsHere}" AutomationProperties.HeadingLevel="3" />
                  <ItemsControl ItemsSource="{Binding Presence}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeamPresenceRowViewModel">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Name}" />
                            <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                            <TextBlock Classes="v2-label v2-team-state" VerticalAlignment="Center"
                                       Classes.v2-team-live="{Binding IsLive}" Classes.v2-team-stale="{Binding IsStale}"
                                       Text="{Binding StateLabel}" />
                          </StackPanel>
                          <TextBlock Classes="v2-label" Text="{Binding Position}" IsVisible="{Binding HasPosition}" />
                          <TextBlock Classes="v2-label" Text="{Binding Shared}" IsVisible="{Binding HasShared}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- Tablet preview: this desktop's own paired devices, never the group's members. -->
        <Border Classes="v2-team-pane" IsVisible="{Binding IsDevicesSection}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- Readable form width: the star column stops at 820 and the rest of the pane stays empty. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="28,22,28,28" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="v2-heading-2" Text="{x:Static l:TeamText.YourDevices}" AutomationProperties.HeadingLevel="2" />
                    <TextBlock Classes="v2-label" Text="{Binding DevicesSummary}" />
                  </StackPanel>
                  <!-- Kept for the automation id that used to open the window; inside this
                       section the flow below is the surface, so it is not a second entry point. -->
                  <Button Grid.Column="1" Classes="v2-team-primary" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="v2-team-pair-tablet"
                          ToolTip.Tip="{Binding PairTabletTooltip}" ToolTip.ShowOnDisabled="True"
                          Content="{x:Static l:TeamText.PairATablet}" Command="{Binding Pairing.StartPairingCommand}"
                          IsEnabled="{Binding Pairing.CanStartPairing}" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding PairingUnavailableReason}"
                           AutomationProperties.AutomationId="v2-team-pairing-unavailable"
                           IsVisible="{Binding !CanPairDevice}" TextWrapping="Wrap" />

                <Border Classes="v2-team-row" IsVisible="{Binding Pairing.HasClockSkewNotice}"
                        AutomationProperties.AutomationId="v2-team-clock-skew">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="v2-body v2-team-warning-text" TextWrapping="Wrap"
                               Text="{Binding Pairing.ClockSkewNotice}" />
                    <TextBlock Classes="v2-label" TextWrapping="Wrap"
                               Text="{Binding Pairing.ClockSkewHelp}" />
                  </StackPanel>
                </Border>

                <!-- V2 rough package 48 (#290, #292): pairing lives here now, not in a popout
                     window. [#553] There is no claim step and no admin key: this desktop
                     registers itself on the relay with the group key, and these two lines say
                     how that went. One is shown at a time. -->
                <TextBlock Classes="v2-label" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-team-claimed"
                           Text="{Binding Pairing.ClaimedSummary}"
                           IsVisible="{Binding Pairing.IsClaimedByThisDesktop}" />
                <TextBlock Classes="v2-label" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="v2-team-claim-message"
                           Text="{Binding Pairing.RelayClaimMessage}"
                           IsVisible="{Binding Pairing.ShowsRelayProblem}" />

                <Border Classes="v2-team-row" IsVisible="{Binding CanPairDevice}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="v2-body v2-team-strong" Text="{x:Static l:TeamText.AddADevice}" />

                    <StackPanel Spacing="8" IsVisible="{Binding Pairing.IsIdle}">
                      <TextBlock Classes="v2-label" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-team-pairing-blocked"
                                 Text="{Binding Pairing.StartPairingBlockedReason}"
                                 IsVisible="{Binding !Pairing.CanStartPairing}" />
                      <Button Classes="v2-team-primary" HorizontalAlignment="Left" Content="{x:Static l:TeamText.StartPairing}"
                              AutomationProperties.AutomationId="v2-team-start-pairing"
                              Command="{Binding Pairing.StartPairingCommand}"
                              IsEnabled="{Binding Pairing.CanStartPairing}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding Pairing.IsAwaitingTablet}">
                      <TextBlock Classes="v2-label" TextWrapping="Wrap"
                                 Text="{x:Static l:TeamText.ScanThis}" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <!-- [V2 rough package 60 — Team] #289: the payload has always existed and
                             was never drawn, so the only way onto a tablet was to type. White
                             behind it in every theme: a reader wants dark on light, and the
                             high-contrast palette's canvas is black. -->
                        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="0"
                                IsVisible="{Binding Pairing.HasQrSymbol}"
                                AutomationProperties.AccessibilityView="Raw">
                          <Viewbox Width="176" Height="176">
                            <Path Fill="Black" Data="{Binding Pairing.QrPath}"
                                  AutomationProperties.AutomationId="v2-team-pairing-qr" />
                          </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                          <!-- Read across a desk, which is where the tablet is. -->
                          <TextBlock Classes="v2-team-strong" FontFamily="monospace" FontSize="{DynamicResource V2.Type.Display.Size}"
                                     AutomationProperties.AutomationId="v2-team-pairing-code"
                                     Text="{Binding Pairing.PairingCode}" />
                          <!-- The QR is this same URL, with the code in its fragment (#289): a
                               phone camera can only open a link, and this is what it opens. Shown
                               as text too, for typing when the camera or the QR is unavailable. -->
                          <SelectableTextBlock Classes="v2-label" TextWrapping="Wrap"
                                     FontFamily="monospace"
                                     AutomationProperties.AutomationId="v2-team-pairing-url"
                                     IsVisible="{Binding Pairing.HasRelayTabletUrl}"
                                     Text="{Binding Pairing.RelayTabletUrl}" />
                          <TextBlock Classes="v2-label" TextWrapping="Wrap"
                                     AutomationProperties.AutomationId="v2-team-pairing-expiry"
                                     AutomationProperties.LiveSetting="Polite"
                                     IsVisible="{Binding Pairing.HasCodeExpiry}"
                                     Text="{Binding Pairing.CodeExpiry}" />
                          <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.WaitingForTablet}"
                                     IsVisible="{Binding !Pairing.IsCodeExpired}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding Pairing.IsAwaitingApproval}">
                      <TextBlock Classes="v2-label" TextWrapping="Wrap">
                        <Run Text="{Binding Pairing.RequestedDisplayName}" /><Run Text="{x:Static l:TeamText.WantsToPair}" />
                      </TextBlock>
                      <TextBlock Classes="v2-team-strong" FontFamily="monospace" FontSize="{DynamicResource V2.Type.Display.Size}"
                                 AutomationProperties.AutomationId="v2-team-verification-code"
                                 Text="{Binding Pairing.VerificationCode}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="v2-team-primary" Content="{x:Static l:TeamText.Approve}"
                                AutomationProperties.AutomationId="v2-team-approve-pairing"
                                Command="{Binding Pairing.ApproveCommand}" IsEnabled="{Binding !Pairing.IsBusy}" />
                        <Button Classes="v2-team-plain" Content="{x:Static l:TeamText.Deny}"
                                AutomationProperties.AutomationId="v2-team-deny-pairing"
                                Command="{Binding Pairing.DenyCommand}" IsEnabled="{Binding !Pairing.IsBusy}" />
                      </StackPanel>
                    </StackPanel>

                    <TextBlock Classes="v2-label" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="v2-team-pairing-status"
                               Text="{Binding Pairing.StatusMessage}"
                               IsVisible="{Binding Pairing.HasStatusMessage}" />
                  </StackPanel>
                </Border>

                <!-- V2 rough package 24 (#407): a paired device asking to drive this desktop, and
                     the one action that takes control back once one is. -->
                <Border Classes="v2-team-row" IsVisible="{Binding HasControlRequest}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Classes="v2-body" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding ControlRequestMessage}" />
                    <Button Grid.Column="1" Classes="v2-team-primary" Content="{x:Static l:TeamText.Allow}"
                            AutomationProperties.AutomationId="v2-team-allow-control"
                            Command="{Binding AllowControlCommand}" />
                    <Button Grid.Column="2" Classes="v2-team-plain" Content="{x:Static l:TeamText.Deny}"
                            AutomationProperties.AutomationId="v2-team-deny-control"
                            Command="{Binding DenyControlCommand}" />
                  </Grid>
                </Border>

                <Border Classes="v2-team-row" IsVisible="{Binding HasControlHolder}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="v2-body" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding ControlHolderMessage}" />
                    <Button Grid.Column="1" Classes="v2-team-primary" Content="{x:Static l:TeamText.TakeBackControl}"
                            AutomationProperties.AutomationId="v2-team-take-back-control"
                            Command="{Binding TakeBackControlCommand}" />
                  </Grid>
                </Border>

                <!-- #290: the desk's half of the tablet's "Show on desktop". -->
                <Border Classes="v2-team-row" IsVisible="{Binding !HasNoDevices}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="v2-body" Text="{x:Static l:TeamText.ShowMapOnTablets}" TextWrapping="Wrap" />
                      <TextBlock Classes="v2-label" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="v2-team-send-to-tablet-status"
                                 IsVisible="{Binding Pairing.HasSendMapToTabletMessage}" Text="{Binding Pairing.SendMapToTabletMessage}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="v2-team-outline" Content="{x:Static l:TeamText.SendToTablet}"
                            AutomationProperties.AutomationId="v2-team-send-to-tablet"
                            IsEnabled="{Binding Pairing.CanSendMapToTablet}"
                            Command="{Binding Pairing.SendMapToTabletCommand}" />
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding !HasNoDevices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tabletVm:PairedDeviceRowViewModel">
                      <Border Classes="v2-team-row">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                          <Path Classes="v2-icon v2-icon-muted" VerticalAlignment="Center" Data="{DynamicResource V2.Icon.Tablet}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="v2-body v2-team-strong" Text="{Binding DisplayName}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="v2-label" Text="{Binding Role}" />
                              <TextBlock Classes="v2-label" Text="·" />
                              <TextBlock Classes="v2-label" Text="{Binding Status}" />
                              <TextBlock Classes="v2-label" Text="·" IsVisible="{Binding IsPairingOutOfDate}" />
                              <TextBlock Classes="v2-label v2-team-warning-text" IsVisible="{Binding IsPairingOutOfDate}"
                                         Text="{Binding PairingOutOfDateLabel}"
                                         AutomationProperties.AutomationId="v2-team-device-out-of-date" />
                            </StackPanel>
                            <TextBlock Classes="v2-label" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive"
                                       IsVisible="{Binding Confirming}" Text="{Binding RevokeWarning}" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="v2-team-plain" Content="{Binding RevokeLabel}"
                                  Command="{Binding RevokeCommand}" IsVisible="{Binding CanRevoke}"
                                  AutomationProperties.AutomationId="v2-team-revoke-device" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- V2 rough package 32: centred, because with nothing paired this is the whole
                     content of the pane. Left-aligned under the header it left about three
                     quarters of a 1920x1080 window as a void with a line of text in one corner. -->
                <StackPanel IsVisible="{Binding HasNoDevices}" Spacing="10" Margin="0,72,0,72" MaxWidth="420"
                            HorizontalAlignment="Center">
                  <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                    <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Tablet}" />
                  </Viewbox>
                  <TextBlock Classes="v2-heading-3" HorizontalAlignment="Center" Text="{x:Static l:TeamText.NoPairedDevicesYet}" />
                  <TextBlock Classes="v2-label" TextWrapping="Wrap" TextAlignment="Center"
                             Text="{x:Static l:TeamText.PairHint}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>
      </Panel>
    </Grid>

    <!-- The context panel: the same on every Team tab. -->
    <Border Grid.Column="1" Width="420" Classes="v2-team-panel">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="16,12,16,16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="v2-heading-2" Text="{x:Static l:TeamText.Heading}" AutomationProperties.HeadingLevel="2" />
              <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center" Text="{Binding MemberCountLabel}" />
            </Grid>

            <!-- [#269] A squadmate on another game mode: said once, their quests kept apart. -->
            <Border Classes="v2-team-section" IsVisible="{Binding HasModeWarning}"
                    AutomationProperties.AutomationId="v2-team-mode-warning">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Classes="v2-label" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource V2.Brush.Warning}" Text="{Binding ModeWarning}" />
                <Button Grid.Column="1" Classes="v2-target" Content="{x:Static l:TeamText.Ok}" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="v2-team-mode-warning-dismiss"
                        Command="{Binding DismissModeWarningCommand}" />
              </Grid>
            </Border>

            <!-- [#289] Ready check: what this player shares with the squad (ready or not, an
                 extract on the map on screen, a short note) and what each squadmate shared. -->
            <Border Classes="v2-team-section v2-team-accent" IsVisible="{Binding CanShareStatus}"
                    AutomationProperties.AutomationId="v2-team-ready-check">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Check}" />
                  <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.ReadyCheck}"
                             AutomationProperties.HeadingLevel="3" />
                  <TextBlock Grid.Column="2" Classes="v2-label" VerticalAlignment="Center" Text="{Binding ReadySummary}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Classes="v2-team-outline" HorizontalAlignment="Stretch" Content="{x:Static l:TeamText.Ready}"
                          Classes.v2-team-on="{Binding IsReady}"
                          AutomationProperties.AutomationId="v2-team-ready"
                          Command="{Binding ReadyCommand}" />
                  <Button Grid.Column="1" Classes="v2-team-outline" HorizontalAlignment="Stretch" Content="{x:Static l:TeamText.NotReady}"
                          Classes.v2-team-hold="{Binding IsNotReady}"
                          AutomationProperties.AutomationId="v2-team-not-ready"
                          Command="{Binding NotReadyCommand}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <TextBlock Classes="v2-label" VerticalAlignment="Center" Text="{x:Static l:TeamText.Extract}" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="v2-team-extract"
                            AutomationProperties.Name="{x:Static l:TeamText.ExtractToShare}"
                            ItemsSource="{Binding ExtractOptions}" SelectedItem="{Binding SelectedExtract, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="v2-field-input" Text="{Binding NoteDraft, Mode=TwoWay}" MaxLength="{Binding NoteLimit}"
                           Watermark="{x:Static l:TeamText.NoteForSquad}"
                           AutomationProperties.AutomationId="v2-team-note"
                           AutomationProperties.Name="{x:Static l:TeamText.NoteForSquad}" />
                  <Button Grid.Column="1" Classes="v2-team-outline" Content="{x:Static l:TeamText.Share}"
                          AutomationProperties.AutomationId="v2-team-share-note"
                          IsEnabled="{Binding CanShareNote}" Command="{Binding ShareNoteCommand}" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding SharedNoteLabel}" IsVisible="{Binding HasSharedNote}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding SquadStatusRows}" IsVisible="{Binding HasSquadStatusRows}"
                              AutomationProperties.AutomationId="v2-team-squad-status">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamSquadStatusRowViewModel">
                      <StackPanel Spacing="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center"
                                     Classes.v2-team-ready-text="{Binding IsReady}"
                                     Classes.v2-team-warning-text="{Binding IsNotReady}"
                                     Text="{Binding ReadyLabel}" IsVisible="{Binding HasReady}" />
                        </Grid>
                        <TextBlock Classes="v2-label" Text="{Binding ExtractLabel}" IsVisible="{Binding HasExtract}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="v2-body" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- [#780] Squad quests: every member's active quests, named from this catalog, with
                 progress, and "Shared" where two or more of you are on the same one. -->
            <Border Classes="v2-team-section v2-team-accent" IsVisible="{Binding HasSquadQuests}"
                    AutomationProperties.AutomationId="v2-team-squad-quests">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Target}" />
                  <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.SquadQuests}"
                             AutomationProperties.HeadingLevel="3" />
                  <TextBlock Grid.Column="2" Classes="v2-label" VerticalAlignment="Center" Text="{Binding SquadQuestsSummary}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SquadQuests}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamSquadQuestMemberViewModel">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <Ellipse Classes="v2-team-dot" Fill="{Binding Colour}" IsVisible="{Binding HasColour}" />
                          <TextBlock Grid.Column="1" Classes="v2-body v2-team-strong" Text="{Binding Name}" />
                          <TextBlock Grid.Column="2" Classes="v2-label" Text="{Binding Summary}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Quests}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TeamSquadQuestRowViewModel">
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,0,0,0">
                                <TextBlock Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Classes="v2-team-chip" IsVisible="{Binding IsShared}">
                                  <TextBlock Classes="v2-label" Text="{x:Static l:TeamText.Shared}" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="v2-label" VerticalAlignment="Center"
                                           Text="{Binding Progress}" IsVisible="{Binding HasProgress}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="v2-team-section v2-team-accent" IsVisible="{Binding !HasSquadQuests}">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="v2-icon v2-icon-action" Data="{DynamicResource V2.Icon.Target}" />
                  <TextBlock Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.TeamQuests}"
                             AutomationProperties.HeadingLevel="3" />
                </StackPanel>
                <TextBlock Classes="v2-label" IsVisible="{Binding !HasTeamQuests}" TextWrapping="Wrap"
                           Text="{x:Static l:TeamText.NoSharedQuests}" />
                <ItemsControl ItemsSource="{Binding TeamQuests}" IsVisible="{Binding HasTeamQuests}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamQuestRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Classes="v2-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center" Text="{Binding CountLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Package 29 (parity): V1's Squad page — who you are running with, from the game's own
                 party notifications — over the same view model, in the panel's own card shape. -->
            <Border Classes="v2-team-section" IsVisible="{Binding HasParty}"
                    AutomationProperties.AutomationId="v2-team-party">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.People}" />
                  <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.Party}"
                             AutomationProperties.HeadingLevel="3" />
                  <TextBlock Grid.Column="2" Classes="v2-label" VerticalAlignment="Center" Text="{Binding Party.Status}" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding Party.Queue}" TextWrapping="Wrap" />
                <TextBlock Classes="v2-label" IsVisible="{Binding Party.HasNoMembers}" TextWrapping="Wrap"
                           Text="{x:Static l:TeamText.PartyHint}" />
                <ItemsControl ItemsSource="{Binding Party.Members}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="appVm:SquadMemberViewModel">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="v2-label" VerticalAlignment="Center"
                                     Foreground="{Binding ReadinessColor}" Text="{Binding Readiness}" />
                        </Grid>
                        <TextBlock Classes="v2-label" TextWrapping="Wrap">
                          <Run Text="{Binding Role}" /><Run Text=" · " /><Run Text="{Binding Level}" /><Run Text=" · " /><Run Text="{Binding Scav}" />
                        </TextBlock>
                        <ItemsControl IsVisible="{Binding HasGear}" ItemsSource="{Binding Gear}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="appVm:SquadGearViewModel">
                              <TextBlock Classes="v2-label" Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="v2-label" Text="{Binding Party.Evidence}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- The shared plan's marks, numbered like the map's markers, with their actions. -->
            <Border Classes="v2-team-section" Padding="6,4" AutomationProperties.AutomationId="v2-team-marks">
              <Expander Classes="v2-team-expander" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                  <!-- [#314] The heading keeps its width and the summary gives way: a longer
                       language squeezed "Marks" to one letter a line when the summary was Auto. -->
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Pin}" />
                    <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.Marks}"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Grid.Column="2" Classes="v2-label" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextWrapping="Wrap" TextAlignment="Right" Text="{Binding MarksSummary}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Spacing="6">
                  <TextBlock Classes="v2-label" IsVisible="{Binding HasNoMarks}" TextWrapping="Wrap"
                             Text="{x:Static l:TeamText.MarksHint}" />
                  <!-- [V2 rough package 60 — Team] #289: undo rather than confirm. A dialog on
                       every removed ping would be in the way constantly, and putting one back
                       costs nothing; revoking a device is the opposite case and is confirmed. -->
                  <Button Classes="v2-team-plain" HorizontalAlignment="Left"
                          IsVisible="{Binding CanUndoRemove}"
                          AutomationProperties.AutomationId="v2-team-undo-remove-mark"
                          AutomationProperties.LiveSetting="Polite"
                          Content="{Binding UndoRemoveLabel}" Command="{Binding UndoRemoveCommand}" />
                  <ItemsControl ItemsSource="{Binding Waypoints}" IsVisible="{Binding HasWaypoints}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeamMarkRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"
                              Classes.v2-team-reached="{Binding IsReached}">
                          <Border Classes="v2-team-stop">
                            <TextBlock Text="{Binding Number}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" Text="{Binding Detail}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" Text="{Binding MetadataLabel}" TextWrapping="Wrap"
                                       Classes.v2-team-warning-text="{Binding IsQueued}" />
                          </StackPanel>
                          <Path Grid.Column="2" Classes="v2-icon v2-team-success" VerticalAlignment="Center"
                                Data="{DynamicResource V2.Icon.Check}" IsVisible="{Binding IsReached}" />
                          <Button Grid.Column="3" Classes="v2-team-icon" Command="{Binding RemoveCommand}"
                                  AutomationProperties.Name="{x:Static l:TeamText.RemoveWaypoint}" ToolTip.Tip="{x:Static l:TeamText.Remove}">
                            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Pings}" IsVisible="{Binding HasPings}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeamMarkRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Panel Width="30" Height="30">
                            <Path Classes="v2-icon v2-team-warning" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{DynamicResource V2.Icon.Target}" />
                          </Panel>
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Classes="v2-body v2-team-strong" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" Text="{Binding Detail}" TextWrapping="Wrap" />
                            <TextBlock Classes="v2-label" Text="{Binding MetadataLabel}" TextWrapping="Wrap"
                                       Classes.v2-team-warning-text="{Binding IsQueued}" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="v2-team-icon" Command="{Binding RemoveCommand}"
                                  AutomationProperties.Name="{x:Static l:TeamText.RemovePing}" ToolTip.Tip="{x:Static l:TeamText.Remove}">
                            <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.Close}" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </Border>

            <Border Classes="v2-team-section">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.People}" />
                  <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.Group}"
                             AutomationProperties.HeadingLevel="3" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Classes="v2-team-dot" Width="8" Height="8"
                             Classes.v2-team-live="{Binding IsConnected}" Classes.v2-team-stale="{Binding IsReconnecting}" />
                    <TextBlock Classes="v2-label" Text="{Binding ConnectionHealth}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding ConnectionDetail}" TextWrapping="Wrap"
                           IsVisible="{Binding ConnectionDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="v2-team-outline" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                        Content="{x:Static l:TeamText.ManageGroup}" Command="{Binding ManageGroupCommand}"
                        IsVisible="{Binding !IsGroupSection}" />
              </StackPanel>
            </Border>

            <Border Classes="v2-team-section">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Path Classes="v2-icon v2-icon-muted" Data="{DynamicResource V2.Icon.PersonAdd}" />
                  <TextBlock Grid.Column="1" Classes="v2-heading-3" VerticalAlignment="Center" Text="{x:Static l:TeamText.Devices}"
                             AutomationProperties.HeadingLevel="3" />
                </Grid>
                <TextBlock Classes="v2-label" Text="{Binding DevicesSummary}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                  <Button Classes="v2-team-outline" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="v2-team-panel-pair-tablet"
                          ToolTip.Tip="{Binding PairTabletTooltip}" ToolTip.ShowOnDisabled="True"
                          Content="{x:Static l:TeamText.PairATablet}" Command="{Binding PairTabletCommand}"
                          IsEnabled="{Binding CanPairDevice}" />
                  <Button Grid.Column="1" Classes="v2-team-plain" Content="{x:Static l:TeamText.Manage}"
                          Command="{Binding ManageDevicesCommand}" IsVisible="{Binding !IsDevicesSection}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Classes="v2-team-primary" HorizontalAlignment="Stretch" Margin="16,0,16,16"
                Command="{Binding OpenSharedPlanCommand}"
                AutomationProperties.AutomationId="v2-team-open-shared-plan">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="v2-icon" Stroke="{DynamicResource V2.Brush.Canvas}" Data="{DynamicResource V2.Icon.Map}" />
            <TextBlock Text="{x:Static l:TeamText.OpenSharedPlan}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
