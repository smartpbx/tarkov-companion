<Application
    x:Class="TarkovCompanion.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="Foreground" Value="#C6D0D8" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#93A0AA" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#242E39" />
      <Setter Property="TextElement.Foreground" Value="#E8EEF2" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1A212A" />
      <Setter Property="BorderBrush" Value="#303B47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8F9BA6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#E4EAEE" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
