<Application
    x:Class="TarkovCompanion.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <!-- Dark is the variant the application starts in and the one it keeps unless somebody chooses
       otherwise: every control the theme draws on its own, which is the buttons, the combo box
       popups, the text box placeholders, the tooltips and the scroll bars, took its colours from
       the desktop's variant, and on a light desktop that put light grey placeholder text on a
       near-black box and made an unstyled button all but invisible. It is a default rather than a
       pin — V2AppearanceApplier (#266/#315) replaces it at startup with the stored choice, which
       is how light, high contrast and the colour-vision palettes became reachable at all.

       All styling lives in Themes/InstrumentStyles.axaml, included once here so that it
       applies to every window and every view. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TarkovCompanion/Themes/V2/V2Resources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://TarkovCompanion/Themes/InstrumentStyles.axaml" />
    <!-- V2 is merged by the application host, not by the #266 primitive tree.  The legacy
         shell remains styled exactly as before; the V2 classes are opt-in on the preview host. -->
    <StyleInclude Source="avares://TarkovCompanion/Themes/V2/V2PrimitiveStyles.axaml" />
    <StyleInclude Source="avares://TarkovCompanion/Themes/V2/V2WorkspaceStyles.axaml" />
    <Style Selector="Window">
      <!-- The canvas and text roles rather than two literals, so a window in the light or
           high-contrast variant is not a dark frame around a light shell. -->
      <Setter Property="Background" Value="{DynamicResource V2.Brush.Canvas}" />
      <Setter Property="Foreground" Value="{DynamicResource V2.Brush.TextPrimary}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <!-- A resource, not a literal, so the text-scale preference reaches every
           control that has no size class of its own. -->
      <Setter Property="FontSize" Value="{DynamicResource Instrument.Type.Body.Size}" />
    </Style>
  </Application.Styles>
</Application>
