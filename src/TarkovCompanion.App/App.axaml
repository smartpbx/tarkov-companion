<Application
    x:Class="TarkovCompanion.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="Foreground" Value="#C6D0D8" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#93A0AA" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#242E39" />
      <Setter Property="TextElement.Foreground" Value="#E8EEF2" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1A212A" />
      <Setter Property="BorderBrush" Value="#303B47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8F9BA6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#E4EAEE" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="#E4EAEE" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Accent classes encode which kind of information a panel carries, following the
         tokens in docs/DESIGN_SYSTEM.md: cyan for position and navigation, ochre for
         economy and value. -->
    <Style Selector="Border.panel.cyan">
      <Setter Property="BorderBrush" Value="#2F5E68" />
    </Style>
    <Style Selector="Border.panel.ochre">
      <Setter Property="BorderBrush" Value="#6A5731" />
    </Style>
    <Style Selector="Border.readout">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="BorderBrush" Value="#303B47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TextBlock.hotkey">
      <Setter Property="Foreground" Value="#C6A15B" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
    </Style>
  </Application.Styles>
</Application>
