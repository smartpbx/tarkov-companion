<Application
    x:Class="TarkovCompanion.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <!-- The theme variant is pinned to Dark rather than following the desktop. The window has
       always painted itself dark, but every control the theme draws on its own, which is the
       buttons, the combo box popups, the text box placeholders, the tooltips and the scroll
       bars, took its colours from the desktop's variant. On a light desktop that put light
       grey placeholder text on a near-black box and made an unstyled button all but invisible.

       All styling lives in Themes/InstrumentStyles.axaml, included once here so that it
       applies to every window and every view. -->
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://TarkovCompanion/Themes/InstrumentStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="Foreground" Value="#C6D0D8" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Styles>
</Application>
