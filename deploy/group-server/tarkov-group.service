# The relay, as it actually runs on CT 115.
#
# Committed because it was not. It existed only on the box, so the one file that says how this
# service is confined could not be reviewed, could not be diffed, and would have to be
# reconstructed from memory if the container were ever rebuilt.

[Unit]
Description=Tarkov Companion group relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tarkov-group
ExecStart=/opt/tarkov-group/TarkovCompanion.GroupServer
Restart=always
RestartSec=5

# Bound to every interface on purpose. cloudflared is not on this container; the tunnel
# reaches 8090 across the LAN, so a loopback bind takes the public hostname down.
Environment=ASPNETCORE_URLS=http://0.0.0.0:8090

# Waypoints, the room registry, problem reports and update stamps live here. systemd
# creates and owns /var/lib/tarkov-group, which is outside /opt/tarkov-group and survives the
# updater's `rm -rf` of the install tree -- which is the whole point of putting them there.
StateDirectory=tarkov-group

# A relay that holds a handful of rooms has no business being able to take the box down. It
# ran as root with MemoryMax=infinity on a container with 1 GB.
DynamicUser=yes
MemoryMax=512M
MemoryHigh=384M

# Already set before this file was committed; kept and written down.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
