[Unit]
Description=Check for a newer Tarkov Companion group relay build

[Timer]
# Twice an hour, with a spread so every container that ever runs this does not ask GitHub at
# the same second. Live member positions are memory-only and re-publish every five seconds; the
# configured state directory separately preserves room registration, marks, and problem reports.
OnBootSec=3min
OnUnitActiveSec=30min
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
