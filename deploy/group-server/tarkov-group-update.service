[Unit]
Description=Update the Tarkov Companion group relay to its signed release ring
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The feed, ring and trust root this host follows. Optional so that a host not yet configured
# fails with the updater's own explanation rather than a unit that will not start.
EnvironmentFile=-/etc/tarkov-group/release-feed.env
ExecStart=/opt/tarkov-group-update.sh
# Root's own directory for the lock, the swap journal, the work directories and every stamp the
# updater decides from. Not the relay's StateDirectory: the relay's unprivileged user owns that,
# and a journal it can write is a journal it can fill with something for root to install. The
# updater refuses to run if this is a link, is not root's, or is writable by anyone else.
StateDirectory=tarkov-group-update
StateDirectoryMode=0700
# A oneshot has no start timeout by default, so a hung download would hold the lock for ever.
# Timing out sends SIGTERM, which the updater turns into the same rollback as any other failure.
TimeoutStartSec=20min
