<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TarkovCompanion.App/TarkovCompanion.App.csproj" />
    <ProjectReference Include="../../src/TarkovCompanion.Core/TarkovCompanion.Core.csproj" />
    <ProjectReference Include="../../src/TarkovCompanion.Application/TarkovCompanion.Application.csproj" />
    <ProjectReference Include="../../src/TarkovCompanion.CompanionProtocol/TarkovCompanion.CompanionProtocol.csproj" />
    <!-- The group key decides who shares a room with whom, so its rules are worth testing
         in the same suite as everything else rather than only at run time. -->
    <ProjectReference Include="../../src/TarkovCompanion.GroupServer/TarkovCompanion.GroupServer.csproj" />
    <ProjectReference Include="../../src/TarkovCompanion.Infrastructure/TarkovCompanion.Infrastructure.csproj" />
    <ProjectReference Include="../../src/TarkovCompanion.Platform.Windows/TarkovCompanion.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../fixtures/api/tasks-contract.json" Link="fixtures/api/tasks-contract.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/profiles/profile-context-v1.json" Link="fixtures/profiles/profile-context-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/release/version-grammar.json" Link="fixtures/release/version-grammar.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/loot-spawns/**/*" Link="fixtures/loot-spawns/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/quest-zones/*.json" Link="fixtures/quest-zones/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/maps/tarkov-dev-catalog.synthetic.json" Link="fixtures/maps/tarkov-dev-catalog.synthetic.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/maps/catalog-geometry-2026-09-18.json" Link="fixtures/maps/catalog-geometry-2026-09-18.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LootScanMeasurement/Fixtures/real-gear-grid-ground-truth.txt" Link="Fixtures/real-gear-grid-ground-truth.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Three QR symbols this encoder produced and zbar read back, pinned so a change that
         breaks the encoder fails even where no decoder is installed. -->
    <None Include="V2Team/qr-golden.txt" Link="V2Team/qr-golden.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compatibility/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
