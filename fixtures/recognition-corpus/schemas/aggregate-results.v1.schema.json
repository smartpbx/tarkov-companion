{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/aggregate-results.v1.schema.json",
  "title": "Privacy-safe recognition benchmark aggregates",
  "type": "object",
  "required": ["schemaVersion", "policyVersion", "evidenceClass", "privacy", "slices"],
  "properties": {
    "schemaVersion": { "const": "aggregate-results.v1" },
    "policyVersion": { "const": "recognition-scorer-policy.v1" },
    "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
    "privacy": {
      "type": "object",
      "required": ["safeToPublish", "minimumIndependentSplitUnits", "containsPerSampleResults"],
      "properties": {
        "safeToPublish": { "const": true },
        "minimumIndependentSplitUnits": { "type": "integer", "minimum": 5 },
        "containsPerSampleResults": { "const": false }
      },
      "additionalProperties": true
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slice" }
    }
  },
  "$defs": {
    "intent": {
      "enum": ["loot-decision", "full-stash", "ammo", "keys", "quest-items", "map-extracts-timers", "health-character", "auto-detect"]
    },
    "evidenceClass": { "enum": ["real-raster", "synthetic-raster", "post-ocr-evidence"] },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "slice": {
      "type": "object",
      "required": [
        "intent",
        "evidenceClass",
        "status",
        "numerator",
        "denominator",
        "excludedUnknowns",
        "independentSplitUnits",
        "attemptedKnownClaims",
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "abstentions",
        "confidentWrong",
        "missingFrames",
        "reorderedFrames",
        "overlapDeduplicationErrors",
        "accuracyNumerator",
        "accuracyDenominator",
        "recallNumerator",
        "recallDenominator",
        "falsePositiveNumerator",
        "falsePositiveDenominator",
        "coverage",
        "accuracy",
        "recall",
        "falsePositiveRate",
        "f1",
        "abstentionRate",
        "confidentWrongRate",
        "confidenceIntervalLower",
        "confidenceIntervalUpper",
        "performanceSampleCount",
        "meanElapsedMilliseconds",
        "maximumElapsedMilliseconds"
      ],
      "properties": {
        "intent": { "$ref": "#/$defs/intent" },
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "status": { "enum": ["pass", "fail", "insufficient-data"] },
        "numerator": { "$ref": "#/$defs/count" },
        "denominator": { "$ref": "#/$defs/count" },
        "excludedUnknowns": { "$ref": "#/$defs/count" },
        "independentSplitUnits": { "$ref": "#/$defs/count" },
        "attemptedKnownClaims": { "$ref": "#/$defs/count" },
        "truePositives": { "$ref": "#/$defs/count" },
        "falsePositives": { "$ref": "#/$defs/count" },
        "falseNegatives": { "$ref": "#/$defs/count" },
        "abstentions": { "$ref": "#/$defs/count" },
        "confidentWrong": { "$ref": "#/$defs/count" },
        "missingFrames": { "$ref": "#/$defs/count" },
        "reorderedFrames": { "$ref": "#/$defs/count" },
        "overlapDeduplicationErrors": { "$ref": "#/$defs/count" },
        "accuracyNumerator": { "$ref": "#/$defs/count" },
        "accuracyDenominator": { "$ref": "#/$defs/count" },
        "recallNumerator": { "$ref": "#/$defs/count" },
        "recallDenominator": { "$ref": "#/$defs/count" },
        "falsePositiveNumerator": { "$ref": "#/$defs/count" },
        "falsePositiveDenominator": { "$ref": "#/$defs/count" },
        "coverage": { "$ref": "#/$defs/rate" },
        "accuracy": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" },
        "falsePositiveRate": { "$ref": "#/$defs/rate" },
        "f1": { "$ref": "#/$defs/rate" },
        "abstentionRate": { "$ref": "#/$defs/rate" },
        "confidentWrongRate": { "$ref": "#/$defs/rate" },
        "confidenceIntervalLower": { "$ref": "#/$defs/rate" },
        "confidenceIntervalUpper": { "$ref": "#/$defs/rate" },
        "performanceSampleCount": { "$ref": "#/$defs/count" },
        "meanElapsedMilliseconds": { "type": ["number", "null"], "minimum": 0, "maximum": 120000 },
        "maximumElapsedMilliseconds": { "type": ["number", "null"], "minimum": 0, "maximum": 120000 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["pass", "fail"] } }, "required": ["status"] },
          "then": { "properties": { "independentSplitUnits": { "minimum": 5 }, "denominator": { "minimum": 30 } } }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
