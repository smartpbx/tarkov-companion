{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/consent.v1.schema.json",
  "title": "Private recognition corpus consent record",
  "type": "object",
  "required": [
    "schemaVersion",
    "consentId",
    "consentHash",
    "allowedUses",
    "consentedUtc",
    "retention",
    "revocation"
  ],
  "properties": {
    "schemaVersion": { "const": "consent.v1" },
    "consentId": { "$ref": "#/$defs/opaqueId" },
    "consentHash": { "$ref": "#/$defs/sha256" },
    "allowedUses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "benchmark" },
      "items": { "enum": ["benchmark", "train", "tune"] }
    },
    "consentedUtc": { "$ref": "#/$defs/utc" },
    "retention": {
      "type": "object",
      "required": ["expiresUtc"],
      "properties": {
        "expiresUtc": { "$ref": "#/$defs/utc" }
      },
      "additionalProperties": true
    },
    "revocation": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["active", "revoked", "expired"] }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
