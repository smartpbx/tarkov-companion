{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/privacy-review.v1.schema.json",
  "title": "Recognition corpus privacy and redaction review",
  "type": "object",
  "required": ["schemaVersion", "reviewId", "state", "reviewedUtc", "redaction"],
  "properties": {
    "schemaVersion": { "const": "privacy-review.v1" },
    "reviewId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "state": { "enum": ["approved", "rejected", "pending"] },
    "reviewedUtc": { "type": "string", "format": "date-time" },
    "redaction": { "enum": ["not-required", "applied", "rejected"] }
  },
  "additionalProperties": true
}
