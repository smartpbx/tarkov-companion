{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/predictions.v1.schema.json",
  "title": "Truth-free typed recognition predictions",
  "type": "object",
  "required": ["schemaVersion", "runId", "producer", "planLock", "predictions"],
  "properties": {
    "schemaVersion": { "const": "predictions.v1" },
    "runId": { "$ref": "#/$defs/opaqueId" },
    "producer": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": true
    },
    "planLock": {
      "$ref": "#/$defs/sha256",
      "description": "The exact lock of the run plan these predictions answer; a reused run id alone does not bind them."
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prediction" }
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intent": {
      "enum": ["loot-decision", "full-stash", "ammo", "keys", "quest-items", "map-extracts-timers", "health-character", "auto-detect"]
    },
    "evidenceClass": { "enum": ["real-raster", "synthetic-raster", "post-ocr-evidence"] },
    "predictionType": { "enum": ["context", "region", "grid-cell", "item", "attribute", "extract", "timer", "health", "recommendation"] },
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["claimId", "kind", "value", "region"],
      "properties": {
        "claimId": { "$ref": "#/$defs/opaqueId" },
        "kind": { "$ref": "#/$defs/predictionType" },
        "value": { "type": ["string", "null"], "maxLength": 4096 },
        "region": {
          "oneOf": [
            { "$ref": "#/$defs/region" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "sampleId",
        "intent",
        "evidenceClass",
        "provenance",
        "lineage",
        "producedUtc",
        "source",
        "type",
        "status",
        "confidence",
        "claims",
        "performance"
      ],
      "properties": {
        "sampleId": { "$ref": "#/$defs/opaqueId" },
        "intent": { "$ref": "#/$defs/intent" },
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "provenance": {
          "$ref": "provenance.v1.schema.json",
          "description": "The exact provenance snapshot of the run-plan sample this result answers; every member must match."
        },
        "lineage": {
          "$ref": "manifest.v1.schema.json#/$defs/lineage",
          "description": "The exact sequence lineage of the run-plan sample this result answers; every member must match."
        },
        "producedUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "When the producer created this result; never after validation or score time."
        },
        "source": {
          "type": "object",
          "required": ["modelId", "modelVersion", "kind"],
          "properties": {
            "modelId": { "$ref": "#/$defs/opaqueId" },
            "modelVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
            "kind": { "enum": ["modelled-estimate", "deterministic-rule", "derived-calculation"] }
          },
          "additionalProperties": true
        },
        "type": { "$ref": "#/$defs/predictionType" },
        "status": { "enum": ["detected", "abstained", "unavailable"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim" }
        },
        "performance": {
          "type": "object",
          "required": ["elapsedMilliseconds"],
          "properties": {
            "elapsedMilliseconds": { "type": "number", "minimum": 0, "maximum": 120000 }
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "detected" } }, "required": ["status"] },
          "then": { "properties": { "claims": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["abstained", "unavailable"] } }, "required": ["status"] },
          "then": { "properties": { "claims": { "maxItems": 0 }, "confidence": { "const": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "region" } }, "required": ["type"] },
          "then": {
            "properties": {
              "claims": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/claim" },
                    { "properties": { "kind": { "const": "region" }, "value": { "type": "null" }, "region": { "$ref": "#/$defs/region" } } }
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
