{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/provenance.v1.schema.json",
  "title": "Recognition corpus provenance and immutable context",
  "type": "object",
  "required": [
    "schemaVersion",
    "captureIntentId",
    "sessionId",
    "correlationId",
    "captureOrdinal",
    "workspaceId",
    "profileId",
    "mapId",
    "floorId",
    "planId",
    "objectiveIds",
    "selectedReference",
    "priorScanReference",
    "deviceClass",
    "surface",
    "resolution",
    "uiScale",
    "locale",
    "gameVersion",
    "companionUiVersion"
  ],
  "properties": {
    "schemaVersion": { "const": "provenance.v1" },
    "captureIntentId": { "$ref": "#/$defs/opaqueId" },
    "sessionId": { "$ref": "#/$defs/opaqueId" },
    "correlationId": { "$ref": "#/$defs/opaqueId" },
    "captureOrdinal": { "type": "integer", "minimum": 0 },
    "workspaceId": { "$ref": "#/$defs/nullableOpaqueId" },
    "profileId": { "$ref": "#/$defs/nullableOpaqueId" },
    "mapId": { "$ref": "#/$defs/nullableOpaqueId" },
    "floorId": { "$ref": "#/$defs/nullableOpaqueId" },
    "planId": { "$ref": "#/$defs/nullableOpaqueId" },
    "objectiveIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "selectedReference": { "$ref": "#/$defs/nullableOpaqueId" },
    "priorScanReference": { "$ref": "#/$defs/nullableOpaqueId" },
    "deviceClass": { "enum": ["desktop", "tablet", "phone", "unknown"] },
    "surface": { "enum": ["companion-window", "paired-device", "user-screenshot", "unknown"] },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 }
      },
      "additionalProperties": true
    },
    "uiScale": { "type": "number", "minimum": 0.25, "maximum": 8 },
    "locale": { "type": "string", "minLength": 1, "maxLength": 128 },
    "gameVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "companionUiVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "nullableOpaqueId": {
      "oneOf": [
        { "$ref": "#/$defs/opaqueId" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": true
}
