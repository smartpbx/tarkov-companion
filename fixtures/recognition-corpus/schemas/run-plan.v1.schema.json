{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/run-plan.v1.schema.json",
  "title": "Truth-free recognition producer run plan",
  "type": "object",
  "required": ["schemaVersion", "runId", "producer", "policyVersion", "samples"],
  "properties": {
    "schemaVersion": { "const": "run-plan.v1" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "producer": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } }, "additionalProperties": true },
    "policyVersion": { "const": "recognition-scorer-policy.v1" },
    "samples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sampleId", "split", "intent", "provenance", "lineage"], "properties": { "sampleId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "split": { "enum": ["train", "tune", "test"] }, "intent": { "enum": ["loot-decision", "full-stash", "ammo", "keys", "quest-items", "map-extracts-timers", "health-character", "auto-detect"] }, "provenance": { "$ref": "provenance.v1.schema.json" }, "lineage": { "type": "object" } }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
