{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovcompanion.local/schemas/recognition-corpus/manifest.v1.schema.json",
  "title": "Private recognition corpus manifest",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "nearDuplicateGraphVersion", "samples"],
  "properties": {
    "schemaVersion": { "const": "manifest.v1" },
    "corpusId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "nearDuplicateGraphVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sampleId", "evidenceClass", "splitUnitId", "content", "provenance", "lineage", "truth"],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
          "evidenceClass": { "enum": ["real-raster", "synthetic-raster", "post-ocr-evidence"] },
          "splitUnitId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content": { "type": "object", "required": ["decodedPixelSha256"], "properties": { "decodedPixelSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "nearDuplicateIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "additionalProperties": true },
          "consent": { "$ref": "consent.v1.schema.json" },
          "privacyReview": { "$ref": "privacy-review.v1.schema.json" },
          "provenance": { "$ref": "provenance.v1.schema.json" },
          "lineage": { "type": "object", "required": ["sequenceId", "frameOrdinal", "viewportId", "containerIdentity", "overlapWithPrevious"], "properties": { "sequenceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }, "frameOrdinal": { "type": "integer", "minimum": 0 }, "viewportId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }, "containerIdentity": { "type": "string", "pattern": "^[A-Za-z0-9_./-]{1,256}$" }, "overlapWithPrevious": { "type": "number", "minimum": 0, "maximum": 1 }, "parentContainerIdentity": { "type": "string" } }, "additionalProperties": true },
          "truth": { "type": "object", "required": ["claims"], "properties": { "claims": { "type": "array", "items": { "type": "object", "required": ["truthId", "state"], "properties": { "truthId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }, "state": { "enum": ["known", "unknown"] }, "kind": { "type": "string" }, "value": {} }, "additionalProperties": true } } }, "additionalProperties": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
